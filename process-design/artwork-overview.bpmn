      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"전략구매","status":"자료와 사용자 설명을 반영한 1차 초안"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"source":["CFN-01","CFE-01"],"routes":["ON","OO","GN","GO","AN","AO"],"status":"자료와 사용자 설명을 반영한 1차 초안","inputs":"","outputs":""}</bpmn:documentation>
      <bpmn:incoming>F_084</bpmn:incoming>
      <bpmn:outgoing>F_085</bpmn:outgoing>
