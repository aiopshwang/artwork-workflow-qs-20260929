<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Artwork_Overview_02" name="동국제약 Artwork 전체 업무 프로세스 — 연결 표현 개선 2판">
    <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"questions":[{"id":"Q-01","text":"생산·관련 부서가 반드시 확인하는 항목과 QS 검토와의 실제 선후·병행 관계는 무엇인가?","status":"현업 확인 필요","source":["주체-11","CODEX 9"]},{"id":"Q-02","text":"위탁 신규에서 최종 Illustrator 파일을 실제 전환하는 사람은 디자인팀인가, 개발부인가?","status":"URS 표와 그림 상충","source":["GN-10","기타-01"]},{"id":"Q-03","text":"수탁 신규에서 대응 자사 품목이 없거나 여럿이면 어떤 자료를 제작·검토 기준으로 정하는가?","status":"조건 존재 확인, 처리 상세 미확인","source":["품목-13"]},{"id":"Q-04","text":"수탁 자재를 의뢰사가 공급하는 경우와 동국이 공급하는 경우가 실제로 어떻게 나뉘며, 발주·입고 담당자는 누구인가?","status":"사용자 질문 미해결","source":["사용자: 수탁 자재 공급 주체"]},{"id":"Q-05","text":"동국 ERP에 없는 외부 회사의 발주·입고 사실은 어디서 받아 어떤 범위까지 기록하는가?","status":"수집 방법 미정","source":["발주-14"]},{"id":"Q-06","text":"위탁 신규의 개발부 최종안 확인 결과와 QS 시스템의 완료 처리는 어떤 자료로 연결하는가?","status":"업무·시스템 경계 확인 필요","source":["GN-11~12","승인-01"]},{"id":"Q-07","text":"허가증·바코드가 늦는 경우 디자인 반영, 인쇄 일정 반영, 입고 후 추가 인쇄의 담당 인계를 어떻게 구분하는가?","status":"경로는 원문 확인, 세부 인계 확인 필요","source":["ON-20~30"]}],"notes":["한 품목의 대상 자재마다 독립적으로 진행한다.","실제 업무와 시스템 잠정 규칙을 구별한다.","표준서→첫 발주 순서와 완료 후 개정 처리에는 장부의 잠정 규칙이 포함된다.","업무 상자를 클릭하면 담당·받는 자료·행동·전달 결과와 확인 필요 사항을 읽는다. 하위 워크플로우 전체 작성은 다음 단계다."]}</bpmn:documentation>
    <bpmn:participant id="Participant_Process_Dongkook" name="동국제약 Artwork 업무 — 대상 자재마다 독립 진행" processRef="Process_Dongkook" />
    <bpmn:participant id="Participant_Process_Customer" name="수탁 의뢰사 — 품목의 허가권자" processRef="Process_Customer" />
    <bpmn:participant id="Participant_Process_Manufacturer" name="위탁 제조사 — 동국제약의 생산을 맡은 회사" processRef="Process_Manufacturer" />
    <bpmn:messageFlow id="M_01" name="신규·개정 의뢰와 대상 자재" sourceRef="X_C_START" targetRef="N_CONTRACT">
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"source":"X_C_START"}</bpmn:documentation>
    </bpmn:messageFlow>
    <bpmn:messageFlow id="M_02" name="칼선·규격 또는 변경 근거" sourceRef="C_BASIS" targetRef="X_C_ART">
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"source":"C_BASIS"}</bpmn:documentation>
    </bpmn:messageFlow>
    <bpmn:messageFlow id="M_03" name="업체 Artwork PDF·Illustrator 원본" sourceRef="X_C_ART" targetRef="Q_VENDOR_RECEIVE">
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"source":"X_C_ART"}</bpmn:documentation>
    </bpmn:messageFlow>
    <bpmn:messageFlow id="M_04" name="수정 또는 원본 재수령 요청" sourceRef="C_VENDOR_FIX" targetRef="X_C_ART">
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"source":"C_VENDOR_FIX"}</bpmn:documentation>
    </bpmn:messageFlow>
    <bpmn:messageFlow id="M_05" name="같은 확인용 Artwork" sourceRef="C_CONFIRM" targetRef="X_C_CONFIRM">
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"source":"C_CONFIRM"}</bpmn:documentation>
    </bpmn:messageFlow>
    <bpmn:messageFlow id="M_06" name="의뢰사 검토 의견·확인 파일" sourceRef="X_C_CONFIRM" targetRef="C_CONFIRM_RECEIVE">
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"source":"X_C_CONFIRM"}</bpmn:documentation>
    </bpmn:messageFlow>
    <bpmn:messageFlow id="M_07" name="생산 관련 수정 내용과 반영 계획" sourceRef="C_SHARE_CHANGE" targetRef="X_C_CONFIRM">
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"source":"C_SHARE_CHANGE"}</bpmn:documentation>
    </bpmn:messageFlow>
    <bpmn:messageFlow id="M_08" name="위탁 신규의 생산 검토 요청" sourceRef="D_MFG_REQUEST" targetRef="X_M_PROD">
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"source":"D_MFG_REQUEST"}</bpmn:documentation>
    </bpmn:messageFlow>
    <bpmn:messageFlow id="M_09" name="위탁 개정의 생산 검토 요청" sourceRef="Q_MFG_REQUEST" targetRef="X_M_PROD">
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"source":"Q_MFG_REQUEST"}</bpmn:documentation>
    </bpmn:messageFlow>
    <bpmn:messageFlow id="M_10" name="위탁 신규 검토 결과" sourceRef="X_M_PROD" targetRef="D_MFG_RESULT">
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"source":"X_M_PROD"}</bpmn:documentation>
    </bpmn:messageFlow>
    <bpmn:messageFlow id="M_11" name="위탁 개정 검토 결과" sourceRef="X_M_PROD" targetRef="Q_MFG_RESULT">
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"source":"X_M_PROD"}</bpmn:documentation>
    </bpmn:messageFlow>
    <bpmn:messageFlow id="M_12" name="위탁 신규 최종 Artwork" sourceRef="DEV_FINAL" targetRef="X_M_FINAL">
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"source":"DEV_FINAL"}</bpmn:documentation>
    </bpmn:messageFlow>
    <bpmn:messageFlow id="M_13" name="위탁 개정 최종 Artwork" sourceRef="Q_DELIVER" targetRef="X_M_FINAL">
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"source":"Q_DELIVER"}</bpmn:documentation>
    </bpmn:messageFlow>
    <bpmn:messageFlow id="M_14" name="다음 발주용 인쇄 파일" sourceRef="X_M_REORDER" targetRef="N_EXTERNAL_REORDER">
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"source":"X_M_REORDER"}</bpmn:documentation>
    </bpmn:messageFlow>
    <bpmn:messageFlow id="M_15" name="인쇄용 파일 수정·재전달 요청" sourceRef="Q_REPLACE" targetRef="X_M_REORDER">
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"source":"Q_REPLACE"}</bpmn:documentation>
    </bpmn:messageFlow>
    <bpmn:messageFlow id="M_16" name="변경 없음 또는 사용할 버전" sourceRef="Q_REPLY" targetRef="X_M_ORDER">
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"source":"Q_REPLY"}</bpmn:documentation>
    </bpmn:messageFlow>
  </bpmn:collaboration>
  <bpmn:process id="Process_Dongkook" isExecutable="false">
    <bpmn:documentation>전체 업무 1차 검토 초안. 실제 실행용 자동화 모델이 아니다. 업무 담당과 자료 전달을 검토한다.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Process_Dongkook">
      <bpmn:lane id="Lane_Process_Dongkook_DEV" name="개발·마케팅 및 요청부서">
        <bpmn:flowNodeRef>N_NEW</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_REV</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>D_REQUEST</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>D_CHANGE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>D_GN_PREP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>D_GN_DESIGN</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>D_MFG_REQUEST</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>D_GN_REVIEW</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>D_MFG_RESULT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>D_CIRCULATE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J_DEV_FINAL</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>DEV_FINAL</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Process_Dongkook_QS" name="QS팀">
        <bpmn:flowNodeRef>N_DISCOVER</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_LATE_PERMIT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_BARCODE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_EXTERNAL_REORDER</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J_Q_SCOPE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Q_LATE_PERMIT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Q_BARCODE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J_Q_REORDER</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Q_DOWNLOAD</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Q_SCOPE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_LATE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_BARCODE_TIMING</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Q_REORDER</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_CONTRACT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J_G_PERMIT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_LATE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Q_BARCODE_BEFORE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_REORDER</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_GN</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_PERMIT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J_Q_BARCODE_DONE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Q_REPLACE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Q_REPLY</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Q_MATERIAL</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J_Q_VENDOR_RECEIVE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Q_PERMIT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Q_TEXT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Q_BARCODE_DONE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Q_GN_CODE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_REGISTER</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Q_VENDOR_RECEIVE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J_Q_CHECK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_BARCODE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Q_REGISTER</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J_Q_BASIS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Q_VENDOR_REVIEW</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Q_CHECK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Q_BASIS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Q_FIX</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_REV</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_VENDOR_FIX</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J_Q_NOTES</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_PROD_ROUTE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_REVIEW_ROUTE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Q_CHANGE_NOTES</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J_Q_DESIGN_REQUEST</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Q_NOTES</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Q_MFG_REQUEST</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_SPLIT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Q_DESIGN_REQUEST</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J_G_ALL_FIX</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Q_MFG_RESULT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Q_A_REVIEW</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_ALL_FIX</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_FINAL</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_JOIN</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Q_A_COLLECT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J_Q_FINAL_CHECK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Q_FINAL_CHECK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_FINAL_ERROR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Q_DELIVER</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_DELIVERY</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Q_STANDARD</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Q_EXTERNAL_ORDER</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_EXTERNAL_FIRST</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Process_Dongkook_BUY" name="전략구매">
        <bpmn:flowNodeRef>N_REORDER</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_VERSION_REQUEST</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_REORDER</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_ORDER_OWNER</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_ORDER</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Process_Dongkook_CON" name="수탁담당">
        <bpmn:flowNodeRef>N_CONTRACT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C_RECEIVE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C_BASIS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J_C_VENDOR_FIX</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C_VENDOR_FIX</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C_CONFIRM</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C_CONFIRM_RECEIVE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C_SHARE_CHANGE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C_FINAL_RECEIVE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_CON_DELIVERY</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Process_Dongkook_PROD" name="생산 및 관련 부서">
        <bpmn:flowNodeRef>P_VENDOR_REVIEW</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_CHECK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_A_CHECK</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Process_Dongkook_DES" name="디자인팀">
        <bpmn:flowNodeRef>J_D_ART</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>D_ART</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>D_CHECK_FILE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_FILE_OK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J_D_FINAL</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>D_FINAL</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_RECONVERT</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Process_Dongkook_STOCK" name="재고·입고 담당">
        <bpmn:flowNodeRef>S_BARCODE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_RECEIVE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_FIRST</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="N_NEW" name="신규 Artwork 제작이 필요하다">
      <bpmn:documentation>개발·마케팅이 신제품의 표시자재 제작을 요청하는 시작이다.
상태: 자료와 사용자 설명을 반영한 1차 초안</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"개발·마케팅 및 요청부서","status":"자료와 사용자 설명을 반영한 1차 초안"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"source":["사용자: 신규 작업의뢰서와 대상 자재 범위"],"routes":["ON","GN"],"status":"자료와 사용자 설명을 반영한 1차 초안","inputs":"","outputs":""}</bpmn:documentation>
      <bpmn:outgoing>F_001</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:startEvent id="N_REV" name="기존 Artwork의 변경 요청이 있다">
      <bpmn:documentation>내부 요청부서 또는 상대 회사에서 메일·메신저 등으로 변경을 요청한다.
상태: 자료와 사용자 설명을 반영한 1차 초안</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"개발·마케팅 및 요청부서","status":"자료와 사용자 설명을 반영한 1차 초안"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"source":["OO-01","GO-01","AO-01"],"routes":["OO","GO","AO"],"status":"자료와 사용자 설명을 반영한 1차 초안","inputs":"","outputs":""}</bpmn:documentation>
      <bpmn:outgoing>F_004</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:startEvent id="N_DISCOVER" name="QS팀이 Artwork의&#10;변경 필요를 확인한다">
      <bpmn:documentation>허가사항 변경, 통일조정·변경 명령 등 QS가 직접 확인한 변경 필요도 업무를 시작시킨다.
상태: 자료와 사용자 설명을 반영한 1차 초안</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀","status":"자료와 사용자 설명을 반영한 1차 초안"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"source":["docs/20 M-74~80","자료-02"],"routes":["OO","GO"],"status":"자료와 사용자 설명을 반영한 1차 초안","inputs":"","outputs":""}</bpmn:documentation>
      <bpmn:outgoing>F_006</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:startEvent id="N_REORDER" name="같은 자재의&#10;다음 발주 요청이 있다">
      <bpmn:documentation>첫 발주 뒤 발생하는 별도 업무다.
상태: 자료와 사용자 설명을 반영한 1차 초안</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"전략구매","status":"자료와 사용자 설명을 반영한 1차 초안"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"source":["CFN-01","CFE-01","발주-09"],"routes":["ON","OO","GN","GO","AN","AO"],"status":"자료와 사용자 설명을 반영한 1차 초안","inputs":"","outputs":""}</bpmn:documentation>
      <bpmn:outgoing>F_084</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:startEvent id="N_LATE_PERMIT" name="진행 중이거나 완료된 품목의&#10;허가증을 나중에 받는다">
      <bpmn:documentation>자료 도착 시점에 따라 해당 자재의 현재 상태를 확인한다. 모든 건의 마지막 고정 단계가 아니다.
상태: 자료와 사용자 설명을 반영한 1차 초안</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀","status":"자료와 사용자 설명을 반영한 1차 초안"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"source":["허가-11","ON-20"],"routes":["ON","OO","GN","GO","AN","AO"],"status":"자료와 사용자 설명을 반영한 1차 초안","inputs":"","outputs":""}</bpmn:documentation>
      <bpmn:outgoing>F_092</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:startEvent id="N_BARCODE" name="바코드 반영이 필요하거나&#10;번호를 나중에 받았다">
      <bpmn:documentation>허가증 도착과 별개로 바코드 적용 대상, 번호 확보, 실제 반영 상태를 확인한다.
상태: 자료와 사용자 설명을 반영한 1차 초안</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀","status":"자료와 사용자 설명을 반영한 1차 초안"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"source":["ON-10","ON-21~23","바코-04"],"routes":["ON"],"status":"자료와 사용자 설명을 반영한 1차 초안","inputs":"","outputs":""}</bpmn:documentation>
      <bpmn:outgoing>F_108</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:startEvent id="N_CONTRACT" name=" 수탁 의뢰사의&#10;Artwork 요청을 받는다">
      <bpmn:documentation>수탁 의뢰사의 메시지로 해당 업무가 시작된다.
상태: 자료와 사용자 설명을 반영한 1차 초안</bpmn:documentation>
