        <bpmn:flowNodeRef>J_Q_BARCODE_DONE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Q_REPLACE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Q_REPLY</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Q_MATERIAL</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J_Q_VENDOR_RECEIVE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Q_PERMIT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Q_TEXT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Q_BARCODE_DONE</bpmn:flowNodeRef>
