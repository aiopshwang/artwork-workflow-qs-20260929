        <bpmn:flowNodeRef>J_Q_DESIGN_REQUEST</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R_DESIGN_RETURN</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Q_MFG_REQUEST</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Q_DESIGN_REQUEST</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J_G_ALL_FIX</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Q_MFG_RESULT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_ALL_FIX</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_SPLIT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_FINAL</bpmn:flowNodeRef>
