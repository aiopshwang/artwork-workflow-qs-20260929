      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"source":["ON-18","OO-13","GO-09","AN-23","AO-21"],"routes":["ON","OO","GO","AN","AO"],"status":"기존 업무를 구분해 표현한 2판 — 새 업무 추가 아님","inputs":"","outputs":"","gatewayDirection":"Converging","mergeTarget":"D_FINAL","joinSources":["D_CIRCULATE","G_FINAL","G_RECONVERT"]}</bpmn:documentation>
      <bpmn:incoming>F_066</bpmn:incoming>
