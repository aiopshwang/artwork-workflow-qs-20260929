        <bpmn:flowNodeRef>G_RECONVERT</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Process_Dongkook_STOCK" name="재고·입고 담당">
        <bpmn:flowNodeRef>S_BARCODE</bpmn:flowNodeRef>
