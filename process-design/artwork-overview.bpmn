      <bpmn:incoming>F_010</bpmn:incoming>
      <bpmn:outgoing>F_020</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Q_MATERIAL" name="사용할 자재와 기존 승인&#10;Artwork·규격을 확인한다">
      <bpmn:documentation>신규는 기존 자재를 활용할 수 있는지 확인한다. 개정은 변경 대상과 기존 승인본을 확인하고 규격·자재코드 변경 필요를 판단한다.
입력 자료: 대상 자재, 기존 등록 정보와 승인 Artwork·규격
전달 자료: 사용할 자재와 승인본·규격, 신규 등록 또는 규격 변경 필요 여부
업무 규칙: 적용 업무: 자사 신규, 자사 개정, 위탁 개정</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"source":["ON-02~04","OO-02~05","단계-36"],"routes":["ON","OO","GO"],"inputs":"대상 자재, 기존 등록 정보와 승인 Artwork·규격","outputs":"사용할 자재와 승인본·규격, 신규 등록 또는 규격 변경 필요 여부","businessRules":["적용 업무: 자사 신규, 자사 개정, 위탁 개정"],"solutionSupport":{"label":"솔루션 지원","description":"대상 품목·자재 조건으로 기존 자재와 승인 Artwork·규격을 검색하고, 담당자가 고른 자료를 이번 업무에 연결한다.","functionIds":["K-접수-13","K-접수-14","K-접수-15"],"basis":[{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","section":"기존 기능 번호 K-접수-13, K-접수-14, K-접수-15"},{"path":"docs/23_업무규칙장부.md","section":"현재 채택한 업무 규칙과 역할·전달·검토 조건"}],"definitionState":"설계에 정의됨","perspective":"tobe","workflow":"NW_Q_MATERIAL"},"includedNodeIds":["Q_MATERIAL"],"perspective":"asis"}</bpmn:documentation>
