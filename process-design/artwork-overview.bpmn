        <bpmn:flowNodeRef>P_VENDOR_REVIEW</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_CHECK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_A_CHECK</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Process_Dongkook_DES" name="디자인팀">
        <bpmn:flowNodeRef>J_D_ART_GN</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>D_ART_GN</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>D_CHECK_FILE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_FILE_OK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J_D_ART</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J_D_ART_A</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>D_ART</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>D_ART_A</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J_D_FINAL</bpmn:flowNodeRef>
