      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"source":["ON-17","GN-10~12","GO-09~11","AN-23~24"],"routes":["ON","OO","GN","GO","AN","AO"],"status":"자료와 사용자 설명을 반영한 1차 초안","inputs":"","outputs":""}</bpmn:documentation>
