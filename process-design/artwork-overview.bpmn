      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"source":["CFN-02","CFE-02","발주-11~12"],"routes":["ON","OO","GN","GO","AN","AO"],"status":"기존 업무를 구분해 표현한 2판 — 새 업무 추가 아님","inputs":"","outputs":"","gatewayDirection":"Converging","mergeTarget":"Q_REORDER","joinSources":["B_VERSION_REQUEST","Q_REPLACE","N_EXTERNAL_REORDER"]}</bpmn:documentation>
      <bpmn:incoming>F_085</bpmn:incoming>
