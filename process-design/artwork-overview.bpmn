        <bpmn:flowNodeRef>Q_VENDOR_RECEIVE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J_Q_CHECK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_BARCODE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Q_REGISTER</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J_Q_BASIS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Q_VENDOR_REVIEW</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Q_FIX</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Q_BASIS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J_Q_NOTES</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_ON_PERMIT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_REV</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_VENDOR_FIX</bpmn:flowNodeRef>
