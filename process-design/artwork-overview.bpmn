<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Artwork_Overview_02" name="Artwork 현행 업무 흐름">
    <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"questionsApproved":[{"id":"CQ-01","label":"고객사 질문 1","text":"신규 작업의뢰서의 대상 자재는 보통 케이스·설명서·라벨처럼 종류가 지정되어 오나요? 아니면 포장단위와 자재 규격까지 함께 정해져 오나요?","status":"답변 대기"}],"perspective":"asis"}</bpmn:documentation>
    <bpmn:participant id="Participant_Process_Dongkook" name="동국제약 Artwork 업무 — 대상 자재마다 독립 진행" processRef="Process_Dongkook" />
    <bpmn:participant id="Participant_Process_Customer" name="수탁 의뢰사 — 품목의 허가권자" processRef="Process_Customer" />
    <bpmn:participant id="Participant_Process_Manufacturer" name="위탁 제조사 — 동국제약의 생산을 맡은 회사" processRef="Process_Manufacturer" />
    <bpmn:messageFlow id="M_01" name="신규·개정 의뢰와 대상 자재" sourceRef="X_C_START" targetRef="N_CONTRACT">
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"source":"X_C_START"}</bpmn:documentation>
    </bpmn:messageFlow>
    <bpmn:messageFlow id="M_02" name="칼선·규격 또는 변경 근거" sourceRef="C_BASIS" targetRef="X_C_ART">
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"source":"C_BASIS"}</bpmn:documentation>
    </bpmn:messageFlow>
    <bpmn:messageFlow id="M_03" name="업체 Artwork PDF·Illustrator 원본" sourceRef="X_C_ART" targetRef="Q_VENDOR_RECEIVE">
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"source":"X_C_ART"}</bpmn:documentation>
    </bpmn:messageFlow>
    <bpmn:messageFlow id="M_04" name="수정 또는 원본 재수령 요청" sourceRef="C_VENDOR_FIX" targetRef="X_C_ART">
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"source":"C_VENDOR_FIX"}</bpmn:documentation>
    </bpmn:messageFlow>
    <bpmn:messageFlow id="M_05" name="같은 확인용 Artwork" sourceRef="C_CONFIRM" targetRef="X_C_CONFIRM">
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"source":"C_CONFIRM"}</bpmn:documentation>
    </bpmn:messageFlow>
    <bpmn:messageFlow id="M_06" name="의뢰사 검토 의견·확인 파일" sourceRef="X_C_CONFIRM" targetRef="C_CONFIRM_RECEIVE">
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"source":"X_C_CONFIRM"}</bpmn:documentation>
    </bpmn:messageFlow>
    <bpmn:messageFlow id="M_07" name="생산 관련 수정 내용과 반영 계획" sourceRef="C_SHARE_CHANGE" targetRef="X_C_CONFIRM">
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"source":"C_SHARE_CHANGE"}</bpmn:documentation>
    </bpmn:messageFlow>
    <bpmn:messageFlow id="M_08" name="위탁 신규의 생산 검토 요청" sourceRef="D_MFG_REQUEST" targetRef="X_M_PROD">
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"source":"D_MFG_REQUEST"}</bpmn:documentation>
    </bpmn:messageFlow>
    <bpmn:messageFlow id="M_09" name="위탁 개정의 생산 검토 요청" sourceRef="Q_MFG_REQUEST" targetRef="X_M_PROD">
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"source":"Q_MFG_REQUEST"}</bpmn:documentation>
    </bpmn:messageFlow>
    <bpmn:messageFlow id="M_10" name="위탁 신규 검토 결과" sourceRef="X_M_PROD" targetRef="D_MFG_RESULT">
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"source":"X_M_PROD"}</bpmn:documentation>
    </bpmn:messageFlow>
    <bpmn:messageFlow id="M_11" name="위탁 개정 검토 결과" sourceRef="X_M_PROD" targetRef="Q_MFG_RESULT">
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"source":"X_M_PROD"}</bpmn:documentation>
    </bpmn:messageFlow>
    <bpmn:messageFlow id="M_12" name="위탁 신규 최종 Artwork" sourceRef="DEV_FINAL" targetRef="X_M_FINAL">
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"source":"DEV_FINAL"}</bpmn:documentation>
    </bpmn:messageFlow>
    <bpmn:messageFlow id="M_13" name="위탁 개정 최종 Artwork" sourceRef="Q_DELIVER" targetRef="X_M_FINAL">
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"source":"Q_DELIVER"}</bpmn:documentation>
    </bpmn:messageFlow>
    <bpmn:messageFlow id="M_14" name="다음 발주용 인쇄 파일" sourceRef="X_M_REORDER" targetRef="N_EXTERNAL_REORDER">
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"source":"X_M_REORDER"}</bpmn:documentation>
    </bpmn:messageFlow>
    <bpmn:messageFlow id="M_15" name="인쇄용 파일 수정·재전달 요청" sourceRef="Q_REPLACE" targetRef="X_M_REORDER">
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"source":"Q_REPLACE"}</bpmn:documentation>
    </bpmn:messageFlow>
    <bpmn:messageFlow id="M_16" name="변경 없음 또는 사용할 버전" sourceRef="Q_REPLY" targetRef="X_M_ORDER">
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"source":"Q_REPLY"}</bpmn:documentation>
    </bpmn:messageFlow>
  </bpmn:collaboration>
  <bpmn:process id="Process_Dongkook" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Process_Dongkook">
      <bpmn:lane id="Lane_Process_Dongkook_DEV" name="개발·마케팅 및 요청부서">
        <bpmn:flowNodeRef>N_NEW</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_REV</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>D_REQUEST</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>D_CHANGE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>D_GN_PREP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>D_GN_DESIGN</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>D_GN_REVIEW</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>D_MFG_REQUEST</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>D_MFG_RESULT</bpmn:flowNodeRef>
