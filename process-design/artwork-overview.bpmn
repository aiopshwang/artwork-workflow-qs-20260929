      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"source":["CR-34","CR-36","수정-01","사용자: 반영 주석은 다시 달지 않음","GN-07","GO-06"],"routes":["ON","OO","GN","GO","AN","AO"],"status":"자료와 사용자 설명을 반영한 1차 초안","inputs":"","outputs":"검토 의견과 남은 수정 요청"}</bpmn:documentation>
