      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀","status":"기존 업무를 구분해 표현한 2판 — 새 업무 추가 아님"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"source":["ON-01","OO-02~04","AO-02","사용자: 자재마다 검토·완료","O-01","G-01"],"routes":["ON","OO","GN","GO","AN","AO"],"status":"기존 업무를 구분해 표현한 2판 — 새 업무 추가 아님","inputs":"","outputs":"","gatewayDirection":"Converging","mergeTarget":"Q_SCOPE","joinSources":["Q_DOWNLOAD","D_CHANGE","N_DISCOVER","C_RECEIVE","G_REORDER","G_LATE"]}</bpmn:documentation>
