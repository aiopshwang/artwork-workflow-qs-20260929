      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"source":["CFN-03","CFE-03"],"routes":["ON","OO","GN","GO","AN","AO"],"inputs":"발주 전 확인 결과와 사용할 Artwork 버전","outputs":"요청자에게 전달할 버전 또는 변경 없음 회신","businessRules":["적용 업무: 자사 신규, 자사 개정, 위탁 신규, 위탁 개정, 수탁 신규, 수탁 개정"],"solutionSupport":{"label":"솔루션 지원","description":"QS가 발주 전 비교 결과를 보고 회신 내용을 결정하며, 회신에 사용한 파일·개정번호·확인 결과와 전달 기록을 보존한다.","functionIds":["C-14","C-17"],"basis":[{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","section":"기존 기능 번호 C-14, C-17"},{"path":"docs/23_업무규칙장부.md","section":"현재 채택한 업무 규칙과 역할·전달·검토 조건"}],"definitionState":"설계에 정의됨","perspective":"tobe","workflow":"NW_Q_REPLY"},"includedNodeIds":["Q_REPLY"],"perspective":"asis"}</bpmn:documentation>
