      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"source":["접수-07","접수-13","사용자: 신규 시작"],"routes":["ON","GN"],"status":"자료와 사용자 설명을 반영한 1차 초안","inputs":"","outputs":"작업의뢰서와 첨부자료"}</bpmn:documentation>
