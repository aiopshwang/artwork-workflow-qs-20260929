      <bpmn:incoming>F_107</bpmn:incoming>
      <bpmn:outgoing>F_077</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G_ORDER_OWNER" name="이 자재를&#10;누가 발주하는가?" gatewayDirection="Diverging" default="F_080">
      <bpmn:documentation>자재 공급 관계에 따라 동국제약 또는 외부 회사가 발주한다. 수탁이라는 이유만으로 동국 구매가 자재를 발주한다고 단정하지 않는다.
확인할 질문: Q-04
