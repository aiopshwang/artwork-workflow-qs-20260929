    <bpmn:userTask id="C_SHARE_CHANGE" name="수탁 의뢰사에 수정 내용과&#10;반영 예정 사항을 공유한다">
      <bpmn:documentation>동국의 생산 관련 수정 등 의뢰사에도 알려야 할 사항을 수탁담당이 전달한다. 모든 수정이 이 업무를 반드시 거친다고 단정하지 않는다.
상태: 자료와 사용자 설명을 반영한 1차 초안</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"수탁담당","status":"자료와 사용자 설명을 반영한 1차 초안"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"source":["AN-20~21","AO-18~19"],"routes":["AN","AO"],"status":"자료와 사용자 설명을 반영한 1차 초안","inputs":"","outputs":""}</bpmn:documentation>
      <bpmn:incoming>F_062</bpmn:incoming>
      <bpmn:outgoing>F_063</bpmn:outgoing>
    </bpmn:userTask>
