<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="WF07_T_Collaboration" name="생산·관련 부서와 수탁 양측 결과 취합 · 도입 후 업무">
    <bpmn:documentation>요청·보낸 판·회신·반환 파일을 기록하고 수탁은 동일 판에 대한 양측 결과를 모은다.
입력 자료: QS가 연결한 후속 검토 요청
전달 자료: Artwork의 판에 연결한 부서·회사별 검토 회신과 최종 파일 준비 자료 또는 수정·재검토 이력</bpmn:documentation>
    <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"QS가 연결한 후속 검토 요청","outputs":"Artwork의 판에 연결한 부서·회사별 검토 회신과 최종 파일 준비 자료 또는 수정·재검토 이력","perspective":"tobe","sourceRefs":[{"path":"docs/22_URS원문.md","ref":"ON 생산 검토·GN-08·GO-07·AN-14~22·AO 양측 검토"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-58"},{"path":"docs/23_업무규칙장부.md","ref":"주체-05·주체-06·주체-11·단계-21·단계-22·단계-28·단계-29"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"C-10~12·C-15·K-검토-17·T-12·T-19"},{"path":"CODEX.md","ref":"생산 내부 절차 범위 밖, 결과와 파일을 QS가 받아 재검토"}],"workflowId":"WF07","sourceSteps":[],"level":"context","scope":null}</bpmn:documentation>
    <bpmn:participant id="Participant_WF07_T_Process" name="생산·관련 부서와 수탁 양측 결과 취합 · 도입 후 업무" processRef="WF07_T_Process" />
  </bpmn:collaboration>
  <bpmn:process id="WF07_T_Process" isExecutable="false">
    <bpmn:laneSet id="LaneSet_WF07_T_Process">
      <bpmn:lane id="Lane_WF07_T_Process_R0" name="QS팀">
        <bpmn:flowNodeRef>WF07_T00</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J_WF07_T01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF07_T01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF07_T02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF07_T03</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF07_T04</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J_WF07_T12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF07_T05</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF07_T12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF07_T07</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J_WF07_T08</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF07_T08</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF07_T09</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF07_T10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF07_T11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF07_T11_RESULT</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_WF07_T_Process_R1" name="수탁담당">
        <bpmn:flowNodeRef>WF07_T06</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_WF07_T_Process_R2" name="시스템">
        <bpmn:flowNodeRef>WF07_T08_SYS_RESPONSE</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="WF07_T00" name="후속 검토를 요청할 파일과 범위가 마련된다">
      <bpmn:documentation>해당 업무를 시작할 자료·요청을 받는다.
입력 자료: QS가 연결한 후속 검토 요청
전달 자료: 생산·관련 부서 또는 수탁 양측에 검토를 요청할 Artwork 파일</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀","scope":null}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"QS가 연결한 후속 검토 요청","outputs":"생산·관련 부서 또는 수탁 양측에 검토를 요청할 Artwork 파일","businessRules":[],"approvedQuestionIds":[],"perspective":"tobe","phase":"Phase 1","functionIds":[],"sourceRefs":[{"path":"docs/22_URS원문.md","ref":"ON 생산 검토·GN-08·GO-07·AN-14~22·AO 양측 검토"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-58"},{"path":"docs/23_업무규칙장부.md","ref":"주체-05·주체-06·주체-11·단계-21·단계-22·단계-28·단계-29"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"C-10~12·C-15·K-검토-17·T-12·T-19"},{"path":"CODEX.md","ref":"생산 내부 절차 범위 밖, 결과와 파일을 QS가 받아 재검토"}],"workflowId":"WF07","originalStepId":"WF07_T00","actorDetail":"QS 담당자","sourceSteps":[],"level":"context","scope":null}</bpmn:documentation>
      <bpmn:outgoing>WF07_T00_START_FLOW</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="J_WF07_T01" name="경로 합류" gatewayDirection="Converging">
      <bpmn:documentation>해당 경로의 업무 결과를 이어 받는다.
입력 자료: QS 검토한 자재 Artwork
전달 자료: QS 검토한 자재 Artwork</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"QS 검토한 자재 Artwork","outputs":"QS 검토한 자재 Artwork","gatewayDirection":"Converging","gatewayMeaning":"경로 합류","perspective":"tobe","workflowId":"WF07","originalStepId":"WF07_T01"}</bpmn:documentation>
      <bpmn:incoming>WF07_T00_START_FLOW</bpmn:incoming>
      <bpmn:incoming>WF07_TF14</bpmn:incoming>
      <bpmn:outgoing>WF07_T_JOIN_WF07_T01</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="WF07_T01" name="해당 경로의 후속 검토를 정한다" gatewayDirection="Diverging" default="WF07_TF03">
      <bpmn:documentation>자사 생산부, 위탁 제조사, 수탁 양측 검토 중 필요한 경로로 보낸다.
입력 자료: QS 검토한 자재 Artwork
전달 자료: 해당 자재에서 검토를 요청할 생산·관련 부서, 위탁 제조사 또는 수탁 의뢰사·동국 측 구분</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀","scope":null}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"QS 검토한 자재 Artwork","outputs":"해당 자재에서 검토를 요청할 생산·관련 부서, 위탁 제조사 또는 수탁 의뢰사·동국 측 구분","gatewayDirection":"Diverging","businessRules":[],"gatewayMeaning":"하나 선택","approvedQuestionIds":[],"perspective":"tobe","phase":"Phase 1","functionIds":["C-10","C-12","C-15"],"sourceRefs":[{"path":"docs/22_URS원문.md","ref":"ON 생산 검토·GN-08·GO-07·AN-14~22·AO 양측 검토"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-58"},{"path":"docs/23_업무규칙장부.md","ref":"주체-05·주체-06·주체-11·단계-21·단계-22·단계-28·단계-29"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"C-10~12·C-15·K-검토-17·T-12·T-19"},{"path":"CODEX.md","ref":"생산 내부 절차 범위 밖, 결과와 파일을 QS가 받아 재검토"}],"workflowId":"WF07","originalStepId":"WF07_T01","actorDetail":"QS팀·경로별 담당자","sourceSteps":[],"level":"context","scope":null}</bpmn:documentation>
      <bpmn:incoming>WF07_T_JOIN_WF07_T01</bpmn:incoming>
      <bpmn:outgoing>WF07_TF01</bpmn:outgoing>
      <bpmn:outgoing>WF07_TF02</bpmn:outgoing>
      <bpmn:outgoing>WF07_TF03</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="WF07_T02" name="생산·관련 부서에 파일을 보내 확인을 요청한다">
      <bpmn:documentation>요청 파일과 검토할 내용을 전달한다. 생산부 내부 검사 방법은 여기서 상세화하지 않는다.
입력 자료: 검토할 Artwork와 요청 내용
전달 자료: 보낸 파일과 검토 요청
업무 규칙: 자사 신규는 허가증 검토가 끝난 도안을 생산 관련 확인에 전달한다.</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀","scope":null}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"검토할 Artwork와 요청 내용","outputs":"보낸 파일과 검토 요청","businessRules":["자사 신규는 허가증 검토가 끝난 도안을 생산 관련 확인에 전달한다."],"approvedQuestionIds":[],"perspective":"tobe","phase":"Phase 1","functionIds":["C-10","C-15"],"sourceRefs":[{"path":"docs/22_URS원문.md","ref":"ON 생산 검토·GN-08·GO-07·AN-14~22·AO 양측 검토"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-58"},{"path":"docs/23_업무규칙장부.md","ref":"주체-05·주체-06·주체-11·단계-21·단계-22·단계-28·단계-29"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"C-10~12·C-15·K-검토-17·T-12·T-19"},{"path":"CODEX.md","ref":"생산 내부 절차 범위 밖, 결과와 파일을 QS가 받아 재검토"}],"workflowId":"WF07","originalStepId":"WF07_T02","actorDetail":"QS팀 → 생산·관련 부서","sourceSteps":[],"level":"context","scope":null}</bpmn:documentation>
      <bpmn:incoming>WF07_TF01</bpmn:incoming>
      <bpmn:outgoing>WF07_TF04</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="WF07_T03" name="위탁 제조사에 검토를 요청한다">
      <bpmn:documentation>경로별 담당자가 위탁 제조사에 파일을 보내고 생산 관련 결과를 요청한다.
입력 자료: 해당 Artwork와 확인 내용
전달 자료: 제조사에 보낸 파일과 요청</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀","scope":null}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"해당 Artwork와 확인 내용","outputs":"제조사에 보낸 파일과 요청","businessRules":[],"approvedQuestionIds":[],"perspective":"tobe","phase":"Phase 1","functionIds":["C-10","C-12"],"sourceRefs":[{"path":"docs/22_URS원문.md","ref":"ON 생산 검토·GN-08·GO-07·AN-14~22·AO 양측 검토"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-58"},{"path":"docs/23_업무규칙장부.md","ref":"주체-05·주체-06·주체-11·단계-21·단계-22·단계-28·단계-29"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"C-10~12·C-15·K-검토-17·T-12·T-19"},{"path":"CODEX.md","ref":"생산 내부 절차 범위 밖, 결과와 파일을 QS가 받아 재검토"}],"workflowId":"WF07","originalStepId":"WF07_T03","actorDetail":"위탁 신규: 개발부 / 위탁 개정: QS팀","sourceSteps":[],"level":"context","scope":null}</bpmn:documentation>
      <bpmn:incoming>WF07_TF02</bpmn:incoming>
      <bpmn:outgoing>WF07_TF05</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="WF07_T04" name="같은 동국용 확인본을 양측 검토로 나눈다" gatewayDirection="Diverging">
      <bpmn:documentation>의뢰사와 동국 측이 동일한 판을 각자 검토하도록 전달한다.
입력 자료: 동국용 확인 PDF
전달 자료: 수탁 의뢰사와 동국제약에 각각 전달한 동일한 확인용 PDF</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀","scope":null}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"동국용 확인 PDF","outputs":"수탁 의뢰사와 동국제약에 각각 전달한 동일한 확인용 PDF","gatewayDirection":"Diverging","businessRules":[],"gatewayMeaning":"함께 진행","approvedQuestionIds":[],"perspective":"tobe","phase":"Phase 1","functionIds":["C-15"],"sourceRefs":[{"path":"docs/22_URS원문.md","ref":"ON 생산 검토·GN-08·GO-07·AN-14~22·AO 양측 검토"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-58"},{"path":"docs/23_업무규칙장부.md","ref":"주체-05·주체-06·주체-11·단계-21·단계-22·단계-28·단계-29"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"C-10~12·C-15·K-검토-17·T-12·T-19"},{"path":"CODEX.md","ref":"생산 내부 절차 범위 밖, 결과와 파일을 QS가 받아 재검토"}],"workflowId":"WF07","originalStepId":"WF07_T04","actorDetail":"QS팀·수탁 연락 담당","sourceSteps":[],"level":"context","scope":null}</bpmn:documentation>
      <bpmn:incoming>WF07_TF03</bpmn:incoming>
      <bpmn:outgoing>WF07_TF07</bpmn:outgoing>
      <bpmn:outgoing>WF07_TF08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="J_WF07_T12" name="경로 합류" gatewayDirection="Converging">
      <bpmn:documentation>해당 경로의 업무 결과를 이어 받는다.
입력 자료: 전달한 파일과 검토 요청
전달 자료: 전달한 파일과 검토 요청</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"전달한 파일과 검토 요청","outputs":"전달한 파일과 검토 요청","gatewayDirection":"Converging","gatewayMeaning":"경로 합류","perspective":"tobe","workflowId":"WF07","originalStepId":"WF07_T12"}</bpmn:documentation>
      <bpmn:incoming>WF07_TF04</bpmn:incoming>
      <bpmn:incoming>WF07_TF05</bpmn:incoming>
      <bpmn:outgoing>WF07_T_JOIN_WF07_T12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="WF07_T05" name="동국 QS 검토와 생산 결과를 확인한다">
      <bpmn:documentation>QS가 표시사항·이전 주석을 보고 생산 관련 결과와 파일을 받는다.
입력 자료: 동국용 파일·의뢰사 원본·생산 회신
전달 자료: 동국 QS의 도안 검토 결과, 생산 검토 회신과 각 결과가 확인한 파일</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀","scope":null}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"동국용 파일·의뢰사 원본·생산 회신","outputs":"동국 QS의 도안 검토 결과, 생산 검토 회신과 각 결과가 확인한 파일","businessRules":[],"approvedQuestionIds":[],"perspective":"tobe","phase":"Phase 1","functionIds":["K-대조-20","C-11","T-12"],"sourceRefs":[{"path":"docs/22_URS원문.md","ref":"ON 생산 검토·GN-08·GO-07·AN-14~22·AO 양측 검토"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-58"},{"path":"docs/23_업무규칙장부.md","ref":"주체-05·주체-06·주체-11·단계-21·단계-22·단계-28·단계-29"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"C-10~12·C-15·K-검토-17·T-12·T-19"},{"path":"CODEX.md","ref":"생산 내부 절차 범위 밖, 결과와 파일을 QS가 받아 재검토"}],"workflowId":"WF07","originalStepId":"WF07_T05","actorDetail":"QS팀","sourceSteps":[],"level":"context","scope":null}</bpmn:documentation>
      <bpmn:incoming>WF07_TF07</bpmn:incoming>
      <bpmn:outgoing>WF07_TF09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="WF07_T06" name="의뢰사 의견과 확인 파일을 받는다">
      <bpmn:documentation>의뢰사 검토 결과와 대상 파일의 판을 받아 연결한다.
입력 자료: 의뢰사가 받은 동일 확인본
전달 자료: 의뢰사 의견과 확인 파일</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"수탁담당","scope":null}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"의뢰사가 받은 동일 확인본","outputs":"의뢰사 의견과 확인 파일","businessRules":[],"approvedQuestionIds":[],"perspective":"tobe","phase":"Phase 1","functionIds":["C-15"],"sourceRefs":[{"path":"docs/22_URS원문.md","ref":"ON 생산 검토·GN-08·GO-07·AN-14~22·AO 양측 검토"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-58"},{"path":"docs/23_업무규칙장부.md","ref":"주체-05·주체-06·주체-11·단계-21·단계-22·단계-28·단계-29"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"C-10~12·C-15·K-검토-17·T-12·T-19"},{"path":"CODEX.md","ref":"생산 내부 절차 범위 밖, 결과와 파일을 QS가 받아 재검토"}],"workflowId":"WF07","originalStepId":"WF07_T06","actorDetail":"수탁팀 또는 개발부 → QS팀","sourceSteps":[],"level":"context","scope":null}</bpmn:documentation>
      <bpmn:incoming>WF07_TF08</bpmn:incoming>
      <bpmn:outgoing>WF07_TF10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="WF07_T12" name="회신을 기다려 결과와 파일을 받는다">
      <bpmn:documentation>해당 상대의 결과·반환 파일을 받아 QS 취합으로 연결한다.
입력 자료: 전달한 파일과 검토 요청
전달 자료: 수령한 회신과 파일</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀","scope":null}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"전달한 파일과 검토 요청","outputs":"수령한 회신과 파일","businessRules":[],"approvedQuestionIds":[],"perspective":"tobe","phase":"Phase 1","functionIds":["C-10","C-11","C-15"],"sourceRefs":[{"path":"docs/22_URS원문.md","ref":"ON 생산 검토·GN-08·GO-07·AN-14~22·AO 양측 검토"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-58"},{"path":"docs/23_업무규칙장부.md","ref":"주체-05·주체-06·주체-11·단계-21·단계-22·단계-28·단계-29"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"C-10~12·C-15·K-검토-17·T-12·T-19"},{"path":"CODEX.md","ref":"생산 내부 절차 범위 밖, 결과와 파일을 QS가 받아 재검토"}],"workflowId":"WF07","originalStepId":"WF07_T12","actorDetail":"QS팀 또는 개발부","sourceSteps":[],"level":"context","scope":null}</bpmn:documentation>
      <bpmn:incoming>WF07_T_JOIN_WF07_T12</bpmn:incoming>
      <bpmn:outgoing>WF07_TF06</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="WF07_T07" name="양측의 결과를 같은 판 기준으로 모은다" gatewayDirection="Converging">
      <bpmn:documentation>양측이 확인한 파일을 모은다. 서로 다른 판에 대한 결과는 같은 판의 결과로 취급하지 않는다.
입력 자료: 동국 결과와 의뢰사 결과
전달 자료: 같은 확인용 PDF에 대한 수탁 의뢰사와 동국제약의 검토 결과·수정 의견</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀","scope":null}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"동국 결과와 의뢰사 결과","outputs":"같은 확인용 PDF에 대한 수탁 의뢰사와 동국제약의 검토 결과·수정 의견","gatewayDirection":"Converging","businessRules":[],"gatewayMeaning":"모두 대기","approvedQuestionIds":[],"perspective":"tobe","phase":"Phase 1","functionIds":["C-15"],"sourceRefs":[{"path":"docs/22_URS원문.md","ref":"ON 생산 검토·GN-08·GO-07·AN-14~22·AO 양측 검토"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-58"},{"path":"docs/23_업무규칙장부.md","ref":"주체-05·주체-06·주체-11·단계-21·단계-22·단계-28·단계-29"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"C-10~12·C-15·K-검토-17·T-12·T-19"},{"path":"CODEX.md","ref":"생산 내부 절차 범위 밖, 결과와 파일을 QS가 받아 재검토"}],"workflowId":"WF07","originalStepId":"WF07_T07","actorDetail":"QS팀","sourceSteps":[],"level":"context","scope":null}</bpmn:documentation>
      <bpmn:incoming>WF07_TF09</bpmn:incoming>
      <bpmn:incoming>WF07_TF10</bpmn:incoming>
      <bpmn:outgoing>WF07_TF11</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="J_WF07_T08" name="경로 합류" gatewayDirection="Converging">
      <bpmn:documentation>해당 경로의 업무 결과를 이어 받는다.
입력 자료: 생산·관련 부서 또는 양측 회신
전달 자료: 생산·관련 부서 또는 양측 회신</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"생산·관련 부서 또는 양측 회신","outputs":"생산·관련 부서 또는 양측 회신","gatewayDirection":"Converging","gatewayMeaning":"경로 합류","perspective":"tobe","workflowId":"WF07","originalStepId":"WF07_T08"}</bpmn:documentation>
      <bpmn:incoming>WF07_TF06</bpmn:incoming>
      <bpmn:incoming>WF07_TF11</bpmn:incoming>
      <bpmn:outgoing>WF07_T_JOIN_WF07_T08</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="WF07_T08" name="결과·파일과 수정 내용을 취합한다">
      <bpmn:documentation>회신한 상대·대상 판·내용을 확인한다. 수탁은 의뢰사·동국 요구를 구분해 디자인팀에 줄 내용을 정리한다. 시스템에서는 요청일·요청 사유·보낸 판·회신일·기록자를 보존한다. 수정 출처의 구조화와 부서 대응표·알림 확장은 Phase 2이다.
입력 자료: 생산·관련 부서 또는 양측 회신
전달 자료: 취합된 수정사항과 회신</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀","scope":null}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"생산·관련 부서 또는 양측 회신","outputs":"취합된 수정사항과 회신","businessRules":[],"approvedQuestionIds":[],"perspective":"tobe","phase":"Phase 1","functionIds":["C-11","C-12","C-15"],"sourceRefs":[{"path":"docs/22_URS원문.md","ref":"ON 생산 검토·GN-08·GO-07·AN-14~22·AO 양측 검토"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-58"},{"path":"docs/23_업무규칙장부.md","ref":"주체-05·주체-06·주체-11·단계-21·단계-22·단계-28·단계-29"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"C-10~12·C-15·K-검토-17·T-12·T-19"},{"path":"CODEX.md","ref":"생산 내부 절차 범위 밖, 결과와 파일을 QS가 받아 재검토"}],"workflowId":"WF07","originalStepId":"WF07_T08","actorDetail":"QS팀","sourceSteps":[],"level":"context","scope":null}</bpmn:documentation>
      <bpmn:incoming>WF07_T_JOIN_WF07_T08</bpmn:incoming>
      <bpmn:outgoing>WF07_T08_SYS_RESPONSE_FLOW</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="WF07_T08_SYS_RESPONSE" name="요청·회신 파일의 판과 담당자가 취합한 의견을 저장한다">
      <bpmn:documentation>QS가 입력한 요청일·요청 사유·보낸 판·회신일·기록자와 받은 파일을 보존한다. 생산 적합성을 판정하지 않으며 외부 자동 회람을 실행하지 않는다. 수정 출처 구조화와 부서 대응표·알림 확장은 Phase 2로 구분한다.
입력 자료: 취합된 수정사항과 회신
전달 자료: 취합된 수정사항과 회신</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"시스템","scope":null}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"취합된 수정사항과 회신","outputs":"취합된 수정사항과 회신","businessRules":[],"approvedQuestionIds":[],"perspective":"tobe","phase":"Phase 1","functionIds":["C-11","C-12","C-15"],"sourceRefs":[{"path":"docs/22_URS원문.md","ref":"ON 생산 검토·GN-08·GO-07·AN-14~22·AO 양측 검토"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-58"},{"path":"docs/23_업무규칙장부.md","ref":"주체-05·주체-06·주체-11·단계-21·단계-22·단계-28·단계-29"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"C-10~12·C-15·K-검토-17·T-12·T-19"},{"path":"CODEX.md","ref":"생산 내부 절차 범위 밖, 결과와 파일을 QS가 받아 재검토"}],"workflowId":"WF07","originalStepId":"WF07_T08_SYS_RESPONSE","actorDetail":"Artwork 시스템","sourceSteps":["WF07_T08"],"level":"context","scope":null}</bpmn:documentation>
      <bpmn:incoming>WF07_T08_SYS_RESPONSE_FLOW</bpmn:incoming>
      <bpmn:outgoing>WF07_TF12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="WF07_T09" name="반영하거나 다시 검토할 수정이 있는가?" gatewayDirection="Diverging" default="WF07_TF15">
      <bpmn:documentation>생산 관련 의견도 Artwork를 바꾸면 QS 재검토 대상으로 보낸다.
입력 자료: 취합 결과
전달 자료: 수정 반복 또는 최종화</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀","scope":null}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"취합 결과","outputs":"수정 반복 또는 최종화","gatewayDirection":"Diverging","businessRules":[],"gatewayMeaning":"하나 선택","approvedQuestionIds":[],"perspective":"tobe","phase":"Phase 1","functionIds":["K-검토-04","T-12"],"sourceRefs":[{"path":"docs/22_URS원문.md","ref":"ON 생산 검토·GN-08·GO-07·AN-14~22·AO 양측 검토"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-58"},{"path":"docs/23_업무규칙장부.md","ref":"주체-05·주체-06·주체-11·단계-21·단계-22·단계-28·단계-29"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"C-10~12·C-15·K-검토-17·T-12·T-19"},{"path":"CODEX.md","ref":"생산 내부 절차 범위 밖, 결과와 파일을 QS가 받아 재검토"}],"workflowId":"WF07","originalStepId":"WF07_T09","actorDetail":"QS팀","sourceSteps":[],"level":"context","scope":null}</bpmn:documentation>
