      <bpmn:outgoing>WF07_TF14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="WF07_T11" name="최종 내용·파일 준비로 이어 간다">
      <bpmn:documentation>각 경로의 최종 파일 준비와 최종 확인으로 연결한다.
입력 자료: 취합된 검토 결과와 해당 Artwork
