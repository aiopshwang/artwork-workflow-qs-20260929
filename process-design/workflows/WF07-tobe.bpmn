      <bpmn:outgoing>WF07_TF13</bpmn:outgoing>
      <bpmn:outgoing>WF07_TF15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="WF07_T10" name="수정 내용을 전달하고 반영본을 다시 받는다">
      <bpmn:documentation>수탁에서 동국 생산 조건으로 바꾸는 내용은 필요한 경우 의뢰사에 공유한다. 디자인 반영 후 같은 범위의 검토를 다시 요청한다.
입력 자료: 정리한 수정사항
전달 자료: 수정된 Artwork와 재검토 요청</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀","scope":null}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"정리한 수정사항","outputs":"수정된 Artwork와 재검토 요청","businessRules":[],"approvedQuestionIds":[],"perspective":"tobe","phase":"Phase 1","functionIds":["C-05","C-06","C-15"],"sourceRefs":[{"path":"docs/22_URS원문.md","ref":"ON 생산 검토·GN-08·GO-07·AN-14~22·AO 양측 검토"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-58"},{"path":"docs/23_업무규칙장부.md","ref":"주체-05·주체-06·주체-11·단계-21·단계-22·단계-28·단계-29"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"C-10~12·C-15·K-검토-17·T-12·T-19"},{"path":"CODEX.md","ref":"생산 내부 절차 범위 밖, 결과와 파일을 QS가 받아 재검토"}],"workflowId":"WF07","originalStepId":"WF07_T10","actorDetail":"QS팀 ↔ 디자인팀·경로별 담당자","sourceSteps":[],"level":"context","scope":null}</bpmn:documentation>
