<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="WF01_A_Collaboration" name="의뢰·변경 요청과 대상 자재 확인 · 현재 업무">
    <bpmn:documentation>새 요청은 경로별로 받고, QS가 품목·대상 자재와 현재 확보 자료를 확인한다.
입력 자료: 신규 제작 요청 또는 기존 Artwork의 변경 필요
전달 자료: 자재별 준비 대상 또는 기존 업무의 추가 요청</bpmn:documentation>
    <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"신규 제작 요청 또는 기존 Artwork의 변경 필요","outputs":"자재별 준비 대상 또는 기존 업무의 추가 요청","perspective":"asis","sourceRefs":[{"path":"CODEX.md","ref":"현행 업무의 시작·대상 자재 확인: 사용자 승인 4단계"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-18·M-22·M-30·M-77·M-96"},{"path":"docs/22_URS원문.md","ref":"O-01·A-01·G-01"},{"path":"docs/23_업무규칙장부.md","ref":"접수-02·접수-04·접수-07·접수-08·접수-12·접수-13"}],"workflowId":"WF01"}</bpmn:documentation>
    <bpmn:participant id="Participant_WF01_A_Process" name="의뢰·변경 요청과 대상 자재 확인 · 현재 업무" processRef="WF01_A_Process" />
  </bpmn:collaboration>
  <bpmn:process id="WF01_A_Process" isExecutable="false">
    <bpmn:laneSet id="LaneSet_WF01_A_Process">
      <bpmn:lane id="Lane_WF01_A_Process_R2" name="수탁 의뢰사">
        <bpmn:flowNodeRef>WF01_A11</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_WF01_A_Process_R0" name="QS팀">
        <bpmn:flowNodeRef>WF01_A01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF01_A10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF01_A02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF01_A03</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J_WF01_A05</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF01_A05</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF01_A12</bpmn:flowNodeRef>
