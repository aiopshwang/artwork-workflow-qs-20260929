        <bpmn:flowNodeRef>WF01_A09</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF01_A09_RESULT</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_WF01_A_Process_R1" name="수탁담당">
        <bpmn:flowNodeRef>WF01_A04</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="WF01_A01" name="자사·위탁 신규 제작 요청이 접수된다">
      <bpmn:documentation>신규 제작 요청과 첨부자료가 QS 업무로 들어온다.
입력 자료: 결재된 작업의뢰서
전달 자료: 신규 요청</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"결재된 작업의뢰서","outputs":"신규 요청","businessRules":[],"perspective":"asis","phase":"현행","functionIds":[],"sourceRefs":[{"path":"CODEX.md","ref":"현행 업무의 시작·대상 자재 확인: 사용자 승인 4단계"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-18·M-22·M-30·M-77·M-96"},{"path":"docs/22_URS원문.md","ref":"O-01·A-01·G-01"},{"path":"docs/23_업무규칙장부.md","ref":"접수-02·접수-04·접수-07·접수-08·접수-12·접수-13"}],"workflowId":"WF01","originalStepId":"WF01_A01","actorDetail":"요청부서 → QS팀"}</bpmn:documentation>
      <bpmn:outgoing>WF01_AF01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:startEvent id="WF01_A10" name="기존 Artwork의 변경 요청·필요가 발생한다">
      <bpmn:documentation>기존 Artwork를 변경할 필요가 생긴다.
입력 자료: 변경 요청·통지 또는 QS의 발견
전달 자료: 변경 업무</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"변경 요청·통지 또는 QS의 발견","outputs":"변경 업무","businessRules":[],"perspective":"asis","phase":"현행","functionIds":[],"sourceRefs":[{"path":"CODEX.md","ref":"현행 업무의 시작·대상 자재 확인: 사용자 승인 4단계"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-18·M-22·M-30·M-77·M-96"},{"path":"docs/22_URS원문.md","ref":"O-01·A-01·G-01"},{"path":"docs/23_업무규칙장부.md","ref":"접수-02·접수-04·접수-07·접수-08·접수-12·접수-13"}],"workflowId":"WF01","originalStepId":"WF01_A10","actorDetail":"요청부서 또는 QS팀"}</bpmn:documentation>
      <bpmn:outgoing>WF01_AF20</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:startEvent id="WF01_A11" name="수탁 의뢰사의 신규·개정 요청이 들어온다">
      <bpmn:documentation>의뢰사 요청을 QS 검토로 연결한다.
입력 자료: 수탁 의뢰
전달 자료: 수탁 요청</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"수탁 의뢰사"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"수탁 의뢰","outputs":"수탁 요청","businessRules":[],"perspective":"asis","phase":"현행","functionIds":[],"sourceRefs":[{"path":"CODEX.md","ref":"현행 업무의 시작·대상 자재 확인: 사용자 승인 4단계"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-18·M-22·M-30·M-77·M-96"},{"path":"docs/22_URS원문.md","ref":"O-01·A-01·G-01"},{"path":"docs/23_업무규칙장부.md","ref":"접수-02·접수-04·접수-07·접수-08·접수-12·접수-13"}],"workflowId":"WF01","originalStepId":"WF01_A11","actorDetail":"의뢰사 → 수탁팀 또는 개발부"}</bpmn:documentation>
      <bpmn:outgoing>WF01_AF21</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="WF01_A02" name="결재된 작업의뢰서와 첨부자료를 내려받는다">
      <bpmn:documentation>완료된 작업의뢰서와 첨부된 문안·제작 자료를 확보한다.
입력 자료: 자사·위탁 신규의 전자결재
전달 자료: 작업의뢰서와 첨부자료</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"자사·위탁 신규의 전자결재","outputs":"작업의뢰서와 첨부자료","businessRules":[],"perspective":"asis","phase":"현행","functionIds":[],"sourceRefs":[{"path":"CODEX.md","ref":"현행 업무의 시작·대상 자재 확인: 사용자 승인 4단계"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-18·M-22·M-30·M-77·M-96"},{"path":"docs/22_URS원문.md","ref":"O-01·A-01·G-01"},{"path":"docs/23_업무규칙장부.md","ref":"접수-02·접수-04·접수-07·접수-08·접수-12·접수-13"}],"workflowId":"WF01","originalStepId":"WF01_A02","actorDetail":"QS팀"}</bpmn:documentation>
      <bpmn:incoming>WF01_AF01</bpmn:incoming>
      <bpmn:outgoing>WF01_AF04</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="WF01_A03" name="변경 요청과 변경 근거를 받는다">
      <bpmn:documentation>누가 무엇을 왜 바꾸려는지와 적용 시점을 확인한다.
입력 자료: 메일·메신저 요청 또는 QS가 확인한 변경 필요
전달 자료: 변경 내용·사유·근거</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"메일·메신저 요청 또는 QS가 확인한 변경 필요","outputs":"변경 내용·사유·근거","businessRules":[],"perspective":"asis","phase":"현행","functionIds":[],"sourceRefs":[{"path":"CODEX.md","ref":"현행 업무의 시작·대상 자재 확인: 사용자 승인 4단계"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-18·M-22·M-30·M-77·M-96"},{"path":"docs/22_URS원문.md","ref":"O-01·A-01·G-01"},{"path":"docs/23_업무규칙장부.md","ref":"접수-02·접수-04·접수-07·접수-08·접수-12·접수-13"}],"workflowId":"WF01","originalStepId":"WF01_A03","actorDetail":"QS팀"}</bpmn:documentation>
      <bpmn:incoming>WF01_AF20</bpmn:incoming>
      <bpmn:outgoing>WF01_AF05</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="WF01_A04" name="수탁 의뢰 내용과 업체 자료를 받는다">
      <bpmn:documentation>의뢰 대상과 업체가 보낸 파일을 QS에 전달한다.
입력 자료: 의뢰사의 신규·개정 요청
전달 자료: 수탁 의뢰 내용과 수령 자료</bpmn:documentation>
