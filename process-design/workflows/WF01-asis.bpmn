    <bpmn:exclusiveGateway id="WF01_A07" name="확보한 자료로 업무를 시작할 수 있는가?" gatewayDirection="Diverging" default="WF01_AF11">
      <bpmn:documentation>검토·제작을 시작할 근거가 있는지 확인한다. 허가증이 없다는 이유만으로 전체를 멈추지 않는다.
입력 자료: 자재별 자료 현황
전달 자료: 착수 또는 필요한 자료 요청</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"자재별 자료 현황","outputs":"착수 또는 필요한 자료 요청","gatewayDirection":"Diverging","businessRules":[],"gatewayMeaning":"하나 선택","perspective":"asis","phase":"현행","functionIds":[],"sourceRefs":[{"path":"CODEX.md","ref":"현행 업무의 시작·대상 자재 확인: 사용자 승인 4단계"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-18·M-22·M-30·M-77·M-96"},{"path":"docs/22_URS원문.md","ref":"O-01·A-01·G-01"},{"path":"docs/23_업무규칙장부.md","ref":"접수-02·접수-04·접수-07·접수-08·접수-12·접수-13"}],"workflowId":"WF01","originalStepId":"WF01_A07","actorDetail":"QS팀"}</bpmn:documentation>
