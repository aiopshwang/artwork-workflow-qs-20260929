<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="WF11_A_Collaboration" name="늦은 허가증 재검토와 바코드 후속 처리 · 현재 업무">
    <bpmn:documentation>나중에 받은 허가증을 도안과 확인하고, 바코드는 입고 전후 시점에 맞춰 반영한다.
입력 자료: 추가 허가증 수령 또는 바코드 반영 필요
전달 자료: 새 허가증의 Artwork 반영 확인 결과 또는 자재의 바코드 반영·후인쇄 처리 및 번호 확인 결과</bpmn:documentation>
    <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"추가 허가증 수령 또는 바코드 반영 필요","outputs":"새 허가증의 Artwork 반영 확인 결과 또는 자재의 바코드 반영·후인쇄 처리 및 번호 확인 결과","perspective":"asis","sourceRefs":[{"path":"docs/20_회의록_2026-09-22.md","ref":"허가 후 바코드 부여·입고 전후 후속 조치"},{"path":"docs/23_업무규칙장부.md","ref":"허가-11·차수-13·차수-14·차수-22·바코-07·단계-34"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"T-11·T-13·T-18·K-대조-18·21·K-검토-08~11"},{"path":"CODEX.md","ref":"늦은 허가·바코드는 독립된 후속 업무"}],"workflowId":"WF11","sourceSteps":[],"level":"context","scope":null}</bpmn:documentation>
    <bpmn:participant id="Participant_WF11_A_Process" name="늦은 허가증 재검토와 바코드 후속 처리 · 현재 업무" processRef="WF11_A_Process" />
  </bpmn:collaboration>
  <bpmn:process id="WF11_A_Process" isExecutable="false">
    <bpmn:laneSet id="LaneSet_WF11_A_Process">
      <bpmn:lane id="Lane_WF11_A_Process_R0" name="QS팀">
        <bpmn:flowNodeRef>WF11_A01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF11_A07</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF11_A02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF11_A08</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J_WF11_A03</bpmn:flowNodeRef>
