      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"확보 허가증·Artwork","outputs":"확보 허가증·Artwork","gatewayDirection":"Converging","gatewayMeaning":"경로 합류","perspective":"asis","workflowId":"WF11","originalStepId":"WF11_A03"}</bpmn:documentation>
      <bpmn:incoming>WF11_AF02</bpmn:incoming>
