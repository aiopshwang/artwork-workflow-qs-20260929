      <bpmn:outgoing>WF11_AF02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="WF11_A08" name="입고 전에 반영할 수 있는가?" gatewayDirection="Diverging" default="WF11_AF09">
      <bpmn:documentation>입고 전 도안·인쇄 반영인지 입고 뒤 추가 인쇄인지 나눈다.
입력 자료: 디자인·인쇄·입고 일정
전달 자료: 반영 시점</bpmn:documentation>
