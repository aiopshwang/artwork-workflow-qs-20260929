      <bpmn:incoming>WF11_AF07</bpmn:incoming>
      <bpmn:outgoing>WF11_AF08</bpmn:outgoing>
      <bpmn:outgoing>WF11_AF09</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="J_WF11_A03" name="경로 합류" gatewayDirection="Converging">
      <bpmn:documentation>해당 경로의 업무 결과를 이어 받는다.
