<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="NW_Q_BASIS_T_Collaboration" name="문안·허가증·칼선 등 제작과 검토에 쓸 자료를 준비한다 · 도입 후 업무">
    <bpmn:documentation>해당 업무에서 사용할 시스템 지원과 담당자의 확인
입력 자료: 사용할 자재 정보, 확보된 문안·허가증·칼선·규격 및 기존 Artwork
전달 자료: 디자인 제작과 QS 검토에 사용할 문안·허가증·칼선·규격 및 참고 Artwork, 아직 확보하지 못해 나중에 확인할 자료 목록</bpmn:documentation>
    <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"scope":{"parentNodeId":"Q_BASIS","start":"상위 흐름에서 아래 입력 자료를 받은 때","end":"아래 결과를 정리하여 상위 흐름의 다음 업무에 전달한 때","inputs":"사용할 자재 정보, 확보된 문안·허가증·칼선·규격 및 기존 Artwork","outputs":"디자인 제작과 QS 검토에 사용할 문안·허가증·칼선·규격 및 참고 Artwork, 아직 확보하지 못해 나중에 확인할 자료 목록","includes":["확보한 문안·허가증·칼선·규격·기존 Artwork의 확인과 등록","자료 종류·대상·판 연결","확보·미확보·해당없음 구분"],"excludes":["자료 내용을 Artwork와 실제 대조","디자인팀 전달 확정","모든 자료가 모일 때까지 일괄 대기","작업의뢰 자동 연동"]}}</bpmn:documentation>
    <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"사용할 자재 정보, 확보된 문안·허가증·칼선·규격 및 기존 Artwork","outputs":"디자인 제작과 QS 검토에 사용할 문안·허가증·칼선·규격 및 참고 Artwork, 아직 확보하지 못해 나중에 확인할 자료 목록","perspective":"tobe","sourceRefs":[{"path":"docs/기능설계/조사_2026-09-25/08_기능지도_2판.md","ref":"K-접수-04~08 / K-대조-02~04"},{"path":"docs/23_업무규칙장부.md","ref":"자료-01·자료-02·자료-04·자료-10·자료-11"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"2장 접수·기준 자료 / 5장 다 4) 자료 변경과 재전달"}],"workflowId":"NW_Q_BASIS","sourceSteps":["WF02_A05","WF02_A06","WF02_T06","WF02_T07","WF02_T08"],"level":"node-detail","scope":{"parentNodeId":"Q_BASIS","start":"상위 흐름에서 아래 입력 자료를 받은 때","end":"아래 결과를 정리하여 상위 흐름의 다음 업무에 전달한 때","inputs":"사용할 자재 정보, 확보된 문안·허가증·칼선·규격 및 기존 Artwork","outputs":"디자인 제작과 QS 검토에 사용할 문안·허가증·칼선·규격 및 참고 Artwork, 아직 확보하지 못해 나중에 확인할 자료 목록","includes":["확보한 문안·허가증·칼선·규격·기존 Artwork의 확인과 등록","자료 종류·대상·판 연결","확보·미확보·해당없음 구분"],"excludes":["자료 내용을 Artwork와 실제 대조","디자인팀 전달 확정","모든 자료가 모일 때까지 일괄 대기","작업의뢰 자동 연동"]}}</bpmn:documentation>
    <bpmn:participant id="Participant_NW_Q_BASIS_T_Process" name="문안·허가증·칼선 등 제작과 검토에 쓸 자료를 준비한다 · 도입 후 업무" processRef="NW_Q_BASIS_T_Process" />
  </bpmn:collaboration>
  <bpmn:process id="NW_Q_BASIS_T_Process" isExecutable="false">
    <bpmn:laneSet id="LaneSet_NW_Q_BASIS_T_Process">
      <bpmn:lane id="Lane_NW_Q_BASIS_T_Process_R0" name="QS팀">
        <bpmn:flowNodeRef>NW_Q_BASIS_T00</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J_NW_Q_BASIS_T01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NW_Q_BASIS_T01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NW_Q_BASIS_T03</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NW_Q_BASIS_T05</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NW_Q_BASIS_T06</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NW_Q_BASIS_T08</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_NW_Q_BASIS_T_Process_R1" name="시스템">
        <bpmn:flowNodeRef>NW_Q_BASIS_T02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NW_Q_BASIS_T04</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NW_Q_BASIS_T07</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="NW_Q_BASIS_T00" name="대상 자재와 받은 자료를 확인한다">
      <bpmn:documentation>해당 자재의 이 업무를 시작할 자료를 받는다.
입력 자료: 사용할 자재 정보, 확보된 문안·허가증·칼선·규격 및 기존 Artwork
전달 자료: 사용할 자재 정보, 확보된 문안·허가증·칼선·규격 및 기존 Artwork</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀","scope":{"parentNodeId":"Q_BASIS","start":"상위 흐름에서 아래 입력 자료를 받은 때","end":"아래 결과를 정리하여 상위 흐름의 다음 업무에 전달한 때","inputs":"사용할 자재 정보, 확보된 문안·허가증·칼선·규격 및 기존 Artwork","outputs":"디자인 제작과 QS 검토에 사용할 문안·허가증·칼선·규격 및 참고 Artwork, 아직 확보하지 못해 나중에 확인할 자료 목록","includes":["확보한 문안·허가증·칼선·규격·기존 Artwork의 확인과 등록","자료 종류·대상·판 연결","확보·미확보·해당없음 구분"],"excludes":["자료 내용을 Artwork와 실제 대조","디자인팀 전달 확정","모든 자료가 모일 때까지 일괄 대기","작업의뢰 자동 연동"]}}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"사용할 자재 정보, 확보된 문안·허가증·칼선·규격 및 기존 Artwork","outputs":"사용할 자재 정보, 확보된 문안·허가증·칼선·규격 및 기존 Artwork","businessRules":[],"approvedQuestionIds":[],"perspective":"tobe","phase":"Phase 1","functionIds":[],"sourceRefs":[{"path":"docs/기능설계/조사_2026-09-25/08_기능지도_2판.md","ref":"K-접수-04~08 / K-대조-02~04"},{"path":"docs/23_업무규칙장부.md","ref":"자료-01·자료-02·자료-04·자료-10·자료-11"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"2장 접수·기준 자료 / 5장 다 4) 자료 변경과 재전달"}],"workflowId":"NW_Q_BASIS","originalStepId":"NW_Q_BASIS_T00","actorDetail":"QS팀","sourceSteps":[],"level":"node-detail","scope":{"parentNodeId":"Q_BASIS","start":"상위 흐름에서 아래 입력 자료를 받은 때","end":"아래 결과를 정리하여 상위 흐름의 다음 업무에 전달한 때","inputs":"사용할 자재 정보, 확보된 문안·허가증·칼선·규격 및 기존 Artwork","outputs":"디자인 제작과 QS 검토에 사용할 문안·허가증·칼선·규격 및 참고 Artwork, 아직 확보하지 못해 나중에 확인할 자료 목록","includes":["확보한 문안·허가증·칼선·규격·기존 Artwork의 확인과 등록","자료 종류·대상·판 연결","확보·미확보·해당없음 구분"],"excludes":["자료 내용을 Artwork와 실제 대조","디자인팀 전달 확정","모든 자료가 모일 때까지 일괄 대기","작업의뢰 자동 연동"]}}</bpmn:documentation>
      <bpmn:outgoing>NW_Q_BASIS_TF01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="J_NW_Q_BASIS_T01" name="경로 합류" gatewayDirection="Converging">
      <bpmn:documentation>해당 경로의 업무 결과를 이어 받는다.
입력 자료: 이번 자재와 확보한 파일
전달 자료: 이번 자재와 확보한 파일</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"이번 자재와 확보한 파일","outputs":"이번 자재와 확보한 파일","gatewayDirection":"Converging","gatewayMeaning":"경로 합류","perspective":"tobe","workflowId":"NW_Q_BASIS","originalStepId":"NW_Q_BASIS_T01"}</bpmn:documentation>
      <bpmn:incoming>NW_Q_BASIS_TF01</bpmn:incoming>
      <bpmn:incoming>NW_Q_BASIS_TF07</bpmn:incoming>
      <bpmn:outgoing>NW_Q_BASIS_T_JOIN_NW_Q_BASIS_T01</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="NW_Q_BASIS_T01" name="등록된 자료를 선택하거나 받은 파일을 올린다">
      <bpmn:documentation>QS가 기존 등록 파일을 찾거나 문안·허가증·칼선·규격·기존 Artwork 파일을 올린다. 수령일과 보낸 부서 등 확인 가능한 수령 정보를 입력한다.
입력 자료: 이번 자재와 확보한 파일
전달 자료: 선택·업로드한 파일과 수령 정보</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀","scope":{"parentNodeId":"Q_BASIS","start":"상위 흐름에서 아래 입력 자료를 받은 때","end":"아래 결과를 정리하여 상위 흐름의 다음 업무에 전달한 때","inputs":"사용할 자재 정보, 확보된 문안·허가증·칼선·규격 및 기존 Artwork","outputs":"디자인 제작과 QS 검토에 사용할 문안·허가증·칼선·규격 및 참고 Artwork, 아직 확보하지 못해 나중에 확인할 자료 목록","includes":["확보한 문안·허가증·칼선·규격·기존 Artwork의 확인과 등록","자료 종류·대상·판 연결","확보·미확보·해당없음 구분"],"excludes":["자료 내용을 Artwork와 실제 대조","디자인팀 전달 확정","모든 자료가 모일 때까지 일괄 대기","작업의뢰 자동 연동"]}}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"이번 자재와 확보한 파일","outputs":"선택·업로드한 파일과 수령 정보","businessRules":[],"approvedQuestionIds":[],"perspective":"tobe","phase":"Phase 1","functionIds":["K-접수-04","K-접수-08"],"sourceRefs":[{"path":"docs/기능설계/조사_2026-09-25/08_기능지도_2판.md","ref":"K-접수-04~08 / K-대조-02~04"},{"path":"docs/23_업무규칙장부.md","ref":"자료-01·자료-02·자료-04·자료-10·자료-11"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"2장 접수·기준 자료 / 5장 다 4) 자료 변경과 재전달"}],"workflowId":"NW_Q_BASIS","originalStepId":"NW_Q_BASIS_T01","actorDetail":"QS팀","sourceSteps":[],"level":"node-detail","scope":{"parentNodeId":"Q_BASIS","start":"상위 흐름에서 아래 입력 자료를 받은 때","end":"아래 결과를 정리하여 상위 흐름의 다음 업무에 전달한 때","inputs":"사용할 자재 정보, 확보된 문안·허가증·칼선·규격 및 기존 Artwork","outputs":"디자인 제작과 QS 검토에 사용할 문안·허가증·칼선·규격 및 참고 Artwork, 아직 확보하지 못해 나중에 확인할 자료 목록","includes":["확보한 문안·허가증·칼선·규격·기존 Artwork의 확인과 등록","자료 종류·대상·판 연결","확보·미확보·해당없음 구분"],"excludes":["자료 내용을 Artwork와 실제 대조","디자인팀 전달 확정","모든 자료가 모일 때까지 일괄 대기","작업의뢰 자동 연동"]}}</bpmn:documentation>
      <bpmn:incoming>NW_Q_BASIS_T_JOIN_NW_Q_BASIS_T01</bpmn:incoming>
      <bpmn:outgoing>NW_Q_BASIS_TF02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="NW_Q_BASIS_T02" name="파일을 보관하고 자료 종류·대상 연결을 제안한다">
      <bpmn:documentation>시스템은 원본을 보존하고 자료 종류와 자재 연결 후보를 표시한다. 새 판은 이전 파일을 덮어쓰지 않는다.
입력 자료: 올린 파일과 수령 정보
전달 자료: 보관된 원본과 종류·자재 연결 후보</bpmn:documentation>
