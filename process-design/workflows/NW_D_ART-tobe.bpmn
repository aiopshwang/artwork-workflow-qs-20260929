<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="NW_D_ART_T_Collaboration" name="자사 신규·개정 또는 위탁 개정의 Artwork를 제작·수정해 QS팀에 전달한다 · 도입 후 업무">
    <bpmn:documentation>받은 일의 자료를 내려받아 외부 디자인 도구에서 반영하고 같은 일에 파일을 올린다. 전달받을 담당자는 기존 업무 경로를 따른다.
입력 자료: 대상 자재의 제작 자료 또는 QS 주석본·수정 요청
전달 자료: QS팀에 전달할 신규 Artwork 또는 주석을 반영한 수정본</bpmn:documentation>
    <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"scope":{"parentNodeId":"D_ART","start":"다음 자료를 받은 상태에서 시작한다: 대상 자재의 제작 자료 또는 QS 주석본·수정 요청","end":"이 업무에서 남길 내용: QS팀에 전달할 신규 Artwork 또는 주석을 반영한 수정본","inputs":"대상 자재의 제작 자료 또는 QS 주석본·수정 요청","outputs":"QS팀에 전달할 신규 Artwork 또는 주석을 반영한 수정본","includes":["디자인팀이 받은 제작 자료·주석 확인","필요한 자료 보완 확인","외부 디자인 도구에서 제작·수정","해당 경로의 검토용 파일 전달"],"excludes":["QS의 자료 묶음 준비","QS 또는 의뢰사의 실제 검토","생산 검토와 최종 승인"]}}</bpmn:documentation>
    <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"대상 자재의 제작 자료 또는 QS 주석본·수정 요청","outputs":"QS팀에 전달할 신규 Artwork 또는 주석을 반영한 수정본","perspective":"tobe","sourceRefs":[{"path":"docs/20_회의록_2026-09-22.md","ref":"디자인팀 자료 전달·반환 / 사용자 순간 22"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"5장 다 디자인팀 받은 일 / C-01~09"},{"path":"docs/23_업무규칙장부.md","ref":"전달-01~06·차수-11"},{"path":"CODEX.md","ref":"디자인팀 다운로드·업로드 중심 원칙"}],"workflowId":"NW_D_ART","sourceSteps":["WF04_A03","WF04_A04","WF04_A05","WF04_A06","WF04_T03","WF04_T02","WF04_T04","WF04_T05","WF04_T06","WF04_T07"],"level":"node-detail","scope":{"parentNodeId":"D_ART","start":"다음 자료를 받은 상태에서 시작한다: 대상 자재의 제작 자료 또는 QS 주석본·수정 요청","end":"이 업무에서 남길 내용: QS팀에 전달할 신규 Artwork 또는 주석을 반영한 수정본","inputs":"대상 자재의 제작 자료 또는 QS 주석본·수정 요청","outputs":"QS팀에 전달할 신규 Artwork 또는 주석을 반영한 수정본","includes":["디자인팀이 받은 제작 자료·주석 확인","필요한 자료 보완 확인","외부 디자인 도구에서 제작·수정","해당 경로의 검토용 파일 전달"],"excludes":["QS의 자료 묶음 준비","QS 또는 의뢰사의 실제 검토","생산 검토와 최종 승인"]}}</bpmn:documentation>
    <bpmn:participant id="Participant_NW_D_ART_T_Process" name="자사 신규·개정 또는 위탁 개정의 Artwork를 제작·수정해 QS팀에 전달한다 · 도입 후 업무" processRef="NW_D_ART_T_Process" />
  </bpmn:collaboration>
