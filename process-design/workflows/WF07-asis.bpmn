<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="WF07_A_Collaboration" name="생산·관련 부서와 수탁 양측 결과 취합 · 현재 업무">
    <bpmn:documentation>타 부서 내부 절차는 맡은 곳에서 수행하고 QS는 결과·파일과 필요한 수정을 취합한다.
입력 자료: 후속 검토에 전달할 Artwork
전달 자료: 취합 결과와 최종화할 판 또는 수정 반복</bpmn:documentation>
    <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"후속 검토에 전달할 Artwork","outputs":"취합 결과와 최종화할 판 또는 수정 반복","perspective":"asis","sourceRefs":[{"path":"docs/22_URS원문.md","ref":"ON 생산 검토·GN-08·GO-07·AN-14~22·AO 양측 검토"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-58"},{"path":"docs/23_업무규칙장부.md","ref":"주체-05·주체-06·주체-11·단계-21·단계-22·단계-28·단계-29"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"C-10~12·C-15·K-검토-17·T-12·T-19"},{"path":"CODEX.md","ref":"생산 내부 절차 범위 밖, 결과와 파일을 QS가 받아 재검토"}],"workflowId":"WF07"}</bpmn:documentation>
    <bpmn:participant id="Participant_WF07_A_Process" name="생산·관련 부서와 수탁 양측 결과 취합 · 현재 업무" processRef="WF07_A_Process" />
  </bpmn:collaboration>
  <bpmn:process id="WF07_A_Process" isExecutable="false">
    <bpmn:laneSet id="LaneSet_WF07_A_Process">
      <bpmn:lane id="Lane_WF07_A_Process_R0" name="QS팀">
        <bpmn:flowNodeRef>WF07_A00</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J_WF07_A01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF07_A01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF07_A02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF07_A03</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF07_A04</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J_WF07_A12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF07_A05</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF07_A12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF07_A07</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J_WF07_A08</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF07_A08</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF07_A09</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF07_A10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF07_A11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF07_A11_RESULT</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_WF07_A_Process_R1" name="수탁담당">
        <bpmn:flowNodeRef>WF07_A06</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="WF07_A00" name="해당 경로의 후속 검토 대상 파일이 마련된다">
      <bpmn:documentation>해당 업무를 시작할 자료·요청을 받는다.
입력 자료: 후속 검토에 전달할 Artwork
전달 자료: 후속 검토에 전달할 Artwork</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"후속 검토에 전달할 Artwork","outputs":"후속 검토에 전달할 Artwork","businessRules":[],"perspective":"asis","phase":"현행","functionIds":[],"sourceRefs":[{"path":"docs/22_URS원문.md","ref":"ON 생산 검토·GN-08·GO-07·AN-14~22·AO 양측 검토"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-58"},{"path":"docs/23_업무규칙장부.md","ref":"주체-05·주체-06·주체-11·단계-21·단계-22·단계-28·단계-29"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"C-10~12·C-15·K-검토-17·T-12·T-19"},{"path":"CODEX.md","ref":"생산 내부 절차 범위 밖, 결과와 파일을 QS가 받아 재검토"}],"workflowId":"WF07","originalStepId":"WF07_A00","actorDetail":"QS팀"}</bpmn:documentation>
      <bpmn:outgoing>WF07_A00_START_FLOW</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="J_WF07_A01" name="경로 합류" gatewayDirection="Converging">
      <bpmn:documentation>해당 경로의 업무 결과를 이어 받는다.
입력 자료: QS 검토한 자재 Artwork
전달 자료: QS 검토한 자재 Artwork</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"QS 검토한 자재 Artwork","outputs":"QS 검토한 자재 Artwork","gatewayDirection":"Converging","gatewayMeaning":"경로 합류","perspective":"asis","workflowId":"WF07","originalStepId":"WF07_A01"}</bpmn:documentation>
      <bpmn:incoming>WF07_A00_START_FLOW</bpmn:incoming>
      <bpmn:incoming>WF07_AF14</bpmn:incoming>
      <bpmn:outgoing>WF07_A_JOIN_WF07_A01</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="WF07_A01" name="해당 경로의 후속 검토를 정한다" gatewayDirection="Diverging" default="WF07_AF03">
      <bpmn:documentation>자사 생산부, 위탁 제조사, 수탁 양측 검토 중 필요한 경로로 보낸다.
입력 자료: QS 검토한 자재 Artwork
전달 자료: 후속 검토 경로</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"QS 검토한 자재 Artwork","outputs":"후속 검토 경로","gatewayDirection":"Diverging","businessRules":[],"gatewayMeaning":"하나 선택","perspective":"asis","phase":"현행","functionIds":[],"sourceRefs":[{"path":"docs/22_URS원문.md","ref":"ON 생산 검토·GN-08·GO-07·AN-14~22·AO 양측 검토"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-58"},{"path":"docs/23_업무규칙장부.md","ref":"주체-05·주체-06·주체-11·단계-21·단계-22·단계-28·단계-29"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"C-10~12·C-15·K-검토-17·T-12·T-19"},{"path":"CODEX.md","ref":"생산 내부 절차 범위 밖, 결과와 파일을 QS가 받아 재검토"}],"workflowId":"WF07","originalStepId":"WF07_A01","actorDetail":"QS팀·경로별 담당자"}</bpmn:documentation>
      <bpmn:incoming>WF07_A_JOIN_WF07_A01</bpmn:incoming>
      <bpmn:outgoing>WF07_AF01</bpmn:outgoing>
      <bpmn:outgoing>WF07_AF02</bpmn:outgoing>
      <bpmn:outgoing>WF07_AF03</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="WF07_A02" name="생산·관련 부서에 파일을 보내 확인을 요청한다">
      <bpmn:documentation>요청 파일과 검토할 내용을 전달한다. 생산부 내부 검사 방법은 여기서 상세화하지 않는다.
입력 자료: 검토할 Artwork와 요청 내용
전달 자료: 보낸 파일과 검토 요청
업무 규칙: 자사 신규는 허가증 검토가 끝난 도안을 생산 관련 확인에 전달한다.</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"검토할 Artwork와 요청 내용","outputs":"보낸 파일과 검토 요청","businessRules":["자사 신규는 허가증 검토가 끝난 도안을 생산 관련 확인에 전달한다."],"perspective":"asis","phase":"현행","functionIds":[],"sourceRefs":[{"path":"docs/22_URS원문.md","ref":"ON 생산 검토·GN-08·GO-07·AN-14~22·AO 양측 검토"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-58"},{"path":"docs/23_업무규칙장부.md","ref":"주체-05·주체-06·주체-11·단계-21·단계-22·단계-28·단계-29"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"C-10~12·C-15·K-검토-17·T-12·T-19"},{"path":"CODEX.md","ref":"생산 내부 절차 범위 밖, 결과와 파일을 QS가 받아 재검토"}],"workflowId":"WF07","originalStepId":"WF07_A02","actorDetail":"QS팀 → 생산·관련 부서"}</bpmn:documentation>
      <bpmn:incoming>WF07_AF01</bpmn:incoming>
      <bpmn:outgoing>WF07_AF04</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="WF07_A03" name="위탁 제조사에 검토를 요청한다">
      <bpmn:documentation>경로별 담당자가 위탁 제조사에 파일을 보내고 생산 관련 결과를 요청한다.
입력 자료: 해당 Artwork와 확인 내용
전달 자료: 제조사에 보낸 파일과 요청</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"해당 Artwork와 확인 내용","outputs":"제조사에 보낸 파일과 요청","businessRules":[],"perspective":"asis","phase":"현행","functionIds":[],"sourceRefs":[{"path":"docs/22_URS원문.md","ref":"ON 생산 검토·GN-08·GO-07·AN-14~22·AO 양측 검토"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-58"},{"path":"docs/23_업무규칙장부.md","ref":"주체-05·주체-06·주체-11·단계-21·단계-22·단계-28·단계-29"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"C-10~12·C-15·K-검토-17·T-12·T-19"},{"path":"CODEX.md","ref":"생산 내부 절차 범위 밖, 결과와 파일을 QS가 받아 재검토"}],"workflowId":"WF07","originalStepId":"WF07_A03","actorDetail":"위탁 신규: 개발부 / 위탁 개정: QS팀"}</bpmn:documentation>
      <bpmn:incoming>WF07_AF02</bpmn:incoming>
      <bpmn:outgoing>WF07_AF05</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="WF07_A04" name="같은 동국용 확인본을 양측 검토로 나눈다" gatewayDirection="Diverging">
      <bpmn:documentation>의뢰사와 동국 측이 동일한 판을 각자 검토하도록 전달한다.
입력 자료: 동국용 확인 PDF
전달 자료: 양측에 전달한 같은 판</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"동국용 확인 PDF","outputs":"양측에 전달한 같은 판","gatewayDirection":"Diverging","businessRules":[],"gatewayMeaning":"함께 진행","perspective":"asis","phase":"현행","functionIds":[],"sourceRefs":[{"path":"docs/22_URS원문.md","ref":"ON 생산 검토·GN-08·GO-07·AN-14~22·AO 양측 검토"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-58"},{"path":"docs/23_업무규칙장부.md","ref":"주체-05·주체-06·주체-11·단계-21·단계-22·단계-28·단계-29"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"C-10~12·C-15·K-검토-17·T-12·T-19"},{"path":"CODEX.md","ref":"생산 내부 절차 범위 밖, 결과와 파일을 QS가 받아 재검토"}],"workflowId":"WF07","originalStepId":"WF07_A04","actorDetail":"QS팀·수탁 연락 담당"}</bpmn:documentation>
      <bpmn:incoming>WF07_AF03</bpmn:incoming>
      <bpmn:outgoing>WF07_AF07</bpmn:outgoing>
      <bpmn:outgoing>WF07_AF08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="J_WF07_A12" name="경로 합류" gatewayDirection="Converging">
      <bpmn:documentation>해당 경로의 업무 결과를 이어 받는다.
입력 자료: 전달한 파일과 검토 요청
전달 자료: 전달한 파일과 검토 요청</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"전달한 파일과 검토 요청","outputs":"전달한 파일과 검토 요청","gatewayDirection":"Converging","gatewayMeaning":"경로 합류","perspective":"asis","workflowId":"WF07","originalStepId":"WF07_A12"}</bpmn:documentation>
      <bpmn:incoming>WF07_AF04</bpmn:incoming>
      <bpmn:incoming>WF07_AF05</bpmn:incoming>
      <bpmn:outgoing>WF07_A_JOIN_WF07_A12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="WF07_A05" name="동국 QS 검토와 생산 결과를 확인한다">
      <bpmn:documentation>QS가 표시사항·이전 주석을 보고 생산 관련 결과와 파일을 받는다.
입력 자료: 동국용 파일·의뢰사 원본·생산 회신
전달 자료: 동국 측 의견과 확인 파일</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"동국용 파일·의뢰사 원본·생산 회신","outputs":"동국 측 의견과 확인 파일","businessRules":[],"perspective":"asis","phase":"현행","functionIds":[],"sourceRefs":[{"path":"docs/22_URS원문.md","ref":"ON 생산 검토·GN-08·GO-07·AN-14~22·AO 양측 검토"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-58"},{"path":"docs/23_업무규칙장부.md","ref":"주체-05·주체-06·주체-11·단계-21·단계-22·단계-28·단계-29"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"C-10~12·C-15·K-검토-17·T-12·T-19"},{"path":"CODEX.md","ref":"생산 내부 절차 범위 밖, 결과와 파일을 QS가 받아 재검토"}],"workflowId":"WF07","originalStepId":"WF07_A05","actorDetail":"QS팀"}</bpmn:documentation>
      <bpmn:incoming>WF07_AF07</bpmn:incoming>
      <bpmn:outgoing>WF07_AF09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="WF07_A06" name="의뢰사 의견과 확인 파일을 받는다">
      <bpmn:documentation>의뢰사 검토 결과와 대상 파일의 판을 받아 연결한다.
입력 자료: 의뢰사가 받은 동일 확인본
전달 자료: 의뢰사 의견과 확인 파일</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"수탁담당"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"의뢰사가 받은 동일 확인본","outputs":"의뢰사 의견과 확인 파일","businessRules":[],"perspective":"asis","phase":"현행","functionIds":[],"sourceRefs":[{"path":"docs/22_URS원문.md","ref":"ON 생산 검토·GN-08·GO-07·AN-14~22·AO 양측 검토"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-58"},{"path":"docs/23_업무규칙장부.md","ref":"주체-05·주체-06·주체-11·단계-21·단계-22·단계-28·단계-29"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"C-10~12·C-15·K-검토-17·T-12·T-19"},{"path":"CODEX.md","ref":"생산 내부 절차 범위 밖, 결과와 파일을 QS가 받아 재검토"}],"workflowId":"WF07","originalStepId":"WF07_A06","actorDetail":"수탁팀 또는 개발부 → QS팀"}</bpmn:documentation>
      <bpmn:incoming>WF07_AF08</bpmn:incoming>
      <bpmn:outgoing>WF07_AF10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="WF07_A12" name="회신을 기다려 결과와 파일을 받는다">
      <bpmn:documentation>해당 상대의 결과·반환 파일을 받아 QS 취합으로 연결한다.
입력 자료: 전달한 파일과 검토 요청
전달 자료: 수령한 회신과 파일</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀"}</bpmn:documentation>
