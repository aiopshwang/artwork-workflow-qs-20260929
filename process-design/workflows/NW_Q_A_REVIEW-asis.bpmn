<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="NW_Q_A_REVIEW_A_Collaboration" name="동국제약용 도안·규격과 이전 지적 반영 여부를 검토한다 · 현재 업무">
    <bpmn:documentation>의뢰사 원본의 표시사항과 동국제약용 제작 규격, 개정일 때 해당 자재의 기존 동국제약용 승인본와 도안을 대조하고, 이전 지적이 있으면 반영 여부를 확인하며 새 오류도 함께 검토한다.
입력 자료: 동국제약용 Artwork와 의뢰사 원본, 해당 자재의 제작 규격·칼선, 개정이면 기존 동국제약용 승인본, 이전 수정 지적이 있으면 해당 지적
전달 자료: 동국제약용 Artwork의 표시사항·규격 대조 결과, 이전 지적의 미반영 사항과 새 수정 의견</bpmn:documentation>
    <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"scope":{"parentNodeId":"Q_A_REVIEW","start":"다음 자료를 받은 상태에서 시작한다: 동국제약용 Artwork와 의뢰사 원본, 해당 자재의 제작 규격·칼선, 개정이면 기존 동국제약용 승인본, 이전 수정 지적이 있으면 해당 지적","end":"이 업무에서 남길 내용: 동국제약용 Artwork의 표시사항·규격 대조 결과, 이전 지적의 미반영 사항과 새 수정 의견","inputs":"동국제약용 Artwork와 의뢰사 원본, 해당 자재의 제작 규격·칼선, 개정이면 기존 동국제약용 승인본, 이전 수정 지적이 있으면 해당 지적","outputs":"동국제약용 Artwork의 표시사항·규격 대조 결과, 이전 지적의 미반영 사항과 새 수정 의견","includes":["이번 자재·판과 해당 검토 기준 확인","기준 내용의 Artwork 반영 여부 대조","이전 지적이 있을 때 반영 확인","요청 밖 변경·새 오류·적용되는 공통 항목 확인","수정할 내용과 확인하지 못한 항목 정리"],"excludes":["새 수정 주석 작성·디자인팀 전달","디자인 수정과 생산·의뢰사 검토","동국 QS의 허가증 대조를 수탁 기본 흐름에 추가"]}}</bpmn:documentation>
    <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"동국제약용 Artwork와 의뢰사 원본, 해당 자재의 제작 규격·칼선, 개정이면 기존 동국제약용 승인본, 이전 수정 지적이 있으면 해당 지적","outputs":"동국제약용 Artwork의 표시사항·규격 대조 결과, 이전 지적의 미반영 사항과 새 수정 의견","perspective":"asis","sourceRefs":[{"path":"docs/20_회의록_2026-09-22.md","ref":"M-42·M-58·M-61 / 허가 전 자료로 검토·주석"},{"path":"docs/23_업무규칙장부.md","ref":"허가-08·자료-01·자료-04·기준-06·차수-08·차수-11·수정-01"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"2장 판독·대조·검토·주석"},{"path":"CODEX.md","ref":"문안은 글 중심 기준자료, QS는 Artwork 반영 여부 검토"},{"path":"CODEX.md","ref":"사용자 인터뷰: 미반영 지적은 새 도안에 다시, 반영된 지적은 달지 않음"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-61"},{"path":"docs/23_업무규칙장부.md","ref":"수정-01·수정-02·차수-11·차수-14·자료-10·자료-11"},{"path":"docs/22_URS원문.md","ref":"CR-34·CR-35·CR-36"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"K-대조-11·12·15 / K-검토-02~05"}],"workflowId":"NW_Q_A_REVIEW","sourceSteps":["WF05_A01","WF06_A01","WF05_A04","WF05_A05","WF06_A02","WF06_A03","WF06_A05","WF06_A06","WF05_A06","WF05_T01","WF05_T02","WF06_T02","WF05_T03","WF05_T04","WF05_T05","WF05_T06","WF06_T03","WF05_T07","WF06_T04","WF06_T05"],"level":"node-detail","scope":{"parentNodeId":"Q_A_REVIEW","start":"다음 자료를 받은 상태에서 시작한다: 동국제약용 Artwork와 의뢰사 원본, 해당 자재의 제작 규격·칼선, 개정이면 기존 동국제약용 승인본, 이전 수정 지적이 있으면 해당 지적","end":"이 업무에서 남길 내용: 동국제약용 Artwork의 표시사항·규격 대조 결과, 이전 지적의 미반영 사항과 새 수정 의견","inputs":"동국제약용 Artwork와 의뢰사 원본, 해당 자재의 제작 규격·칼선, 개정이면 기존 동국제약용 승인본, 이전 수정 지적이 있으면 해당 지적","outputs":"동국제약용 Artwork의 표시사항·규격 대조 결과, 이전 지적의 미반영 사항과 새 수정 의견","includes":["이번 자재·판과 해당 검토 기준 확인","기준 내용의 Artwork 반영 여부 대조","이전 지적이 있을 때 반영 확인","요청 밖 변경·새 오류·적용되는 공통 항목 확인","수정할 내용과 확인하지 못한 항목 정리"],"excludes":["새 수정 주석 작성·디자인팀 전달","디자인 수정과 생산·의뢰사 검토","동국 QS의 허가증 대조를 수탁 기본 흐름에 추가"]}}</bpmn:documentation>
    <bpmn:participant id="Participant_NW_Q_A_REVIEW_A_Process" name="동국제약용 도안·규격과 이전 지적 반영 여부를 검토한다 · 현재 업무" processRef="NW_Q_A_REVIEW_A_Process" />
  </bpmn:collaboration>
  <bpmn:process id="NW_Q_A_REVIEW_A_Process" isExecutable="false">
    <bpmn:laneSet id="LaneSet_NW_Q_A_REVIEW_A_Process">
      <bpmn:lane id="Lane_NW_Q_A_REVIEW_A_Process_R0" name="QS팀">
        <bpmn:flowNodeRef>NW_Q_A_REVIEW_A00</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NW_Q_A_REVIEW_A01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NW_Q_A_REVIEW_A02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NW_Q_A_REVIEW_A03</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NW_Q_A_REVIEW_A04</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J_NW_Q_A_REVIEW_A05</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NW_Q_A_REVIEW_A05</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NW_Q_A_REVIEW_A06</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NW_Q_A_REVIEW_A07</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="NW_Q_A_REVIEW_A00" name="이 업무에 필요한 자료를 확인한다">
      <bpmn:documentation>상위 업무에서 전달받은 자료로 이 업무를 시작한다.
입력 자료: 동국제약용 Artwork와 의뢰사 원본, 해당 자재의 제작 규격·칼선, 개정이면 기존 동국제약용 승인본, 이전 수정 지적이 있으면 해당 지적
전달 자료: 동국제약용 Artwork와 의뢰사 원본, 해당 자재의 제작 규격·칼선, 개정이면 기존 동국제약용 승인본, 이전 수정 지적이 있으면 해당 지적
업무 규칙: 의뢰사 원본 표시사항과 동국제약 재제작본을 대조한다. / 기존 동국제약용 승인본은 수탁 개정에만, 이전 지적은 실제 존재할 때만 적용한다.</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀","scope":{"parentNodeId":"Q_A_REVIEW","start":"다음 자료를 받은 상태에서 시작한다: 동국제약용 Artwork와 의뢰사 원본, 해당 자재의 제작 규격·칼선, 개정이면 기존 동국제약용 승인본, 이전 수정 지적이 있으면 해당 지적","end":"이 업무에서 남길 내용: 동국제약용 Artwork의 표시사항·규격 대조 결과, 이전 지적의 미반영 사항과 새 수정 의견","inputs":"동국제약용 Artwork와 의뢰사 원본, 해당 자재의 제작 규격·칼선, 개정이면 기존 동국제약용 승인본, 이전 수정 지적이 있으면 해당 지적","outputs":"동국제약용 Artwork의 표시사항·규격 대조 결과, 이전 지적의 미반영 사항과 새 수정 의견","includes":["이번 자재·판과 해당 검토 기준 확인","기준 내용의 Artwork 반영 여부 대조","이전 지적이 있을 때 반영 확인","요청 밖 변경·새 오류·적용되는 공통 항목 확인","수정할 내용과 확인하지 못한 항목 정리"],"excludes":["새 수정 주석 작성·디자인팀 전달","디자인 수정과 생산·의뢰사 검토","동국 QS의 허가증 대조를 수탁 기본 흐름에 추가"]}}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"동국제약용 Artwork와 의뢰사 원본, 해당 자재의 제작 규격·칼선, 개정이면 기존 동국제약용 승인본, 이전 수정 지적이 있으면 해당 지적","outputs":"동국제약용 Artwork와 의뢰사 원본, 해당 자재의 제작 규격·칼선, 개정이면 기존 동국제약용 승인본, 이전 수정 지적이 있으면 해당 지적","businessRules":["의뢰사 원본 표시사항과 동국제약 재제작본을 대조한다.","기존 동국제약용 승인본은 수탁 개정에만, 이전 지적은 실제 존재할 때만 적용한다."],"approvedQuestionIds":[],"perspective":"asis","phase":"현행","functionIds":[],"sourceRefs":[{"path":"docs/20_회의록_2026-09-22.md","ref":"M-42·M-58·M-61 / 허가 전 자료로 검토·주석"},{"path":"docs/23_업무규칙장부.md","ref":"허가-08·자료-01·자료-04·기준-06·차수-08·차수-11·수정-01"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"2장 판독·대조·검토·주석"},{"path":"CODEX.md","ref":"문안은 글 중심 기준자료, QS는 Artwork 반영 여부 검토"}],"workflowId":"NW_Q_A_REVIEW","originalStepId":"NW_Q_A_REVIEW_A00","actorDetail":"QS팀","sourceSteps":["WF05_A01"],"level":"node-detail","scope":{"parentNodeId":"Q_A_REVIEW","start":"다음 자료를 받은 상태에서 시작한다: 동국제약용 Artwork와 의뢰사 원본, 해당 자재의 제작 규격·칼선, 개정이면 기존 동국제약용 승인본, 이전 수정 지적이 있으면 해당 지적","end":"이 업무에서 남길 내용: 동국제약용 Artwork의 표시사항·규격 대조 결과, 이전 지적의 미반영 사항과 새 수정 의견","inputs":"동국제약용 Artwork와 의뢰사 원본, 해당 자재의 제작 규격·칼선, 개정이면 기존 동국제약용 승인본, 이전 수정 지적이 있으면 해당 지적","outputs":"동국제약용 Artwork의 표시사항·규격 대조 결과, 이전 지적의 미반영 사항과 새 수정 의견","includes":["이번 자재·판과 해당 검토 기준 확인","기준 내용의 Artwork 반영 여부 대조","이전 지적이 있을 때 반영 확인","요청 밖 변경·새 오류·적용되는 공통 항목 확인","수정할 내용과 확인하지 못한 항목 정리"],"excludes":["새 수정 주석 작성·디자인팀 전달","디자인 수정과 생산·의뢰사 검토","동국 QS의 허가증 대조를 수탁 기본 흐름에 추가"]}}</bpmn:documentation>
      <bpmn:outgoing>NW_Q_A_REVIEW_AF01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="NW_Q_A_REVIEW_A01" name="검토할 Artwork와 기준자료를 확인한다">
      <bpmn:documentation>이번 자재·판과 검토 목적을 확인하고 의뢰사 원본의 표시사항과 동국제약용 제작 규격, 개정일 때 해당 자재의 기존 동국제약용 승인본을 준비한다.
입력 자료: 동국제약용 Artwork와 의뢰사 원본, 해당 자재의 제작 규격·칼선, 개정이면 기존 동국제약용 승인본, 이전 수정 지적이 있으면 해당 지적
전달 자료: 이번 도안과 적용할 기준자료
업무 규칙: 의뢰사 원본 표시사항과 동국제약 재제작본을 대조한다. / 기존 동국제약용 승인본은 수탁 개정에만, 이전 지적은 실제 존재할 때만 적용한다.</bpmn:documentation>
