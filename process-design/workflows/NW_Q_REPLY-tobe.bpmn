    <bpmn:participant id="Participant_NW_Q_REPLY_T_Process" name="사용할 버전 또는 변경 없음을 회신한다 · 도입 후 업무" processRef="NW_Q_REPLY_T_Process" />
  </bpmn:collaboration>
  <bpmn:process id="NW_Q_REPLY_T_Process" isExecutable="false">
