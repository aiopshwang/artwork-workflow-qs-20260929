      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"사용할 자재 정보, 확보된 문안·허가증·칼선·규격 및 기존 Artwork","outputs":"사용할 자재 정보, 확보된 문안·허가증·칼선·규격 및 기존 Artwork","businessRules":[],"approvedQuestionIds":[],"perspective":"asis","phase":"현행","functionIds":[],"sourceRefs":[{"path":"docs/기능설계/조사_2026-09-25/08_기능지도_2판.md","ref":"K-접수-04~08 / K-대조-02~04"},{"path":"docs/23_업무규칙장부.md","ref":"자료-01·자료-02·자료-04·자료-10·자료-11"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"2장 접수·기준 자료 / 5장 다 4) 자료 변경과 재전달"}],"workflowId":"NW_Q_BASIS","originalStepId":"NW_Q_BASIS_A00","actorDetail":"QS팀","sourceSteps":[],"level":"node-detail","scope":{"parentNodeId":"Q_BASIS","start":"상위 흐름에서 아래 입력 자료를 받은 때","end":"아래 결과를 정리하여 상위 흐름의 다음 업무에 전달한 때","inputs":"사용할 자재 정보, 확보된 문안·허가증·칼선·규격 및 기존 Artwork","outputs":"디자인 제작과 QS 검토에 사용할 문안·허가증·칼선·규격 및 참고 Artwork, 아직 확보하지 못해 나중에 확인할 자료 목록","includes":["확보한 문안·허가증·칼선·규격·기존 Artwork의 확인과 등록","자료 종류·대상·판 연결","확보·미확보·해당없음 구분"],"excludes":["자료 내용을 Artwork와 실제 대조","디자인팀 전달 확정","모든 자료가 모일 때까지 일괄 대기","작업의뢰 자동 연동"]}}</bpmn:documentation>
      <bpmn:outgoing>NW_Q_BASIS_AF01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="NW_Q_BASIS_A01" name="확보한 문안·허가증·칼선·규격·기존 도안을 모은다">
      <bpmn:documentation>이번 자재 제작과 검토에 사용할 확보 자료를 모은다. 해당하지 않는 자료를 필수로 요구하지 않는다.
입력 자료: 사용할 자재 정보, 확보된 문안·허가증·칼선·규격 및 기존 Artwork
전달 자료: 확보한 제작·검토 자료</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀","scope":{"parentNodeId":"Q_BASIS","start":"상위 흐름에서 아래 입력 자료를 받은 때","end":"아래 결과를 정리하여 상위 흐름의 다음 업무에 전달한 때","inputs":"사용할 자재 정보, 확보된 문안·허가증·칼선·규격 및 기존 Artwork","outputs":"디자인 제작과 QS 검토에 사용할 문안·허가증·칼선·규격 및 참고 Artwork, 아직 확보하지 못해 나중에 확인할 자료 목록","includes":["확보한 문안·허가증·칼선·규격·기존 Artwork의 확인과 등록","자료 종류·대상·판 연결","확보·미확보·해당없음 구분"],"excludes":["자료 내용을 Artwork와 실제 대조","디자인팀 전달 확정","모든 자료가 모일 때까지 일괄 대기","작업의뢰 자동 연동"]}}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"사용할 자재 정보, 확보된 문안·허가증·칼선·규격 및 기존 Artwork","outputs":"확보한 제작·검토 자료","businessRules":[],"approvedQuestionIds":[],"perspective":"asis","phase":"현행","functionIds":[],"sourceRefs":[{"path":"docs/기능설계/조사_2026-09-25/08_기능지도_2판.md","ref":"K-접수-04~08 / K-대조-02~04"},{"path":"docs/23_업무규칙장부.md","ref":"자료-01·자료-02·자료-04·자료-10·자료-11"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"2장 접수·기준 자료 / 5장 다 4) 자료 변경과 재전달"}],"workflowId":"NW_Q_BASIS","originalStepId":"NW_Q_BASIS_A01","actorDetail":"QS팀","sourceSteps":[],"level":"node-detail","scope":{"parentNodeId":"Q_BASIS","start":"상위 흐름에서 아래 입력 자료를 받은 때","end":"아래 결과를 정리하여 상위 흐름의 다음 업무에 전달한 때","inputs":"사용할 자재 정보, 확보된 문안·허가증·칼선·규격 및 기존 Artwork","outputs":"디자인 제작과 QS 검토에 사용할 문안·허가증·칼선·규격 및 참고 Artwork, 아직 확보하지 못해 나중에 확인할 자료 목록","includes":["확보한 문안·허가증·칼선·규격·기존 Artwork의 확인과 등록","자료 종류·대상·판 연결","확보·미확보·해당없음 구분"],"excludes":["자료 내용을 Artwork와 실제 대조","디자인팀 전달 확정","모든 자료가 모일 때까지 일괄 대기","작업의뢰 자동 연동"]}}</bpmn:documentation>
      <bpmn:incoming>NW_Q_BASIS_AF01</bpmn:incoming>
      <bpmn:outgoing>NW_Q_BASIS_AF02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="NW_Q_BASIS_A02" name="자재·자료 종류·판과 적용할 변경 내용을 확인한다">
      <bpmn:documentation>자료가 이번 품목·자재의 것인지, 어느 판인지 확인한다. 변경 건은 기존 승인본과 변경대비표 등 근거를 구분한다.
입력 자료: 확보한 파일과 변경 요청
전달 자료: 대상과 판을 확인한 문안·허가증·도면·Artwork</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀","scope":{"parentNodeId":"Q_BASIS","start":"상위 흐름에서 아래 입력 자료를 받은 때","end":"아래 결과를 정리하여 상위 흐름의 다음 업무에 전달한 때","inputs":"사용할 자재 정보, 확보된 문안·허가증·칼선·규격 및 기존 Artwork","outputs":"디자인 제작과 QS 검토에 사용할 문안·허가증·칼선·규격 및 참고 Artwork, 아직 확보하지 못해 나중에 확인할 자료 목록","includes":["확보한 문안·허가증·칼선·규격·기존 Artwork의 확인과 등록","자료 종류·대상·판 연결","확보·미확보·해당없음 구분"],"excludes":["자료 내용을 Artwork와 실제 대조","디자인팀 전달 확정","모든 자료가 모일 때까지 일괄 대기","작업의뢰 자동 연동"]}}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"확보한 파일과 변경 요청","outputs":"대상과 판을 확인한 문안·허가증·도면·Artwork","businessRules":[],"approvedQuestionIds":[],"perspective":"asis","phase":"현행","functionIds":[],"sourceRefs":[{"path":"docs/기능설계/조사_2026-09-25/08_기능지도_2판.md","ref":"K-접수-04~08 / K-대조-02~04"},{"path":"docs/23_업무규칙장부.md","ref":"자료-01·자료-02·자료-04·자료-10·자료-11"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"2장 접수·기준 자료 / 5장 다 4) 자료 변경과 재전달"}],"workflowId":"NW_Q_BASIS","originalStepId":"NW_Q_BASIS_A02","actorDetail":"QS팀","sourceSteps":[],"level":"node-detail","scope":{"parentNodeId":"Q_BASIS","start":"상위 흐름에서 아래 입력 자료를 받은 때","end":"아래 결과를 정리하여 상위 흐름의 다음 업무에 전달한 때","inputs":"사용할 자재 정보, 확보된 문안·허가증·칼선·규격 및 기존 Artwork","outputs":"디자인 제작과 QS 검토에 사용할 문안·허가증·칼선·규격 및 참고 Artwork, 아직 확보하지 못해 나중에 확인할 자료 목록","includes":["확보한 문안·허가증·칼선·규격·기존 Artwork의 확인과 등록","자료 종류·대상·판 연결","확보·미확보·해당없음 구분"],"excludes":["자료 내용을 Artwork와 실제 대조","디자인팀 전달 확정","모든 자료가 모일 때까지 일괄 대기","작업의뢰 자동 연동"]}}</bpmn:documentation>
      <bpmn:incoming>NW_Q_BASIS_AF02</bpmn:incoming>
      <bpmn:outgoing>NW_Q_BASIS_AF03</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="NW_Q_BASIS_A03" name="미확보 자료나 서로 다른 내용이 있는가?" gatewayDirection="Diverging" default="NW_Q_BASIS_AF05">
      <bpmn:documentation>추가로 받아야 하거나 확인할 자료를 구분한다.
