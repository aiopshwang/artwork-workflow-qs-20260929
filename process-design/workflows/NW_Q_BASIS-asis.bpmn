<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="NW_Q_BASIS_A_Collaboration" name="문안·허가증·칼선 등 제작과 검토에 쓸 자료를 준비한다 · 현재 업무">
    <bpmn:documentation>현재 해당 담당자가 수행하는 업무
입력 자료: 사용할 자재 정보, 확보된 문안·허가증·칼선·규격 및 기존 Artwork
전달 자료: 디자인 제작과 QS 검토에 사용할 문안·허가증·칼선·규격 및 참고 Artwork, 아직 확보하지 못해 나중에 확인할 자료 목록</bpmn:documentation>
    <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"scope":{"parentNodeId":"Q_BASIS","start":"상위 흐름에서 아래 입력 자료를 받은 때","end":"아래 결과를 정리하여 상위 흐름의 다음 업무에 전달한 때","inputs":"사용할 자재 정보, 확보된 문안·허가증·칼선·규격 및 기존 Artwork","outputs":"디자인 제작과 QS 검토에 사용할 문안·허가증·칼선·규격 및 참고 Artwork, 아직 확보하지 못해 나중에 확인할 자료 목록","includes":["확보한 문안·허가증·칼선·규격·기존 Artwork의 확인과 등록","자료 종류·대상·판 연결","확보·미확보·해당없음 구분"],"excludes":["자료 내용을 Artwork와 실제 대조","디자인팀 전달 확정","모든 자료가 모일 때까지 일괄 대기","작업의뢰 자동 연동"]}}</bpmn:documentation>
    <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"사용할 자재 정보, 확보된 문안·허가증·칼선·규격 및 기존 Artwork","outputs":"디자인 제작과 QS 검토에 사용할 문안·허가증·칼선·규격 및 참고 Artwork, 아직 확보하지 못해 나중에 확인할 자료 목록","perspective":"asis","sourceRefs":[{"path":"docs/기능설계/조사_2026-09-25/08_기능지도_2판.md","ref":"K-접수-04~08 / K-대조-02~04"},{"path":"docs/23_업무규칙장부.md","ref":"자료-01·자료-02·자료-04·자료-10·자료-11"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"2장 접수·기준 자료 / 5장 다 4) 자료 변경과 재전달"}],"workflowId":"NW_Q_BASIS","sourceSteps":["WF02_A05","WF02_A06","WF02_T06","WF02_T07","WF02_T08"],"level":"node-detail","scope":{"parentNodeId":"Q_BASIS","start":"상위 흐름에서 아래 입력 자료를 받은 때","end":"아래 결과를 정리하여 상위 흐름의 다음 업무에 전달한 때","inputs":"사용할 자재 정보, 확보된 문안·허가증·칼선·규격 및 기존 Artwork","outputs":"디자인 제작과 QS 검토에 사용할 문안·허가증·칼선·규격 및 참고 Artwork, 아직 확보하지 못해 나중에 확인할 자료 목록","includes":["확보한 문안·허가증·칼선·규격·기존 Artwork의 확인과 등록","자료 종류·대상·판 연결","확보·미확보·해당없음 구분"],"excludes":["자료 내용을 Artwork와 실제 대조","디자인팀 전달 확정","모든 자료가 모일 때까지 일괄 대기","작업의뢰 자동 연동"]}}</bpmn:documentation>
    <bpmn:participant id="Participant_NW_Q_BASIS_A_Process" name="문안·허가증·칼선 등 제작과 검토에 쓸 자료를 준비한다 · 현재 업무" processRef="NW_Q_BASIS_A_Process" />
  </bpmn:collaboration>
  <bpmn:process id="NW_Q_BASIS_A_Process" isExecutable="false">
    <bpmn:laneSet id="LaneSet_NW_Q_BASIS_A_Process">
      <bpmn:lane id="Lane_NW_Q_BASIS_A_Process_R0" name="QS팀">
        <bpmn:flowNodeRef>NW_Q_BASIS_A00</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NW_Q_BASIS_A01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NW_Q_BASIS_A02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NW_Q_BASIS_A03</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NW_Q_BASIS_A04</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NW_Q_BASIS_A05</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="NW_Q_BASIS_A00" name="대상 자재와 받은 자료를 확인한다">
      <bpmn:documentation>해당 자재의 이 업무를 시작할 자료를 받는다.
입력 자료: 사용할 자재 정보, 확보된 문안·허가증·칼선·규격 및 기존 Artwork
전달 자료: 사용할 자재 정보, 확보된 문안·허가증·칼선·규격 및 기존 Artwork</bpmn:documentation>
