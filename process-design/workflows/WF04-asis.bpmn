<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="WF04_A_Collaboration" name="디자인팀 자료 전달·다운로드·반영 업로드 · 현재 업무">
    <bpmn:documentation>자료와 요청을 전달하고 디자인팀이 작업 파일을 돌려주면 QS가 검토한다.
입력 자료: 최초 제작·수정·바코드·전환 작업 요청
전달 자료: 대상 자재와 판을 확인해 QS팀·개발부 등 해당 경로의 담당자에게 전달한 Artwork, 수탁이면 양측 검토용 동일 PDF</bpmn:documentation>
    <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"최초 제작·수정·바코드·전환 작업 요청","outputs":"대상 자재와 판을 확인해 QS팀·개발부 등 해당 경로의 담당자에게 전달한 Artwork, 수탁이면 양측 검토용 동일 PDF","perspective":"asis","sourceRefs":[{"path":"docs/20_회의록_2026-09-22.md","ref":"디자인팀 자료 전달·반환 / 사용자 순간 22"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"5장 다 디자인팀 받은 일 / C-01~09"},{"path":"docs/23_업무규칙장부.md","ref":"전달-01~06·차수-11"},{"path":"CODEX.md","ref":"디자인팀 다운로드·업로드 중심 원칙"}],"workflowId":"WF04","sourceSteps":[],"level":"context","scope":null}</bpmn:documentation>
    <bpmn:participant id="Participant_WF04_A_Process" name="디자인팀 자료 전달·다운로드·반영 업로드 · 현재 업무" processRef="WF04_A_Process" />
  </bpmn:collaboration>
  <bpmn:process id="WF04_A_Process" isExecutable="false">
    <bpmn:laneSet id="LaneSet_WF04_A_Process">
      <bpmn:lane id="Lane_WF04_A_Process_R0" name="QS팀">
        <bpmn:flowNodeRef>WF04_A_START1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF04_A01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J_WF04_A02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF04_A02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF04_A04</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J_WF04_A06</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF04_A06</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF04_A07</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF04_A08</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF04_A09</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF04_A08_RESULT</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_WF04_A_Process_R1" name="디자인팀">
        <bpmn:flowNodeRef>WF04_A03</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF04_A05</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="WF04_A_START1" name="시작">
      <bpmn:documentation>최초 제작·수정·바코드·전환 작업 요청
입력 자료: 최초 제작·수정·바코드·전환 작업 요청
전달 자료: 기준자료·해당 주석·이전 도안</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"최초 제작·수정·바코드·전환 작업 요청","outputs":"기준자료·해당 주석·이전 도안","perspective":"asis","workflowId":"WF04"}</bpmn:documentation>
      <bpmn:outgoing>WF04_A_START_FLOW1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="WF04_A01" name="작업에 필요한 자료와 요청 내용을 모은다">
      <bpmn:documentation>신규 제작·수정·바코드 반영·최종 파일 전환 중 이번 요청 내용을 정리한다.
입력 자료: 기준자료·해당 주석·이전 도안
전달 자료: 디자인팀에 전달할 대상 자재의 제작자료 또는 주석본과 작업 요청</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀","scope":null}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"기준자료·해당 주석·이전 도안","outputs":"디자인팀에 전달할 대상 자재의 제작자료 또는 주석본과 작업 요청","businessRules":[],"approvedQuestionIds":[],"perspective":"asis","phase":"현행","functionIds":[],"sourceRefs":[{"path":"docs/20_회의록_2026-09-22.md","ref":"디자인팀 자료 전달·반환 / 사용자 순간 22"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"5장 다 디자인팀 받은 일 / C-01~09"},{"path":"docs/23_업무규칙장부.md","ref":"전달-01~06·차수-11"},{"path":"CODEX.md","ref":"디자인팀 다운로드·업로드 중심 원칙"}],"workflowId":"WF04","originalStepId":"WF04_A01","actorDetail":"QS팀; 위탁 신규는 개발부","sourceSteps":[],"level":"context","scope":null}</bpmn:documentation>
      <bpmn:incoming>WF04_A_START_FLOW1</bpmn:incoming>
      <bpmn:outgoing>WF04_AF01</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="J_WF04_A02" name="경로 합류" gatewayDirection="Converging">
      <bpmn:documentation>해당 경로의 업무 결과를 이어 받는다.
입력 자료: 준비된 파일과 요청 내용
전달 자료: 준비된 파일과 요청 내용</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"준비된 파일과 요청 내용","outputs":"준비된 파일과 요청 내용","gatewayDirection":"Converging","gatewayMeaning":"경로 합류","perspective":"asis","workflowId":"WF04","originalStepId":"WF04_A02"}</bpmn:documentation>
      <bpmn:incoming>WF04_AF01</bpmn:incoming>
      <bpmn:incoming>WF04_AF04</bpmn:incoming>
      <bpmn:outgoing>WF04_A_JOIN_WF04_A02</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="WF04_A02" name="디자인팀에 자료와 요청을 전달한다">
      <bpmn:documentation>현재 사용하는 파일 전달 경로로 자료와 요청을 보낸다.
입력 자료: 준비된 파일과 요청 내용
전달 자료: 디자인팀이 받은 파일과 지시</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀","scope":null}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"준비된 파일과 요청 내용","outputs":"디자인팀이 받은 파일과 지시","businessRules":[],"approvedQuestionIds":[],"perspective":"asis","phase":"현행","functionIds":[],"sourceRefs":[{"path":"docs/20_회의록_2026-09-22.md","ref":"디자인팀 자료 전달·반환 / 사용자 순간 22"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"5장 다 디자인팀 받은 일 / C-01~09"},{"path":"docs/23_업무규칙장부.md","ref":"전달-01~06·차수-11"},{"path":"CODEX.md","ref":"디자인팀 다운로드·업로드 중심 원칙"}],"workflowId":"WF04","originalStepId":"WF04_A02","actorDetail":"QS팀 또는 개발부 → 디자인팀","sourceSteps":[],"level":"context","scope":null}</bpmn:documentation>
      <bpmn:incoming>WF04_A_JOIN_WF04_A02</bpmn:incoming>
      <bpmn:outgoing>WF04_AF02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="WF04_A03" name="받은 자료로 작업할 수 있는가?" gatewayDirection="Diverging" default="WF04_AF05">
      <bpmn:documentation>필요한 원본과 수정 내용이 있는지 확인한다.
입력 자료: 전달자료
전달 자료: 현재 자료로 작업할 수 있는지와 추가로 받아야 할 파일·요청 내용</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"디자인팀","scope":null}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"전달자료","outputs":"현재 자료로 작업할 수 있는지와 추가로 받아야 할 파일·요청 내용","gatewayDirection":"Diverging","businessRules":[],"gatewayMeaning":"하나 선택","approvedQuestionIds":[],"perspective":"asis","phase":"현행","functionIds":[],"sourceRefs":[{"path":"docs/20_회의록_2026-09-22.md","ref":"디자인팀 자료 전달·반환 / 사용자 순간 22"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"5장 다 디자인팀 받은 일 / C-01~09"},{"path":"docs/23_업무규칙장부.md","ref":"전달-01~06·차수-11"},{"path":"CODEX.md","ref":"디자인팀 다운로드·업로드 중심 원칙"}],"workflowId":"WF04","originalStepId":"WF04_A03","actorDetail":"디자인팀","sourceSteps":[],"level":"context","scope":null}</bpmn:documentation>
      <bpmn:incoming>WF04_AF02</bpmn:incoming>
      <bpmn:outgoing>WF04_AF03</bpmn:outgoing>
      <bpmn:outgoing>WF04_AF05</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="WF04_A04" name="부족한 자료나 요청 내용을 확인한다">
      <bpmn:documentation>작업에 필요한 내용을 되묻고 보완 자료를 받는다.
입력 자료: 부족한 자료 또는 모호한 요청
전달 자료: 보완된 전달자료</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀","scope":null}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"부족한 자료 또는 모호한 요청","outputs":"보완된 전달자료","businessRules":[],"approvedQuestionIds":[],"perspective":"asis","phase":"현행","functionIds":[],"sourceRefs":[{"path":"docs/20_회의록_2026-09-22.md","ref":"디자인팀 자료 전달·반환 / 사용자 순간 22"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"5장 다 디자인팀 받은 일 / C-01~09"},{"path":"docs/23_업무규칙장부.md","ref":"전달-01~06·차수-11"},{"path":"CODEX.md","ref":"디자인팀 다운로드·업로드 중심 원칙"}],"workflowId":"WF04","originalStepId":"WF04_A04","actorDetail":"디자인팀 ↔ QS팀·개발부","sourceSteps":[],"level":"context","scope":null}</bpmn:documentation>
      <bpmn:incoming>WF04_AF03</bpmn:incoming>
      <bpmn:outgoing>WF04_AF04</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="WF04_A05" name="Artwork를 제작·수정한다">
      <bpmn:documentation>디자인 도구에서 신규 제작 또는 요청사항을 반영한다.
입력 자료: 전달받은 도안·기준자료·주석
전달 자료: 제작·수정된 Artwork</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"디자인팀","scope":null}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"전달받은 도안·기준자료·주석","outputs":"제작·수정된 Artwork","businessRules":[],"approvedQuestionIds":[],"perspective":"asis","phase":"현행","functionIds":[],"sourceRefs":[{"path":"docs/20_회의록_2026-09-22.md","ref":"디자인팀 자료 전달·반환 / 사용자 순간 22"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"5장 다 디자인팀 받은 일 / C-01~09"},{"path":"docs/23_업무규칙장부.md","ref":"전달-01~06·차수-11"},{"path":"CODEX.md","ref":"디자인팀 다운로드·업로드 중심 원칙"}],"workflowId":"WF04","originalStepId":"WF04_A05","actorDetail":"디자인팀","sourceSteps":[],"level":"context","scope":null}</bpmn:documentation>
      <bpmn:incoming>WF04_AF05</bpmn:incoming>
      <bpmn:outgoing>WF04_AF06</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="J_WF04_A06" name="경로 합류" gatewayDirection="Converging">
      <bpmn:documentation>해당 경로의 업무 결과를 이어 받는다.
입력 자료: 초안·반영본·전환본
전달 자료: 초안·반영본·전환본</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"초안·반영본·전환본","outputs":"초안·반영본·전환본","gatewayDirection":"Converging","gatewayMeaning":"경로 합류","perspective":"asis","workflowId":"WF04","originalStepId":"WF04_A06"}</bpmn:documentation>
      <bpmn:incoming>WF04_AF06</bpmn:incoming>
      <bpmn:incoming>WF04_AF22</bpmn:incoming>
      <bpmn:outgoing>WF04_A_JOIN_WF04_A06</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="WF04_A06" name="제작·수정 파일을 해당 경로의 검토 담당자에게 전달한다">
      <bpmn:documentation>자사 신규·개정과 위탁 개정은 QS팀에 전달한다. 위탁 신규는 개발부에 전달하고 개발부가 마케팅·QS 검토를 요청한다. 수탁은 의뢰사와 동국제약이 같은 확인용 PDF를 검토할 수 있도록 전달한다.
입력 자료: 초안·반영본·전환본
전달 자료: QS팀에 전달한 Artwork, 개발부에 전달한 위탁 신규 Artwork 또는 수탁 양측 검토용 동일 PDF</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀","scope":null}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"초안·반영본·전환본","outputs":"QS팀에 전달한 Artwork, 개발부에 전달한 위탁 신규 Artwork 또는 수탁 양측 검토용 동일 PDF","businessRules":[],"approvedQuestionIds":[],"perspective":"asis","phase":"현행","functionIds":[],"sourceRefs":[{"path":"docs/20_회의록_2026-09-22.md","ref":"디자인팀 자료 전달·반환 / 사용자 순간 22"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"5장 다 디자인팀 받은 일 / C-01~09"},{"path":"docs/23_업무규칙장부.md","ref":"전달-01~06·차수-11"},{"path":"CODEX.md","ref":"디자인팀 다운로드·업로드 중심 원칙"}],"workflowId":"WF04","originalStepId":"WF04_A06","actorDetail":"디자인팀 → QS팀; 위탁 신규는 개발부 경유","sourceSteps":[],"level":"context","scope":null}</bpmn:documentation>
      <bpmn:incoming>WF04_A_JOIN_WF04_A06</bpmn:incoming>
      <bpmn:outgoing>WF04_AF07</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="WF04_A07" name="검토할 대상·판·파일이 맞는가?" gatewayDirection="Diverging" default="WF04_AF21">
      <bpmn:documentation>이번 자재와 요청에 맞는 파일인지 확인한다.
입력 자료: 디자인팀 반환 파일
전달 자료: 검토 진행 또는 파일 재전달 요청</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀","scope":null}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"디자인팀 반환 파일","outputs":"검토 진행 또는 파일 재전달 요청","gatewayDirection":"Diverging","businessRules":[],"gatewayMeaning":"하나 선택","approvedQuestionIds":[],"perspective":"asis","phase":"현행","functionIds":[],"sourceRefs":[{"path":"docs/20_회의록_2026-09-22.md","ref":"디자인팀 자료 전달·반환 / 사용자 순간 22"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"5장 다 디자인팀 받은 일 / C-01~09"},{"path":"docs/23_업무규칙장부.md","ref":"전달-01~06·차수-11"},{"path":"CODEX.md","ref":"디자인팀 다운로드·업로드 중심 원칙"}],"workflowId":"WF04","originalStepId":"WF04_A07","actorDetail":"QS팀","sourceSteps":[],"level":"context","scope":null}</bpmn:documentation>
      <bpmn:incoming>WF04_AF07</bpmn:incoming>
      <bpmn:outgoing>WF04_AF20</bpmn:outgoing>
      <bpmn:outgoing>WF04_AF21</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="WF04_A08" name="확인한 파일을 해당 경로의 검토로 넘긴다">
      <bpmn:documentation>자사 신규·개정과 위탁 개정은 QS 검토로, 위탁 신규는 개발부를 통한 마케팅·QS 검토로, 수탁은 의뢰사·동국제약의 같은 확인용 PDF 검토로 이어 간다. 최종 전환 요청의 결과는 해당 최종 파일 대조로 넘긴다.
입력 자료: 반환 파일 확인 결과
전달 자료: 대상 자재와 파일의 판을 확인한 Artwork 또는 최종 전환 파일, 수탁이면 양측이 검토할 동일 PDF</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀","scope":null}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"반환 파일 확인 결과","outputs":"대상 자재와 파일의 판을 확인한 Artwork 또는 최종 전환 파일, 수탁이면 양측이 검토할 동일 PDF","businessRules":[],"approvedQuestionIds":[],"perspective":"asis","phase":"현행","functionIds":[],"sourceRefs":[{"path":"docs/20_회의록_2026-09-22.md","ref":"디자인팀 자료 전달·반환 / 사용자 순간 22"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"5장 다 디자인팀 받은 일 / C-01~09"},{"path":"docs/23_업무규칙장부.md","ref":"전달-01~06·차수-11"},{"path":"CODEX.md","ref":"디자인팀 다운로드·업로드 중심 원칙"}],"workflowId":"WF04","originalStepId":"WF04_A08","actorDetail":"QS팀","sourceSteps":[],"level":"context","scope":null}</bpmn:documentation>
      <bpmn:incoming>WF04_AF20</bpmn:incoming>
      <bpmn:outgoing>WF04_A08_END_FLOW</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="WF04_A09" name="잘못된 파일의 재전달을 요청한다">
      <bpmn:documentation>대상이나 판이 다른 파일은 올바른 파일을 다시 보내 달라고 요청한다.
입력 자료: 반환 파일 확인 결과
전달 자료: 재전달 요청</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀","scope":null}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"반환 파일 확인 결과","outputs":"재전달 요청","businessRules":[],"approvedQuestionIds":[],"perspective":"asis","phase":"현행","functionIds":[],"sourceRefs":[{"path":"docs/20_회의록_2026-09-22.md","ref":"디자인팀 자료 전달·반환 / 사용자 순간 22"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"5장 다 디자인팀 받은 일 / C-01~09"},{"path":"docs/23_업무규칙장부.md","ref":"전달-01~06·차수-11"},{"path":"CODEX.md","ref":"디자인팀 다운로드·업로드 중심 원칙"}],"workflowId":"WF04","originalStepId":"WF04_A09","actorDetail":"QS팀","sourceSteps":[],"level":"context","scope":null}</bpmn:documentation>
      <bpmn:incoming>WF04_AF21</bpmn:incoming>
      <bpmn:outgoing>WF04_AF22</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="WF04_A08_RESULT" name="경로별 검토에 사용할 Artwork 파일 전달 완료">
      <bpmn:documentation>파일의 대상 자재와 판을 확인한 상태에서 해당 경로의 검토 담당자가 사용할 자료를 남긴다.
입력 자료: 대상 자재와 파일의 판을 확인한 Artwork 또는 최종 전환 파일, 수탁이면 양측이 검토할 동일 PDF
전달 자료: 대상 자재와 파일의 판을 확인한 Artwork 또는 최종 전환 파일, 수탁이면 양측이 검토할 동일 PDF</bpmn:documentation>
