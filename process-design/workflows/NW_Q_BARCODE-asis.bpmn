<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="NW_Q_BARCODE_A_Collaboration" name="바코드 적용·번호·반영 시점과 필요한 작업을 확인한다 · 현재 업무">
    <bpmn:documentation>현재 해당 담당자가 수행하는 업무
입력 자료: 바코드 적용 대상 자재, 확보한 번호와 현재 반영 상태
전달 자료: 확인한 바코드 번호·현재 반영 상태와 디자인·인쇄 또는 후인쇄 담당자에게 요청할 작업 내용</bpmn:documentation>
    <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"scope":{"parentNodeId":"Q_BARCODE","start":"상위 흐름에서 아래 입력 자료를 받은 때","end":"아래 결과를 정리하여 상위 흐름의 다음 업무에 전달한 때","inputs":"바코드 적용 대상 자재, 확보한 번호와 현재 반영 상태","outputs":"확인한 바코드 번호·현재 반영 상태와 디자인·인쇄 또는 후인쇄 담당자에게 요청할 작업 내용","includes":["바코드 반영 대상 자재의 포장단위·확보 번호 확인","번호 후보 조회와 담당자 확정","현재 도안 반영 상태 확인","다음 담당자에게 요청할 번호·작업 시점 정리"],"excludes":["입고 후 추가 인쇄 실행","디자인팀의 도안 수정 실행","번호를 허가증에서 추출","AI가 사용할 바코드를 결정","후인쇄 결과 자동 대조를 1단계로 확대"]}}</bpmn:documentation>
    <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"바코드 적용 대상 자재, 확보한 번호와 현재 반영 상태","outputs":"확인한 바코드 번호·현재 반영 상태와 디자인·인쇄 또는 후인쇄 담당자에게 요청할 작업 내용","perspective":"asis","sourceRefs":[{"path":"docs/기능설계/조사_2026-09-25/08_기능지도_2판.md","ref":"K-검토-08~11 / K-대조-18 / T-13"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-51~56"},{"path":"docs/23_업무규칙장부.md","ref":"바코-04: 필요 여부 사람 판단·번호 연결·자동 읽기와 QS 확인 / ON-10·ON-21~23"}],"workflowId":"NW_Q_BARCODE","sourceSteps":["WF11_A08","WF11_A09","WF11_T08","WF11_T09","WF11_T10"],"level":"node-detail","scope":{"parentNodeId":"Q_BARCODE","start":"상위 흐름에서 아래 입력 자료를 받은 때","end":"아래 결과를 정리하여 상위 흐름의 다음 업무에 전달한 때","inputs":"바코드 적용 대상 자재, 확보한 번호와 현재 반영 상태","outputs":"확인한 바코드 번호·현재 반영 상태와 디자인·인쇄 또는 후인쇄 담당자에게 요청할 작업 내용","includes":["바코드 반영 대상 자재의 포장단위·확보 번호 확인","번호 후보 조회와 담당자 확정","현재 도안 반영 상태 확인","다음 담당자에게 요청할 번호·작업 시점 정리"],"excludes":["입고 후 추가 인쇄 실행","디자인팀의 도안 수정 실행","번호를 허가증에서 추출","AI가 사용할 바코드를 결정","후인쇄 결과 자동 대조를 1단계로 확대"]}}</bpmn:documentation>
    <bpmn:participant id="Participant_NW_Q_BARCODE_A_Process" name="바코드 적용·번호·반영 시점과 필요한 작업을 확인한다 · 현재 업무" processRef="NW_Q_BARCODE_A_Process" />
  </bpmn:collaboration>
  <bpmn:process id="NW_Q_BARCODE_A_Process" isExecutable="false">
    <bpmn:laneSet id="LaneSet_NW_Q_BARCODE_A_Process">
      <bpmn:lane id="Lane_NW_Q_BARCODE_A_Process_R0" name="QS팀">
        <bpmn:flowNodeRef>NW_Q_BARCODE_A00</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NW_Q_BARCODE_A01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J_NW_Q_BARCODE_A02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NW_Q_BARCODE_A02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NW_Q_BARCODE_A03</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NW_Q_BARCODE_A04</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NW_Q_BARCODE_A05</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="NW_Q_BARCODE_A00" name="대상 자재와 받은 자료를 확인한다">
      <bpmn:documentation>해당 자재의 이 업무를 시작할 자료를 받는다.
