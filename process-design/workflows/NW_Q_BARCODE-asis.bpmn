      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"바코드 적용 대상 자재, 확보한 번호와 현재 반영 상태","outputs":"바코드 적용 대상 자재, 확보한 번호와 현재 반영 상태","businessRules":[],"approvedQuestionIds":[],"perspective":"asis","phase":"현행","functionIds":[],"sourceRefs":[{"path":"docs/기능설계/조사_2026-09-25/08_기능지도_2판.md","ref":"K-검토-08~11 / K-대조-18 / T-13"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-51~56"},{"path":"docs/23_업무규칙장부.md","ref":"바코-04: 필요 여부 사람 판단·번호 연결·자동 읽기와 QS 확인 / ON-10·ON-21~23"}],"workflowId":"NW_Q_BARCODE","originalStepId":"NW_Q_BARCODE_A00","actorDetail":"QS팀","sourceSteps":[],"level":"node-detail","scope":{"parentNodeId":"Q_BARCODE","start":"상위 흐름에서 아래 입력 자료를 받은 때","end":"아래 결과를 정리하여 상위 흐름의 다음 업무에 전달한 때","inputs":"바코드 적용 대상 자재, 확보한 번호와 현재 반영 상태","outputs":"확인한 바코드 번호·현재 반영 상태와 디자인·인쇄 또는 후인쇄 담당자에게 요청할 작업 내용","includes":["바코드 반영 대상 자재의 포장단위·확보 번호 확인","번호 후보 조회와 담당자 확정","현재 도안 반영 상태 확인","다음 담당자에게 요청할 번호·작업 시점 정리"],"excludes":["입고 후 추가 인쇄 실행","디자인팀의 도안 수정 실행","번호를 허가증에서 추출","AI가 사용할 바코드를 결정","후인쇄 결과 자동 대조를 1단계로 확대"]}}</bpmn:documentation>
      <bpmn:outgoing>NW_Q_BARCODE_AF01</bpmn:outgoing>
