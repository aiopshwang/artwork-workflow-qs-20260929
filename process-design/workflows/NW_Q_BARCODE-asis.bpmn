      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"대상 자재·포장단위·확보 번호","outputs":"대상 자재·포장단위·확보 번호","gatewayDirection":"Converging","gatewayMeaning":"경로 합류","perspective":"asis","workflowId":"NW_Q_BARCODE","originalStepId":"NW_Q_BARCODE_A02"}</bpmn:documentation>
