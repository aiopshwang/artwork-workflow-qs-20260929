      <bpmn:incoming>WF12_T00_START_FLOW</bpmn:incoming>
      <bpmn:incoming>WF12_TF21</bpmn:incoming>
      <bpmn:incoming>WF12_TF27</bpmn:incoming>
      <bpmn:outgoing>WF12_T_JOIN_WF12_T01</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="WF12_T12" name="멈춤·접음·이어가기 중 어느 처리인가?" gatewayDirection="Diverging" default="WF12_TF17">
      <bpmn:documentation>잠시 쉬는 멈춤, 완료 없이 종료하는 접음, 중단 업무의 재개를 구분한다.
입력 자료: 상태 변경 요청
전달 자료: 처리할 상태</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"상태 변경 요청","outputs":"처리할 상태","gatewayDirection":"Diverging","businessRules":[],"gatewayMeaning":"하나 선택","perspective":"tobe","phase":"Phase 1","functionIds":["B-04","B-25"],"sourceRefs":[{"path":"docs/20_회의록_2026-09-22.md","ref":"M-22·M-30·M-77·M-78~80·M-101"},{"path":"docs/23_업무규칙장부.md","ref":"접수-08·개정-17·검건-02·검건-05·검건-07·검건-08·자료-10·자료-11·승인-07"},{"path":"docs/superpowers/specs/2026-09-26-artwork-phase1-design-supplement-1.md","ref":"라 ② 중단·되살리기 / ⑤ 사건 하나·자재마다 건"},{"path":"CODEX.md","ref":"현행과 목표 구분·변경 요청·자재 추가·중단 취소 재개"}],"workflowId":"WF12","originalStepId":"WF12_T12","actorDetail":"QS 담당자"}</bpmn:documentation>
      <bpmn:incoming>WF12_TF14</bpmn:incoming>
      <bpmn:outgoing>WF12_TF15</bpmn:outgoing>
      <bpmn:outgoing>WF12_TF16</bpmn:outgoing>
      <bpmn:outgoing>WF12_TF17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="WF12_T19" name="첫 단계에서 아직 다음 단계로 넘어가지 않았는가?" gatewayDirection="Diverging" default="WF12_TF26">
      <bpmn:documentation>첫 단계 안의 선택 수정인지 이후 업무 흐름을 바꾸는 것인지 구분한다.
입력 자료: 현재 진행 단계
전달 자료: 수정 또는 재접수</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"현재 진행 단계","outputs":"수정 또는 재접수","gatewayDirection":"Diverging","businessRules":[],"gatewayMeaning":"하나 선택","perspective":"tobe","phase":"Phase 1","functionIds":["K-접수-01","B-04"],"sourceRefs":[{"path":"docs/20_회의록_2026-09-22.md","ref":"M-22·M-30·M-77·M-78~80·M-101"},{"path":"docs/23_업무규칙장부.md","ref":"접수-08·개정-17·검건-02·검건-05·검건-07·검건-08·자료-10·자료-11·승인-07"},{"path":"docs/superpowers/specs/2026-09-26-artwork-phase1-design-supplement-1.md","ref":"라 ② 중단·되살리기 / ⑤ 사건 하나·자재마다 건"},{"path":"CODEX.md","ref":"현행과 목표 구분·변경 요청·자재 추가·중단 취소 재개"}],"workflowId":"WF12","originalStepId":"WF12_T19","actorDetail":"QS 담당자"}</bpmn:documentation>
      <bpmn:incoming>WF12_TF23</bpmn:incoming>
      <bpmn:outgoing>WF12_TF24</bpmn:outgoing>
      <bpmn:outgoing>WF12_TF26</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="WF12_T01" name="추가 자료 또는 새 요청을 받는다">
      <bpmn:documentation>기존 요청과의 관계를 확인하고 수령 정보를 남긴다.
입력 자료: 반영본·보완 자료·자재 추가·변경 요청
전달 자료: 추가 수령 내용</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"반영본·보완 자료·자재 추가·변경 요청","outputs":"추가 수령 내용","businessRules":[],"perspective":"tobe","phase":"Phase 1","functionIds":["K-접수-08"],"sourceRefs":[{"path":"docs/20_회의록_2026-09-22.md","ref":"M-22·M-30·M-77·M-78~80·M-101"},{"path":"docs/23_업무규칙장부.md","ref":"접수-08·개정-17·검건-02·검건-05·검건-07·검건-08·자료-10·자료-11·승인-07"},{"path":"docs/superpowers/specs/2026-09-26-artwork-phase1-design-supplement-1.md","ref":"라 ② 중단·되살리기 / ⑤ 사건 하나·자재마다 건"},{"path":"CODEX.md","ref":"현행과 목표 구분·변경 요청·자재 추가·중단 취소 재개"}],"workflowId":"WF12","originalStepId":"WF12_T01","actorDetail":"QS 담당자"}</bpmn:documentation>
      <bpmn:incoming>WF12_T_JOIN_WF12_T01</bpmn:incoming>
      <bpmn:outgoing>WF12_TF01</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="WF12_T13" name="열린 개정을 멈춤으로 둔다">
      <bpmn:documentation>같은 개정·차수 줄을 유지하고 사유를 남긴다. 멈춘 개정도 열린 개정으로 센다.
입력 자료: 잠시 중단할 사유
전달 자료: 멈춤 상태의 개정</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"잠시 중단할 사유","outputs":"멈춤 상태의 개정","businessRules":[],"perspective":"tobe","phase":"Phase 1","functionIds":["B-04","B-26"],"sourceRefs":[{"path":"docs/20_회의록_2026-09-22.md","ref":"M-22·M-30·M-77·M-78~80·M-101"},{"path":"docs/23_업무규칙장부.md","ref":"접수-08·개정-17·검건-02·검건-05·검건-07·검건-08·자료-10·자료-11·승인-07"},{"path":"docs/superpowers/specs/2026-09-26-artwork-phase1-design-supplement-1.md","ref":"라 ② 중단·되살리기 / ⑤ 사건 하나·자재마다 건"},{"path":"CODEX.md","ref":"현행과 목표 구분·변경 요청·자재 추가·중단 취소 재개"}],"workflowId":"WF12","originalStepId":"WF12_T13","actorDetail":"QS 담당자"}</bpmn:documentation>
      <bpmn:incoming>WF12_TF15</bpmn:incoming>
      <bpmn:outgoing>WF12_TF18</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="WF12_T14" name="완료 없이 접고 사유를 남긴다">
      <bpmn:documentation>완료본을 만들지 않고 닫는다. 이미 부여된 개정번호를 다른 개정에 재사용하지 않는다.
입력 자료: 개발 중단·허가 미발급·요청 철회 등의 사유
전달 자료: 접힌 개정과 사유</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀"}</bpmn:documentation>
