<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="WF12_T_Collaboration" name="추가 변경·동시 요청·멈춤·접음·재개 · 도입 후 업무">
    <bpmn:documentation>추가자료·자재 추가·새 변경 요청을 구분하고 한 자재의 열린 개정 하나를 유지한다. 멈춤과 접음을 나누고 조건에 맞춰 재개한다.
입력 자료: 추가 요청·상태 변경·업무 유형 정정
전달 자료: 이어갈 자재별 업무와 보존된 상태 이력</bpmn:documentation>
    <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"추가 요청·상태 변경·업무 유형 정정","outputs":"이어갈 자재별 업무와 보존된 상태 이력","perspective":"tobe","sourceRefs":[{"path":"docs/20_회의록_2026-09-22.md","ref":"M-22·M-30·M-77·M-78~80·M-101"},{"path":"docs/23_업무규칙장부.md","ref":"접수-08·개정-17·검건-02·검건-05·검건-07·검건-08·자료-10·자료-11·승인-07"},{"path":"docs/superpowers/specs/2026-09-26-artwork-phase1-design-supplement-1.md","ref":"라 ② 중단·되살리기 / ⑤ 사건 하나·자재마다 건"},{"path":"CODEX.md","ref":"현행과 목표 구분·변경 요청·자재 추가·중단 취소 재개"}],"workflowId":"WF12"}</bpmn:documentation>
    <bpmn:participant id="Participant_WF12_T_Process" name="추가 변경·동시 요청·멈춤·접음·재개 · 도입 후 업무" processRef="WF12_T_Process" />
  </bpmn:collaboration>
  <bpmn:process id="WF12_T_Process" isExecutable="false">
    <bpmn:laneSet id="LaneSet_WF12_T_Process">
