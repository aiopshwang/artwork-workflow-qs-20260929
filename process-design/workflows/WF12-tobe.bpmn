        <bpmn:flowNodeRef>WF12_T05</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF12_T17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J_WF12_T10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF12_T06</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J_WF12_T09</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF12_T17_RESULT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF12_T10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF12_T07</bpmn:flowNodeRef>
