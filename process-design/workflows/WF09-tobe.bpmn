<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="WF09_T_Collaboration" name="자재표준서 작성·대조 · 도입 후 업무">
    <bpmn:documentation>받은 LIMS 표준서와 완료된 승인본을 대조하고 결과를 해당 완료 개정에 남긴다.
입력 자료: 대상 자재의 LIMS 표준서 파일
전달 자료: 완료된 개정의 대조 기록 또는 새 개정 대상</bpmn:documentation>
    <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"대상 자재의 LIMS 표준서 파일","outputs":"완료된 개정의 대조 기록 또는 새 개정 대상","perspective":"tobe","sourceRefs":[{"path":"docs/22_URS원문.md","ref":"CF-01·C-10"},{"path":"docs/23_업무규칙장부.md","ref":"표준-01·표준-03·표준-04·표준-07·차수-22·발주-09"},{"path":"CODEX.md","ref":"완료→자재표준서→첫 발주 / LIMS 대조 Phase 1·초안지원 Phase 2"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"K-검토-16·T-17"}],"workflowId":"WF09"}</bpmn:documentation>
    <bpmn:participant id="Participant_WF09_T_Process" name="자재표준서 작성·대조 · 도입 후 업무" processRef="WF09_T_Process" />
  </bpmn:collaboration>
  <bpmn:process id="WF09_T_Process" isExecutable="false">
    <bpmn:laneSet id="LaneSet_WF09_T_Process">
      <bpmn:lane id="Lane_WF09_T_Process_R0" name="QS팀">
        <bpmn:flowNodeRef>WF09_T_START1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF09_T01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J_WF09_T02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF09_T02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF09_T04</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF09_T05</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF09_T06</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF09_T07</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF09_T06_RESULT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF09_T07_RESULT</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_WF09_T_Process_R1" name="시스템">
        <bpmn:flowNodeRef>WF09_T03</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="WF09_T_START1" name="시작">
      <bpmn:documentation>대상 자재의 LIMS 표준서 파일
입력 자료: 대상 자재의 LIMS 표준서 파일
전달 자료: 최신 승인 Artwork와 받은 LIMS 자재표준서</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"대상 자재의 LIMS 표준서 파일","outputs":"최신 승인 Artwork와 받은 LIMS 자재표준서","perspective":"tobe","workflowId":"WF09"}</bpmn:documentation>
      <bpmn:outgoing>WF09_T_START_FLOW1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="WF09_T01" name="완료된 개정과 LIMS 표준서 파일을 연결한다">
      <bpmn:documentation>대상 자재·개정과 비교할 표준서 파일을 확인한다. LIMS 내부 작성 절차를 대체하지 않는다.
입력 자료: 최신 승인 Artwork와 받은 LIMS 자재표준서
전달 자료: 대조할 표준서·승인본</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"최신 승인 Artwork와 받은 LIMS 자재표준서","outputs":"대조할 표준서·승인본","businessRules":[],"perspective":"tobe","phase":"Phase 1","functionIds":["K-검토-16","K-대조-02"],"sourceRefs":[{"path":"docs/22_URS원문.md","ref":"CF-01·C-10"},{"path":"docs/23_업무규칙장부.md","ref":"표준-01·표준-03·표준-04·표준-07·차수-22·발주-09"},{"path":"CODEX.md","ref":"완료→자재표준서→첫 발주 / LIMS 대조 Phase 1·초안지원 Phase 2"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"K-검토-16·T-17"}],"workflowId":"WF09","originalStepId":"WF09_T01","actorDetail":"QS 담당자"}</bpmn:documentation>
      <bpmn:incoming>WF09_T_START_FLOW1</bpmn:incoming>
      <bpmn:outgoing>WF09_TF01</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="J_WF09_T02" name="경로 합류" gatewayDirection="Converging">
      <bpmn:documentation>해당 경로의 업무 결과를 이어 받는다.
입력 자료: 표준서와 승인 파일
전달 자료: 표준서와 승인 파일</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"표준서와 승인 파일","outputs":"표준서와 승인 파일","gatewayDirection":"Converging","gatewayMeaning":"경로 합류","perspective":"tobe","workflowId":"WF09","originalStepId":"WF09_T02"}</bpmn:documentation>
      <bpmn:incoming>WF09_TF01</bpmn:incoming>
      <bpmn:incoming>WF09_TF05</bpmn:incoming>
      <bpmn:outgoing>WF09_T_JOIN_WF09_T02</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="WF09_T02" name="표준서·시방서의 판독값을 확인한다">
      <bpmn:documentation>AI 판독값을 QS가 확인한다. 대조할 항목의 값과 위치를 확인하고 판독 오류를 보완한다.
입력 자료: 표준서와 승인 파일
전달 자료: 확인된 비교 값</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"표준서와 승인 파일","outputs":"확인된 비교 값","businessRules":[],"perspective":"tobe","phase":"Phase 1","functionIds":["K-판독-03","K-판독-04","K-판독-07"],"sourceRefs":[{"path":"docs/22_URS원문.md","ref":"CF-01·C-10"},{"path":"docs/23_업무규칙장부.md","ref":"표준-01·표준-03·표준-04·표준-07·차수-22·발주-09"},{"path":"CODEX.md","ref":"완료→자재표준서→첫 발주 / LIMS 대조 Phase 1·초안지원 Phase 2"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"K-검토-16·T-17"}],"workflowId":"WF09","originalStepId":"WF09_T02","actorDetail":"QS 담당자"}</bpmn:documentation>
      <bpmn:incoming>WF09_T_JOIN_WF09_T02</bpmn:incoming>
      <bpmn:outgoing>WF09_TF02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="WF09_T03" name="표준서와 승인본을 대조한다">
      <bpmn:documentation>대상 자재의 기재·규격 차이를 대조하고 결과를 완료된 개정에 연결한다.
입력 자료: 확인한 값과 대상 판
전달 자료: 대조 실행 기록</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"시스템"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"확인한 값과 대상 판","outputs":"대조 실행 기록","businessRules":[],"perspective":"tobe","phase":"Phase 1","functionIds":["K-검토-16","K-대조-09","K-대조-24"],"sourceRefs":[{"path":"docs/22_URS원문.md","ref":"CF-01·C-10"},{"path":"docs/23_업무규칙장부.md","ref":"표준-01·표준-03·표준-04·표준-07·차수-22·발주-09"},{"path":"CODEX.md","ref":"완료→자재표준서→첫 발주 / LIMS 대조 Phase 1·초안지원 Phase 2"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"K-검토-16·T-17"}],"workflowId":"WF09","originalStepId":"WF09_T03","actorDetail":"시스템"}</bpmn:documentation>
      <bpmn:incoming>WF09_TF02</bpmn:incoming>
      <bpmn:outgoing>WF09_TF03</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="WF09_T04" name="고칠 대상이 표준서인가, Artwork인가?" gatewayDirection="Diverging" default="WF09_TF07">
      <bpmn:documentation>차이를 확인하고 표준서 보완·Artwork 새 개정·기록 보존으로 구분한다.
입력 자료: 규칙 결과와 원문
전달 자료: 담당자 처리 결정</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"규칙 결과와 원문","outputs":"담당자 처리 결정","gatewayDirection":"Diverging","businessRules":[],"gatewayMeaning":"하나 선택","perspective":"tobe","phase":"Phase 1","functionIds":["K-검토-04","K-검토-16"],"sourceRefs":[{"path":"docs/22_URS원문.md","ref":"CF-01·C-10"},{"path":"docs/23_업무규칙장부.md","ref":"표준-01·표준-03·표준-04·표준-07·차수-22·발주-09"},{"path":"CODEX.md","ref":"완료→자재표준서→첫 발주 / LIMS 대조 Phase 1·초안지원 Phase 2"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"K-검토-16·T-17"}],"workflowId":"WF09","originalStepId":"WF09_T04","actorDetail":"QS 담당자"}</bpmn:documentation>
      <bpmn:incoming>WF09_TF03</bpmn:incoming>
      <bpmn:outgoing>WF09_TF04</bpmn:outgoing>
      <bpmn:outgoing>WF09_TF06</bpmn:outgoing>
      <bpmn:outgoing>WF09_TF07</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="WF09_T05" name="표준서 파일을 보완해 다시 연결한다">
      <bpmn:documentation>외부 표준서 업무에서 보완한 파일을 받아 다시 비교한다.
입력 자료: 표준서 수정사항
전달 자료: 수정된 표준서 파일</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"표준서 수정사항","outputs":"수정된 표준서 파일","businessRules":[],"perspective":"tobe","phase":"Phase 1","functionIds":["K-접수-08","K-검토-16"],"sourceRefs":[{"path":"docs/22_URS원문.md","ref":"CF-01·C-10"},{"path":"docs/23_업무규칙장부.md","ref":"표준-01·표준-03·표준-04·표준-07·차수-22·발주-09"},{"path":"CODEX.md","ref":"완료→자재표준서→첫 발주 / LIMS 대조 Phase 1·초안지원 Phase 2"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"K-검토-16·T-17"}],"workflowId":"WF09","originalStepId":"WF09_T05","actorDetail":"QS 담당자"}</bpmn:documentation>
      <bpmn:incoming>WF09_TF04</bpmn:incoming>
      <bpmn:outgoing>WF09_TF05</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="WF09_T06" name="Artwork 변경은 새 개정으로 연결한다">
      <bpmn:documentation>완료된 개정에 차수를 붙이지 않고 새 개정 작업으로 연결한다.
입력 자료: 완료 후 발견한 도안 변경사항
전달 자료: 새 개정 검토 대상</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"완료 후 발견한 도안 변경사항","outputs":"새 개정 검토 대상","businessRules":[],"perspective":"tobe","phase":"Phase 1","functionIds":["B-02","K-접수-10"],"sourceRefs":[{"path":"docs/22_URS원문.md","ref":"CF-01·C-10"},{"path":"docs/23_업무규칙장부.md","ref":"표준-01·표준-03·표준-04·표준-07·차수-22·발주-09"},{"path":"CODEX.md","ref":"완료→자재표준서→첫 발주 / LIMS 대조 Phase 1·초안지원 Phase 2"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"K-검토-16·T-17"}],"workflowId":"WF09","originalStepId":"WF09_T06","actorDetail":"QS 담당자"}</bpmn:documentation>
      <bpmn:incoming>WF09_TF06</bpmn:incoming>
      <bpmn:outgoing>WF09_T06_END_FLOW</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="WF09_T07" name="비교 결과와 사용 표준서를 남긴다">
      <bpmn:documentation>어떤 표준서와 승인본을 비교했는지 기록하고 후속 발주에 사용할 자료를 연결한다.
입력 자료: 담당자 확인 결과
전달 자료: 표준서 대조 기록</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"담당자 확인 결과","outputs":"표준서 대조 기록","businessRules":[],"perspective":"tobe","phase":"Phase 1","functionIds":["K-검토-16","B-11"],"sourceRefs":[{"path":"docs/22_URS원문.md","ref":"CF-01·C-10"},{"path":"docs/23_업무규칙장부.md","ref":"표준-01·표준-03·표준-04·표준-07·차수-22·발주-09"},{"path":"CODEX.md","ref":"완료→자재표준서→첫 발주 / LIMS 대조 Phase 1·초안지원 Phase 2"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"K-검토-16·T-17"}],"workflowId":"WF09","originalStepId":"WF09_T07","actorDetail":"QS 담당자"}</bpmn:documentation>
