        <bpmn:flowNodeRef>NW_Q_DESIGN_REQUEST_A01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NW_Q_DESIGN_REQUEST_A02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NW_Q_DESIGN_REQUEST_A03</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="NW_Q_DESIGN_REQUEST_A00" name="이 업무에 필요한 자료를 확인한다">
      <bpmn:documentation>상위 업무에서 전달받은 자료로 이 업무를 시작한다.
