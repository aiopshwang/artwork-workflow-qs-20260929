<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="NW_Q_DESIGN_REQUEST_A_Collaboration" name="디자인팀에 제작 자료와 신규·수정 요청을 전달한다 · 현재 업무">
    <bpmn:documentation>현재 업무: 디자인팀에 제작 자료와 신규·수정 요청을 전달한다
입력 자료: 해당 자재의 확보된 문안·허가증·칼선·규격 등 제작자료 또는 기존 Artwork의 변경 주석본
전달 자료: 디자인팀에 전달한 대상 자재의 제작·수정 요청, 사용할 Artwork와 확보된 문안·허가증·칼선·규격 또는 변경 주석본</bpmn:documentation>
    <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"scope":{"parentNodeId":"Q_DESIGN_REQUEST","start":"다음 자료를 받은 상태에서 시작한다: 자재의 제작 기준자료 또는 기존 Artwork의 변경 주석","end":"이 업무에서 남길 내용: 디자인팀에 전달할 기준자료·주석본과 대상 파일·요청 내용","inputs":"해당 자재의 확보된 문안·허가증·칼선·규격 등 제작자료 또는 기존 Artwork의 변경 주석본","outputs":"디자인팀에 전달한 대상 자재의 제작·수정 요청, 사용할 Artwork와 확보된 문안·허가증·칼선·규격 또는 변경 주석본","includes":["전달할 파일·판·요청 내용 확인","내부 받은 일 전달 또는 외부 메일용 파일 다운로드·사람 전달","전달 기록 확인"],"excludes":["기준자료 취합과 주석 작성","디자인팀의 내려받기·실제 작업·업로드"]}}</bpmn:documentation>
    <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"해당 자재의 확보된 문안·허가증·칼선·규격 등 제작자료 또는 기존 Artwork의 변경 주석본","outputs":"디자인팀에 전달한 대상 자재의 제작·수정 요청, 사용할 Artwork와 확보된 문안·허가증·칼선·규격 또는 변경 주석본","perspective":"asis","sourceRefs":[{"path":"docs/20_회의록_2026-09-22.md","ref":"디자인팀 자료 전달·반환 / 사용자 순간 22"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"5장 다 디자인팀 받은 일 / C-01~09"},{"path":"docs/23_업무규칙장부.md","ref":"전달-01~06·차수-11"},{"path":"CODEX.md","ref":"디자인팀 다운로드·업로드 중심 원칙"}],"workflowId":"NW_Q_DESIGN_REQUEST","sourceSteps":["WF04_A01","WF04_A02","WF04_T01","WF04_T02"],"level":"node-detail","scope":{"parentNodeId":"Q_DESIGN_REQUEST","start":"다음 자료를 받은 상태에서 시작한다: 자재의 제작 기준자료 또는 기존 Artwork의 변경 주석","end":"이 업무에서 남길 내용: 디자인팀에 전달할 기준자료·주석본과 대상 파일·요청 내용","inputs":"해당 자재의 확보된 문안·허가증·칼선·규격 등 제작자료 또는 기존 Artwork의 변경 주석본","outputs":"디자인팀에 전달한 대상 자재의 제작·수정 요청, 사용할 Artwork와 확보된 문안·허가증·칼선·규격 또는 변경 주석본","includes":["전달할 파일·판·요청 내용 확인","내부 받은 일 전달 또는 외부 메일용 파일 다운로드·사람 전달","전달 기록 확인"],"excludes":["기준자료 취합과 주석 작성","디자인팀의 내려받기·실제 작업·업로드"]}}</bpmn:documentation>
