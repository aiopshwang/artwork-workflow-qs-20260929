<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="WF02_A_Collaboration" name="기존 자재 사용과 기준자료 준비 · 현재 업무">
    <bpmn:documentation>QS가 기존 자재와 자료를 찾고 개정은 기존 도안에 변경 주석을 작성한다.
입력 자료: 대상 자재가 확인된 요청
전달 자료: 디자인팀에 전달할 제작·수정 요청, 확보된 문안·허가증·칼선·규격과 필요한 변경 주석본</bpmn:documentation>
    <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"대상 자재가 확인된 요청","outputs":"디자인팀에 전달할 제작·수정 요청, 확보된 문안·허가증·칼선·규격과 필요한 변경 주석본","perspective":"asis","sourceRefs":[{"path":"CODEX.md","ref":"기존 자재·등록정보·기준자료 준비와 ERP Phase 2 결정"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-22·M-30·M-78~80"},{"path":"docs/23_업무규칙장부.md","ref":"자재-13·단계-08·단계-09·단계-10·단계-16·자료-02·자료-04"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"2장 접수·대조·주석 / 6장 자재·기준 자료"}],"workflowId":"WF02","sourceSteps":[],"level":"context","scope":null}</bpmn:documentation>
    <bpmn:participant id="Participant_WF02_A_Process" name="기존 자재 사용과 기준자료 준비 · 현재 업무" processRef="WF02_A_Process" />
  </bpmn:collaboration>
  <bpmn:process id="WF02_A_Process" isExecutable="false">
    <bpmn:laneSet id="LaneSet_WF02_A_Process">
      <bpmn:lane id="Lane_WF02_A_Process_R0" name="QS팀">
        <bpmn:flowNodeRef>WF02_A09</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF02_A10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF02_A01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J_WF02_A05</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF02_A02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF02_A05</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF02_A03</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF02_A06</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF02_A04</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF02_A07</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J_WF02_A08</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF02_A08</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF02_A08_RESULT</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="WF02_A09" name="자사 또는 기존 자재의 준비 업무가 시작된다">
      <bpmn:documentation>자사·개정은 자재 조건을 확인하고, 위탁 신규는 개발부의 자료 취합과 QS의 표준코드 관련 업무에서 시작한다.
입력 자료: 확인된 대상 자재
전달 자료: 사용할 기존 자재를 확인하기 위한 대상 자재정보와 요청 내용</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀","scope":null}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"확인된 대상 자재","outputs":"사용할 기존 자재를 확인하기 위한 대상 자재정보와 요청 내용","businessRules":[],"approvedQuestionIds":[],"perspective":"asis","phase":"현행","functionIds":[],"sourceRefs":[{"path":"CODEX.md","ref":"기존 자재·등록정보·기준자료 준비와 ERP Phase 2 결정"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-22·M-30·M-78~80"},{"path":"docs/23_업무규칙장부.md","ref":"자재-13·단계-08·단계-09·단계-10·단계-16·자료-02·자료-04"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"2장 접수·대조·주석 / 6장 자재·기준 자료"}],"workflowId":"WF02","originalStepId":"WF02_A09","actorDetail":"QS팀·개발부","sourceSteps":[],"level":"context","scope":null}</bpmn:documentation>
      <bpmn:outgoing>WF02_AFA09</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:startEvent id="WF02_A10" name="위탁 신규의 제작 자료 준비가 시작된다">
      <bpmn:documentation>자사·개정은 자재 조건을 확인하고, 위탁 신규는 개발부의 자료 취합과 QS의 표준코드 관련 업무에서 시작한다.
입력 자료: 확인된 대상 자재
전달 자료: 개발부가 준비한 위탁 신규 품목의 제작자료와 대상 자재정보</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀","scope":null}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"확인된 대상 자재","outputs":"개발부가 준비한 위탁 신규 품목의 제작자료와 대상 자재정보","businessRules":[],"approvedQuestionIds":[],"perspective":"asis","phase":"현행","functionIds":[],"sourceRefs":[{"path":"CODEX.md","ref":"기존 자재·등록정보·기준자료 준비와 ERP Phase 2 결정"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-22·M-30·M-78~80"},{"path":"docs/23_업무규칙장부.md","ref":"자재-13·단계-08·단계-09·단계-10·단계-16·자료-02·자료-04"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"2장 접수·대조·주석 / 6장 자재·기준 자료"}],"workflowId":"WF02","originalStepId":"WF02_A10","actorDetail":"QS팀·개발부","sourceSteps":[],"level":"context","scope":null}</bpmn:documentation>
      <bpmn:outgoing>WF02_AFA10</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="WF02_A01" name="요청에 필요한 자재 조건을 확인한다">
      <bpmn:documentation>알려진 자재 종류·규격·기존 코드로 찾을 조건을 정한다.
입력 자료: 대상 자재와 작업의뢰·변경 요청
전달 자료: 품목·대상 자재와 이번 요청에서 요구한 자재 조건</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀","scope":null}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"대상 자재와 작업의뢰·변경 요청","outputs":"품목·대상 자재와 이번 요청에서 요구한 자재 조건","businessRules":[],"approvedQuestionIds":[],"perspective":"asis","phase":"현행","functionIds":[],"sourceRefs":[{"path":"CODEX.md","ref":"기존 자재·등록정보·기준자료 준비와 ERP Phase 2 결정"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-22·M-30·M-78~80"},{"path":"docs/23_업무규칙장부.md","ref":"자재-13·단계-08·단계-09·단계-10·단계-16·자료-02·자료-04"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"2장 접수·대조·주석 / 6장 자재·기준 자료"}],"workflowId":"WF02","originalStepId":"WF02_A01","actorDetail":"QS팀","sourceSteps":[],"level":"context","scope":null}</bpmn:documentation>
      <bpmn:incoming>WF02_AFA09</bpmn:incoming>
      <bpmn:outgoing>WF02_AF01</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="J_WF02_A05" name="경로 합류" gatewayDirection="Converging">
      <bpmn:documentation>해당 경로의 업무 결과를 이어 받는다.
입력 자료: 문안·허가증·시방서·칼선·참고 Artwork
전달 자료: 문안·허가증·시방서·칼선·참고 Artwork</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"문안·허가증·시방서·칼선·참고 Artwork","outputs":"문안·허가증·시방서·칼선·참고 Artwork","gatewayDirection":"Converging","gatewayMeaning":"경로 합류","perspective":"asis","workflowId":"WF02","originalStepId":"WF02_A05"}</bpmn:documentation>
      <bpmn:incoming>WF02_AF04</bpmn:incoming>
      <bpmn:incoming>WF02_AF05</bpmn:incoming>
      <bpmn:incoming>WF02_AFA10</bpmn:incoming>
      <bpmn:outgoing>WF02_A_JOIN_WF02_A05</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="WF02_A02" name="사용할 기존 자재와 도안·규격을 찾는다">
      <bpmn:documentation>동일하거나 참고할 규격의 사용 중 자재와 최신 승인 Artwork·시방서·칼선을 확인한다.
입력 자료: 기존 자재와 관련 파일
전달 자료: 사용 여부를 검토할 기존 자재정보, 승인 Artwork와 규격 자료</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀","scope":null}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"기존 자재와 관련 파일","outputs":"사용 여부를 검토할 기존 자재정보, 승인 Artwork와 규격 자료","businessRules":[],"approvedQuestionIds":[],"perspective":"asis","phase":"현행","functionIds":[],"sourceRefs":[{"path":"CODEX.md","ref":"기존 자재·등록정보·기준자료 준비와 ERP Phase 2 결정"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-22·M-30·M-78~80"},{"path":"docs/23_업무규칙장부.md","ref":"자재-13·단계-08·단계-09·단계-10·단계-16·자료-02·자료-04"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"2장 접수·대조·주석 / 6장 자재·기준 자료"}],"workflowId":"WF02","originalStepId":"WF02_A02","actorDetail":"QS팀","sourceSteps":[],"level":"context","scope":null}</bpmn:documentation>
      <bpmn:incoming>WF02_AF01</bpmn:incoming>
      <bpmn:outgoing>WF02_AF02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="WF02_A05" name="현재 확보한 제작·검토 기준자료를 모은다">
      <bpmn:documentation>사용할 자료를 모으고 기준이 서로 다르면 요청부서와 유효한 내용을 확인한다.
입력 자료: 문안·허가증·시방서·칼선·참고 Artwork
전달 자료: 해당 자재의 제작·검토에 사용할 확보된 문안, 허가증, 칼선·규격과 기존 Artwork</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀","scope":null}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"문안·허가증·시방서·칼선·참고 Artwork","outputs":"해당 자재의 제작·검토에 사용할 확보된 문안, 허가증, 칼선·규격과 기존 Artwork","businessRules":[],"approvedQuestionIds":[],"perspective":"asis","phase":"현행","functionIds":[],"sourceRefs":[{"path":"CODEX.md","ref":"기존 자재·등록정보·기준자료 준비와 ERP Phase 2 결정"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-22·M-30·M-78~80"},{"path":"docs/23_업무규칙장부.md","ref":"자재-13·단계-08·단계-09·단계-10·단계-16·자료-02·자료-04"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"2장 접수·대조·주석 / 6장 자재·기준 자료"}],"workflowId":"WF02","originalStepId":"WF02_A05","actorDetail":"QS팀; 위탁 신규는 개발부와 함께","sourceSteps":[],"level":"context","scope":null}</bpmn:documentation>
      <bpmn:incoming>WF02_A_JOIN_WF02_A05</bpmn:incoming>
      <bpmn:outgoing>WF02_AF06</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="WF02_A03" name="그 자재를 그대로 사용할 수 있는가?" gatewayDirection="Diverging" default="WF02_AF04">
      <bpmn:documentation>재사용인지 신규 자재 등록·규격 변경이 필요한지 구분한다.
입력 자료: 요청 조건과 기존 자재
전달 자료: 재사용 또는 등록·변경</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀","scope":null}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"요청 조건과 기존 자재","outputs":"재사용 또는 등록·변경","gatewayDirection":"Diverging","businessRules":[],"gatewayMeaning":"하나 선택","approvedQuestionIds":[],"perspective":"asis","phase":"현행","functionIds":[],"sourceRefs":[{"path":"CODEX.md","ref":"기존 자재·등록정보·기준자료 준비와 ERP Phase 2 결정"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-22·M-30·M-78~80"},{"path":"docs/23_업무규칙장부.md","ref":"자재-13·단계-08·단계-09·단계-10·단계-16·자료-02·자료-04"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"2장 접수·대조·주석 / 6장 자재·기준 자료"}],"workflowId":"WF02","originalStepId":"WF02_A03","actorDetail":"QS팀","sourceSteps":[],"level":"context","scope":null}</bpmn:documentation>
      <bpmn:incoming>WF02_AF02</bpmn:incoming>
      <bpmn:outgoing>WF02_AF03</bpmn:outgoing>
      <bpmn:outgoing>WF02_AF04</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="WF02_A06" name="기존 도안에 변경 지시를 먼저 달아야 하는가?" gatewayDirection="Diverging" default="WF02_AF08">
      <bpmn:documentation>기존 Artwork를 고치는 개정이면 변경할 위치와 유지할 부분을 먼저 확인한다.
입력 자료: 개정 요청과 변경 근거
전달 자료: 변경 주석 필요 여부</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀","scope":null}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"개정 요청과 변경 근거","outputs":"변경 주석 필요 여부","gatewayDirection":"Diverging","businessRules":[],"gatewayMeaning":"하나 선택","approvedQuestionIds":[],"perspective":"asis","phase":"현행","functionIds":[],"sourceRefs":[{"path":"CODEX.md","ref":"기존 자재·등록정보·기준자료 준비와 ERP Phase 2 결정"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-22·M-30·M-78~80"},{"path":"docs/23_업무규칙장부.md","ref":"자재-13·단계-08·단계-09·단계-10·단계-16·자료-02·자료-04"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"2장 접수·대조·주석 / 6장 자재·기준 자료"}],"workflowId":"WF02","originalStepId":"WF02_A06","actorDetail":"QS팀","sourceSteps":[],"level":"context","scope":null}</bpmn:documentation>
      <bpmn:incoming>WF02_AF06</bpmn:incoming>
      <bpmn:outgoing>WF02_AF07</bpmn:outgoing>
      <bpmn:outgoing>WF02_AF08</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="WF02_A04" name="신규 등록·규격 변경 업무를 연결한다">
      <bpmn:documentation>ERP 관련 등록 절차로 전달하고 등록된 자재정보를 받는다. ERP 내부 입력 절차는 이 흐름에서 다루지 않는다.
입력 자료: 새 자재 또는 달라진 규격
전달 자료: 신규 등록 또는 규격 변경을 마친 ERP 자재정보와 규격</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀","scope":null}</bpmn:documentation>
