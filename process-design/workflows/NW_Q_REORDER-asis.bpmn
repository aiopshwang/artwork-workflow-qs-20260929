<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="NW_Q_REORDER_A_Collaboration" name="발주할 자재와 파일을 최신 승인 Artwork와 비교한다 · 현재 업무">
    <bpmn:documentation>발주할 자재의 버전·변경 상태를 확인하거나 받은 파일을 최신 승인본과 비교한다.
입력 자료: 다음 발주 대상 자재, 요청된 버전·인쇄용 파일과 최신 승인 Artwork
전달 자료: 최신 승인본과의 비교 결과 및 버전·파일 수정 필요 여부</bpmn:documentation>
    <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"scope":{"parentNodeId":"Q_REORDER","start":"다음 자료를 받은 상태에서 시작한다: 다음 발주 대상 자재, 요청된 버전·인쇄용 파일과 최신 승인 Artwork","end":"이 업무에서 남길 내용: 최신 승인본과의 비교 결과 및 버전·파일 수정 필요 여부","inputs":"다음 발주 대상 자재, 요청된 버전·인쇄용 파일과 최신 승인 Artwork","outputs":"최신 승인본과의 비교 결과 및 버전·파일 수정 필요 여부","includes":["요청 자재·파일과 최신 승인본 확인","최신 개정·진행 중 변경 조회 또는 받은 파일의 공통 항목 대조","차이·구버전 가능성·수정 필요 내용 정리"],"excludes":["잘못된 파일 재요청과 회신 발송","Artwork 개정 업무 실행","실제 발주·입고·ERP 발주 이력 적재"]}}</bpmn:documentation>
    <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"다음 발주 대상 자재, 요청된 버전·인쇄용 파일과 최신 승인 Artwork","outputs":"최신 승인본과의 비교 결과 및 버전·파일 수정 필요 여부","perspective":"asis","sourceRefs":[{"path":"docs/20_회의록_2026-09-22.md","ref":"M-69·M-86 / 발주 전 버전 확인·위탁 문의"},{"path":"docs/22_URS원문.md","ref":"CF-01~03·CFE/CFN 발주 전 검수"},{"path":"docs/23_업무규칙장부.md","ref":"발주-06·발주-09·발주-11·발주-14·검건-03·차수-22·승인-07"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"T-07·T-15·C-14·C-17·B-18·B-19·B-45"},{"path":"CODEX.md","ref":"첫 발주와 반복 발주 / 외부 발주 정보·ERP 실제 이력 구분"}],"workflowId":"NW_Q_REORDER","sourceSteps":["WF10_A05","WF10_A06","WF10_A07","WF10_A08","WF10_T05","WF10_T06","WF10_T07","WF10_T08","WF10_T09"],"level":"node-detail","scope":{"parentNodeId":"Q_REORDER","start":"다음 자료를 받은 상태에서 시작한다: 다음 발주 대상 자재, 요청된 버전·인쇄용 파일과 최신 승인 Artwork","end":"이 업무에서 남길 내용: 최신 승인본과의 비교 결과 및 버전·파일 수정 필요 여부","inputs":"다음 발주 대상 자재, 요청된 버전·인쇄용 파일과 최신 승인 Artwork","outputs":"최신 승인본과의 비교 결과 및 버전·파일 수정 필요 여부","includes":["요청 자재·파일과 최신 승인본 확인","최신 개정·진행 중 변경 조회 또는 받은 파일의 공통 항목 대조","차이·구버전 가능성·수정 필요 내용 정리"],"excludes":["잘못된 파일 재요청과 회신 발송","Artwork 개정 업무 실행","실제 발주·입고·ERP 발주 이력 적재"]}}</bpmn:documentation>
    <bpmn:participant id="Participant_NW_Q_REORDER_A_Process" name="발주할 자재와 파일을 최신 승인 Artwork와 비교한다 · 현재 업무" processRef="NW_Q_REORDER_A_Process" />
  </bpmn:collaboration>
  <bpmn:process id="NW_Q_REORDER_A_Process" isExecutable="false">
    <bpmn:laneSet id="LaneSet_NW_Q_REORDER_A_Process">
      <bpmn:lane id="Lane_NW_Q_REORDER_A_Process_R0" name="QS팀">
        <bpmn:flowNodeRef>NW_Q_REORDER_A00</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NW_Q_REORDER_A01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NW_Q_REORDER_A02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NW_Q_REORDER_A03</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J_NW_Q_REORDER_A04</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NW_Q_REORDER_A04</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NW_Q_REORDER_A05</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="NW_Q_REORDER_A00" name="이 업무에 필요한 자료를 확인한다">
      <bpmn:documentation>상위 업무에서 전달받은 자료로 이 업무를 시작한다.
입력 자료: 다음 발주 대상 자재, 요청된 버전·인쇄용 파일과 최신 승인 Artwork
전달 자료: 다음 발주 대상 자재, 요청된 버전·인쇄용 파일과 최신 승인 Artwork</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀","scope":{"parentNodeId":"Q_REORDER","start":"다음 자료를 받은 상태에서 시작한다: 다음 발주 대상 자재, 요청된 버전·인쇄용 파일과 최신 승인 Artwork","end":"이 업무에서 남길 내용: 최신 승인본과의 비교 결과 및 버전·파일 수정 필요 여부","inputs":"다음 발주 대상 자재, 요청된 버전·인쇄용 파일과 최신 승인 Artwork","outputs":"최신 승인본과의 비교 결과 및 버전·파일 수정 필요 여부","includes":["요청 자재·파일과 최신 승인본 확인","최신 개정·진행 중 변경 조회 또는 받은 파일의 공통 항목 대조","차이·구버전 가능성·수정 필요 내용 정리"],"excludes":["잘못된 파일 재요청과 회신 발송","Artwork 개정 업무 실행","실제 발주·입고·ERP 발주 이력 적재"]}}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"다음 발주 대상 자재, 요청된 버전·인쇄용 파일과 최신 승인 Artwork","outputs":"다음 발주 대상 자재, 요청된 버전·인쇄용 파일과 최신 승인 Artwork","businessRules":[],"approvedQuestionIds":[],"perspective":"asis","phase":"현행","functionIds":[],"sourceRefs":[{"path":"docs/20_회의록_2026-09-22.md","ref":"M-69·M-86 / 발주 전 버전 확인·위탁 문의"},{"path":"docs/22_URS원문.md","ref":"CF-01~03·CFE/CFN 발주 전 검수"},{"path":"docs/23_업무규칙장부.md","ref":"발주-06·발주-09·발주-11·발주-14·검건-03·차수-22·승인-07"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"T-07·T-15·C-14·C-17·B-18·B-19·B-45"},{"path":"CODEX.md","ref":"첫 발주와 반복 발주 / 외부 발주 정보·ERP 실제 이력 구분"}],"workflowId":"NW_Q_REORDER","originalStepId":"NW_Q_REORDER_A00","actorDetail":"QS팀","sourceSteps":["WF10_A05"],"level":"node-detail","scope":{"parentNodeId":"Q_REORDER","start":"다음 자료를 받은 상태에서 시작한다: 다음 발주 대상 자재, 요청된 버전·인쇄용 파일과 최신 승인 Artwork","end":"이 업무에서 남길 내용: 최신 승인본과의 비교 결과 및 버전·파일 수정 필요 여부","inputs":"다음 발주 대상 자재, 요청된 버전·인쇄용 파일과 최신 승인 Artwork","outputs":"최신 승인본과의 비교 결과 및 버전·파일 수정 필요 여부","includes":["요청 자재·파일과 최신 승인본 확인","최신 개정·진행 중 변경 조회 또는 받은 파일의 공통 항목 대조","차이·구버전 가능성·수정 필요 내용 정리"],"excludes":["잘못된 파일 재요청과 회신 발송","Artwork 개정 업무 실행","실제 발주·입고·ERP 발주 이력 적재"]}}</bpmn:documentation>
      <bpmn:outgoing>NW_Q_REORDER_AF01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="NW_Q_REORDER_A01" name="버전 조회인가, 받은 파일 비교인가?" gatewayDirection="Diverging" default="NW_Q_REORDER_AF03">
      <bpmn:documentation>요청 내용에 맞게 최신 개정 조회 또는 받은 파일 비교를 진행한다.
입력 자료: 다음 발주 대상 자재, 요청된 버전·인쇄용 파일과 최신 승인 Artwork
전달 자료: 이번 요청의 확인 방법</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀","scope":{"parentNodeId":"Q_REORDER","start":"다음 자료를 받은 상태에서 시작한다: 다음 발주 대상 자재, 요청된 버전·인쇄용 파일과 최신 승인 Artwork","end":"이 업무에서 남길 내용: 최신 승인본과의 비교 결과 및 버전·파일 수정 필요 여부","inputs":"다음 발주 대상 자재, 요청된 버전·인쇄용 파일과 최신 승인 Artwork","outputs":"최신 승인본과의 비교 결과 및 버전·파일 수정 필요 여부","includes":["요청 자재·파일과 최신 승인본 확인","최신 개정·진행 중 변경 조회 또는 받은 파일의 공통 항목 대조","차이·구버전 가능성·수정 필요 내용 정리"],"excludes":["잘못된 파일 재요청과 회신 발송","Artwork 개정 업무 실행","실제 발주·입고·ERP 발주 이력 적재"]}}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"다음 발주 대상 자재, 요청된 버전·인쇄용 파일과 최신 승인 Artwork","outputs":"이번 요청의 확인 방법","gatewayDirection":"Diverging","businessRules":[],"gatewayMeaning":"하나 선택","approvedQuestionIds":[],"perspective":"asis","phase":"현행","functionIds":[],"sourceRefs":[{"path":"docs/20_회의록_2026-09-22.md","ref":"M-69·M-86 / 발주 전 버전 확인·위탁 문의"},{"path":"docs/22_URS원문.md","ref":"CF-01~03·CFE/CFN 발주 전 검수"},{"path":"docs/23_업무규칙장부.md","ref":"발주-06·발주-09·발주-11·발주-14·검건-03·차수-22·승인-07"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"T-07·T-15·C-14·C-17·B-18·B-19·B-45"},{"path":"CODEX.md","ref":"첫 발주와 반복 발주 / 외부 발주 정보·ERP 실제 이력 구분"}],"workflowId":"NW_Q_REORDER","originalStepId":"NW_Q_REORDER_A01","actorDetail":"QS팀","sourceSteps":["WF10_A05"],"level":"node-detail","scope":{"parentNodeId":"Q_REORDER","start":"다음 자료를 받은 상태에서 시작한다: 다음 발주 대상 자재, 요청된 버전·인쇄용 파일과 최신 승인 Artwork","end":"이 업무에서 남길 내용: 최신 승인본과의 비교 결과 및 버전·파일 수정 필요 여부","inputs":"다음 발주 대상 자재, 요청된 버전·인쇄용 파일과 최신 승인 Artwork","outputs":"최신 승인본과의 비교 결과 및 버전·파일 수정 필요 여부","includes":["요청 자재·파일과 최신 승인본 확인","최신 개정·진행 중 변경 조회 또는 받은 파일의 공통 항목 대조","차이·구버전 가능성·수정 필요 내용 정리"],"excludes":["잘못된 파일 재요청과 회신 발송","Artwork 개정 업무 실행","실제 발주·입고·ERP 발주 이력 적재"]}}</bpmn:documentation>
