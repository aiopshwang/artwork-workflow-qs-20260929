  </bpmn:collaboration>
  <bpmn:process id="NW_Q_SCOPE_T_Process" isExecutable="false">
    <bpmn:laneSet id="LaneSet_NW_Q_SCOPE_T_Process">
      <bpmn:lane id="Lane_NW_Q_SCOPE_T_Process_R0" name="QS팀">
        <bpmn:flowNodeRef>NW_Q_SCOPE_T00</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NW_Q_SCOPE_T01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NW_Q_SCOPE_T02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NW_Q_SCOPE_T03</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NW_Q_SCOPE_T04</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_NW_Q_SCOPE_T_Process_R1" name="시스템">
        <bpmn:flowNodeRef>NW_Q_SCOPE_T01_SYS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NW_Q_SCOPE_T02_SYS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NW_Q_SCOPE_T03_SYS</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="NW_Q_SCOPE_T00" name="이 업무에 필요한 자료를 확인한다">
      <bpmn:documentation>상위 업무에서 전달받은 자료로 이 업무를 시작한다.
입력 자료: 작업의뢰서 또는 변경 요청, 대상 품목·자재 정보와 확보된 자료
전달 자료: 작업의뢰서 또는 변경 요청, 대상 품목·자재 정보와 확보된 자료</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀","scope":{"parentNodeId":"Q_SCOPE","start":"다음 자료를 받은 상태에서 시작한다: 작업의뢰서 또는 변경 요청, 대상 품목·자재 정보와 확보된 자료","end":"이 업무에서 남길 내용: 업무 유형, 대상 품목·표시자재, 요청 사유·적용 시점, 자재별 확보 자료와 추가로 필요한 자료","inputs":"작업의뢰서 또는 변경 요청, 대상 품목·자재 정보와 확보된 자료","outputs":"업무 유형, 대상 품목·표시자재, 요청 사유·적용 시점, 자재별 확보 자료와 추가로 필요한 자료","includes":["받은 요청의 품목·업무 내용·사유·적용 시점 확인","대상 표시자재 확인","자재별 확보 자료와 추가로 필요한 자료 정리"],"excludes":["전자결재 수행과 작업의뢰서 다운로드","기존 자재 검색·선정 및 ERP 등록","디자인 작업·Artwork 검토"]}}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"작업의뢰서 또는 변경 요청, 대상 품목·자재 정보와 확보된 자료","outputs":"작업의뢰서 또는 변경 요청, 대상 품목·자재 정보와 확보된 자료","businessRules":[],"approvedQuestionIds":[],"perspective":"tobe","phase":"Phase 1","functionIds":[],"sourceRefs":[{"path":"CODEX.md","ref":"현행 업무의 시작·대상 자재 확인: 사용자 승인 4단계"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-18·M-22·M-30·M-77·M-96"},{"path":"docs/22_URS원문.md","ref":"O-01·A-01·G-01"},{"path":"docs/23_업무규칙장부.md","ref":"접수-02·접수-04·접수-07·접수-08·접수-12·접수-13"}],"workflowId":"NW_Q_SCOPE","originalStepId":"NW_Q_SCOPE_T00","actorDetail":"QS팀","sourceSteps":["WF01_T01"],"level":"node-detail","scope":{"parentNodeId":"Q_SCOPE","start":"다음 자료를 받은 상태에서 시작한다: 작업의뢰서 또는 변경 요청, 대상 품목·자재 정보와 확보된 자료","end":"이 업무에서 남길 내용: 업무 유형, 대상 품목·표시자재, 요청 사유·적용 시점, 자재별 확보 자료와 추가로 필요한 자료","inputs":"작업의뢰서 또는 변경 요청, 대상 품목·자재 정보와 확보된 자료","outputs":"업무 유형, 대상 품목·표시자재, 요청 사유·적용 시점, 자재별 확보 자료와 추가로 필요한 자료","includes":["받은 요청의 품목·업무 내용·사유·적용 시점 확인","대상 표시자재 확인","자재별 확보 자료와 추가로 필요한 자료 정리"],"excludes":["전자결재 수행과 작업의뢰서 다운로드","기존 자재 검색·선정 및 ERP 등록","디자인 작업·Artwork 검토"]}}</bpmn:documentation>
      <bpmn:outgoing>NW_Q_SCOPE_TF01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="NW_Q_SCOPE_T01" name="받은 요청파일을 올리거나 등록된 파일을 고른다">
      <bpmn:documentation>이미 받은 요청자료를 업로드하거나 등록된 파일을 선택하고 품목·업무 유형·요청 내용을 입력한다. 새 검토 건 생성·중복 요청 편입은 이 상세에서 실행하지 않는다.
입력 자료: 작업의뢰서 또는 변경 요청, 대상 품목·자재 정보와 확보된 자료
전달 자료: QS가 등록·선택한 요청파일과 입력한 업무 내용</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀","scope":{"parentNodeId":"Q_SCOPE","start":"다음 자료를 받은 상태에서 시작한다: 작업의뢰서 또는 변경 요청, 대상 품목·자재 정보와 확보된 자료","end":"이 업무에서 남길 내용: 업무 유형, 대상 품목·표시자재, 요청 사유·적용 시점, 자재별 확보 자료와 추가로 필요한 자료","inputs":"작업의뢰서 또는 변경 요청, 대상 품목·자재 정보와 확보된 자료","outputs":"업무 유형, 대상 품목·표시자재, 요청 사유·적용 시점, 자재별 확보 자료와 추가로 필요한 자료","includes":["받은 요청의 품목·업무 내용·사유·적용 시점 확인","대상 표시자재 확인","자재별 확보 자료와 추가로 필요한 자료 정리"],"excludes":["전자결재 수행과 작업의뢰서 다운로드","기존 자재 검색·선정 및 ERP 등록","디자인 작업·Artwork 검토"]}}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"작업의뢰서 또는 변경 요청, 대상 품목·자재 정보와 확보된 자료","outputs":"QS가 등록·선택한 요청파일과 입력한 업무 내용","businessRules":[],"approvedQuestionIds":[],"perspective":"tobe","phase":"Phase 1","functionIds":["K-접수-01","K-접수-04","K-접수-02","K-접수-03","K-접수-05"],"sourceRefs":[{"path":"CODEX.md","ref":"현행 업무의 시작·대상 자재 확인: 사용자 승인 4단계"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-18·M-22·M-30·M-77·M-96"},{"path":"docs/22_URS원문.md","ref":"O-01·A-01·G-01"},{"path":"docs/23_업무규칙장부.md","ref":"접수-02·접수-04·접수-07·접수-08·접수-12·접수-13"}],"workflowId":"NW_Q_SCOPE","originalStepId":"NW_Q_SCOPE_T01","actorDetail":"QS팀","sourceSteps":["WF01_T01","WF01_T02"],"level":"node-detail","scope":{"parentNodeId":"Q_SCOPE","start":"다음 자료를 받은 상태에서 시작한다: 작업의뢰서 또는 변경 요청, 대상 품목·자재 정보와 확보된 자료","end":"이 업무에서 남길 내용: 업무 유형, 대상 품목·표시자재, 요청 사유·적용 시점, 자재별 확보 자료와 추가로 필요한 자료","inputs":"작업의뢰서 또는 변경 요청, 대상 품목·자재 정보와 확보된 자료","outputs":"업무 유형, 대상 품목·표시자재, 요청 사유·적용 시점, 자재별 확보 자료와 추가로 필요한 자료","includes":["받은 요청의 품목·업무 내용·사유·적용 시점 확인","대상 표시자재 확인","자재별 확보 자료와 추가로 필요한 자료 정리"],"excludes":["전자결재 수행과 작업의뢰서 다운로드","기존 자재 검색·선정 및 ERP 등록","디자인 작업·Artwork 검토"]}}</bpmn:documentation>
      <bpmn:incoming>NW_Q_SCOPE_TF01</bpmn:incoming>
      <bpmn:outgoing>NW_Q_SCOPE_T01_SYS_FLOW</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="NW_Q_SCOPE_T01_SYS" name="요청자료와 입력한 품목·업무 내용을 보여준다">
      <bpmn:documentation>시스템이 입력 내용과 첨부파일을 보관해 표시한다. 자료 종류·대상 제안이 있으면 제안으로 구분한다.
입력 자료: QS가 확인한 요청자료와 대상 품목
