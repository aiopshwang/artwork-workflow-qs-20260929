<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="NW_Q_SCOPE_T_Collaboration" name="Artwork 업무 요청 내용과 해당 품목의 대상 자재를 확인한다 · 도입 후 업무">
    <bpmn:documentation>받은 요청을 등록하고 품목·자재·자료 연결을 QS가 확인한다.
입력 자료: 작업의뢰서 또는 변경 요청, 대상 품목·자재 정보와 확보된 자료
전달 자료: 업무 유형, 대상 품목·표시자재, 요청 사유·적용 시점, 자재별 확보 자료와 추가로 필요한 자료</bpmn:documentation>
    <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"scope":{"parentNodeId":"Q_SCOPE","start":"다음 자료를 받은 상태에서 시작한다: 작업의뢰서 또는 변경 요청, 대상 품목·자재 정보와 확보된 자료","end":"이 업무에서 남길 내용: 업무 유형, 대상 품목·표시자재, 요청 사유·적용 시점, 자재별 확보 자료와 추가로 필요한 자료","inputs":"작업의뢰서 또는 변경 요청, 대상 품목·자재 정보와 확보된 자료","outputs":"업무 유형, 대상 품목·표시자재, 요청 사유·적용 시점, 자재별 확보 자료와 추가로 필요한 자료","includes":["받은 요청의 품목·업무 내용·사유·적용 시점 확인","대상 표시자재 확인","자재별 확보 자료와 추가로 필요한 자료 정리"],"excludes":["전자결재 수행과 작업의뢰서 다운로드","기존 자재 검색·선정 및 ERP 등록","디자인 작업·Artwork 검토"]}}</bpmn:documentation>
    <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"작업의뢰서 또는 변경 요청, 대상 품목·자재 정보와 확보된 자료","outputs":"업무 유형, 대상 품목·표시자재, 요청 사유·적용 시점, 자재별 확보 자료와 추가로 필요한 자료","perspective":"tobe","sourceRefs":[{"path":"CODEX.md","ref":"현행 업무의 시작·대상 자재 확인: 사용자 승인 4단계"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-18·M-22·M-30·M-77·M-96"},{"path":"docs/22_URS원문.md","ref":"O-01·A-01·G-01"},{"path":"docs/23_업무규칙장부.md","ref":"접수-02·접수-04·접수-07·접수-08·접수-12·접수-13"}],"workflowId":"NW_Q_SCOPE","sourceSteps":["WF01_A05","WF01_A03","WF01_A12","WF01_A06","WF01_T01","WF01_T02","WF01_T05","WF01_T08"],"level":"node-detail","scope":{"parentNodeId":"Q_SCOPE","start":"다음 자료를 받은 상태에서 시작한다: 작업의뢰서 또는 변경 요청, 대상 품목·자재 정보와 확보된 자료","end":"이 업무에서 남길 내용: 업무 유형, 대상 품목·표시자재, 요청 사유·적용 시점, 자재별 확보 자료와 추가로 필요한 자료","inputs":"작업의뢰서 또는 변경 요청, 대상 품목·자재 정보와 확보된 자료","outputs":"업무 유형, 대상 품목·표시자재, 요청 사유·적용 시점, 자재별 확보 자료와 추가로 필요한 자료","includes":["받은 요청의 품목·업무 내용·사유·적용 시점 확인","대상 표시자재 확인","자재별 확보 자료와 추가로 필요한 자료 정리"],"excludes":["전자결재 수행과 작업의뢰서 다운로드","기존 자재 검색·선정 및 ERP 등록","디자인 작업·Artwork 검토"]}}</bpmn:documentation>
