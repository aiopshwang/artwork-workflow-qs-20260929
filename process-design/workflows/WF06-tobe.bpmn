        <bpmn:flowNodeRef>WF06_T08_RESULT</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_WF06_T_Process_R1" name="시스템">
        <bpmn:flowNodeRef>WF06_T01_SYS_RESPONSE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF06_T02_SYS_RESPONSE</bpmn:flowNodeRef>
