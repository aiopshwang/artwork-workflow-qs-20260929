    <bpmn:exclusiveGateway id="J_WF06_T01" name="경로 합류" gatewayDirection="Converging">
      <bpmn:documentation>해당 경로의 업무 결과를 이어 받는다.
입력 자료: 새 Artwork와 수정 요청 이력
전달 자료: 새 Artwork와 수정 요청 이력</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"새 Artwork와 수정 요청 이력","outputs":"새 Artwork와 수정 요청 이력","gatewayDirection":"Converging","gatewayMeaning":"경로 합류","perspective":"tobe","workflowId":"WF06","originalStepId":"WF06_T01"}</bpmn:documentation>
      <bpmn:incoming>WF06_T00_START_FLOW</bpmn:incoming>
