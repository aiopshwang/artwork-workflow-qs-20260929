    <bpmn:userTask id="WF06_T01" name="수령본을 확인하고 새 검토 차수를 연다">
      <bpmn:documentation>같은 미완료 검토의 다음 차수로 시작한다. 완료된 개정은 새 개정으로 연결한다.
입력 자료: 새 Artwork와 수정 요청 이력
전달 자료: QS 담당자가 반영본 검토를 위해 시작한 해당 자재의 새 검토 차수</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀","scope":null}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"새 Artwork와 수정 요청 이력","outputs":"QS 담당자가 반영본 검토를 위해 시작한 해당 자재의 새 검토 차수","businessRules":[],"approvedQuestionIds":[],"perspective":"tobe","phase":"Phase 1","functionIds":["K-검토-02","B-02"],"sourceRefs":[{"path":"CODEX.md","ref":"사용자 인터뷰: 미반영 지적은 새 도안에 다시, 반영된 지적은 달지 않음"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-61"},{"path":"docs/23_업무규칙장부.md","ref":"수정-01·수정-02·차수-11·차수-14·자료-10·자료-11"},{"path":"docs/22_URS원문.md","ref":"CR-34·CR-35·CR-36"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"K-대조-11·12·15 / K-검토-02~05"}],"workflowId":"WF06","originalStepId":"WF06_T01","actorDetail":"QS 담당자","sourceSteps":[],"level":"context","scope":null}</bpmn:documentation>
      <bpmn:incoming>WF06_T_JOIN_WF06_T01</bpmn:incoming>
      <bpmn:outgoing>WF06_T01_SYS_RESPONSE_FLOW</bpmn:outgoing>
