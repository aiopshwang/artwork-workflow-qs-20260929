        <bpmn:flowNodeRef>WF06_T06_SYS_RESPONSE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF06_T08_SYS_RESPONSE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF06_T07_SYS_RESPONSE</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="WF06_T00" name="수정 요청의 반환본을 QS가 검토한다">
      <bpmn:documentation>해당 업무를 시작할 자료·요청을 받는다.
입력 자료: QS가 검토를 시작한 반영본
전달 자료: QS가 검토를 시작한 반영본</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀","scope":null}</bpmn:documentation>
