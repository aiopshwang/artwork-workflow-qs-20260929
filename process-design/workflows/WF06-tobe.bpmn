  <bpmn:collaboration id="WF06_T_Collaboration" name="이전 주석 반영과 새 오류 재검토 · 도입 후 업무">
    <bpmn:documentation>차수·판·주석을 연결하고 규칙 대조 후 QS가 반영 여부와 추가 지적을 확정한다.
입력 자료: QS가 검토를 시작한 반영본
전달 자료: 이전 지적별 반영 이력과 수정 요청 또는 다음 검토에 사용할 Artwork의 판·QS 확인 기록</bpmn:documentation>
    <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"QS가 검토를 시작한 반영본","outputs":"이전 지적별 반영 이력과 수정 요청 또는 다음 검토에 사용할 Artwork의 판·QS 확인 기록","perspective":"tobe","sourceRefs":[{"path":"CODEX.md","ref":"사용자 인터뷰: 미반영 지적은 새 도안에 다시, 반영된 지적은 달지 않음"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-61"},{"path":"docs/23_업무규칙장부.md","ref":"수정-01·수정-02·차수-11·차수-14·자료-10·자료-11"},{"path":"docs/22_URS원문.md","ref":"CR-34·CR-35·CR-36"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"K-대조-11·12·15 / K-검토-02~05"}],"workflowId":"WF06","sourceSteps":[],"level":"context","scope":null}</bpmn:documentation>
    <bpmn:participant id="Participant_WF06_T_Process" name="이전 주석 반영과 새 오류 재검토 · 도입 후 업무" processRef="WF06_T_Process" />
  </bpmn:collaboration>
  <bpmn:process id="WF06_T_Process" isExecutable="false">
    <bpmn:laneSet id="LaneSet_WF06_T_Process">
      <bpmn:lane id="Lane_WF06_T_Process_R0" name="QS팀">
        <bpmn:flowNodeRef>WF06_T00</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J_WF06_T01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF06_T01</bpmn:flowNodeRef>
