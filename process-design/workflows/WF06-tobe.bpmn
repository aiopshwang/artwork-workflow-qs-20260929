<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="WF06_T_Collaboration" name="이전 주석 반영과 새 오류 재검토 · 도입 후 업무">
    <bpmn:documentation>차수·판·주석을 연결하고 규칙 대조 후 QS가 반영 여부와 추가 지적을 확정한다.
입력 자료: QS가 검토를 시작한 반영본
전달 자료: 반영 이력과 다음 업무 기준판</bpmn:documentation>
    <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"QS가 검토를 시작한 반영본","outputs":"반영 이력과 다음 업무 기준판","perspective":"tobe","sourceRefs":[{"path":"CODEX.md","ref":"사용자 인터뷰: 미반영 지적은 새 도안에 다시, 반영된 지적은 달지 않음"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-61"},{"path":"docs/23_업무규칙장부.md","ref":"수정-01·수정-02·차수-11·차수-14·자료-10·자료-11"},{"path":"docs/22_URS원문.md","ref":"CR-34·CR-35·CR-36"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"K-대조-11·12·15 / K-검토-02~05"}],"workflowId":"WF06"}</bpmn:documentation>
    <bpmn:participant id="Participant_WF06_T_Process" name="이전 주석 반영과 새 오류 재검토 · 도입 후 업무" processRef="WF06_T_Process" />
  </bpmn:collaboration>
  <bpmn:process id="WF06_T_Process" isExecutable="false">
    <bpmn:laneSet id="LaneSet_WF06_T_Process">
      <bpmn:lane id="Lane_WF06_T_Process_R0" name="QS팀">
        <bpmn:flowNodeRef>WF06_T00</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J_WF06_T01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF06_T01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF06_T02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF06_T04</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF06_T05</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF06_T06</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF06_T08</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF06_T07</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF06_T08_RESULT</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_WF06_T_Process_R1" name="시스템">
        <bpmn:flowNodeRef>WF06_T03</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="WF06_T00" name="수정 요청의 반환본을 QS가 검토한다">
      <bpmn:documentation>해당 업무를 시작할 자료·요청을 받는다.
입력 자료: QS가 검토를 시작한 반영본
전달 자료: QS가 검토를 시작한 반영본</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"QS가 검토를 시작한 반영본","outputs":"QS가 검토를 시작한 반영본","businessRules":[],"perspective":"tobe","phase":"Phase 1","functionIds":[],"sourceRefs":[{"path":"CODEX.md","ref":"사용자 인터뷰: 미반영 지적은 새 도안에 다시, 반영된 지적은 달지 않음"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-61"},{"path":"docs/23_업무규칙장부.md","ref":"수정-01·수정-02·차수-11·차수-14·자료-10·자료-11"},{"path":"docs/22_URS원문.md","ref":"CR-34·CR-35·CR-36"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"K-대조-11·12·15 / K-검토-02~05"}],"workflowId":"WF06","originalStepId":"WF06_T00","actorDetail":"QS 담당자"}</bpmn:documentation>
      <bpmn:outgoing>WF06_T00_START_FLOW</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="J_WF06_T01" name="경로 합류" gatewayDirection="Converging">
      <bpmn:documentation>해당 경로의 업무 결과를 이어 받는다.
입력 자료: 새 Artwork와 수정 요청 이력
전달 자료: 새 Artwork와 수정 요청 이력</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"새 Artwork와 수정 요청 이력","outputs":"새 Artwork와 수정 요청 이력","gatewayDirection":"Converging","gatewayMeaning":"경로 합류","perspective":"tobe","workflowId":"WF06","originalStepId":"WF06_T01"}</bpmn:documentation>
      <bpmn:incoming>WF06_T00_START_FLOW</bpmn:incoming>
      <bpmn:incoming>WF06_TF07</bpmn:incoming>
      <bpmn:outgoing>WF06_T_JOIN_WF06_T01</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="WF06_T01" name="수령본을 확인하고 새 검토 차수를 연다">
      <bpmn:documentation>같은 미완료 검토의 다음 차수로 시작한다. 완료된 개정은 새 개정으로 연결한다.
입력 자료: 새 Artwork와 수정 요청 이력
전달 자료: 반영 검토 차수</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"새 Artwork와 수정 요청 이력","outputs":"반영 검토 차수","businessRules":[],"perspective":"tobe","phase":"Phase 1","functionIds":["K-검토-02","B-02"],"sourceRefs":[{"path":"CODEX.md","ref":"사용자 인터뷰: 미반영 지적은 새 도안에 다시, 반영된 지적은 달지 않음"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-61"},{"path":"docs/23_업무규칙장부.md","ref":"수정-01·수정-02·차수-11·차수-14·자료-10·자료-11"},{"path":"docs/22_URS원문.md","ref":"CR-34·CR-35·CR-36"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"K-대조-11·12·15 / K-검토-02~05"}],"workflowId":"WF06","originalStepId":"WF06_T01","actorDetail":"QS 담당자"}</bpmn:documentation>
      <bpmn:incoming>WF06_T_JOIN_WF06_T01</bpmn:incoming>
      <bpmn:outgoing>WF06_TF01</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="WF06_T02" name="직전 차수·주석·기준자료를 연결한다">
      <bpmn:documentation>비교할 판과 주석을 고정하고 기준자료 변경 여부를 확인한다.
입력 자료: 이전 차수와 이번 파일
전달 자료: 차수별 비교 기준</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"이전 차수와 이번 파일","outputs":"차수별 비교 기준","businessRules":[],"perspective":"tobe","phase":"Phase 1","functionIds":["K-대조-02","K-검토-03"],"sourceRefs":[{"path":"CODEX.md","ref":"사용자 인터뷰: 미반영 지적은 새 도안에 다시, 반영된 지적은 달지 않음"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-61"},{"path":"docs/23_업무규칙장부.md","ref":"수정-01·수정-02·차수-11·차수-14·자료-10·자료-11"},{"path":"docs/22_URS원문.md","ref":"CR-34·CR-35·CR-36"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"K-대조-11·12·15 / K-검토-02~05"}],"workflowId":"WF06","originalStepId":"WF06_T02","actorDetail":"QS 담당자"}</bpmn:documentation>
      <bpmn:incoming>WF06_TF01</bpmn:incoming>
      <bpmn:outgoing>WF06_TF02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="WF06_T03" name="주석 반영과 도안 변경을 대조한다">
      <bpmn:documentation>이전 요청 반영·요청 밖 변경·구버전 작업 가능성을 표시한다. 적용 점검을 다시 실행해 새 오류도 찾는다.
입력 자료: 확인한 판독값·두 판·이전 주석
전달 자료: 반영 상태·변경 위치·새 검출</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"시스템"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"확인한 판독값·두 판·이전 주석","outputs":"반영 상태·변경 위치·새 검출","businessRules":[],"perspective":"tobe","phase":"Phase 1","functionIds":["K-대조-11","K-대조-12","K-대조-15","K-대조-06"],"sourceRefs":[{"path":"CODEX.md","ref":"사용자 인터뷰: 미반영 지적은 새 도안에 다시, 반영된 지적은 달지 않음"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-61"},{"path":"docs/23_업무규칙장부.md","ref":"수정-01·수정-02·차수-11·차수-14·자료-10·자료-11"},{"path":"docs/22_URS원문.md","ref":"CR-34·CR-35·CR-36"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"K-대조-11·12·15 / K-검토-02~05"}],"workflowId":"WF06","originalStepId":"WF06_T03","actorDetail":"시스템"}</bpmn:documentation>
      <bpmn:incoming>WF06_TF02</bpmn:incoming>
      <bpmn:outgoing>WF06_TF03</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="WF06_T04" name="각 지적의 반영 상태와 새 검출을 확인한다">
      <bpmn:documentation>규칙 결과와 원문을 보고 반영·미반영·부분반영을 확인한다. AI 의견은 제안으로 참고한다.
입력 자료: 규칙 결과와 두 판
전달 자료: QS가 확인한 반영 상태</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"규칙 결과와 두 판","outputs":"QS가 확인한 반영 상태","businessRules":[],"perspective":"tobe","phase":"Phase 1","functionIds":["K-검토-04","K-검토-06","K-에이전트-06"],"sourceRefs":[{"path":"CODEX.md","ref":"사용자 인터뷰: 미반영 지적은 새 도안에 다시, 반영된 지적은 달지 않음"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-61"},{"path":"docs/23_업무규칙장부.md","ref":"수정-01·수정-02·차수-11·차수-14·자료-10·자료-11"},{"path":"docs/22_URS원문.md","ref":"CR-34·CR-35·CR-36"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"K-대조-11·12·15 / K-검토-02~05"}],"workflowId":"WF06","originalStepId":"WF06_T04","actorDetail":"QS 담당자"}</bpmn:documentation>
      <bpmn:incoming>WF06_TF03</bpmn:incoming>
      <bpmn:outgoing>WF06_TF04</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="WF06_T05" name="다시 전달할 수정이 있는가?" gatewayDirection="Diverging" default="WF06_TF08">
      <bpmn:documentation>미반영 지적이나 새 수정이 있으면 다음 주석으로 넘긴다.
입력 자료: 반영 상태와 새 오류
전달 자료: 수정 전달 여부</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"반영 상태와 새 오류","outputs":"수정 전달 여부","gatewayDirection":"Diverging","businessRules":[],"gatewayMeaning":"하나 선택","perspective":"tobe","phase":"Phase 1","functionIds":["K-검토-05"],"sourceRefs":[{"path":"CODEX.md","ref":"사용자 인터뷰: 미반영 지적은 새 도안에 다시, 반영된 지적은 달지 않음"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-61"},{"path":"docs/23_업무규칙장부.md","ref":"수정-01·수정-02·차수-11·차수-14·자료-10·자료-11"},{"path":"docs/22_URS원문.md","ref":"CR-34·CR-35·CR-36"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"K-대조-11·12·15 / K-검토-02~05"}],"workflowId":"WF06","originalStepId":"WF06_T05","actorDetail":"QS 담당자"}</bpmn:documentation>
      <bpmn:incoming>WF06_TF04</bpmn:incoming>
      <bpmn:outgoing>WF06_TF05</bpmn:outgoing>
      <bpmn:outgoing>WF06_TF08</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="WF06_T06" name="미반영 지적을 새 도안에 이어 붙인다">
      <bpmn:documentation>반영된 지적은 전달 목록에서 제외하고 미반영 지적은 연결 이력을 유지한다. 지시를 바꾸면 이전 지시의 대체 관계를 남긴다.
입력 자료: 남은 요청·새 지적과 위치
전달 자료: 새 도안의 주석과 이어진 지적</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"남은 요청·새 지적과 위치","outputs":"새 도안의 주석과 이어진 지적","businessRules":[],"perspective":"tobe","phase":"Phase 1","functionIds":["K-주석-01","K-주석-03","K-검토-05"],"sourceRefs":[{"path":"CODEX.md","ref":"사용자 인터뷰: 미반영 지적은 새 도안에 다시, 반영된 지적은 달지 않음"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-61"},{"path":"docs/23_업무규칙장부.md","ref":"수정-01·수정-02·차수-11·차수-14·자료-10·자료-11"},{"path":"docs/22_URS원문.md","ref":"CR-34·CR-35·CR-36"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"K-대조-11·12·15 / K-검토-02~05"}],"workflowId":"WF06","originalStepId":"WF06_T06","actorDetail":"QS 담당자"}</bpmn:documentation>
      <bpmn:incoming>WF06_TF05</bpmn:incoming>
      <bpmn:outgoing>WF06_TF06</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="WF06_T08" name="후속 검토에 사용할 판을 남긴다">
      <bpmn:documentation>어느 차수의 파일로 후속 검토하는지 연결한다. 파일 수령이나 지적 해소만으로 최종 승인을 만들지 않는다.
입력 자료: 이번 차수의 결과
전달 자료: 후속 검토 기준판</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"이번 차수의 결과","outputs":"후속 검토 기준판","businessRules":[],"perspective":"tobe","phase":"Phase 1","functionIds":["K-검토-03","K-검토-12"],"sourceRefs":[{"path":"CODEX.md","ref":"사용자 인터뷰: 미반영 지적은 새 도안에 다시, 반영된 지적은 달지 않음"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-61"},{"path":"docs/23_업무규칙장부.md","ref":"수정-01·수정-02·차수-11·차수-14·자료-10·자료-11"},{"path":"docs/22_URS원문.md","ref":"CR-34·CR-35·CR-36"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"K-대조-11·12·15 / K-검토-02~05"}],"workflowId":"WF06","originalStepId":"WF06_T08","actorDetail":"QS 담당자"}</bpmn:documentation>
      <bpmn:incoming>WF06_TF08</bpmn:incoming>
      <bpmn:outgoing>WF06_T08_END_FLOW</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="WF06_T07" name="차수를 마감하고 새 수정 요청을 전달한다">
      <bpmn:documentation>디자인팀 받은 일로 넘기고 새 파일이 오면 QS가 다음 검토를 시작한다.
입력 자료: 확인한 주석·반영 요약
