    <bpmn:userTask id="WF06_T02" name="직전 차수·주석·기준자료를 연결한다">
      <bpmn:documentation>비교할 판과 주석을 고정하고 기준자료 변경 여부를 확인한다.
입력 자료: 이전 차수와 이번 파일
전달 자료: 현재 검토 차수에 연결한 직전 Artwork·주석본과 적용 문안·허가증 등 비교 자료</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀","scope":null}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"이전 차수와 이번 파일","outputs":"현재 검토 차수에 연결한 직전 Artwork·주석본과 적용 문안·허가증 등 비교 자료","businessRules":[],"approvedQuestionIds":[],"perspective":"tobe","phase":"Phase 1","functionIds":["K-대조-02","K-검토-03"],"sourceRefs":[{"path":"CODEX.md","ref":"사용자 인터뷰: 미반영 지적은 새 도안에 다시, 반영된 지적은 달지 않음"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-61"},{"path":"docs/23_업무규칙장부.md","ref":"수정-01·수정-02·차수-11·차수-14·자료-10·자료-11"},{"path":"docs/22_URS원문.md","ref":"CR-34·CR-35·CR-36"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"K-대조-11·12·15 / K-검토-02~05"}],"workflowId":"WF06","originalStepId":"WF06_T02","actorDetail":"QS 담당자","sourceSteps":[],"level":"context","scope":null}</bpmn:documentation>
