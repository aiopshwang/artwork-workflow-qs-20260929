    </bpmn:userTask>
    <bpmn:serviceTask id="WF06_T04_SYS_RESPONSE" name="QS가 확인한 지적별 반영 상태와 새 오류를 기록한다">
      <bpmn:documentation>규칙 대조 결과와 별도로 담당자가 확인한 반영·미반영·부분반영 및 새 오류를 저장한다.
입력 자료: QS 담당자가 원문을 보고 확인한 이전 지적의 반영 상태와 새 오류
전달 자료: QS 담당자가 원문을 보고 확인한 이전 지적의 반영 상태와 새 오류</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"시스템","scope":null}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"QS 담당자가 원문을 보고 확인한 이전 지적의 반영 상태와 새 오류","outputs":"QS 담당자가 원문을 보고 확인한 이전 지적의 반영 상태와 새 오류","businessRules":[],"approvedQuestionIds":[],"perspective":"tobe","phase":"Phase 1","functionIds":["K-검토-04","K-검토-06","K-에이전트-06"],"sourceRefs":[{"path":"CODEX.md","ref":"사용자 인터뷰: 미반영 지적은 새 도안에 다시, 반영된 지적은 달지 않음"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-61"},{"path":"docs/23_업무규칙장부.md","ref":"수정-01·수정-02·차수-11·차수-14·자료-10·자료-11"},{"path":"docs/22_URS원문.md","ref":"CR-34·CR-35·CR-36"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"K-대조-11·12·15 / K-검토-02~05"}],"workflowId":"WF06","originalStepId":"WF06_T04_SYS_RESPONSE","actorDetail":"Artwork 시스템","sourceSteps":["WF06_T04"],"level":"context","scope":null}</bpmn:documentation>
