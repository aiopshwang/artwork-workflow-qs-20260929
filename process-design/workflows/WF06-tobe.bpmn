    <bpmn:serviceTask id="WF06_T03" name="주석 반영과 도안 변경을 대조한다">
      <bpmn:documentation>이전 요청 반영·요청 밖 변경·구버전 작업 가능성을 표시한다. 적용 점검을 다시 실행해 새 오류도 찾는다.
입력 자료: 확인한 판독값·두 판·이전 주석
전달 자료: 이전 주석별 반영 대조 결과, 도안의 변경 위치와 새로 검출한 차이</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"시스템","scope":null}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"확인한 판독값·두 판·이전 주석","outputs":"이전 주석별 반영 대조 결과, 도안의 변경 위치와 새로 검출한 차이","businessRules":[],"approvedQuestionIds":[],"perspective":"tobe","phase":"Phase 1","functionIds":["K-대조-11","K-대조-12","K-대조-15","K-대조-06"],"sourceRefs":[{"path":"CODEX.md","ref":"사용자 인터뷰: 미반영 지적은 새 도안에 다시, 반영된 지적은 달지 않음"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-61"},{"path":"docs/23_업무규칙장부.md","ref":"수정-01·수정-02·차수-11·차수-14·자료-10·자료-11"},{"path":"docs/22_URS원문.md","ref":"CR-34·CR-35·CR-36"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"K-대조-11·12·15 / K-검토-02~05"}],"workflowId":"WF06","originalStepId":"WF06_T03","actorDetail":"Artwork 시스템","sourceSteps":[],"level":"context","scope":null}</bpmn:documentation>
      <bpmn:incoming>WF06_TF02</bpmn:incoming>
      <bpmn:outgoing>WF06_TF03</bpmn:outgoing>
