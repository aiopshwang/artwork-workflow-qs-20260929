    <bpmn:userTask id="WF06_T06" name="미반영 지적을 새 도안에 이어 붙인다">
      <bpmn:documentation>반영된 지적은 전달 목록에서 제외하고 미반영 지적은 연결 이력을 유지한다. 지시를 바꾸면 이전 지시의 대체 관계를 남긴다.
입력 자료: 남은 요청·새 지적과 위치
전달 자료: 새 Artwork의 해당 위치에 이어 붙인 미반영 지적과 이전 주석의 연결 이력</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀","scope":null}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"남은 요청·새 지적과 위치","outputs":"새 Artwork의 해당 위치에 이어 붙인 미반영 지적과 이전 주석의 연결 이력","businessRules":[],"approvedQuestionIds":[],"perspective":"tobe","phase":"Phase 1","functionIds":["K-주석-01","K-주석-03","K-검토-05"],"sourceRefs":[{"path":"CODEX.md","ref":"사용자 인터뷰: 미반영 지적은 새 도안에 다시, 반영된 지적은 달지 않음"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-61"},{"path":"docs/23_업무규칙장부.md","ref":"수정-01·수정-02·차수-11·차수-14·자료-10·자료-11"},{"path":"docs/22_URS원문.md","ref":"CR-34·CR-35·CR-36"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"K-대조-11·12·15 / K-검토-02~05"}],"workflowId":"WF06","originalStepId":"WF06_T06","actorDetail":"QS 담당자","sourceSteps":[],"level":"context","scope":null}</bpmn:documentation>
