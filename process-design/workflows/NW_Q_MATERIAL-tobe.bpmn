<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="NW_Q_MATERIAL_T_Collaboration" name="사용할 자재와 기존 승인 Artwork·규격을 확인한다 · 도입 후 업무">
    <bpmn:documentation>해당 업무에서 사용할 시스템 지원과 담당자의 확인
입력 자료: 대상 자재, 기존 등록 정보와 승인 Artwork·규격
전달 자료: 사용할 자재와 승인본·규격, 신규 등록 또는 규격 변경 필요 여부</bpmn:documentation>
    <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"scope":{"parentNodeId":"Q_MATERIAL","start":"상위 흐름에서 아래 입력 자료를 받은 때","end":"아래 결과를 정리하여 상위 흐름의 다음 업무에 전달한 때","inputs":"대상 자재, 기존 등록 정보와 승인 Artwork·규격","outputs":"사용할 자재와 승인본·규격, 신규 등록 또는 규격 변경 필요 여부","includes":["대상 자재의 기존 규격·승인본 확인","같은 규격 또는 유사 규격 검색","사용할 기존 자재 선택과 등록 필요 구분"],"excludes":["ERP 등록 실행","디자인 전달 자료 취합","위탁 신규에 기존 자재 검색 강제"]}}</bpmn:documentation>
    <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"대상 자재, 기존 등록 정보와 승인 Artwork·규격","outputs":"사용할 자재와 승인본·규격, 신규 등록 또는 규격 변경 필요 여부","perspective":"tobe","sourceRefs":[{"path":"docs/기능설계/조사_2026-09-25/08_기능지도_2판.md","ref":"K-접수-09·13·14·15 / B-34"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-31~40·M-78~80"},{"path":"docs/23_업무규칙장부.md","ref":"단계-36: 기존 자재 조회 1단계, 등록 절차 2단계"}],"workflowId":"NW_Q_MATERIAL","sourceSteps":["WF02_A01","WF02_A02","WF02_A03","WF02_T01","WF02_T02"],"level":"node-detail","scope":{"parentNodeId":"Q_MATERIAL","start":"상위 흐름에서 아래 입력 자료를 받은 때","end":"아래 결과를 정리하여 상위 흐름의 다음 업무에 전달한 때","inputs":"대상 자재, 기존 등록 정보와 승인 Artwork·규격","outputs":"사용할 자재와 승인본·규격, 신규 등록 또는 규격 변경 필요 여부","includes":["대상 자재의 기존 규격·승인본 확인","같은 규격 또는 유사 규격 검색","사용할 기존 자재 선택과 등록 필요 구분"],"excludes":["ERP 등록 실행","디자인 전달 자료 취합","위탁 신규에 기존 자재 검색 강제"]}}</bpmn:documentation>
    <bpmn:participant id="Participant_NW_Q_MATERIAL_T_Process" name="사용할 자재와 기존 승인 Artwork·규격을 확인한다 · 도입 후 업무" processRef="NW_Q_MATERIAL_T_Process" />
  </bpmn:collaboration>
  <bpmn:process id="NW_Q_MATERIAL_T_Process" isExecutable="false">
    <bpmn:laneSet id="LaneSet_NW_Q_MATERIAL_T_Process">
      <bpmn:lane id="Lane_NW_Q_MATERIAL_T_Process_R0" name="QS팀">
        <bpmn:flowNodeRef>NW_Q_MATERIAL_T00</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J_NW_Q_MATERIAL_T01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NW_Q_MATERIAL_T01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NW_Q_MATERIAL_T03</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NW_Q_MATERIAL_T04</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NW_Q_MATERIAL_T05</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NW_Q_MATERIAL_T08</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NW_Q_MATERIAL_T07</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_NW_Q_MATERIAL_T_Process_R1" name="시스템">
        <bpmn:flowNodeRef>NW_Q_MATERIAL_T02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NW_Q_MATERIAL_T06</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="NW_Q_MATERIAL_T00" name="대상 자재와 받은 자료를 확인한다">
      <bpmn:documentation>해당 자재의 이 업무를 시작할 자료를 받는다.
입력 자료: 대상 자재, 기존 등록 정보와 승인 Artwork·규격
전달 자료: 대상 자재, 기존 등록 정보와 승인 Artwork·규격</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀","scope":{"parentNodeId":"Q_MATERIAL","start":"상위 흐름에서 아래 입력 자료를 받은 때","end":"아래 결과를 정리하여 상위 흐름의 다음 업무에 전달한 때","inputs":"대상 자재, 기존 등록 정보와 승인 Artwork·규격","outputs":"사용할 자재와 승인본·규격, 신규 등록 또는 규격 변경 필요 여부","includes":["대상 자재의 기존 규격·승인본 확인","같은 규격 또는 유사 규격 검색","사용할 기존 자재 선택과 등록 필요 구분"],"excludes":["ERP 등록 실행","디자인 전달 자료 취합","위탁 신규에 기존 자재 검색 강제"]}}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"대상 자재, 기존 등록 정보와 승인 Artwork·규격","outputs":"대상 자재, 기존 등록 정보와 승인 Artwork·규격","businessRules":[],"approvedQuestionIds":[],"perspective":"tobe","phase":"Phase 1","functionIds":[],"sourceRefs":[{"path":"docs/기능설계/조사_2026-09-25/08_기능지도_2판.md","ref":"K-접수-09·13·14·15 / B-34"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-31~40·M-78~80"},{"path":"docs/23_업무규칙장부.md","ref":"단계-36: 기존 자재 조회 1단계, 등록 절차 2단계"}],"workflowId":"NW_Q_MATERIAL","originalStepId":"NW_Q_MATERIAL_T00","actorDetail":"QS팀","sourceSteps":[],"level":"node-detail","scope":{"parentNodeId":"Q_MATERIAL","start":"상위 흐름에서 아래 입력 자료를 받은 때","end":"아래 결과를 정리하여 상위 흐름의 다음 업무에 전달한 때","inputs":"대상 자재, 기존 등록 정보와 승인 Artwork·규격","outputs":"사용할 자재와 승인본·규격, 신규 등록 또는 규격 변경 필요 여부","includes":["대상 자재의 기존 규격·승인본 확인","같은 규격 또는 유사 규격 검색","사용할 기존 자재 선택과 등록 필요 구분"],"excludes":["ERP 등록 실행","디자인 전달 자료 취합","위탁 신규에 기존 자재 검색 강제"]}}</bpmn:documentation>
      <bpmn:outgoing>NW_Q_MATERIAL_TF01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="J_NW_Q_MATERIAL_T01" name="경로 합류" gatewayDirection="Converging">
      <bpmn:documentation>해당 경로의 업무 결과를 이어 받는다.
입력 자료: 대상 품목·자재와 규격
전달 자료: 대상 품목·자재와 규격</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"대상 품목·자재와 규격","outputs":"대상 품목·자재와 규격","gatewayDirection":"Converging","gatewayMeaning":"경로 합류","perspective":"tobe","workflowId":"NW_Q_MATERIAL","originalStepId":"NW_Q_MATERIAL_T01"}</bpmn:documentation>
      <bpmn:incoming>NW_Q_MATERIAL_TF01</bpmn:incoming>
      <bpmn:incoming>NW_Q_MATERIAL_TF05</bpmn:incoming>
      <bpmn:outgoing>NW_Q_MATERIAL_T_JOIN_NW_Q_MATERIAL_T01</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="NW_Q_MATERIAL_T01" name="자재코드·이름 또는 필요한 규격을 입력해 찾는다">
      <bpmn:documentation>QS가 조회할 자재코드·이름·규격을 입력한다. 개정은 변경 대상 자재부터 찾는다.
입력 자료: 대상 품목·자재와 규격
전달 자료: 조회 조건</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀","scope":{"parentNodeId":"Q_MATERIAL","start":"상위 흐름에서 아래 입력 자료를 받은 때","end":"아래 결과를 정리하여 상위 흐름의 다음 업무에 전달한 때","inputs":"대상 자재, 기존 등록 정보와 승인 Artwork·규격","outputs":"사용할 자재와 승인본·규격, 신규 등록 또는 규격 변경 필요 여부","includes":["대상 자재의 기존 규격·승인본 확인","같은 규격 또는 유사 규격 검색","사용할 기존 자재 선택과 등록 필요 구분"],"excludes":["ERP 등록 실행","디자인 전달 자료 취합","위탁 신규에 기존 자재 검색 강제"]}}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"대상 품목·자재와 규격","outputs":"조회 조건","businessRules":[],"approvedQuestionIds":[],"perspective":"tobe","phase":"Phase 1","functionIds":["K-접수-09","K-접수-13"],"sourceRefs":[{"path":"docs/기능설계/조사_2026-09-25/08_기능지도_2판.md","ref":"K-접수-09·13·14·15 / B-34"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-31~40·M-78~80"},{"path":"docs/23_업무규칙장부.md","ref":"단계-36: 기존 자재 조회 1단계, 등록 절차 2단계"}],"workflowId":"NW_Q_MATERIAL","originalStepId":"NW_Q_MATERIAL_T01","actorDetail":"QS팀","sourceSteps":[],"level":"node-detail","scope":{"parentNodeId":"Q_MATERIAL","start":"상위 흐름에서 아래 입력 자료를 받은 때","end":"아래 결과를 정리하여 상위 흐름의 다음 업무에 전달한 때","inputs":"대상 자재, 기존 등록 정보와 승인 Artwork·규격","outputs":"사용할 자재와 승인본·규격, 신규 등록 또는 규격 변경 필요 여부","includes":["대상 자재의 기존 규격·승인본 확인","같은 규격 또는 유사 규격 검색","사용할 기존 자재 선택과 등록 필요 구분"],"excludes":["ERP 등록 실행","디자인 전달 자료 취합","위탁 신규에 기존 자재 검색 강제"]}}</bpmn:documentation>
      <bpmn:incoming>NW_Q_MATERIAL_T_JOIN_NW_Q_MATERIAL_T01</bpmn:incoming>
      <bpmn:outgoing>NW_Q_MATERIAL_TF02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="NW_Q_MATERIAL_T02" name="조건에 맞는 기존 자재와 규격을 보여준다">
      <bpmn:documentation>시스템은 등록된 자재와 규격을 조회한다. 같은 규격과 비슷한 규격을 구분하여 보여준다.
입력 자료: QS가 정한 조회 조건
전달 자료: 자재별 규격·기존 승인본 조회 결과
업무 규칙: 비슷한 규격의 허용차는 QS팀 확정 전 잠정 기준이다.</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"시스템","scope":{"parentNodeId":"Q_MATERIAL","start":"상위 흐름에서 아래 입력 자료를 받은 때","end":"아래 결과를 정리하여 상위 흐름의 다음 업무에 전달한 때","inputs":"대상 자재, 기존 등록 정보와 승인 Artwork·규격","outputs":"사용할 자재와 승인본·규격, 신규 등록 또는 규격 변경 필요 여부","includes":["대상 자재의 기존 규격·승인본 확인","같은 규격 또는 유사 규격 검색","사용할 기존 자재 선택과 등록 필요 구분"],"excludes":["ERP 등록 실행","디자인 전달 자료 취합","위탁 신규에 기존 자재 검색 강제"]}}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"QS가 정한 조회 조건","outputs":"자재별 규격·기존 승인본 조회 결과","businessRules":["비슷한 규격의 허용차는 QS팀 확정 전 잠정 기준이다."],"approvedQuestionIds":[],"perspective":"tobe","phase":"Phase 1","functionIds":["K-접수-13","K-접수-14"],"sourceRefs":[{"path":"docs/기능설계/조사_2026-09-25/08_기능지도_2판.md","ref":"K-접수-09·13·14·15 / B-34"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-31~40·M-78~80"},{"path":"docs/23_업무규칙장부.md","ref":"단계-36: 기존 자재 조회 1단계, 등록 절차 2단계"}],"workflowId":"NW_Q_MATERIAL","originalStepId":"NW_Q_MATERIAL_T02","actorDetail":"Artwork 시스템","sourceSteps":[],"level":"node-detail","scope":{"parentNodeId":"Q_MATERIAL","start":"상위 흐름에서 아래 입력 자료를 받은 때","end":"아래 결과를 정리하여 상위 흐름의 다음 업무에 전달한 때","inputs":"대상 자재, 기존 등록 정보와 승인 Artwork·규격","outputs":"사용할 자재와 승인본·규격, 신규 등록 또는 규격 변경 필요 여부","includes":["대상 자재의 기존 규격·승인본 확인","같은 규격 또는 유사 규격 검색","사용할 기존 자재 선택과 등록 필요 구분"],"excludes":["ERP 등록 실행","디자인 전달 자료 취합","위탁 신규에 기존 자재 검색 강제"]}}</bpmn:documentation>
      <bpmn:incoming>NW_Q_MATERIAL_TF02</bpmn:incoming>
      <bpmn:outgoing>NW_Q_MATERIAL_TF03</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="NW_Q_MATERIAL_T03" name="자재의 규격과 승인 Artwork를 열어 확인한다">
      <bpmn:documentation>QS가 후보를 열어 필요한 규격과 승인 도안을 확인한다. 사용할 수 없는 후보를 자동 채택하지 않는다.
입력 자료: 검색된 자재·규격·승인본
