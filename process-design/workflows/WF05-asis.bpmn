    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="J_WF05_A03" name="경로 합류" gatewayDirection="Converging">
      <bpmn:documentation>해당 경로의 업무 결과를 이어 받는다.
입력 자료: 허가증 원본과 Artwork
전달 자료: 허가증 원본과 Artwork</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"허가증 원본과 Artwork","outputs":"허가증 원본과 Artwork","gatewayDirection":"Converging","gatewayMeaning":"경로 합류","perspective":"asis","workflowId":"WF05","originalStepId":"WF05_A03"}</bpmn:documentation>
