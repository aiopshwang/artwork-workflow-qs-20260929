        <bpmn:flowNodeRef>WF05_A09_RESULT</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="WF05_A_START1" name="시작">
      <bpmn:documentation>초안·수정본과 확보된 기준자료
입력 자료: 초안·수정본과 확보된 기준자료
전달 자료: 초안·수정본과 요청 내용</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"초안·수정본과 확보된 기준자료","outputs":"초안·수정본과 요청 내용","perspective":"asis","workflowId":"WF05"}</bpmn:documentation>
      <bpmn:outgoing>WF05_A_START_FLOW1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="WF05_A01" name="이번에 볼 Artwork와 검토 목적을 확인한다">
      <bpmn:documentation>해당 자재의 파일인지, 처음 보는 도안인지 어떤 변경을 검토하는지 확인한다.
입력 자료: 초안·수정본과 요청 내용
전달 자료: 이번 검토 대상 자재의 Artwork와 확인할 검토 목적</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀","scope":null}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"초안·수정본과 요청 내용","outputs":"이번 검토 대상 자재의 Artwork와 확인할 검토 목적","businessRules":[],"approvedQuestionIds":[],"perspective":"asis","phase":"현행","functionIds":[],"sourceRefs":[{"path":"docs/20_회의록_2026-09-22.md","ref":"M-42·M-58·M-61 / 허가 전 자료로 검토·주석"},{"path":"docs/23_업무규칙장부.md","ref":"허가-08·자료-01·자료-04·기준-06·차수-08·차수-11·수정-01"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"2장 판독·대조·검토·주석"},{"path":"CODEX.md","ref":"문안은 글 중심 기준자료, QS는 Artwork 반영 여부 검토"}],"workflowId":"WF05","originalStepId":"WF05_A01","actorDetail":"QS팀","sourceSteps":[],"level":"context","scope":null}</bpmn:documentation>
      <bpmn:incoming>WF05_A_START_FLOW1</bpmn:incoming>
      <bpmn:outgoing>WF05_AF01</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="WF05_A02" name="이번 검토가 허가 내용 반영을 확인하는 범위인가?" gatewayDirection="Diverging" default="WF05_AF21">
      <bpmn:documentation>이번 변경에서 허가 내용을 볼 필요가 있는지 먼저 정한다. 허가증이 있어도 허가와 무관한 개정은 해당 변경 근거로 본다.
입력 자료: 이번 검토 목적과 변경 범위
전달 자료: 허가 내용 검토 또는 다른 변경 근거 검토</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀","scope":null}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"이번 검토 목적과 변경 범위","outputs":"허가 내용 검토 또는 다른 변경 근거 검토","gatewayDirection":"Diverging","businessRules":[],"gatewayMeaning":"하나 선택","approvedQuestionIds":[],"perspective":"asis","phase":"현행","functionIds":[],"sourceRefs":[{"path":"docs/20_회의록_2026-09-22.md","ref":"M-42·M-58·M-61 / 허가 전 자료로 검토·주석"},{"path":"docs/23_업무규칙장부.md","ref":"허가-08·자료-01·자료-04·기준-06·차수-08·차수-11·수정-01"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"2장 판독·대조·검토·주석"},{"path":"CODEX.md","ref":"문안은 글 중심 기준자료, QS는 Artwork 반영 여부 검토"}],"workflowId":"WF05","originalStepId":"WF05_A02","actorDetail":"QS팀","sourceSteps":[],"level":"context","scope":null}</bpmn:documentation>
      <bpmn:incoming>WF05_AF01</bpmn:incoming>
      <bpmn:outgoing>WF05_AF20</bpmn:outgoing>
      <bpmn:outgoing>WF05_AF21</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="WF05_A10" name="이번에 쓸 허가증이 확보되어 있는가?" gatewayDirection="Diverging" default="WF05_AF23">
      <bpmn:documentation>허가증이 있으면 해당 허가증을, 없으면 확보 문안·신청 관련 자료를 기준으로 본다.
입력 자료: 허가 내용을 볼 대상과 확보 자료
전달 자료: 허가증 또는 확보 문안</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀","scope":null}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"허가 내용을 볼 대상과 확보 자료","outputs":"허가증 또는 확보 문안","gatewayDirection":"Diverging","businessRules":[],"gatewayMeaning":"하나 선택","approvedQuestionIds":[],"perspective":"asis","phase":"현행","functionIds":[],"sourceRefs":[{"path":"docs/20_회의록_2026-09-22.md","ref":"M-42·M-58·M-61 / 허가 전 자료로 검토·주석"},{"path":"docs/23_업무규칙장부.md","ref":"허가-08·자료-01·자료-04·기준-06·차수-08·차수-11·수정-01"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"2장 판독·대조·검토·주석"},{"path":"CODEX.md","ref":"문안은 글 중심 기준자료, QS는 Artwork 반영 여부 검토"}],"workflowId":"WF05","originalStepId":"WF05_A10","actorDetail":"QS팀","sourceSteps":[],"level":"context","scope":null}</bpmn:documentation>
