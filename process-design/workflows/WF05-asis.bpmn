<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="WF05_A_Collaboration" name="허가·문안 대조와 주석 작성 · 현재 업무">
    <bpmn:documentation>QS가 허가증 또는 확보 문안과 도안을 직접 확인하고 수정 주석을 작성한다.
입력 자료: 초안·수정본과 확보된 기준자료
전달 자료: 디자인팀 수정 요청용 주석본 또는 생산·관련 부서 검토에 사용할 Artwork와 QS 확인 결과</bpmn:documentation>
    <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"초안·수정본과 확보된 기준자료","outputs":"디자인팀 수정 요청용 주석본 또는 생산·관련 부서 검토에 사용할 Artwork와 QS 확인 결과","perspective":"asis","sourceRefs":[{"path":"docs/20_회의록_2026-09-22.md","ref":"M-42·M-58·M-61 / 허가 전 자료로 검토·주석"},{"path":"docs/23_업무규칙장부.md","ref":"허가-08·자료-01·자료-04·기준-06·차수-08·차수-11·수정-01"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"2장 판독·대조·검토·주석"},{"path":"CODEX.md","ref":"문안은 글 중심 기준자료, QS는 Artwork 반영 여부 검토"}],"workflowId":"WF05","sourceSteps":[],"level":"context","scope":null}</bpmn:documentation>
    <bpmn:participant id="Participant_WF05_A_Process" name="허가·문안 대조와 주석 작성 · 현재 업무" processRef="WF05_A_Process" />
  </bpmn:collaboration>
  <bpmn:process id="WF05_A_Process" isExecutable="false">
    <bpmn:laneSet id="LaneSet_WF05_A_Process">
      <bpmn:lane id="Lane_WF05_A_Process_R0" name="QS팀">
