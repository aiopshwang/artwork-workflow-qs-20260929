      <bpmn:outgoing>WF05_AF05</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="WF05_A03" name="허가증과 Artwork를 대조한다">
      <bpmn:documentation>해당 허가 내용이 자재 디자인에 빠지거나 다르게 들어간 곳이 있는지 본다.
입력 자료: 허가증 원본과 Artwork
전달 자료: 허가증의 표시 내용이 Artwork에 반영됐는지 확인한 결과와 차이</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀","scope":null}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"허가증 원본과 Artwork","outputs":"허가증의 표시 내용이 Artwork에 반영됐는지 확인한 결과와 차이","businessRules":[],"approvedQuestionIds":[],"perspective":"asis","phase":"현행","functionIds":[],"sourceRefs":[{"path":"docs/20_회의록_2026-09-22.md","ref":"M-42·M-58·M-61 / 허가 전 자료로 검토·주석"},{"path":"docs/23_업무규칙장부.md","ref":"허가-08·자료-01·자료-04·기준-06·차수-08·차수-11·수정-01"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"2장 판독·대조·검토·주석"},{"path":"CODEX.md","ref":"문안은 글 중심 기준자료, QS는 Artwork 반영 여부 검토"}],"workflowId":"WF05","originalStepId":"WF05_A03","actorDetail":"QS팀","sourceSteps":[],"level":"context","scope":null}</bpmn:documentation>
