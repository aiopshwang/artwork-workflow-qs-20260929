      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"의뢰사 수정 요청 및 이전 지적과 연결한 의뢰사 수정본","outputs":"의뢰사 수정 요청 및 이전 지적과 연결한 의뢰사 수정본","businessRules":[],"approvedQuestionIds":[],"perspective":"tobe","phase":"Phase 1","functionIds":["K-주석-03","K-접수-08","C-09"],"sourceRefs":[{"path":"CODEX.md","ref":"수탁 신규·개정과 최신 고객 정정: 수탁 허가증은 동국 검토 소관 아님"},{"path":"docs/22_URS원문.md","ref":"AN-01~14·AO-01~12·AN-04-01·AO-04-01"},{"path":"docs/23_업무규칙장부.md","ref":"품목-13·단계-21·단계-22·전달-05"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-96·M-101"}],"workflowId":"WF03","originalStepId":"WF03_T07_SYS_RESPONSE","actorDetail":"Artwork 시스템","sourceSteps":["WF03_T07"],"level":"context","scope":null}</bpmn:documentation>
