    <bpmn:serviceTask id="WF03_T02_SYS_RESPONSE" name="의뢰사 파일과 칼선·규격의 대상·판·수령일을 저장한다">
      <bpmn:documentation>올린 파일을 대상 자재에 연결하고 자료의 종류와 판·받은 날짜를 보여준다.
입력 자료: 검토할 의뢰사 원본 파일과 해당 자재의 칼선·규격 자료
전달 자료: 검토할 의뢰사 원본 파일과 해당 자재의 칼선·규격 자료</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"시스템","scope":null}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"검토할 의뢰사 원본 파일과 해당 자재의 칼선·규격 자료","outputs":"검토할 의뢰사 원본 파일과 해당 자재의 칼선·규격 자료","businessRules":[],"approvedQuestionIds":[],"perspective":"tobe","phase":"Phase 1","functionIds":["K-접수-04","K-접수-17","K-대조-04"],"sourceRefs":[{"path":"CODEX.md","ref":"수탁 신규·개정과 최신 고객 정정: 수탁 허가증은 동국 검토 소관 아님"},{"path":"docs/22_URS원문.md","ref":"AN-01~14·AO-01~12·AN-04-01·AO-04-01"},{"path":"docs/23_업무규칙장부.md","ref":"품목-13·단계-21·단계-22·전달-05"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-96·M-101"}],"workflowId":"WF03","originalStepId":"WF03_T02_SYS_RESPONSE","actorDetail":"Artwork 시스템","sourceSteps":["WF03_T02"],"level":"context","scope":null}</bpmn:documentation>
