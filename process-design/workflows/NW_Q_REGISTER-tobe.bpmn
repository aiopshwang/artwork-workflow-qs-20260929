<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="NW_Q_REGISTER_T_Collaboration" name="신규 자재의 ERP 등록 또는 기존 규격 변경을 진행한다 · 도입 후 업무">
    <bpmn:documentation>ERP 등록은 외부 절차로 유지하고, 등록 대기와 등록정보 수신·연결은 Phase 2 지원으로 구분한다.
입력 자료: 대상 자재와 신규 등록·규격 변경에 필요한 자료
전달 자료: ERP에 등록된 자재정보와 규격</bpmn:documentation>
    <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"scope":{"parentNodeId":"Q_REGISTER","start":"다음 자료를 받은 상태에서 시작한다: 대상 자재와 신규 등록·규격 변경에 필요한 자료","end":"이 업무에서 남길 내용: ERP에 등록된 자재정보와 규격","inputs":"대상 자재와 신규 등록·규격 변경에 필요한 자료","outputs":"ERP에 등록된 자재정보와 규격","includes":["신규 등록·규격 변경에 필요한 자료 확인","외부 ERP 등록 절차와 등록 결과 확인","목표 Phase 2: 등록정보 수신·대상 업무 연결"],"excludes":["기존 자재 재사용 결정","ERP 내부 입력자·결재 절차","전체 기준자료 취합과 디자인 요청"]}}</bpmn:documentation>
    <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"대상 자재와 신규 등록·규격 변경에 필요한 자료","outputs":"ERP에 등록된 자재정보와 규격","perspective":"tobe","sourceRefs":[{"path":"CODEX.md","ref":"기존 자재·등록정보·기준자료 준비와 ERP Phase 2 결정"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-22·M-30·M-78~80"},{"path":"docs/23_업무규칙장부.md","ref":"자재-13·단계-08·단계-09·단계-10·단계-16·자료-02·자료-04"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"2장 접수·대조·주석 / 6장 자재·기준 자료"}],"workflowId":"NW_Q_REGISTER","sourceSteps":["WF02_A04","WF02_T04","WF02_T05","WF02_T05_RESULT"],"level":"node-detail","scope":{"parentNodeId":"Q_REGISTER","start":"다음 자료를 받은 상태에서 시작한다: 대상 자재와 신규 등록·규격 변경에 필요한 자료","end":"이 업무에서 남길 내용: ERP에 등록된 자재정보와 규격","inputs":"대상 자재와 신규 등록·규격 변경에 필요한 자료","outputs":"ERP에 등록된 자재정보와 규격","includes":["신규 등록·규격 변경에 필요한 자료 확인","외부 ERP 등록 절차와 등록 결과 확인","목표 Phase 2: 등록정보 수신·대상 업무 연결"],"excludes":["기존 자재 재사용 결정","ERP 내부 입력자·결재 절차","전체 기준자료 취합과 디자인 요청"]}}</bpmn:documentation>
    <bpmn:participant id="Participant_NW_Q_REGISTER_T_Process" name="신규 자재의 ERP 등록 또는 기존 규격 변경을 진행한다 · 도입 후 업무" processRef="NW_Q_REGISTER_T_Process" />
  </bpmn:collaboration>
  <bpmn:process id="NW_Q_REGISTER_T_Process" isExecutable="false">
    <bpmn:laneSet id="LaneSet_NW_Q_REGISTER_T_Process">
      <bpmn:lane id="Lane_NW_Q_REGISTER_T_Process_R0" name="QS팀">
        <bpmn:flowNodeRef>NW_Q_REGISTER_T00</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NW_Q_REGISTER_T01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NW_Q_REGISTER_T02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NW_Q_REGISTER_T03</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NW_Q_REGISTER_T04</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_NW_Q_REGISTER_T_Process_R1" name="시스템">
        <bpmn:flowNodeRef>NW_Q_REGISTER_T01_SYS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NW_Q_REGISTER_T03_PRE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NW_Q_REGISTER_T03_SYS</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="NW_Q_REGISTER_T00" name="이 업무에 필요한 자료를 확인한다">
      <bpmn:documentation>상위 업무에서 전달받은 자료로 이 업무를 시작한다.
