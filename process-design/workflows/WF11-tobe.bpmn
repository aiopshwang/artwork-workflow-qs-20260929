      <bpmn:incoming>WF11_T03_SYS_RESPONSE_FLOW</bpmn:incoming>
      <bpmn:outgoing>WF11_T03_END_FLOW</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="WF11_T04_SYS_RESPONSE" name="완료 승인본과 새 허가증의 차이를 대조 기록으로 보여준다">
      <bpmn:documentation>완료된 개정에 차수를 추가하지 않고 사용한 승인본·허가증의 판과 규칙 대조 결과를 저장한다.
입력 자료: 완료된 승인 Artwork와 새 허가증의 차이 및 수정 필요 여부
전달 자료: 완료된 승인 Artwork와 새 허가증의 차이 및 수정 필요 여부</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"시스템","scope":null}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"완료된 승인 Artwork와 새 허가증의 차이 및 수정 필요 여부","outputs":"완료된 승인 Artwork와 새 허가증의 차이 및 수정 필요 여부","businessRules":[],"approvedQuestionIds":[],"perspective":"tobe","phase":null,"functionIds":["K-대조-21","K-대조-07","K-검토-04"],"sourceRefs":[{"path":"docs/20_회의록_2026-09-22.md","ref":"허가 후 바코드 부여·입고 전후 후속 조치"},{"path":"docs/23_업무규칙장부.md","ref":"허가-11·차수-13·차수-14·차수-22·바코-07·단계-34"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"T-11·T-13·T-18·K-대조-18·21·K-검토-08~11"},{"path":"CODEX.md","ref":"늦은 허가·바코드는 독립된 후속 업무"}],"workflowId":"WF11","originalStepId":"WF11_T04_SYS_RESPONSE","actorDetail":"Artwork 시스템","sourceSteps":["WF11_T04"],"level":"context","scope":null}</bpmn:documentation>
      <bpmn:incoming>WF11_T04_SYS_RESPONSE_FLOW</bpmn:incoming>
