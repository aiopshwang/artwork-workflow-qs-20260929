<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="WF11_T_Collaboration" name="늦은 허가증 재검토와 바코드 후속 처리 · 도입 후 업무">
    <bpmn:documentation>허가 재대조는 완료 전후로 구분하며 바코드는 별도 시작점에서 필요한 반영·후인쇄를 진행한다.
입력 자료: 허가증 등록 또는 별도 바코드 반영 요청
전달 자료: 진행 중 개정의 허가증 재검토 결과, 필요한 새 개정의 연결, 완료본의 허가 대조 기록 또는 자재별 바코드 반영·확인 기록</bpmn:documentation>
    <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"허가증 등록 또는 별도 바코드 반영 요청","outputs":"진행 중 개정의 허가증 재검토 결과, 필요한 새 개정의 연결, 완료본의 허가 대조 기록 또는 자재별 바코드 반영·확인 기록","perspective":"tobe","sourceRefs":[{"path":"docs/20_회의록_2026-09-22.md","ref":"허가 후 바코드 부여·입고 전후 후속 조치"},{"path":"docs/23_업무규칙장부.md","ref":"허가-11·차수-13·차수-14·차수-22·바코-07·단계-34"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"T-11·T-13·T-18·K-대조-18·21·K-검토-08~11"},{"path":"CODEX.md","ref":"늦은 허가·바코드는 독립된 후속 업무"}],"workflowId":"WF11","sourceSteps":[],"level":"context","scope":null}</bpmn:documentation>
    <bpmn:participant id="Participant_WF11_T_Process" name="늦은 허가증 재검토와 바코드 후속 처리 · 도입 후 업무" processRef="WF11_T_Process" />
  </bpmn:collaboration>
  <bpmn:process id="WF11_T_Process" isExecutable="false">
    <bpmn:laneSet id="LaneSet_WF11_T_Process">
      <bpmn:lane id="Lane_WF11_T_Process_R0" name="QS팀">
        <bpmn:flowNodeRef>WF11_T01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF11_T08</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF11_T02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF11_T03</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF11_T04</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF11_T09</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF11_T03_RESULT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF11_T05</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J_WF11_T10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF11_T06</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF11_T07</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF11_T10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF11_T11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF11_T14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF11_T06_RESULT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF11_T07_RESULT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF11_T12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF11_T13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J_WF11_T15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF11_T15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF11_T16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF11_T16_RESULT</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_WF11_T_Process_R1" name="시스템">
        <bpmn:flowNodeRef>WF11_T09_SYS_DISPLAY</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF11_T03_SYS_RESPONSE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF11_T04_SYS_RESPONSE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF11_T09_SYS_RESPONSE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF11_T06_SYS_RESPONSE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF11_T07_SYS_RESPONSE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF11_T14_SYS_RESPONSE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF11_T16_SYS_RESPONSE</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="WF11_T01" name="새 허가증과 대상 품목을 연결한다">
      <bpmn:documentation>대상·판을 확인해 등록하고 영향받는 자재를 확인한다. 수탁 기본업무와 섞지 않는다.
입력 자료: 나중에 받은 허가증
전달 자료: 새 허가증을 연결한 품목과 해당 허가 내용을 다시 대조할 자재 목록</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀","scope":null}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"나중에 받은 허가증","outputs":"새 허가증을 연결한 품목과 해당 허가 내용을 다시 대조할 자재 목록","businessRules":[],"approvedQuestionIds":[],"perspective":"tobe","phase":null,"functionIds":["K-접수-04","K-대조-21","B-15"],"sourceRefs":[{"path":"docs/20_회의록_2026-09-22.md","ref":"허가 후 바코드 부여·입고 전후 후속 조치"},{"path":"docs/23_업무규칙장부.md","ref":"허가-11·차수-13·차수-14·차수-22·바코-07·단계-34"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"T-11·T-13·T-18·K-대조-18·21·K-검토-08~11"},{"path":"CODEX.md","ref":"늦은 허가·바코드는 독립된 후속 업무"}],"workflowId":"WF11","originalStepId":"WF11_T01","actorDetail":"QS 담당자","sourceSteps":[],"level":"context","scope":null}</bpmn:documentation>
      <bpmn:outgoing>WF11_TF01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:startEvent id="WF11_T08" name="바코드 반영 업무가 발생한다">
      <bpmn:documentation>허가 재대조의 종료를 기다리는 단일 순서로 묶지 않고 필요한 시점에 해당 업무를 시작한다.
입력 자료: 번호 부여·디자인 반영·후인쇄 요청
전달 자료: 바코드 반영을 요청한 대상 자재와 요청 내용</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀","scope":null}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"번호 부여·디자인 반영·후인쇄 요청","outputs":"바코드 반영을 요청한 대상 자재와 요청 내용","businessRules":[],"approvedQuestionIds":[],"perspective":"tobe","phase":"Phase 1","functionIds":["T-13","K-검토-08"],"sourceRefs":[{"path":"docs/20_회의록_2026-09-22.md","ref":"허가 후 바코드 부여·입고 전후 후속 조치"},{"path":"docs/23_업무규칙장부.md","ref":"허가-11·차수-13·차수-14·차수-22·바코-07·단계-34"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"T-11·T-13·T-18·K-대조-18·21·K-검토-08~11"},{"path":"CODEX.md","ref":"늦은 허가·바코드는 독립된 후속 업무"}],"workflowId":"WF11","originalStepId":"WF11_T08","actorDetail":"QS 담당자","sourceSteps":[],"level":"context","scope":null}</bpmn:documentation>
      <bpmn:outgoing>WF11_TF07</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="WF11_T02" name="대상 개정이 QS 완료 전인가?" gatewayDirection="Diverging" default="WF11_TF03">
      <bpmn:documentation>내용 확정만 했는지 최종 전환 확인 후 완료했는지 구분한다.
입력 자료: 개정의 현재 상태
전달 자료: 다음 차수 또는 완료본 대조</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀","scope":null}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"개정의 현재 상태","outputs":"다음 차수 또는 완료본 대조","gatewayDirection":"Diverging","businessRules":[],"gatewayMeaning":"하나 선택","approvedQuestionIds":[],"perspective":"tobe","phase":null,"functionIds":["K-검토-12","K-검토-14"],"sourceRefs":[{"path":"docs/20_회의록_2026-09-22.md","ref":"허가 후 바코드 부여·입고 전후 후속 조치"},{"path":"docs/23_업무규칙장부.md","ref":"허가-11·차수-13·차수-14·차수-22·바코-07·단계-34"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"T-11·T-13·T-18·K-대조-18·21·K-검토-08~11"},{"path":"CODEX.md","ref":"늦은 허가·바코드는 독립된 후속 업무"}],"workflowId":"WF11","originalStepId":"WF11_T02","actorDetail":"QS 담당자","sourceSteps":[],"level":"context","scope":null}</bpmn:documentation>
      <bpmn:incoming>WF11_TF01</bpmn:incoming>
      <bpmn:outgoing>WF11_TF02</bpmn:outgoing>
      <bpmn:outgoing>WF11_TF03</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="WF11_T09_SYS_DISPLAY" name="포장단위별 바코드 후보와 현재 도안의 규칙 확인 결과를 보여준다">
      <bpmn:documentation>확보된 표준코드 후보·출처와 자재별 적용 상태를 보여준다. 도안의 바코드는 규칙 디코딩 결과를 표시하며 최종 번호와 적용 여부는 QS가 확인한다.
입력 자료: 대상 품목·포장단위·확정 번호
전달 자료: QS 담당자가 원문과 확인할 대상 품목·포장단위·확정 번호</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"시스템","scope":null}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"대상 품목·포장단위·확정 번호","outputs":"QS 담당자가 원문과 확인할 대상 품목·포장단위·확정 번호","businessRules":[],"approvedQuestionIds":[],"perspective":"tobe","phase":"Phase 1","functionIds":["K-검토-08","K-검토-10","K-검토-11","K-대조-18"],"sourceRefs":[{"path":"docs/20_회의록_2026-09-22.md","ref":"허가 후 바코드 부여·입고 전후 후속 조치"},{"path":"docs/23_업무규칙장부.md","ref":"허가-11·차수-13·차수-14·차수-22·바코-07·단계-34"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"T-11·T-13·T-18·K-대조-18·21·K-검토-08~11"},{"path":"CODEX.md","ref":"늦은 허가·바코드는 독립된 후속 업무"}],"workflowId":"WF11","originalStepId":"WF11_T09_SYS_DISPLAY","actorDetail":"Artwork 시스템","sourceSteps":["WF11_T09"],"level":"context","scope":null}</bpmn:documentation>
      <bpmn:incoming>WF11_TF07</bpmn:incoming>
      <bpmn:outgoing>WF11_T09_SYS_DISPLAY_FLOW</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="WF11_T03" name="같은 개정의 다음 차수에서 허가를 대조한다">
      <bpmn:documentation>확정 뒤라면 확정을 풀고 다음 차수를 연다. 직전 결과와 나란히 보며 허가 반영을 검토한다.
입력 자료: 미완료 개정·새 허가증
전달 자료: 진행 중인 개정의 다음 검토 차수에 남긴 새 허가증 대조 결과와 추가 수정사항</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀","scope":null}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"미완료 개정·새 허가증","outputs":"진행 중인 개정의 다음 검토 차수에 남긴 새 허가증 대조 결과와 추가 수정사항","businessRules":[],"approvedQuestionIds":[],"perspective":"tobe","phase":null,"functionIds":["K-검토-02","K-대조-21"],"sourceRefs":[{"path":"docs/20_회의록_2026-09-22.md","ref":"허가 후 바코드 부여·입고 전후 후속 조치"},{"path":"docs/23_업무규칙장부.md","ref":"허가-11·차수-13·차수-14·차수-22·바코-07·단계-34"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"T-11·T-13·T-18·K-대조-18·21·K-검토-08~11"},{"path":"CODEX.md","ref":"늦은 허가·바코드는 독립된 후속 업무"}],"workflowId":"WF11","originalStepId":"WF11_T03","actorDetail":"QS 담당자","sourceSteps":[],"level":"context","scope":null}</bpmn:documentation>
      <bpmn:incoming>WF11_TF02</bpmn:incoming>
      <bpmn:outgoing>WF11_T03_SYS_RESPONSE_FLOW</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="WF11_T04" name="완료된 승인본을 새 허가증과 대조한다">
      <bpmn:documentation>완료 개정에는 차수를 추가하지 않고 대조 실행 기록을 남긴다.
입력 자료: 완료 승인본·새 허가증
전달 자료: 완료된 승인 Artwork와 새 허가증의 차이 및 수정 필요 여부</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀","scope":null}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"완료 승인본·새 허가증","outputs":"완료된 승인 Artwork와 새 허가증의 차이 및 수정 필요 여부","businessRules":[],"approvedQuestionIds":[],"perspective":"tobe","phase":null,"functionIds":["K-대조-21","K-대조-07","K-검토-04"],"sourceRefs":[{"path":"docs/20_회의록_2026-09-22.md","ref":"허가 후 바코드 부여·입고 전후 후속 조치"},{"path":"docs/23_업무규칙장부.md","ref":"허가-11·차수-13·차수-14·차수-22·바코-07·단계-34"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"T-11·T-13·T-18·K-대조-18·21·K-검토-08~11"},{"path":"CODEX.md","ref":"늦은 허가·바코드는 독립된 후속 업무"}],"workflowId":"WF11","originalStepId":"WF11_T04","actorDetail":"QS 담당자","sourceSteps":[],"level":"context","scope":null}</bpmn:documentation>
      <bpmn:incoming>WF11_TF03</bpmn:incoming>
      <bpmn:outgoing>WF11_T04_SYS_RESPONSE_FLOW</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="WF11_T09" name="포장단위·번호·적용 여부를 확인한다">
      <bpmn:documentation>규칙 조회가 제시한 번호 후보를 QS가 확인한다. 후보와 출처를 확인해 사용할 번호를 정한다. 규칙으로 번호·검증숫자·도안 반영 여부를 확인한다.
입력 자료: 대상 품목·포장단위·확정 번호
전달 자료: QS가 확인한 포장단위별 바코드 번호와 반영할 자재</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀","scope":null}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"대상 품목·포장단위·확정 번호","outputs":"QS가 확인한 포장단위별 바코드 번호와 반영할 자재","businessRules":[],"approvedQuestionIds":[],"perspective":"tobe","phase":"Phase 1","functionIds":["K-검토-08","K-검토-10","K-검토-11","K-대조-18"],"sourceRefs":[{"path":"docs/20_회의록_2026-09-22.md","ref":"허가 후 바코드 부여·입고 전후 후속 조치"},{"path":"docs/23_업무규칙장부.md","ref":"허가-11·차수-13·차수-14·차수-22·바코-07·단계-34"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"T-11·T-13·T-18·K-대조-18·21·K-검토-08~11"},{"path":"CODEX.md","ref":"늦은 허가·바코드는 독립된 후속 업무"}],"workflowId":"WF11","originalStepId":"WF11_T09","actorDetail":"QS 담당자","sourceSteps":[],"level":"context","scope":null}</bpmn:documentation>
      <bpmn:incoming>WF11_T09_SYS_DISPLAY_FLOW</bpmn:incoming>
      <bpmn:outgoing>WF11_T09_SYS_RESPONSE_FLOW</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="WF11_T03_SYS_RESPONSE" name="다음 차수의 허가증 대조 결과와 직전 판단을 나란히 보여준다">
      <bpmn:documentation>진행 중 개정에서 QS가 시작한 다음 검토 차수의 허가 대조를 수행하고 이전 판단과 함께 보여준다.
입력 자료: 진행 중인 개정의 다음 검토 차수에 남긴 새 허가증 대조 결과와 추가 수정사항
전달 자료: 진행 중인 개정의 다음 검토 차수에 남긴 새 허가증 대조 결과와 추가 수정사항</bpmn:documentation>
