<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="NW_Q_NOTES_T_Collaboration" name="Artwork에 주석을 작성하고 디자인팀에 수정을 요청한다 · 도입 후 업무">
    <bpmn:documentation>확인된 수정내용과 이전 미반영 지적을 QS가 도안에 표시·수정하고, 시스템이 주석 PDF를 출력·저장해 전달한다.
입력 자료: 현재 Artwork와 수정할 내용·적용 기준자료
전달 자료: 디자인팀에 전달할 주석본, 수정 요청과 기준자료</bpmn:documentation>
    <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"scope":{"parentNodeId":"Q_NOTES","start":"다음 자료를 받은 상태에서 시작한다: 현재 Artwork와 수정할 내용·적용 기준자료","end":"이 업무에서 남길 내용: 디자인팀에 전달할 주석본, 수정 요청과 기준자료","inputs":"현재 Artwork와 수정할 내용·적용 기준자료","outputs":"디자인팀에 전달할 주석본, 수정 요청과 기준자료","includes":["이미 확인한 수정사항의 위치·요청 문구 정리","미반영 지적을 이번 도안에 다시 표시","주석본·근거자료 확인과 디자인팀 전달"],"excludes":["허가·문안 및 전체 도안의 대조 검토","디자인팀의 수정 작업","반환본 수령과 다음 검토 차수"]}}</bpmn:documentation>
    <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"현재 Artwork와 수정할 내용·적용 기준자료","outputs":"디자인팀에 전달할 주석본, 수정 요청과 기준자료","perspective":"tobe","sourceRefs":[{"path":"docs/20_회의록_2026-09-22.md","ref":"M-42·M-58·M-61 / 허가 전 자료로 검토·주석"},{"path":"docs/23_업무규칙장부.md","ref":"허가-08·자료-01·자료-04·기준-06·차수-08·차수-11·수정-01"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"2장 판독·대조·검토·주석"},{"path":"CODEX.md","ref":"문안은 글 중심 기준자료, QS는 Artwork 반영 여부 검토"},{"path":"CODEX.md","ref":"사용자 인터뷰: 미반영 지적은 새 도안에 다시, 반영된 지적은 달지 않음"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-61"},{"path":"docs/23_업무규칙장부.md","ref":"수정-01·수정-02·차수-11·차수-14·자료-10·자료-11"},{"path":"docs/22_URS원문.md","ref":"CR-34·CR-35·CR-36"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"K-대조-11·12·15 / K-검토-02~05"},{"path":"docs/20_회의록_2026-09-22.md","ref":"디자인팀 자료 전달·반환 / 사용자 순간 22"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"5장 다 디자인팀 받은 일 / C-01~09"},{"path":"docs/23_업무규칙장부.md","ref":"전달-01~06·차수-11"},{"path":"CODEX.md","ref":"디자인팀 다운로드·업로드 중심 원칙"}],"workflowId":"NW_Q_NOTES","sourceSteps":["WF05_A07","WF06_A04","WF05_A08","WF04_A02","WF05_T09","WF06_T06","WF05_T10","WF04_T01","WF04_T02"],"level":"node-detail","scope":{"parentNodeId":"Q_NOTES","start":"다음 자료를 받은 상태에서 시작한다: 현재 Artwork와 수정할 내용·적용 기준자료","end":"이 업무에서 남길 내용: 디자인팀에 전달할 주석본, 수정 요청과 기준자료","inputs":"현재 Artwork와 수정할 내용·적용 기준자료","outputs":"디자인팀에 전달할 주석본, 수정 요청과 기준자료","includes":["이미 확인한 수정사항의 위치·요청 문구 정리","미반영 지적을 이번 도안에 다시 표시","주석본·근거자료 확인과 디자인팀 전달"],"excludes":["허가·문안 및 전체 도안의 대조 검토","디자인팀의 수정 작업","반환본 수령과 다음 검토 차수"]}}</bpmn:documentation>
    <bpmn:participant id="Participant_NW_Q_NOTES_T_Process" name="Artwork에 주석을 작성하고 디자인팀에 수정을 요청한다 · 도입 후 업무" processRef="NW_Q_NOTES_T_Process" />
  </bpmn:collaboration>
  <bpmn:process id="NW_Q_NOTES_T_Process" isExecutable="false">
    <bpmn:laneSet id="LaneSet_NW_Q_NOTES_T_Process">
      <bpmn:lane id="Lane_NW_Q_NOTES_T_Process_R0" name="QS팀">
        <bpmn:flowNodeRef>NW_Q_NOTES_T00</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NW_Q_NOTES_T01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NW_Q_NOTES_T02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NW_Q_NOTES_T03</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NW_Q_NOTES_T04</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_NW_Q_NOTES_T_Process_R1" name="시스템">
        <bpmn:flowNodeRef>NW_Q_NOTES_T01_PRE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NW_Q_NOTES_T02_PRE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NW_Q_NOTES_T02_SYS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NW_Q_NOTES_T03_SYS</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="NW_Q_NOTES_T00" name="이 업무에 필요한 자료를 확인한다">
      <bpmn:documentation>상위 업무에서 전달받은 자료로 이 업무를 시작한다.
