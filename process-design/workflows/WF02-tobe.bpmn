<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="WF02_T_Collaboration" name="기존 자재 사용과 기준자료 준비 · 도입 후 업무">
    <bpmn:documentation>자재 검색·기준본 연결·변경 주석을 지원하고 ERP 등록정보 연계는 2단계로 둔다.
입력 자료: 자재별 검토 건
전달 자료: 자료 전달 준비와 별도로 연결되는 ERP 등록 결과</bpmn:documentation>
    <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"자재별 검토 건","outputs":"자료 전달 준비와 별도로 연결되는 ERP 등록 결과","perspective":"tobe","sourceRefs":[{"path":"CODEX.md","ref":"기존 자재·등록정보·기준자료 준비와 ERP Phase 2 결정"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-22·M-30·M-78~80"},{"path":"docs/23_업무규칙장부.md","ref":"자재-13·단계-08·단계-09·단계-10·단계-16·자료-02·자료-04"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"2장 접수·대조·주석 / 6장 자재·기준 자료"}],"workflowId":"WF02"}</bpmn:documentation>
    <bpmn:participant id="Participant_WF02_T_Process" name="기존 자재 사용과 기준자료 준비 · 도입 후 업무" processRef="WF02_T_Process" />
  </bpmn:collaboration>
  <bpmn:process id="WF02_T_Process" isExecutable="false">
    <bpmn:laneSet id="LaneSet_WF02_T_Process">
      <bpmn:lane id="Lane_WF02_T_Process_R1" name="ERP 관련 담당">
        <bpmn:flowNodeRef>WF02_T10</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_WF02_T_Process_R0" name="QS팀">
        <bpmn:flowNodeRef>WF02_T12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF02_T13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF02_T05</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF02_T01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J_WF02_T06</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF02_T05_RESULT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF02_T02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF02_T06</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF02_T03</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF02_T07</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF02_T04</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF02_T08</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J_WF02_T09</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF02_T09</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF02_T09_RESULT</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="WF02_T10" name="ERP 등록정보가 전달된다">
      <bpmn:documentation>Phase 2 연계 대상으로 등록정보가 전달된다.
입력 자료: 등록된 자재정보
전달 자료: 연결할 ERP 정보</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"ERP 관련 담당"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"등록된 자재정보","outputs":"연결할 ERP 정보","businessRules":[],"perspective":"tobe","phase":"Phase 2","functionIds":["B-09","B-35"],"sourceRefs":[{"path":"CODEX.md","ref":"기존 자재·등록정보·기준자료 준비와 ERP Phase 2 결정"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-22·M-30·M-78~80"},{"path":"docs/23_업무규칙장부.md","ref":"자재-13·단계-08·단계-09·단계-10·단계-16·자료-02·자료-04"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"2장 접수·대조·주석 / 6장 자재·기준 자료"}],"workflowId":"WF02","originalStepId":"WF02_T10","actorDetail":"ERP 관련 담당"}</bpmn:documentation>
      <bpmn:outgoing>WF02_TF20</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:startEvent id="WF02_T12" name="자사 또는 기존 자재의 준비 업무가 시작된다">
      <bpmn:documentation>자사·개정은 자재 조건을 확인하고, 위탁 신규는 개발부의 자료 취합과 QS의 표준코드 관련 업무에서 시작한다.
입력 자료: 확인된 대상 자재
전달 자료: 경로별 준비 업무</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"확인된 대상 자재","outputs":"경로별 준비 업무","businessRules":[],"perspective":"tobe","phase":"Phase 1","functionIds":[],"sourceRefs":[{"path":"CODEX.md","ref":"기존 자재·등록정보·기준자료 준비와 ERP Phase 2 결정"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-22·M-30·M-78~80"},{"path":"docs/23_업무규칙장부.md","ref":"자재-13·단계-08·단계-09·단계-10·단계-16·자료-02·자료-04"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"2장 접수·대조·주석 / 6장 자재·기준 자료"}],"workflowId":"WF02","originalStepId":"WF02_T12","actorDetail":"QS팀·개발부"}</bpmn:documentation>
      <bpmn:outgoing>WF02_TFT12</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:startEvent id="WF02_T13" name="위탁 신규의 제작 자료 준비가 시작된다">
      <bpmn:documentation>자사·개정은 자재 조건을 확인하고, 위탁 신규는 개발부의 자료 취합과 QS의 표준코드 관련 업무에서 시작한다.
입력 자료: 확인된 대상 자재
전달 자료: 경로별 준비 업무</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"확인된 대상 자재","outputs":"경로별 준비 업무","businessRules":[],"perspective":"tobe","phase":"Phase 1","functionIds":[],"sourceRefs":[{"path":"CODEX.md","ref":"기존 자재·등록정보·기준자료 준비와 ERP Phase 2 결정"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-22·M-30·M-78~80"},{"path":"docs/23_업무규칙장부.md","ref":"자재-13·단계-08·단계-09·단계-10·단계-16·자료-02·자료-04"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"2장 접수·대조·주석 / 6장 자재·기준 자료"}],"workflowId":"WF02","originalStepId":"WF02_T13","actorDetail":"QS팀·개발부"}</bpmn:documentation>
      <bpmn:outgoing>WF02_TFT13</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="WF02_T05" name="등록된 ERP 자재정보를 받아 연결한다">
      <bpmn:documentation>등록정보를 연계하고 대상 자재가 맞는지 확인해 기존 업무와 연결한다. 연계 방식은 ERP 담당과 협의한다.
입력 자료: ERP 등록정보와 대기 자재
전달 자료: 등록정보와 연결된 기존 업무·자료·이력</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"ERP 등록정보와 대기 자재","outputs":"등록정보와 연결된 기존 업무·자료·이력","businessRules":[],"perspective":"tobe","phase":"Phase 2","functionIds":["B-09","B-35"],"sourceRefs":[{"path":"CODEX.md","ref":"기존 자재·등록정보·기준자료 준비와 ERP Phase 2 결정"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-22·M-30·M-78~80"},{"path":"docs/23_업무규칙장부.md","ref":"자재-13·단계-08·단계-09·단계-10·단계-16·자료-02·자료-04"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"2장 접수·대조·주석 / 6장 자재·기준 자료"}],"workflowId":"WF02","originalStepId":"WF02_T05","actorDetail":"QS 담당자·ERP 관련 담당"}</bpmn:documentation>
      <bpmn:incoming>WF02_TF20</bpmn:incoming>
      <bpmn:outgoing>WF02_T05_END_FLOW</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="WF02_T01" name="조건으로 기존 자재를 검색한다">
      <bpmn:documentation>AI가 검색 조건을 제안하면 QS가 확인하고 규칙 조회로 후보를 찾는다. 검색 조건을 확인하고 정확한 규격 및 비슷한 규격 후보를 나란히 확인한다. 임의 허용오차로 자동 선택하지 않는다.
입력 자료: 대상 자재 종류·규격·코드
전달 자료: 재사용 검토 후보</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"대상 자재 종류·규격·코드","outputs":"재사용 검토 후보","businessRules":[],"perspective":"tobe","phase":"Phase 1","functionIds":["K-접수-13","K-접수-14","B-13"],"sourceRefs":[{"path":"CODEX.md","ref":"기존 자재·등록정보·기준자료 준비와 ERP Phase 2 결정"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-22·M-30·M-78~80"},{"path":"docs/23_업무규칙장부.md","ref":"자재-13·단계-08·단계-09·단계-10·단계-16·자료-02·자료-04"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"2장 접수·대조·주석 / 6장 자재·기준 자료"}],"workflowId":"WF02","originalStepId":"WF02_T01","actorDetail":"QS 담당자"}</bpmn:documentation>
      <bpmn:incoming>WF02_TFT12</bpmn:incoming>
      <bpmn:outgoing>WF02_TF01</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="J_WF02_T06" name="경로 합류" gatewayDirection="Converging">
      <bpmn:documentation>해당 경로의 업무 결과를 이어 받는다.
입력 자료: 허가증·문안·시방서·칼선·변경 근거
전달 자료: 허가증·문안·시방서·칼선·변경 근거</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"허가증·문안·시방서·칼선·변경 근거","outputs":"허가증·문안·시방서·칼선·변경 근거","gatewayDirection":"Converging","gatewayMeaning":"경로 합류","perspective":"tobe","workflowId":"WF02","originalStepId":"WF02_T06"}</bpmn:documentation>
      <bpmn:incoming>WF02_TF04</bpmn:incoming>
      <bpmn:incoming>WF02_TF05</bpmn:incoming>
      <bpmn:incoming>WF02_TFT13</bpmn:incoming>
      <bpmn:outgoing>WF02_T_JOIN_WF02_T06</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="WF02_T05_RESULT" name="등록정보와 연결된 기존 업무·자료·이력">
      <bpmn:documentation>이 결과에서 연결된 다음 업무를 이어 간다.
입력 자료: 등록정보와 연결된 기존 업무·자료·이력
전달 자료: 등록정보와 연결된 기존 업무·자료·이력</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"등록정보와 연결된 기존 업무·자료·이력","outputs":"등록정보와 연결된 기존 업무·자료·이력","businessRules":[],"perspective":"tobe","phase":"Phase 2","functionIds":[],"sourceRefs":[{"path":"CODEX.md","ref":"기존 자재·등록정보·기준자료 준비와 ERP Phase 2 결정"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-22·M-30·M-78~80"},{"path":"docs/23_업무규칙장부.md","ref":"자재-13·단계-08·단계-09·단계-10·단계-16·자료-02·자료-04"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"2장 접수·대조·주석 / 6장 자재·기준 자료"}],"workflowId":"WF02","originalStepId":"WF02_T05_RESULT","actorDetail":"QS 담당자·ERP 관련 담당"}</bpmn:documentation>
      <bpmn:incoming>WF02_T05_END_FLOW</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="WF02_T02" name="기존 자재·승인본·칼선을 선택한다">
      <bpmn:documentation>사용 여부와 파일의 대상·판을 확인해 선택한다.
입력 자료: 후보 목록과 자재 이력
전달 자료: 이번 업무의 자재·기준 파일</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"후보 목록과 자재 이력","outputs":"이번 업무의 자재·기준 파일","businessRules":[],"perspective":"tobe","phase":"Phase 1","functionIds":["K-접수-15","K-대조-02","K-대조-04"],"sourceRefs":[{"path":"CODEX.md","ref":"기존 자재·등록정보·기준자료 준비와 ERP Phase 2 결정"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-22·M-30·M-78~80"},{"path":"docs/23_업무규칙장부.md","ref":"자재-13·단계-08·단계-09·단계-10·단계-16·자료-02·자료-04"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"2장 접수·대조·주석 / 6장 자재·기준 자료"}],"workflowId":"WF02","originalStepId":"WF02_T02","actorDetail":"QS 담당자"}</bpmn:documentation>
      <bpmn:incoming>WF02_TF01</bpmn:incoming>
      <bpmn:outgoing>WF02_TF02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="WF02_T06" name="기준자료의 종류·대상·판을 정한다">
      <bpmn:documentation>현재 확보된 자료를 연결하고 읽기 어려운 자료나 상충한 값은 담당자가 확인한다. 공개 허가정보로 원본을 대체하지 않는다.
입력 자료: 허가증·문안·시방서·칼선·변경 근거
전달 자료: 이번 업무에 쓰는 기준자료</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"허가증·문안·시방서·칼선·변경 근거","outputs":"이번 업무에 쓰는 기준자료","businessRules":[],"perspective":"tobe","phase":"Phase 1","functionIds":["K-접수-06","K-판독-06","K-대조-02","K-대조-09"],"sourceRefs":[{"path":"CODEX.md","ref":"기존 자재·등록정보·기준자료 준비와 ERP Phase 2 결정"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-22·M-30·M-78~80"},{"path":"docs/23_업무규칙장부.md","ref":"자재-13·단계-08·단계-09·단계-10·단계-16·자료-02·자료-04"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"2장 접수·대조·주석 / 6장 자재·기준 자료"}],"workflowId":"WF02","originalStepId":"WF02_T06","actorDetail":"QS 담당자"}</bpmn:documentation>
      <bpmn:incoming>WF02_T_JOIN_WF02_T06</bpmn:incoming>
      <bpmn:outgoing>WF02_TF08</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="WF02_T03" name="기존 자재 사용인가, 등록·변경이 필요한가?" gatewayDirection="Diverging" default="WF02_TF04">
      <bpmn:documentation>재사용 또는 신규·규격 변경을 구분한다. 코드가 없어도 업무 식별정보를 유지한다.
입력 자료: 자재 조건과 후보
전달 자료: 재사용·등록 대기 구분</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀"}</bpmn:documentation>
