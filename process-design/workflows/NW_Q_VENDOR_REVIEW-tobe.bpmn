        <bpmn:flowNodeRef>NW_Q_VENDOR_REVIEW_T04</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NW_Q_VENDOR_REVIEW_T06</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NW_Q_VENDOR_REVIEW_T08</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="NW_Q_VENDOR_REVIEW_T00" name="대상 자재와 받은 자료를 확인한다">
      <bpmn:documentation>해당 자재의 이 업무를 시작할 자료를 받는다.
입력 자료: 의뢰사 Artwork와 해당 자재의 칼선·규격, 수탁 개정이면 기존 동국제약용 승인 Artwork와 변경 근거자료
전달 자료: 의뢰사 Artwork와 해당 자재의 칼선·규격, 수탁 개정이면 기존 동국제약용 승인 Artwork와 변경 근거자료</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀","scope":{"parentNodeId":"Q_VENDOR_REVIEW","start":"상위 흐름에서 아래 입력 자료를 받은 때","end":"아래 결과를 정리하여 상위 흐름의 다음 업무에 전달한 때","inputs":"의뢰사 Artwork와 해당 자재의 칼선·규격, 수탁 개정이면 기존 동국제약용 승인 Artwork와 변경 근거자료","outputs":"의뢰사 Artwork의 칼선·규격 대조 결과와 수정 의견, 개정이면 기존 동국제약용 승인본·변경 내용 대조 결과","includes":["의뢰사 원본과 동국 칼선·규격의 대조","수탁 개정의 기존 동국제약용 승인본·변경 내용 확인","QS의 수정 의견 정리"],"excludes":["생산 적합성 판정","의뢰사 허가증 대조를 확정 경로로 추가","의뢰사에 수정 요청을 실제 발송","디자인팀의 편집 가능 판단","동국제약용 재제작본 검토"]}}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"의뢰사 Artwork와 해당 자재의 칼선·규격, 수탁 개정이면 기존 동국제약용 승인 Artwork와 변경 근거자료","outputs":"의뢰사 Artwork와 해당 자재의 칼선·규격, 수탁 개정이면 기존 동국제약용 승인 Artwork와 변경 근거자료","businessRules":[],"approvedQuestionIds":[],"perspective":"tobe","phase":"Phase 1","functionIds":[],"sourceRefs":[{"path":"docs/기능설계/조사_2026-09-25/08_기능지도_2판.md","ref":"K-대조-20① / K-대조-02·04·11 / K-검토-04"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-95·M-98·M-101"},{"path":"docs/23_업무규칙장부.md","ref":"단계-21·단계-22 / AN-03~04·AO-03~04"}],"workflowId":"NW_Q_VENDOR_REVIEW","originalStepId":"NW_Q_VENDOR_REVIEW_T00","actorDetail":"QS팀","sourceSteps":[],"level":"node-detail","scope":{"parentNodeId":"Q_VENDOR_REVIEW","start":"상위 흐름에서 아래 입력 자료를 받은 때","end":"아래 결과를 정리하여 상위 흐름의 다음 업무에 전달한 때","inputs":"의뢰사 Artwork와 해당 자재의 칼선·규격, 수탁 개정이면 기존 동국제약용 승인 Artwork와 변경 근거자료","outputs":"의뢰사 Artwork의 칼선·규격 대조 결과와 수정 의견, 개정이면 기존 동국제약용 승인본·변경 내용 대조 결과","includes":["의뢰사 원본과 동국 칼선·규격의 대조","수탁 개정의 기존 동국제약용 승인본·변경 내용 확인","QS의 수정 의견 정리"],"excludes":["생산 적합성 판정","의뢰사 허가증 대조를 확정 경로로 추가","의뢰사에 수정 요청을 실제 발송","디자인팀의 편집 가능 판단","동국제약용 재제작본 검토"]}}</bpmn:documentation>
      <bpmn:outgoing>NW_Q_VENDOR_REVIEW_TF01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="NW_Q_VENDOR_REVIEW_T01" name="의뢰사 파일을 선택·등록하고 자재를 지정한다">
      <bpmn:documentation>QS가 받은 원본을 올리거나 이미 등록된 수령 파일을 선택하고 대상 자재를 확인한다.
입력 자료: 받은 의뢰사 Artwork와 대상 자재
전달 자료: 선택·등록한 의뢰사 파일과 대상 자재</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀","scope":{"parentNodeId":"Q_VENDOR_REVIEW","start":"상위 흐름에서 아래 입력 자료를 받은 때","end":"아래 결과를 정리하여 상위 흐름의 다음 업무에 전달한 때","inputs":"의뢰사 Artwork와 해당 자재의 칼선·규격, 수탁 개정이면 기존 동국제약용 승인 Artwork와 변경 근거자료","outputs":"의뢰사 Artwork의 칼선·규격 대조 결과와 수정 의견, 개정이면 기존 동국제약용 승인본·변경 내용 대조 결과","includes":["의뢰사 원본과 동국 칼선·규격의 대조","수탁 개정의 기존 동국제약용 승인본·변경 내용 확인","QS의 수정 의견 정리"],"excludes":["생산 적합성 판정","의뢰사 허가증 대조를 확정 경로로 추가","의뢰사에 수정 요청을 실제 발송","디자인팀의 편집 가능 판단","동국제약용 재제작본 검토"]}}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"받은 의뢰사 Artwork와 대상 자재","outputs":"선택·등록한 의뢰사 파일과 대상 자재","businessRules":[],"approvedQuestionIds":[],"perspective":"tobe","phase":"Phase 1","functionIds":["K-접수-04","K-접수-17"],"sourceRefs":[{"path":"docs/기능설계/조사_2026-09-25/08_기능지도_2판.md","ref":"K-대조-20① / K-대조-02·04·11 / K-검토-04"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-95·M-98·M-101"},{"path":"docs/23_업무규칙장부.md","ref":"단계-21·단계-22 / AN-03~04·AO-03~04"}],"workflowId":"NW_Q_VENDOR_REVIEW","originalStepId":"NW_Q_VENDOR_REVIEW_T01","actorDetail":"QS팀","sourceSteps":[],"level":"node-detail","scope":{"parentNodeId":"Q_VENDOR_REVIEW","start":"상위 흐름에서 아래 입력 자료를 받은 때","end":"아래 결과를 정리하여 상위 흐름의 다음 업무에 전달한 때","inputs":"의뢰사 Artwork와 해당 자재의 칼선·규격, 수탁 개정이면 기존 동국제약용 승인 Artwork와 변경 근거자료","outputs":"의뢰사 Artwork의 칼선·규격 대조 결과와 수정 의견, 개정이면 기존 동국제약용 승인본·변경 내용 대조 결과","includes":["의뢰사 원본과 동국 칼선·규격의 대조","수탁 개정의 기존 동국제약용 승인본·변경 내용 확인","QS의 수정 의견 정리"],"excludes":["생산 적합성 판정","의뢰사 허가증 대조를 확정 경로로 추가","의뢰사에 수정 요청을 실제 발송","디자인팀의 편집 가능 판단","동국제약용 재제작본 검토"]}}</bpmn:documentation>
