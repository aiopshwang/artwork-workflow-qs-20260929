<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="NW_Q_VENDOR_REVIEW_T_Collaboration" name="의뢰사 Artwork를 칼선·규격과 대조하고 개정이면 기존 승인본·변경 내용도 검토한다 · 도입 후 업무">
    <bpmn:documentation>해당 업무에서 사용할 시스템 지원과 담당자의 확인
입력 자료: 의뢰사 Artwork와 해당 자재의 칼선·규격, 수탁 개정이면 기존 동국제약용 승인 Artwork와 변경 근거자료
전달 자료: 의뢰사 Artwork의 칼선·규격 대조 결과와 수정 의견, 개정이면 기존 동국제약용 승인본·변경 내용 대조 결과</bpmn:documentation>
    <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"scope":{"parentNodeId":"Q_VENDOR_REVIEW","start":"상위 흐름에서 아래 입력 자료를 받은 때","end":"아래 결과를 정리하여 상위 흐름의 다음 업무에 전달한 때","inputs":"의뢰사 Artwork와 해당 자재의 칼선·규격, 수탁 개정이면 기존 동국제약용 승인 Artwork와 변경 근거자료","outputs":"의뢰사 Artwork의 칼선·규격 대조 결과와 수정 의견, 개정이면 기존 동국제약용 승인본·변경 내용 대조 결과","includes":["의뢰사 원본과 동국 칼선·규격의 대조","수탁 개정의 기존 동국제약용 승인본·변경 내용 확인","QS의 수정 의견 정리"],"excludes":["생산 적합성 판정","의뢰사 허가증 대조를 확정 경로로 추가","의뢰사에 수정 요청을 실제 발송","디자인팀의 편집 가능 판단","동국제약용 재제작본 검토"]}}</bpmn:documentation>
    <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"의뢰사 Artwork와 해당 자재의 칼선·규격, 수탁 개정이면 기존 동국제약용 승인 Artwork와 변경 근거자료","outputs":"의뢰사 Artwork의 칼선·규격 대조 결과와 수정 의견, 개정이면 기존 동국제약용 승인본·변경 내용 대조 결과","perspective":"tobe","sourceRefs":[{"path":"docs/기능설계/조사_2026-09-25/08_기능지도_2판.md","ref":"K-대조-20① / K-대조-02·04·11 / K-검토-04"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-95·M-98·M-101"},{"path":"docs/23_업무규칙장부.md","ref":"단계-21·단계-22 / AN-03~04·AO-03~04"}],"workflowId":"NW_Q_VENDOR_REVIEW","sourceSteps":["WF03_A04","WF03_A05","WF03_T02","WF03_T03","WF03_T05","WF03_T06"],"level":"node-detail","scope":{"parentNodeId":"Q_VENDOR_REVIEW","start":"상위 흐름에서 아래 입력 자료를 받은 때","end":"아래 결과를 정리하여 상위 흐름의 다음 업무에 전달한 때","inputs":"의뢰사 Artwork와 해당 자재의 칼선·규격, 수탁 개정이면 기존 동국제약용 승인 Artwork와 변경 근거자료","outputs":"의뢰사 Artwork의 칼선·규격 대조 결과와 수정 의견, 개정이면 기존 동국제약용 승인본·변경 내용 대조 결과","includes":["의뢰사 원본과 동국 칼선·규격의 대조","수탁 개정의 기존 동국제약용 승인본·변경 내용 확인","QS의 수정 의견 정리"],"excludes":["생산 적합성 판정","의뢰사 허가증 대조를 확정 경로로 추가","의뢰사에 수정 요청을 실제 발송","디자인팀의 편집 가능 판단","동국제약용 재제작본 검토"]}}</bpmn:documentation>
    <bpmn:participant id="Participant_NW_Q_VENDOR_REVIEW_T_Process" name="의뢰사 Artwork를 칼선·규격과 대조하고 개정이면 기존 승인본·변경 내용도 검토한다 · 도입 후 업무" processRef="NW_Q_VENDOR_REVIEW_T_Process" />
  </bpmn:collaboration>
