        <bpmn:flowNodeRef>J_WF03_A04</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF03_A04</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF03_A05</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF03_A06</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J_WF03_A07</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF03_A08</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF03_A07</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_WF03_A_Process_R2" name="디자인팀">
        <bpmn:flowNodeRef>WF03_A09</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF03_A10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF03_A10_RESULT</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="WF03_A_START1" name="시작">
      <bpmn:documentation>수탁 신규·개정의 대상과 의뢰사 요청
입력 자료: 수탁 신규·개정의 대상과 의뢰사 요청
전달 자료: 의뢰사 요청과 대상 자재</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"수탁담당"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"수탁 신규·개정의 대상과 의뢰사 요청","outputs":"의뢰사 요청과 대상 자재","perspective":"asis","workflowId":"WF03"}</bpmn:documentation>
      <bpmn:outgoing>WF03_A_START_FLOW1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="WF03_A01" name="수탁 신규인가, 기존 자재 개정인가?" gatewayDirection="Diverging" default="WF03_AF02">
      <bpmn:documentation>최초 제작인지 기존 동국용 Artwork 변경인지 구분한다.
입력 자료: 의뢰사 요청과 대상 자재
전달 자료: 수탁 신규 또는 개정 구분과 그에 따라 사용할 제작·검토 자료</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"수탁담당","scope":null}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"의뢰사 요청과 대상 자재","outputs":"수탁 신규 또는 개정 구분과 그에 따라 사용할 제작·검토 자료","gatewayDirection":"Diverging","businessRules":[],"gatewayMeaning":"하나 선택","approvedQuestionIds":[],"perspective":"asis","phase":"현행","functionIds":[],"sourceRefs":[{"path":"CODEX.md","ref":"수탁 신규·개정과 최신 고객 정정: 수탁 허가증은 동국 검토 소관 아님"},{"path":"docs/22_URS원문.md","ref":"AN-01~14·AO-01~12·AN-04-01·AO-04-01"},{"path":"docs/23_업무규칙장부.md","ref":"품목-13·단계-21·단계-22·전달-05"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-96·M-101"}],"workflowId":"WF03","originalStepId":"WF03_A01","actorDetail":"수탁팀 또는 개발부 → QS팀","sourceSteps":[],"level":"context","scope":null}</bpmn:documentation>
      <bpmn:incoming>WF03_A_START_FLOW1</bpmn:incoming>
      <bpmn:outgoing>WF03_AF01</bpmn:outgoing>
      <bpmn:outgoing>WF03_AF02</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="WF03_A02" name="대응 자사품목과 제공할 제작기준을 확인한다">
      <bpmn:documentation>대응 자사품목이 있으면 관련 칼선·규격을 준비한다. 대응 품목이 없으면 확보한 제작기준으로 진행한다.
입력 자료: 수탁 신규 품목
전달 자료: 의뢰사에 제공할 해당 자재의 칼선 도면과 규격 자료</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀","scope":null}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"수탁 신규 품목","outputs":"의뢰사에 제공할 해당 자재의 칼선 도면과 규격 자료","businessRules":[],"approvedQuestionIds":[],"perspective":"asis","phase":"현행","functionIds":[],"sourceRefs":[{"path":"CODEX.md","ref":"수탁 신규·개정과 최신 고객 정정: 수탁 허가증은 동국 검토 소관 아님"},{"path":"docs/22_URS원문.md","ref":"AN-01~14·AO-01~12·AN-04-01·AO-04-01"},{"path":"docs/23_업무규칙장부.md","ref":"품목-13·단계-21·단계-22·전달-05"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-96·M-101"}],"workflowId":"WF03","originalStepId":"WF03_A02","actorDetail":"수탁팀 또는 개발부·QS팀","sourceSteps":[],"level":"context","scope":null}</bpmn:documentation>
      <bpmn:incoming>WF03_AF01</bpmn:incoming>
      <bpmn:outgoing>WF03_AF03</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="WF03_A03" name="해당 수탁 자재의 기존 자사용 승인본을 확인한다">
      <bpmn:documentation>그 수탁 자재의 기존 동국용 승인 Artwork와 규격을 비교 기준으로 확보한다.
입력 자료: 수탁 개정 대상
전달 자료: 수탁 개정에서 비교할 해당 자재의 기존 동국제약용 승인 Artwork와 변경 근거자료</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀","scope":null}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"수탁 개정 대상","outputs":"수탁 개정에서 비교할 해당 자재의 기존 동국제약용 승인 Artwork와 변경 근거자료","businessRules":[],"approvedQuestionIds":[],"perspective":"asis","phase":"현행","functionIds":[],"sourceRefs":[{"path":"CODEX.md","ref":"수탁 신규·개정과 최신 고객 정정: 수탁 허가증은 동국 검토 소관 아님"},{"path":"docs/22_URS원문.md","ref":"AN-01~14·AO-01~12·AN-04-01·AO-04-01"},{"path":"docs/23_업무규칙장부.md","ref":"품목-13·단계-21·단계-22·전달-05"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-96·M-101"}],"workflowId":"WF03","originalStepId":"WF03_A03","actorDetail":"QS팀","sourceSteps":[],"level":"context","scope":null}</bpmn:documentation>
      <bpmn:incoming>WF03_AF02</bpmn:incoming>
      <bpmn:outgoing>WF03_AF04</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="J_WF03_A04" name="경로 합류" gatewayDirection="Converging">
      <bpmn:documentation>해당 경로의 업무 결과를 이어 받는다.
