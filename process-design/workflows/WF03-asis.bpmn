<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="WF03_A_Collaboration" name="수탁 의뢰사 도안과 제작기준 검토 · 현재 업무">
    <bpmn:documentation>의뢰사가 만든 도안을 동국 기준과 확인하고, 수정 왕복 후 동국용 디자인 작업으로 넘긴다.
입력 자료: 수탁 신규·개정의 대상과 의뢰사 요청
전달 자료: 디자인팀이 동국제약용 Artwork를 제작할 때 사용할 편집 가능한 의뢰사 원본과 칼선·규격·수정 내용</bpmn:documentation>
    <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"수탁 신규·개정의 대상과 의뢰사 요청","outputs":"디자인팀이 동국제약용 Artwork를 제작할 때 사용할 편집 가능한 의뢰사 원본과 칼선·규격·수정 내용","perspective":"asis","sourceRefs":[{"path":"CODEX.md","ref":"수탁 신규·개정의 현행 기본업무: 의뢰사 도안·동국 제작기준 검토"},{"path":"docs/22_URS원문.md","ref":"AN-01~14·AO-01~12·AN-04-01·AO-04-01"},{"path":"docs/23_업무규칙장부.md","ref":"품목-13·단계-21·단계-22·전달-05"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-96·M-101"}],"workflowId":"WF03","sourceSteps":[],"level":"context","scope":null}</bpmn:documentation>
    <bpmn:participant id="Participant_WF03_A_Process" name="수탁 의뢰사 도안과 제작기준 검토 · 현재 업무" processRef="WF03_A_Process" />
  </bpmn:collaboration>
  <bpmn:process id="WF03_A_Process" isExecutable="false">
    <bpmn:laneSet id="LaneSet_WF03_A_Process">
      <bpmn:lane id="Lane_WF03_A_Process_R0" name="수탁담당">
        <bpmn:flowNodeRef>WF03_A_START1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF03_A01</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_WF03_A_Process_R1" name="QS팀">
        <bpmn:flowNodeRef>WF03_A02</bpmn:flowNodeRef>
