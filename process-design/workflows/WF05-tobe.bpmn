<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="WF05_T_Collaboration" name="허가·문안 대조와 주석 작성 · 도입 후 업무">
    <bpmn:documentation>AI 판독·제안, 규칙 대조, 담당자 판단을 구분하고 자재별 차수에 남긴다.
입력 자료: QS가 검토를 시작할 파일
전달 자료: 보존된 차수와 주석 또는 후속 검토</bpmn:documentation>
    <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"QS가 검토를 시작할 파일","outputs":"보존된 차수와 주석 또는 후속 검토","perspective":"tobe","sourceRefs":[{"path":"docs/20_회의록_2026-09-22.md","ref":"M-42·M-58·M-61 / 허가 전 자료로 검토·주석"},{"path":"docs/23_업무규칙장부.md","ref":"허가-08·자료-01·자료-04·기준-06·차수-08·차수-11·수정-01"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"2장 판독·대조·검토·주석"},{"path":"CODEX.md","ref":"문안은 글 중심 기준자료, QS는 Artwork 반영 여부 검토"}],"workflowId":"WF05"}</bpmn:documentation>
    <bpmn:participant id="Participant_WF05_T_Process" name="허가·문안 대조와 주석 작성 · 도입 후 업무" processRef="WF05_T_Process" />
  </bpmn:collaboration>
  <bpmn:process id="WF05_T_Process" isExecutable="false">
    <bpmn:laneSet id="LaneSet_WF05_T_Process">
      <bpmn:lane id="Lane_WF05_T_Process_R0" name="QS팀">
        <bpmn:flowNodeRef>WF05_T00</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J_WF05_T01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF05_T01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J_WF05_T02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF05_T02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF05_T03</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF05_T04</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF05_T05</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF05_T07</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF05_T08</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF05_T09</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF05_T12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF05_T10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF05_T11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF05_T13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF05_T10_RESULT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF05_T11_RESULT</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_WF05_T_Process_R1" name="시스템">
        <bpmn:flowNodeRef>WF05_T06</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="WF05_T00" name="QS가 해당 자재의 검토를 시작한다">
      <bpmn:documentation>검토할 파일과 목적을 확인하고 검토 차수 시작으로 이어 간다.
입력 자료: 수령한 도안과 이번 검토 목적
전달 자료: 검토할 자재별 도안</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"수령한 도안과 이번 검토 목적","outputs":"검토할 자재별 도안","businessRules":[],"perspective":"tobe","phase":"Phase 1","functionIds":[],"sourceRefs":[{"path":"docs/20_회의록_2026-09-22.md","ref":"M-42·M-58·M-61 / 허가 전 자료로 검토·주석"},{"path":"docs/23_업무규칙장부.md","ref":"허가-08·자료-01·자료-04·기준-06·차수-08·차수-11·수정-01"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"2장 판독·대조·검토·주석"},{"path":"CODEX.md","ref":"문안은 글 중심 기준자료, QS는 Artwork 반영 여부 검토"}],"workflowId":"WF05","originalStepId":"WF05_T00","actorDetail":"QS 담당자"}</bpmn:documentation>
      <bpmn:outgoing>WF05_T00_START_FLOW</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="J_WF05_T01" name="경로 합류" gatewayDirection="Converging">
      <bpmn:documentation>해당 경로의 업무 결과를 이어 받는다.
입력 자료: 검토할 Artwork와 수령 내용
전달 자료: 검토할 Artwork와 수령 내용</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"검토할 Artwork와 수령 내용","outputs":"검토할 Artwork와 수령 내용","gatewayDirection":"Converging","gatewayMeaning":"경로 합류","perspective":"tobe","workflowId":"WF05","originalStepId":"WF05_T01"}</bpmn:documentation>
      <bpmn:incoming>WF05_T00_START_FLOW</bpmn:incoming>
      <bpmn:incoming>WF05_TG3</bpmn:incoming>
      <bpmn:outgoing>WF05_T_JOIN_WF05_T01</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="WF05_T01" name="QS가 검토 차수를 시작하고 이유를 남긴다">
      <bpmn:documentation>초안·수정 반영·생산 의견·허가증 도착 등 검토 목적을 기록한다. 자재별로 차수를 관리한다.
입력 자료: 검토할 Artwork와 수령 내용
전달 자료: 해당 자재의 검토 차수</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"검토할 Artwork와 수령 내용","outputs":"해당 자재의 검토 차수","businessRules":[],"perspective":"tobe","phase":"Phase 1","functionIds":["K-검토-02","K-검토-03"],"sourceRefs":[{"path":"docs/20_회의록_2026-09-22.md","ref":"M-42·M-58·M-61 / 허가 전 자료로 검토·주석"},{"path":"docs/23_업무규칙장부.md","ref":"허가-08·자료-01·자료-04·기준-06·차수-08·차수-11·수정-01"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"2장 판독·대조·검토·주석"},{"path":"CODEX.md","ref":"문안은 글 중심 기준자료, QS는 Artwork 반영 여부 검토"}],"workflowId":"WF05","originalStepId":"WF05_T01","actorDetail":"QS 담당자"}</bpmn:documentation>
      <bpmn:incoming>WF05_T_JOIN_WF05_T01</bpmn:incoming>
      <bpmn:outgoing>WF05_TF01</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="J_WF05_T02" name="경로 합류" gatewayDirection="Converging">
      <bpmn:documentation>해당 경로의 업무 결과를 이어 받는다.
입력 자료: 허가증·문안·시방서·칼선·품목정보
전달 자료: 허가증·문안·시방서·칼선·품목정보</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"허가증·문안·시방서·칼선·품목정보","outputs":"허가증·문안·시방서·칼선·품목정보","gatewayDirection":"Converging","gatewayMeaning":"경로 합류","perspective":"tobe","workflowId":"WF05","originalStepId":"WF05_T02"}</bpmn:documentation>
      <bpmn:incoming>WF05_TF01</bpmn:incoming>
      <bpmn:incoming>WF05_TF05</bpmn:incoming>
      <bpmn:outgoing>WF05_T_JOIN_WF05_T02</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="WF05_T02" name="이번 차수의 기준자료와 적용 범위를 정한다">
      <bpmn:documentation>이번 검토 목적과 변경 범위에서 허가 대조가 필요한지 먼저 정한다. 해당 범위의 허가증·문안·변경 근거와 자재 유형·제형·표시면적 등의 적용 조건 및 자료 판을 확인한다.
입력 자료: 허가증·문안·시방서·칼선·품목정보
전달 자료: 고정된 기준자료와 적용 조건</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"허가증·문안·시방서·칼선·품목정보","outputs":"고정된 기준자료와 적용 조건","businessRules":[],"perspective":"tobe","phase":"Phase 1","functionIds":["K-대조-01","K-대조-02","K-대조-03","K-대조-05"],"sourceRefs":[{"path":"docs/20_회의록_2026-09-22.md","ref":"M-42·M-58·M-61 / 허가 전 자료로 검토·주석"},{"path":"docs/23_업무규칙장부.md","ref":"허가-08·자료-01·자료-04·기준-06·차수-08·차수-11·수정-01"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"2장 판독·대조·검토·주석"},{"path":"CODEX.md","ref":"문안은 글 중심 기준자료, QS는 Artwork 반영 여부 검토"}],"workflowId":"WF05","originalStepId":"WF05_T02","actorDetail":"QS 담당자"}</bpmn:documentation>
      <bpmn:incoming>WF05_T_JOIN_WF05_T02</bpmn:incoming>
      <bpmn:outgoing>WF05_TF02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="WF05_T03" name="도안·기준자료의 판독값을 확인한다">
      <bpmn:documentation>AI 판독 결과를 사용하되 QS가 값과 위치를 확인한다. 글자·위치·규격의 판독값을 확인하고 오류를 고친다. 작업의뢰 본문과 결재 의견이 다르면 유효값을 확인한다.
입력 자료: 선택한 파일
전달 자료: 확인한 판독값</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"선택한 파일","outputs":"확인한 판독값","businessRules":[],"perspective":"tobe","phase":"Phase 1","functionIds":["K-판독-02","K-판독-03","K-판독-04","K-판독-06","K-판독-07"],"sourceRefs":[{"path":"docs/20_회의록_2026-09-22.md","ref":"M-42·M-58·M-61 / 허가 전 자료로 검토·주석"},{"path":"docs/23_업무규칙장부.md","ref":"허가-08·자료-01·자료-04·기준-06·차수-08·차수-11·수정-01"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"2장 판독·대조·검토·주석"},{"path":"CODEX.md","ref":"문안은 글 중심 기준자료, QS는 Artwork 반영 여부 검토"}],"workflowId":"WF05","originalStepId":"WF05_T03","actorDetail":"QS 담당자"}</bpmn:documentation>
      <bpmn:incoming>WF05_TF02</bpmn:incoming>
      <bpmn:outgoing>WF05_TF03</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="WF05_T04" name="이번 항목에 비교할 근거가 있는가?" gatewayDirection="Diverging" default="WF05_TF06">
      <bpmn:documentation>대조 항목별로 누락·판독불가·기준 상충을 확인한다. 근거가 없는 항목은 자료 대기로 남기고 확보 자료로 가능한 다른 항목·자재의 검토는 계속한다.
입력 자료: 판독값과 자료 현황
전달 자료: 대조 가능 범위와 자료 대기</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"판독값과 자료 현황","outputs":"대조 가능 범위와 자료 대기","gatewayDirection":"Diverging","businessRules":[],"gatewayMeaning":"하나 선택","perspective":"tobe","phase":"Phase 1","functionIds":["K-대조-06","K-대조-09"],"sourceRefs":[{"path":"docs/20_회의록_2026-09-22.md","ref":"M-42·M-58·M-61 / 허가 전 자료로 검토·주석"},{"path":"docs/23_업무규칙장부.md","ref":"허가-08·자료-01·자료-04·기준-06·차수-08·차수-11·수정-01"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"2장 판독·대조·검토·주석"},{"path":"CODEX.md","ref":"문안은 글 중심 기준자료, QS는 Artwork 반영 여부 검토"}],"workflowId":"WF05","originalStepId":"WF05_T04","actorDetail":"QS 담당자"}</bpmn:documentation>
      <bpmn:incoming>WF05_TF03</bpmn:incoming>
      <bpmn:outgoing>WF05_TF04</bpmn:outgoing>
      <bpmn:outgoing>WF05_TF06</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="WF05_T05" name="해당 항목의 자료를 기다리거나 근거를 확인한다">
      <bpmn:documentation>부족한 항목의 자료·이유를 남긴다. 요청한 자료가 오면 그 항목의 비교 기준을 다시 확인한다. 다른 항목과 자재 전체를 중단시키지 않는다.
입력 자료: 부족하거나 상충한 자료
전달 자료: 보완한 기준자료</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"부족하거나 상충한 자료","outputs":"보완한 기준자료","businessRules":[],"perspective":"tobe","phase":"Phase 1","functionIds":["K-접수-08","K-판독-07"],"sourceRefs":[{"path":"docs/20_회의록_2026-09-22.md","ref":"M-42·M-58·M-61 / 허가 전 자료로 검토·주석"},{"path":"docs/23_업무규칙장부.md","ref":"허가-08·자료-01·자료-04·기준-06·차수-08·차수-11·수정-01"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"2장 판독·대조·검토·주석"},{"path":"CODEX.md","ref":"문안은 글 중심 기준자료, QS는 Artwork 반영 여부 검토"}],"workflowId":"WF05","originalStepId":"WF05_T05","actorDetail":"QS 담당자"}</bpmn:documentation>
      <bpmn:incoming>WF05_TF04</bpmn:incoming>
      <bpmn:outgoing>WF05_TF05</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="WF05_T06" name="적용 대상 항목을 규칙으로 대조한다">
      <bpmn:documentation>이번 검토 목적과 적용 범위의 항목을 대조한다. 허가 대조 대상은 허가·문안을, 다른 개정은 해당 변경 근거를 사용한다. 규격·표준표시·바코드 등 적용 항목을 확인하며 미확보 항목은 자료 대기로 표시한다. 공용 자재는 해당 품목별 기준을 확인한다.
입력 자료: 확인된 판독값·적용 조건·기준
전달 자료: 항목별 규칙 결과와 위치
업무 규칙: 허가증 원본 없는 항목은 허가 대조를 확정하지 않는다. / 공개 허가정보는 참고용이다.</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"시스템"}</bpmn:documentation>
