    <bpmn:userTask id="WF05_T11" name="후속 결과 취합·내용 확정으로 이어 간다">
      <bpmn:documentation>해당 경로의 후속 검토 조건을 확인한다. 자사 신규의 생산 관련 검토는 허가증 검토를 마친 파일로 연결한다. 조건이 남았으면 그 자료·항목의 대기를 유지한다.
입력 자료: 이번 차수의 판단
전달 자료: 생산·관련 부서의 결과 취합과 내용 확정 검토에 사용할 Artwork, 적용 자료와 QS 판단 기록</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀","scope":null}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"이번 차수의 판단","outputs":"생산·관련 부서의 결과 취합과 내용 확정 검토에 사용할 Artwork, 적용 자료와 QS 판단 기록","businessRules":[],"approvedQuestionIds":[],"perspective":"tobe","phase":"Phase 1","functionIds":["K-검토-12","C-10","C-15"],"sourceRefs":[{"path":"docs/20_회의록_2026-09-22.md","ref":"M-42·M-58·M-61 / 허가 전 자료로 검토·주석"},{"path":"docs/23_업무규칙장부.md","ref":"허가-08·자료-01·자료-04·기준-06·차수-08·차수-11·수정-01"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"2장 판독·대조·검토·주석"},{"path":"CODEX.md","ref":"문안은 글 중심 기준자료, QS는 Artwork 반영 여부 검토"}],"workflowId":"WF05","originalStepId":"WF05_T11","actorDetail":"QS 담당자","sourceSteps":[],"level":"context","scope":null}</bpmn:documentation>
