  <bpmn:collaboration id="WF05_T_Collaboration" name="허가·문안 대조와 주석 작성 · 도입 후 업무">
    <bpmn:documentation>AI 판독·제안, 규칙 대조, 담당자 판단을 구분하고 자재별 차수에 남긴다.
입력 자료: QS가 검토를 시작할 파일
전달 자료: 마감한 검토 차수와 디자인팀에 전달한 주석본·수정 요청, 또는 결과 취합·내용 확정에 사용할 Artwork와 QS 판단 기록</bpmn:documentation>
    <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"QS가 검토를 시작할 파일","outputs":"마감한 검토 차수와 디자인팀에 전달한 주석본·수정 요청, 또는 결과 취합·내용 확정에 사용할 Artwork와 QS 판단 기록","perspective":"tobe","sourceRefs":[{"path":"docs/20_회의록_2026-09-22.md","ref":"M-42·M-58·M-61 / 허가 전 자료로 검토·주석"},{"path":"docs/23_업무규칙장부.md","ref":"허가-08·자료-01·자료-04·기준-06·차수-08·차수-11·수정-01"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"2장 판독·대조·검토·주석"},{"path":"CODEX.md","ref":"문안은 글 중심 기준자료, QS는 Artwork 반영 여부 검토"}],"workflowId":"WF05","sourceSteps":[],"level":"context","scope":null}</bpmn:documentation>
    <bpmn:participant id="Participant_WF05_T_Process" name="허가·문안 대조와 주석 작성 · 도입 후 업무" processRef="WF05_T_Process" />
  </bpmn:collaboration>
  <bpmn:process id="WF05_T_Process" isExecutable="false">
    <bpmn:laneSet id="LaneSet_WF05_T_Process">
      <bpmn:lane id="Lane_WF05_T_Process_R0" name="QS팀">
