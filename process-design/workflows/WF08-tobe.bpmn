      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"확정할 마지막 검토 차수","outputs":"전환 대조의 고정 기준본","businessRules":[],"perspective":"tobe","phase":"Phase 1","functionIds":["K-검토-12","K-검토-13"],"sourceRefs":[{"path":"docs/22_URS원문.md","ref":"ON 최종화·OO-13·GN 최종안·GO 최종안·AN-23~24·AO 최종화·CR-58"},{"path":"docs/23_업무규칙장부.md","ref":"차수-13·차수-14·차수-23·승인-01·승인-05·승인-06·승인-11·개정-01"},{"path":"CODEX.md","ref":"내용 확정·최종 전환·QS 완료의 구분"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"K-검토-12~15 / T-14"}],"workflowId":"WF08","originalStepId":"WF08_T03","actorDetail":"QS 담당자"}</bpmn:documentation>
