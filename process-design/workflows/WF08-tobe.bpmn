      <bpmn:incoming>WF08_TF07</bpmn:incoming>
      <bpmn:outgoing>WF08_TF08</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="WF08_T12" name="현재 차수의 판단·판독을 보완한다">
      <bpmn:documentation>판독값이나 담당자 판단을 보완하고 확정 전 상태를 다시 확인한다.
