    <bpmn:userTask id="WF08_T01" name="확정 전 남은 항목을 확인한다">
      <bpmn:documentation>항목별 확인 상태와 경고·예외 조건을 확인한다. 유관 부서 미회신만으로 자동 차단하지 않는다.
입력 자료: 미해소 요청·판독·기준자료·후속 회신
전달 자료: 남은 수정요청·확인필요 항목과 내용 확정 가능 여부에 대한 QS 점검 결과</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀","scope":null}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"미해소 요청·판독·기준자료·후속 회신","outputs":"남은 수정요청·확인필요 항목과 내용 확정 가능 여부에 대한 QS 점검 결과","businessRules":[],"approvedQuestionIds":[],"perspective":"tobe","phase":"Phase 1","functionIds":["K-검토-12"],"sourceRefs":[{"path":"docs/22_URS원문.md","ref":"ON 최종화·OO-13·GN 최종안·GO 최종안·AN-23~24·AO 최종화·CR-58"},{"path":"docs/23_업무규칙장부.md","ref":"차수-13·차수-14·차수-23·승인-01·승인-05·승인-06·승인-11·개정-01"},{"path":"CODEX.md","ref":"내용 확정·최종 전환·QS 완료의 구분"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"K-검토-12~15 / T-14"}],"workflowId":"WF08","originalStepId":"WF08_T01","actorDetail":"QS 담당자","sourceSteps":[],"level":"context","scope":null}</bpmn:documentation>
