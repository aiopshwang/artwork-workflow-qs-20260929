      <bpmn:outgoing>WF08_TF04</bpmn:outgoing>
      <bpmn:outgoing>WF08_TF06</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="WF08_T04" name="최종 전환 파일을 요청해 받는다">
      <bpmn:documentation>확정 기준의 최종 Illustrator·PDF 파일을 받고 전환 목적의 작업으로 연결한다.
