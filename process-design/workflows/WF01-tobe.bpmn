        <bpmn:flowNodeRef>WF01_T11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF01_T11_RESULT</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_WF01_T_Process_R1" name="시스템">
        <bpmn:flowNodeRef>WF01_T01_SYS_RESPONSE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF01_T02_SYS_RESPONSE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF01_T04_SYS_RESPONSE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF01_T05_SYS_RESPONSE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF01_T07_SYS_RESPONSE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF01_T12_SYS_RESPONSE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF01_T10_SYS_RESPONSE</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="WF01_T_START1" name="시작">
      <bpmn:documentation>QS가 받은 요청을 시스템에 등록
입력 자료: QS가 받은 요청을 시스템에 등록
전달 자료: 외부에서 받은 요청과 첨부파일</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"QS가 받은 요청을 시스템에 등록","outputs":"외부에서 받은 요청과 첨부파일","perspective":"tobe","workflowId":"WF01"}</bpmn:documentation>
      <bpmn:outgoing>WF01_T_START_FLOW1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="WF01_T01" name="요청 자료를 올리고 업무 경로를 고른다">
      <bpmn:documentation>자사·위탁·수탁, 신규·개정을 지정하고 수령일·요청자를 남긴다. 전자결재 자동 연동은 하지 않는다.
입력 자료: 외부에서 받은 요청과 첨부파일
전달 자료: 등록된 요청 원본과 선택한 자사·위탁·수탁 및 신규·개정 구분</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀","scope":null}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"외부에서 받은 요청과 첨부파일","outputs":"등록된 요청 원본과 선택한 자사·위탁·수탁 및 신규·개정 구분","businessRules":[],"approvedQuestionIds":[],"perspective":"tobe","phase":"Phase 1","functionIds":["K-접수-01","K-접수-04"],"sourceRefs":[{"path":"CODEX.md","ref":"현행 업무의 시작·대상 자재 확인: 사용자 승인 4단계"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-18·M-22·M-30·M-77·M-96"},{"path":"docs/22_URS원문.md","ref":"O-01·A-01·G-01"},{"path":"docs/23_업무규칙장부.md","ref":"접수-02·접수-04·접수-07·접수-08·접수-12·접수-13"}],"workflowId":"WF01","originalStepId":"WF01_T01","actorDetail":"QS 담당자","sourceSteps":[],"level":"context","scope":null}</bpmn:documentation>
      <bpmn:incoming>WF01_T_START_FLOW1</bpmn:incoming>
      <bpmn:outgoing>WF01_T01_SYS_RESPONSE_FLOW</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="WF01_T01_SYS_RESPONSE" name="요청 원본과 선택한 업무 경로를 저장하고 확인할 항목을 보여준다">
      <bpmn:documentation>올린 요청 파일과 선택한 자사·위탁·수탁 및 신규·개정 구분을 저장한다. 자료 종류와 대상 후보는 제안으로 구별해 보여준다.
입력 자료: 등록된 요청 원본과 선택한 자사·위탁·수탁 및 신규·개정 구분
전달 자료: 등록된 요청 원본과 선택한 자사·위탁·수탁 및 신규·개정 구분</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"시스템","scope":null}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"등록된 요청 원본과 선택한 자사·위탁·수탁 및 신규·개정 구분","outputs":"등록된 요청 원본과 선택한 자사·위탁·수탁 및 신규·개정 구분","businessRules":[],"approvedQuestionIds":[],"perspective":"tobe","phase":"Phase 1","functionIds":["K-접수-01","K-접수-04"],"sourceRefs":[{"path":"CODEX.md","ref":"현행 업무의 시작·대상 자재 확인: 사용자 승인 4단계"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-18·M-22·M-30·M-77·M-96"},{"path":"docs/22_URS원문.md","ref":"O-01·A-01·G-01"},{"path":"docs/23_업무규칙장부.md","ref":"접수-02·접수-04·접수-07·접수-08·접수-12·접수-13"}],"workflowId":"WF01","originalStepId":"WF01_T01_SYS_RESPONSE","actorDetail":"Artwork 시스템","sourceSteps":["WF01_T01"],"level":"context","scope":null}</bpmn:documentation>
      <bpmn:incoming>WF01_T01_SYS_RESPONSE_FLOW</bpmn:incoming>
      <bpmn:outgoing>WF01_TF01</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="WF01_T02" name="품목·대상 자재와 요청 내용을 확인한다">
      <bpmn:documentation>AI의 자료 종류·대상 후보를 확인·수정하고 담당자·기한을 정한다.
입력 자료: 접수 원본
전달 자료: QS 담당자가 확인한 요청 품목, 대상 표시자재와 작업 내용</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀","scope":null}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"접수 원본","outputs":"QS 담당자가 확인한 요청 품목, 대상 표시자재와 작업 내용","businessRules":[],"approvedQuestionIds":["CQ-01"],"perspective":"tobe","phase":"Phase 1","functionIds":["K-접수-02","K-접수-03","K-접수-05"],"sourceRefs":[{"path":"CODEX.md","ref":"현행 업무의 시작·대상 자재 확인: 사용자 승인 4단계"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-18·M-22·M-30·M-77·M-96"},{"path":"docs/22_URS원문.md","ref":"O-01·A-01·G-01"},{"path":"docs/23_업무규칙장부.md","ref":"접수-02·접수-04·접수-07·접수-08·접수-12·접수-13"}],"workflowId":"WF01","originalStepId":"WF01_T02","actorDetail":"QS 담당자","sourceSteps":[],"level":"context","scope":null}</bpmn:documentation>
      <bpmn:incoming>WF01_TF01</bpmn:incoming>
      <bpmn:outgoing>WF01_T02_SYS_RESPONSE_FLOW</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="WF01_T02_SYS_RESPONSE" name="확인한 품목·자재·담당자·기한을 저장한다">
      <bpmn:documentation>QS 담당자가 확인·수정한 요청 내용을 저장하고 등록된 값을 다시 보여준다.
입력 자료: QS 담당자가 확인한 요청 품목, 대상 표시자재와 작업 내용
전달 자료: QS 담당자가 확인한 요청 품목, 대상 표시자재와 작업 내용</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"시스템","scope":null}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"QS 담당자가 확인한 요청 품목, 대상 표시자재와 작업 내용","outputs":"QS 담당자가 확인한 요청 품목, 대상 표시자재와 작업 내용","businessRules":[],"approvedQuestionIds":[],"perspective":"tobe","phase":"Phase 1","functionIds":["K-접수-02","K-접수-03","K-접수-05"],"sourceRefs":[{"path":"CODEX.md","ref":"현행 업무의 시작·대상 자재 확인: 사용자 승인 4단계"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-18·M-22·M-30·M-77·M-96"},{"path":"docs/22_URS원문.md","ref":"O-01·A-01·G-01"},{"path":"docs/23_업무규칙장부.md","ref":"접수-02·접수-04·접수-07·접수-08·접수-12·접수-13"}],"workflowId":"WF01","originalStepId":"WF01_T02_SYS_RESPONSE","actorDetail":"Artwork 시스템","sourceSteps":["WF01_T02"],"level":"context","scope":null}</bpmn:documentation>
      <bpmn:incoming>WF01_T02_SYS_RESPONSE_FLOW</bpmn:incoming>
      <bpmn:outgoing>WF01_TF02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="WF01_T03" name="개정 또는 외부 변경 요청인가?" gatewayDirection="Diverging" default="WF01_TF04">
      <bpmn:documentation>기존 승인본에 대한 변경인지, 신규 제작인지 구분한다.
입력 자료: 업무 경로와 요청 내용
전달 자료: 변경 근거 등록 여부</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀","scope":null}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"업무 경로와 요청 내용","outputs":"변경 근거 등록 여부","gatewayDirection":"Diverging","businessRules":[],"gatewayMeaning":"하나 선택","approvedQuestionIds":[],"perspective":"tobe","phase":"Phase 1","functionIds":["K-접수-01","K-접수-10"],"sourceRefs":[{"path":"CODEX.md","ref":"현행 업무의 시작·대상 자재 확인: 사용자 승인 4단계"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-18·M-22·M-30·M-77·M-96"},{"path":"docs/22_URS원문.md","ref":"O-01·A-01·G-01"},{"path":"docs/23_업무규칙장부.md","ref":"접수-02·접수-04·접수-07·접수-08·접수-12·접수-13"}],"workflowId":"WF01","originalStepId":"WF01_T03","actorDetail":"QS 담당자","sourceSteps":[],"level":"context","scope":null}</bpmn:documentation>
      <bpmn:incoming>WF01_TF02</bpmn:incoming>
      <bpmn:outgoing>WF01_TF03</bpmn:outgoing>
      <bpmn:outgoing>WF01_TF04</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="WF01_T04" name="변경 근거·사유·적용 대상을 연결한다">
      <bpmn:documentation>변경 내용과 적용 시점, 영향 품목·자재를 확인하고 포함·제외 대상을 정한다.
입력 자료: 변경대비표·통지·메일과 직전 승인본
전달 자료: 개정 요청에 연결한 변경 근거자료, 변경 사유와 적용 대상 자재</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀","scope":null}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"변경대비표·통지·메일과 직전 승인본","outputs":"개정 요청에 연결한 변경 근거자료, 변경 사유와 적용 대상 자재","businessRules":[],"approvedQuestionIds":[],"perspective":"tobe","phase":"Phase 1","functionIds":["K-접수-10","K-접수-11","K-접수-12","B-15"],"sourceRefs":[{"path":"CODEX.md","ref":"현행 업무의 시작·대상 자재 확인: 사용자 승인 4단계"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-18·M-22·M-30·M-77·M-96"},{"path":"docs/22_URS원문.md","ref":"O-01·A-01·G-01"},{"path":"docs/23_업무규칙장부.md","ref":"접수-02·접수-04·접수-07·접수-08·접수-12·접수-13"}],"workflowId":"WF01","originalStepId":"WF01_T04","actorDetail":"QS 담당자","sourceSteps":[],"level":"context","scope":null}</bpmn:documentation>
      <bpmn:incoming>WF01_TF03</bpmn:incoming>
      <bpmn:outgoing>WF01_T04_SYS_RESPONSE_FLOW</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="J_WF01_T05" name="경로 합류" gatewayDirection="Converging">
      <bpmn:documentation>해당 경로의 업무 결과를 이어 받는다.
입력 자료: 확정한 대상 자재
전달 자료: 확정한 대상 자재</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"확정한 대상 자재","outputs":"확정한 대상 자재","gatewayDirection":"Converging","gatewayMeaning":"경로 합류","perspective":"tobe","workflowId":"WF01","originalStepId":"WF01_T05"}</bpmn:documentation>
      <bpmn:incoming>WF01_TF04</bpmn:incoming>
      <bpmn:incoming>WF01_TF05</bpmn:incoming>
      <bpmn:outgoing>WF01_T_JOIN_WF01_T05</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="WF01_T04_SYS_RESPONSE" name="변경 근거와 적용 대상 자재를 연결해 보관한다">
      <bpmn:documentation>담당자가 선택한 변경 자료·사유·적용 대상과 포함·제외 내용을 요청에 연결한다.
입력 자료: 개정 요청에 연결한 변경 근거자료, 변경 사유와 적용 대상 자재
전달 자료: 개정 요청에 연결한 변경 근거자료, 변경 사유와 적용 대상 자재</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"시스템","scope":null}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"개정 요청에 연결한 변경 근거자료, 변경 사유와 적용 대상 자재","outputs":"개정 요청에 연결한 변경 근거자료, 변경 사유와 적용 대상 자재","businessRules":[],"approvedQuestionIds":[],"perspective":"tobe","phase":"Phase 1","functionIds":["K-접수-10","K-접수-11","K-접수-12","B-15"],"sourceRefs":[{"path":"CODEX.md","ref":"현행 업무의 시작·대상 자재 확인: 사용자 승인 4단계"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-18·M-22·M-30·M-77·M-96"},{"path":"docs/22_URS원문.md","ref":"O-01·A-01·G-01"},{"path":"docs/23_업무규칙장부.md","ref":"접수-02·접수-04·접수-07·접수-08·접수-12·접수-13"}],"workflowId":"WF01","originalStepId":"WF01_T04_SYS_RESPONSE","actorDetail":"Artwork 시스템","sourceSteps":["WF01_T04"],"level":"context","scope":null}</bpmn:documentation>
