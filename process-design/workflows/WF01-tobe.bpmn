<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="WF01_T_Collaboration" name="의뢰·변경 요청과 대상 자재 확인 · 도입 후 업무">
    <bpmn:documentation>요청 원본을 등록하고 자재별 검토 건·자료·변경 근거를 연결한다.
입력 자료: QS가 받은 요청을 시스템에 등록
전달 자료: 자료가 연결된 자재별 검토 건, 기존 건에 편입한 추가 요청 또는 앞선 개정 종료까지 보관한 요청</bpmn:documentation>
    <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"QS가 받은 요청을 시스템에 등록","outputs":"자료가 연결된 자재별 검토 건, 기존 건에 편입한 추가 요청 또는 앞선 개정 종료까지 보관한 요청","perspective":"tobe","sourceRefs":[{"path":"CODEX.md","ref":"현행 업무의 시작·대상 자재 확인: 사용자 승인 4단계"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-18·M-22·M-30·M-77·M-96"},{"path":"docs/22_URS원문.md","ref":"O-01·A-01·G-01"},{"path":"docs/23_업무규칙장부.md","ref":"접수-02·접수-04·접수-07·접수-08·접수-12·접수-13"}],"workflowId":"WF01","sourceSteps":[],"level":"context","scope":null}</bpmn:documentation>
    <bpmn:participant id="Participant_WF01_T_Process" name="의뢰·변경 요청과 대상 자재 확인 · 도입 후 업무" processRef="WF01_T_Process" />
  </bpmn:collaboration>
  <bpmn:process id="WF01_T_Process" isExecutable="false">
    <bpmn:laneSet id="LaneSet_WF01_T_Process">
      <bpmn:lane id="Lane_WF01_T_Process_R0" name="QS팀">
        <bpmn:flowNodeRef>WF01_T_START1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF01_T01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF01_T02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF01_T03</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF01_T04</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J_WF01_T05</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF01_T05</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF01_T06</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF01_T07</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J_WF01_T08</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF01_T12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF01_T08</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF01_T07_RESULT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF01_T09</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF01_T12_RESULT</bpmn:flowNodeRef>
