<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="WF01_T_Collaboration" name="의뢰·변경 요청과 대상 자재 확인 · 도입 후 업무">
    <bpmn:documentation>요청 원본을 등록하고 자재별 검토 건·자료·변경 근거를 연결한다.
입력 자료: QS가 받은 요청을 시스템에 등록
전달 자료: 새 자재별 준비 업무 또는 기존 건에 편입된 요청</bpmn:documentation>
    <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"QS가 받은 요청을 시스템에 등록","outputs":"새 자재별 준비 업무 또는 기존 건에 편입된 요청","perspective":"tobe","sourceRefs":[{"path":"CODEX.md","ref":"현행 업무의 시작·대상 자재 확인: 사용자 승인 4단계"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-18·M-22·M-30·M-77·M-96"},{"path":"docs/22_URS원문.md","ref":"O-01·A-01·G-01"},{"path":"docs/23_업무규칙장부.md","ref":"접수-02·접수-04·접수-07·접수-08·접수-12·접수-13"}],"workflowId":"WF01"}</bpmn:documentation>
    <bpmn:participant id="Participant_WF01_T_Process" name="의뢰·변경 요청과 대상 자재 확인 · 도입 후 업무" processRef="WF01_T_Process" />
  </bpmn:collaboration>
  <bpmn:process id="WF01_T_Process" isExecutable="false">
    <bpmn:laneSet id="LaneSet_WF01_T_Process">
      <bpmn:lane id="Lane_WF01_T_Process_R0" name="QS팀">
        <bpmn:flowNodeRef>WF01_T_START1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF01_T01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF01_T02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF01_T03</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF01_T04</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J_WF01_T05</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF01_T05</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF01_T06</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF01_T07</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J_WF01_T08</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF01_T12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF01_T07_RESULT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF01_T08</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF01_T12_RESULT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF01_T09</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF01_T10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF01_T11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF01_T11_RESULT</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="WF01_T_START1" name="시작">
      <bpmn:documentation>QS가 받은 요청을 시스템에 등록
입력 자료: QS가 받은 요청을 시스템에 등록
전달 자료: 외부에서 받은 요청과 첨부파일</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"QS가 받은 요청을 시스템에 등록","outputs":"외부에서 받은 요청과 첨부파일","perspective":"tobe","workflowId":"WF01"}</bpmn:documentation>
      <bpmn:outgoing>WF01_T_START_FLOW1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="WF01_T01" name="요청 자료를 올리고 업무 경로를 고른다">
      <bpmn:documentation>자사·위탁·수탁, 신규·개정을 지정하고 수령일·요청자를 남긴다. 전자결재 자동 연동은 하지 않는다.
입력 자료: 외부에서 받은 요청과 첨부파일
전달 자료: 접수 원본과 선택한 경로</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"외부에서 받은 요청과 첨부파일","outputs":"접수 원본과 선택한 경로","businessRules":[],"perspective":"tobe","phase":"Phase 1","functionIds":["K-접수-01","K-접수-04"],"sourceRefs":[{"path":"CODEX.md","ref":"현행 업무의 시작·대상 자재 확인: 사용자 승인 4단계"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-18·M-22·M-30·M-77·M-96"},{"path":"docs/22_URS원문.md","ref":"O-01·A-01·G-01"},{"path":"docs/23_업무규칙장부.md","ref":"접수-02·접수-04·접수-07·접수-08·접수-12·접수-13"}],"workflowId":"WF01","originalStepId":"WF01_T01","actorDetail":"QS 담당자"}</bpmn:documentation>
      <bpmn:incoming>WF01_T_START_FLOW1</bpmn:incoming>
      <bpmn:outgoing>WF01_TF01</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="WF01_T02" name="품목·대상 자재와 요청 내용을 확인한다">
      <bpmn:documentation>AI의 자료 종류·대상 후보를 확인·수정하고 담당자·기한을 정한다.
입력 자료: 접수 원본
전달 자료: 담당자가 정한 접수 내용</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"접수 원본","outputs":"담당자가 정한 접수 내용","businessRules":[],"perspective":"tobe","phase":"Phase 1","functionIds":["K-접수-02","K-접수-03","K-접수-05"],"sourceRefs":[{"path":"CODEX.md","ref":"현행 업무의 시작·대상 자재 확인: 사용자 승인 4단계"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-18·M-22·M-30·M-77·M-96"},{"path":"docs/22_URS원문.md","ref":"O-01·A-01·G-01"},{"path":"docs/23_업무규칙장부.md","ref":"접수-02·접수-04·접수-07·접수-08·접수-12·접수-13"}],"workflowId":"WF01","originalStepId":"WF01_T02","actorDetail":"QS 담당자"}</bpmn:documentation>
      <bpmn:incoming>WF01_TF01</bpmn:incoming>
      <bpmn:outgoing>WF01_TF02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="WF01_T03" name="개정 또는 외부 변경 요청인가?" gatewayDirection="Diverging" default="WF01_TF04">
      <bpmn:documentation>기존 승인본에 대한 변경인지, 신규 제작인지 구분한다.
입력 자료: 업무 경로와 요청 내용
전달 자료: 변경 근거 등록 여부</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"업무 경로와 요청 내용","outputs":"변경 근거 등록 여부","gatewayDirection":"Diverging","businessRules":[],"gatewayMeaning":"하나 선택","perspective":"tobe","phase":"Phase 1","functionIds":["K-접수-01","K-접수-10"],"sourceRefs":[{"path":"CODEX.md","ref":"현행 업무의 시작·대상 자재 확인: 사용자 승인 4단계"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-18·M-22·M-30·M-77·M-96"},{"path":"docs/22_URS원문.md","ref":"O-01·A-01·G-01"},{"path":"docs/23_업무규칙장부.md","ref":"접수-02·접수-04·접수-07·접수-08·접수-12·접수-13"}],"workflowId":"WF01","originalStepId":"WF01_T03","actorDetail":"QS 담당자"}</bpmn:documentation>
      <bpmn:incoming>WF01_TF02</bpmn:incoming>
      <bpmn:outgoing>WF01_TF03</bpmn:outgoing>
      <bpmn:outgoing>WF01_TF04</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="WF01_T04" name="변경 근거·사유·적용 대상을 연결한다">
      <bpmn:documentation>변경 내용과 적용 시점, 영향 품목·자재를 확인하고 포함·제외 대상을 정한다.
입력 자료: 변경대비표·통지·메일과 직전 승인본
전달 자료: 변경 근거와 대상 범위</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"변경대비표·통지·메일과 직전 승인본","outputs":"변경 근거와 대상 범위","businessRules":[],"perspective":"tobe","phase":"Phase 1","functionIds":["K-접수-10","K-접수-11","K-접수-12","B-15"],"sourceRefs":[{"path":"CODEX.md","ref":"현행 업무의 시작·대상 자재 확인: 사용자 승인 4단계"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-18·M-22·M-30·M-77·M-96"},{"path":"docs/22_URS원문.md","ref":"O-01·A-01·G-01"},{"path":"docs/23_업무규칙장부.md","ref":"접수-02·접수-04·접수-07·접수-08·접수-12·접수-13"}],"workflowId":"WF01","originalStepId":"WF01_T04","actorDetail":"QS 담당자"}</bpmn:documentation>
      <bpmn:incoming>WF01_TF03</bpmn:incoming>
      <bpmn:outgoing>WF01_TF05</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="J_WF01_T05" name="경로 합류" gatewayDirection="Converging">
      <bpmn:documentation>해당 경로의 업무 결과를 이어 받는다.
입력 자료: 확정한 대상 자재
전달 자료: 확정한 대상 자재</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"확정한 대상 자재","outputs":"확정한 대상 자재","gatewayDirection":"Converging","gatewayMeaning":"경로 합류","perspective":"tobe","workflowId":"WF01","originalStepId":"WF01_T05"}</bpmn:documentation>
      <bpmn:incoming>WF01_TF04</bpmn:incoming>
      <bpmn:incoming>WF01_TF05</bpmn:incoming>
      <bpmn:outgoing>WF01_T_JOIN_WF01_T05</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="WF01_T05" name="자재마다 검토 대상을 나누고 자료를 연결한다">
      <bpmn:documentation>자재별 검토 건을 나누고 각 파일의 대상 자재를 확인한다. 자재코드가 없으면 임시 식별정보로 시작한다.
입력 자료: 확정한 대상 자재
전달 자료: 독립적으로 진행할 자재별 검토 건</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"확정한 대상 자재","outputs":"독립적으로 진행할 자재별 검토 건","businessRules":[],"perspective":"tobe","phase":"Phase 1","functionIds":["K-접수-17","K-접수-20"],"sourceRefs":[{"path":"CODEX.md","ref":"현행 업무의 시작·대상 자재 확인: 사용자 승인 4단계"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-18·M-22·M-30·M-77·M-96"},{"path":"docs/22_URS원문.md","ref":"O-01·A-01·G-01"},{"path":"docs/23_업무규칙장부.md","ref":"접수-02·접수-04·접수-07·접수-08·접수-12·접수-13"}],"workflowId":"WF01","originalStepId":"WF01_T05","actorDetail":"QS 담당자"}</bpmn:documentation>
      <bpmn:incoming>WF01_T_JOIN_WF01_T05</bpmn:incoming>
      <bpmn:outgoing>WF01_TF06</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="WF01_T06" name="진행 중인 같은 자재 건과 이번 요청을 어떻게 연결할까?" gatewayDirection="Diverging" default="WF01_TF30">
      <bpmn:documentation>같은 자재에 열린 개정이 있으면 기존 건에 편입하거나 새 요청을 대기로 보관한다. 열린 건이 없을 때만 새 준비 업무로 진행한다.
입력 자료: 자재와 진행 중인 건
전달 자료: 새 업무·기존 건 편입·요청 대기
업무 규칙: 같은 자재의 동시 확정을 만들지 않는다.</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"자재와 진행 중인 건","outputs":"새 업무·기존 건 편입·요청 대기","gatewayDirection":"Diverging","businessRules":["같은 자재의 동시 확정을 만들지 않는다."],"gatewayMeaning":"하나 선택","perspective":"tobe","phase":"Phase 1","functionIds":["K-접수-18"],"sourceRefs":[{"path":"CODEX.md","ref":"현행 업무의 시작·대상 자재 확인: 사용자 승인 4단계"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-18·M-22·M-30·M-77·M-96"},{"path":"docs/22_URS원문.md","ref":"O-01·A-01·G-01"},{"path":"docs/23_업무규칙장부.md","ref":"접수-02·접수-04·접수-07·접수-08·접수-12·접수-13"}],"workflowId":"WF01","originalStepId":"WF01_T06","actorDetail":"QS 담당자"}</bpmn:documentation>
      <bpmn:incoming>WF01_TF06</bpmn:incoming>
      <bpmn:outgoing>WF01_TF07</bpmn:outgoing>
      <bpmn:outgoing>WF01_TF08</bpmn:outgoing>
      <bpmn:outgoing>WF01_TF30</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="WF01_T07" name="기존 건에 요청을 연결한다">
      <bpmn:documentation>요청·자료·영향 범위를 기존 건에 추가하고 이미 시작한 차수의 기준은 보존한다.
입력 자료: 진행 중인 동일 자재 건
전달 자료: 기존 건에서 처리할 추가 요청</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"진행 중인 동일 자재 건","outputs":"기존 건에서 처리할 추가 요청","businessRules":[],"perspective":"tobe","phase":"Phase 1","functionIds":["K-접수-08","B-02"],"sourceRefs":[{"path":"CODEX.md","ref":"현행 업무의 시작·대상 자재 확인: 사용자 승인 4단계"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-18·M-22·M-30·M-77·M-96"},{"path":"docs/22_URS원문.md","ref":"O-01·A-01·G-01"},{"path":"docs/23_업무규칙장부.md","ref":"접수-02·접수-04·접수-07·접수-08·접수-12·접수-13"}],"workflowId":"WF01","originalStepId":"WF01_T07","actorDetail":"QS 담당자"}</bpmn:documentation>
      <bpmn:incoming>WF01_TF07</bpmn:incoming>
      <bpmn:outgoing>WF01_T07_END_FLOW</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="J_WF01_T08" name="경로 합류" gatewayDirection="Converging">
      <bpmn:documentation>해당 경로의 업무 결과를 이어 받는다.
입력 자료: 건 종류와 등록 자료
전달 자료: 건 종류와 등록 자료</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"건 종류와 등록 자료","outputs":"건 종류와 등록 자료","gatewayDirection":"Converging","gatewayMeaning":"경로 합류","perspective":"tobe","workflowId":"WF01","originalStepId":"WF01_T08"}</bpmn:documentation>
      <bpmn:incoming>WF01_TF08</bpmn:incoming>
      <bpmn:incoming>WF01_TF11</bpmn:incoming>
      <bpmn:outgoing>WF01_T_JOIN_WF01_T08</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="WF01_T12" name="새 요청을 대기로 보관한다">
      <bpmn:documentation>요청을 따로 보관하고 앞선 개정의 완료·접음 이후 처리한다. 새 개정을 동시에 열지 않는다.
입력 자료: 같은 자재의 열린 개정과 새 요청
