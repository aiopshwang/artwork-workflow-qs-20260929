      <bpmn:outgoing>WF01_TF06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="WF01_T06" name="진행 중인 같은 자재 건과 이번 요청을 어떻게 연결할까?" gatewayDirection="Diverging" default="WF01_TF30">
      <bpmn:documentation>같은 자재에 열린 개정이 있으면 기존 건에 편입하거나 새 요청을 대기로 보관한다. 열린 건이 없을 때만 새 준비 업무로 진행한다.
입력 자료: 자재와 진행 중인 건
전달 자료: 새 업무·기존 건 편입·요청 대기
업무 규칙: 같은 자재의 동시 확정을 만들지 않는다.</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀","scope":null}</bpmn:documentation>
