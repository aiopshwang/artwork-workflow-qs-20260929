        <bpmn:flowNodeRef>WF10_T12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF10_T12_RESULT</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_WF10_T_Process_R1" name="시스템">
        <bpmn:flowNodeRef>WF10_T14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF10_T02_SYS_RESPONSE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J_WF10_T07_SYS_DISPLAY</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF10_T06_SYS_RESPONSE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF10_T07_SYS_DISPLAY</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF10_T15_SYS_RESPONSE</bpmn:flowNodeRef>
