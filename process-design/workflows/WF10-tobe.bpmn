<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="WF10_T_Collaboration" name="발주 전 버전 확인과 첫 발주·입고 이력 · 도입 후 업무">
    <bpmn:documentation>발주 전 확인 이력과 ERP 실제 발주 이력을 분리하고 승인본을 기준으로 조회·대조한다.
입력 자료: 첫 발주 후속·반복 발주 확인·ERP 자료 수령
전달 자료: 자재별 후속 상태·회신·개정 연결·실제 발주 이력</bpmn:documentation>
    <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"첫 발주 후속·반복 발주 확인·ERP 자료 수령","outputs":"자재별 후속 상태·회신·개정 연결·실제 발주 이력","perspective":"tobe","sourceRefs":[{"path":"docs/20_회의록_2026-09-22.md","ref":"M-69·M-86 / 발주 전 버전 확인·위탁 문의"},{"path":"docs/22_URS원문.md","ref":"CF-01~03·CFE/CFN 발주 전 검수"},{"path":"docs/23_업무규칙장부.md","ref":"발주-06·발주-09·발주-11·발주-14·검건-03·차수-22·승인-07"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"T-07·T-15·C-14·C-17·B-18·B-19·B-45"},{"path":"CODEX.md","ref":"첫 발주와 반복 발주 / 외부 발주 정보·ERP 실제 이력 구분"}],"workflowId":"WF10"}</bpmn:documentation>
    <bpmn:participant id="Participant_WF10_T_Process" name="발주 전 버전 확인과 첫 발주·입고 이력 · 도입 후 업무" processRef="WF10_T_Process" />
  </bpmn:collaboration>
  <bpmn:process id="WF10_T_Process" isExecutable="false">
    <bpmn:laneSet id="LaneSet_WF10_T_Process">
      <bpmn:lane id="Lane_WF10_T_Process_R1" name="ERP 관련 담당 → 데이터 운영 담당">
        <bpmn:flowNodeRef>WF10_T13</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_WF10_T_Process_R0" name="QS팀">
        <bpmn:flowNodeRef>WF10_T01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF10_T04</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF10_T02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF10_T05</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF10_T03</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF10_T06</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J_WF10_T07</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF10_T15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF10_T03_RESULT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J_WF10_T08</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF10_T07</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF10_T15_RESULT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF10_T08</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF10_T09</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF10_T10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF10_T11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF10_T10_RESULT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF10_T12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF10_T12_RESULT</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_WF10_T_Process_R2" name="시스템">
        <bpmn:flowNodeRef>WF10_T14</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="WF10_T01" name="첫 발주에 사용할 승인본이 마련된다">
      <bpmn:documentation>해당 자재의 첫 발주 후속 업무에 승인본을 연결한다. 첫 발주용 검토 건을 중복 생성하지 않는다.
입력 자료: 완료된 개정과 필요한 표준서
전달 자료: 첫 발주 후속 대상</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"완료된 개정과 필요한 표준서","outputs":"첫 발주 후속 대상","businessRules":[],"perspective":"tobe","phase":"Phase 1","functionIds":["K-검토-14","B-11"],"sourceRefs":[{"path":"docs/20_회의록_2026-09-22.md","ref":"M-69·M-86 / 발주 전 버전 확인·위탁 문의"},{"path":"docs/22_URS원문.md","ref":"CF-01~03·CFE/CFN 발주 전 검수"},{"path":"docs/23_업무규칙장부.md","ref":"발주-06·발주-09·발주-11·발주-14·검건-03·차수-22·승인-07"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"T-07·T-15·C-14·C-17·B-18·B-19·B-45"},{"path":"CODEX.md","ref":"첫 발주와 반복 발주 / 외부 발주 정보·ERP 실제 이력 구분"}],"workflowId":"WF10","originalStepId":"WF10_T01","actorDetail":"QS 담당자"}</bpmn:documentation>
      <bpmn:outgoing>WF10_TF01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:startEvent id="WF10_T04" name="다음 발주 확인 요청을 등록한다">
      <bpmn:documentation>대상 자재·수량·요청 내용·받은 파일을 연결한다. 개정 작업과 발주 전 확인을 구분한다.
입력 자료: 구매·재고 요청 또는 업체 파일
전달 자료: 발주 전 확인 대상</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"구매·재고 요청 또는 업체 파일","outputs":"발주 전 확인 대상","businessRules":[],"perspective":"tobe","phase":"Phase 1","functionIds":["C-17","T-15","T-07"],"sourceRefs":[{"path":"docs/20_회의록_2026-09-22.md","ref":"M-69·M-86 / 발주 전 버전 확인·위탁 문의"},{"path":"docs/22_URS원문.md","ref":"CF-01~03·CFE/CFN 발주 전 검수"},{"path":"docs/23_업무규칙장부.md","ref":"발주-06·발주-09·발주-11·발주-14·검건-03·차수-22·승인-07"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"T-07·T-15·C-14·C-17·B-18·B-19·B-45"},{"path":"CODEX.md","ref":"첫 발주와 반복 발주 / 외부 발주 정보·ERP 실제 이력 구분"}],"workflowId":"WF10","originalStepId":"WF10_T04","actorDetail":"QS 담당자"}</bpmn:documentation>
      <bpmn:outgoing>WF10_TF03</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:startEvent id="WF10_T13" name="ERP 발주 데이터 파일을 받는다">
      <bpmn:documentation>확보한 실제 발주 데이터를 적재 대상으로 받는다. 실시간 ERP 연동으로 표현하지 않는다.
입력 자료: 받은 ERP 발주 자료
전달 자료: 적재할 발주 원천</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"ERP 관련 담당 → 데이터 운영 담당"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"받은 ERP 발주 자료","outputs":"적재할 발주 원천","businessRules":[],"perspective":"tobe","phase":"Phase 1","functionIds":["B-45"],"sourceRefs":[{"path":"docs/20_회의록_2026-09-22.md","ref":"M-69·M-86 / 발주 전 버전 확인·위탁 문의"},{"path":"docs/22_URS원문.md","ref":"CF-01~03·CFE/CFN 발주 전 검수"},{"path":"docs/23_업무규칙장부.md","ref":"발주-06·발주-09·발주-11·발주-14·검건-03·차수-22·승인-07"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"T-07·T-15·C-14·C-17·B-18·B-19·B-45"},{"path":"CODEX.md","ref":"첫 발주와 반복 발주 / 외부 발주 정보·ERP 실제 이력 구분"}],"workflowId":"WF10","originalStepId":"WF10_T13","actorDetail":"ERP 관련 담당 → 데이터 운영 담당"}</bpmn:documentation>
      <bpmn:outgoing>WF10_TF13</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="WF10_T02" name="자재의 발주·입고 담당과 상태를 연결한다">
      <bpmn:documentation>동국 발주인지 외부 발주인지에 맞춰 확인 가능한 담당·상태·자료를 연결한다.
입력 자료: 대상 자재·승인본
전달 자료: 자재별 후속 업무 상태</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"대상 자재·승인본","outputs":"자재별 후속 업무 상태","businessRules":[],"perspective":"tobe","phase":"Phase 1","functionIds":["B-11","C-17"],"sourceRefs":[{"path":"docs/20_회의록_2026-09-22.md","ref":"M-69·M-86 / 발주 전 버전 확인·위탁 문의"},{"path":"docs/22_URS원문.md","ref":"CF-01~03·CFE/CFN 발주 전 검수"},{"path":"docs/23_업무규칙장부.md","ref":"발주-06·발주-09·발주-11·발주-14·검건-03·차수-22·승인-07"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"T-07·T-15·C-14·C-17·B-18·B-19·B-45"},{"path":"CODEX.md","ref":"첫 발주와 반복 발주 / 외부 발주 정보·ERP 실제 이력 구분"}],"workflowId":"WF10","originalStepId":"WF10_T02","actorDetail":"QS 담당자·자재 담당"}</bpmn:documentation>
      <bpmn:incoming>WF10_TF01</bpmn:incoming>
      <bpmn:outgoing>WF10_TF02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="WF10_T05" name="기록 조회인가, 파일 대조인가?" gatewayDirection="Diverging" default="WF10_TF05">
      <bpmn:documentation>숫자형 자재의 버전 요청과 업체 가공본 등 파일 비교 요청을 구분한다. 코드만으로 발주 주체를 단정하지 않는다.
입력 자료: 요청 종류와 파일
전달 자료: 확인할 경로</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"요청 종류와 파일","outputs":"확인할 경로","gatewayDirection":"Diverging","businessRules":[],"gatewayMeaning":"하나 선택","perspective":"tobe","phase":"Phase 1","functionIds":["B-18","K-대조-19"],"sourceRefs":[{"path":"docs/20_회의록_2026-09-22.md","ref":"M-69·M-86 / 발주 전 버전 확인·위탁 문의"},{"path":"docs/22_URS원문.md","ref":"CF-01~03·CFE/CFN 발주 전 검수"},{"path":"docs/23_업무규칙장부.md","ref":"발주-06·발주-09·발주-11·발주-14·검건-03·차수-22·승인-07"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"T-07·T-15·C-14·C-17·B-18·B-19·B-45"},{"path":"CODEX.md","ref":"첫 발주와 반복 발주 / 외부 발주 정보·ERP 실제 이력 구분"}],"workflowId":"WF10","originalStepId":"WF10_T05","actorDetail":"QS 담당자"}</bpmn:documentation>
      <bpmn:incoming>WF10_TF03</bpmn:incoming>
      <bpmn:outgoing>WF10_TF04</bpmn:outgoing>
      <bpmn:outgoing>WF10_TF05</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="WF10_T14" name="자재·개정·실제 발주 기록을 연결한다">
      <bpmn:documentation>중복·대상 연결을 확인해 실제 발주 이력을 적재한다. 같은 원천을 다시 넣어도 발주 횟수가 늘지 않게 한다.
입력 자료: ERP 발주 파일
전달 자료: 중복을 제외한 실제 발주 이력</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"시스템"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"ERP 발주 파일","outputs":"중복을 제외한 실제 발주 이력","businessRules":[],"perspective":"tobe","phase":"Phase 1","functionIds":["B-45","B-19"],"sourceRefs":[{"path":"docs/20_회의록_2026-09-22.md","ref":"M-69·M-86 / 발주 전 버전 확인·위탁 문의"},{"path":"docs/22_URS원문.md","ref":"CF-01~03·CFE/CFN 발주 전 검수"},{"path":"docs/23_업무규칙장부.md","ref":"발주-06·발주-09·발주-11·발주-14·검건-03·차수-22·승인-07"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"T-07·T-15·C-14·C-17·B-18·B-19·B-45"},{"path":"CODEX.md","ref":"첫 발주와 반복 발주 / 외부 발주 정보·ERP 실제 이력 구분"}],"workflowId":"WF10","originalStepId":"WF10_T14","actorDetail":"시스템"}</bpmn:documentation>
      <bpmn:incoming>WF10_TF13</bpmn:incoming>
      <bpmn:outgoing>WF10_TF14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="WF10_T03" name="첫 발주·입고와 남은 후속 조치를 확인한다">
      <bpmn:documentation>확인 가능한 첫 발주·입고와 해당 바코드 후속 작업을 본다. 이력이 없다는 이유만으로 미발주라고 단정하지 않는다.
입력 자료: 담당자에게 받은 결과와 실제 이력
전달 자료: 확인한 후속 상태</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"담당자에게 받은 결과와 실제 이력","outputs":"확인한 후속 상태","businessRules":[],"perspective":"tobe","phase":"Phase 1","functionIds":["B-11","B-19"],"sourceRefs":[{"path":"docs/20_회의록_2026-09-22.md","ref":"M-69·M-86 / 발주 전 버전 확인·위탁 문의"},{"path":"docs/22_URS원문.md","ref":"CF-01~03·CFE/CFN 발주 전 검수"},{"path":"docs/23_업무규칙장부.md","ref":"발주-06·발주-09·발주-11·발주-14·검건-03·차수-22·승인-07"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"T-07·T-15·C-14·C-17·B-18·B-19·B-45"},{"path":"CODEX.md","ref":"첫 발주와 반복 발주 / 외부 발주 정보·ERP 실제 이력 구분"}],"workflowId":"WF10","originalStepId":"WF10_T03","actorDetail":"QS 담당자"}</bpmn:documentation>
      <bpmn:incoming>WF10_TF02</bpmn:incoming>
      <bpmn:outgoing>WF10_T03_END_FLOW</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="WF10_T06" name="최신 승인 개정·진행 중 변경·발주 이력을 확인한다">
      <bpmn:documentation>최신 승인본과 진행 중 변경, 확인 가능한 발주 이력을 함께 조회한다. 최신 업로드와 승인본을 구분한다.
입력 자료: 자재코드·이력
전달 자료: 회신할 버전과 경고</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"자재코드·이력","outputs":"회신할 버전과 경고","businessRules":[],"perspective":"tobe","phase":"Phase 1","functionIds":["B-18","B-19","B-14"],"sourceRefs":[{"path":"docs/20_회의록_2026-09-22.md","ref":"M-69·M-86 / 발주 전 버전 확인·위탁 문의"},{"path":"docs/22_URS원문.md","ref":"CF-01~03·CFE/CFN 발주 전 검수"},{"path":"docs/23_업무규칙장부.md","ref":"발주-06·발주-09·발주-11·발주-14·검건-03·차수-22·승인-07"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"T-07·T-15·C-14·C-17·B-18·B-19·B-45"},{"path":"CODEX.md","ref":"첫 발주와 반복 발주 / 외부 발주 정보·ERP 실제 이력 구분"}],"workflowId":"WF10","originalStepId":"WF10_T06","actorDetail":"QS 담당자"}</bpmn:documentation>
      <bpmn:incoming>WF10_TF04</bpmn:incoming>
      <bpmn:outgoing>WF10_TF06</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="J_WF10_T07" name="경로 합류" gatewayDirection="Converging">
      <bpmn:documentation>해당 경로의 업무 결과를 이어 받는다.
