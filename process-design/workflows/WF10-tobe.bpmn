        <bpmn:flowNodeRef>WF10_T11_SYS_RESPONSE</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="WF10_T01" name="첫 발주에 사용할 승인본이 마련된다">
      <bpmn:documentation>해당 자재의 첫 발주 후속 업무에 승인본을 연결한다. 첫 발주용 검토 건을 중복 생성하지 않는다.
입력 자료: 완료된 개정과 필요한 표준서
전달 자료: 첫 발주에 사용할 완료된 개정의 승인 Artwork 파일과 대상 자재정보</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀","scope":null}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"완료된 개정과 필요한 표준서","outputs":"첫 발주에 사용할 완료된 개정의 승인 Artwork 파일과 대상 자재정보","businessRules":[],"approvedQuestionIds":[],"perspective":"tobe","phase":"Phase 1","functionIds":["K-검토-14","B-11"],"sourceRefs":[{"path":"docs/20_회의록_2026-09-22.md","ref":"M-69·M-86 / 발주 전 버전 확인·위탁 문의"},{"path":"docs/22_URS원문.md","ref":"CF-01~03·CFE/CFN 발주 전 검수"},{"path":"docs/23_업무규칙장부.md","ref":"발주-06·발주-09·발주-11·발주-14·검건-03·차수-22·승인-07"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"T-07·T-15·C-14·C-17·B-18·B-19·B-45"},{"path":"CODEX.md","ref":"첫 발주와 반복 발주 / 외부 발주 정보·ERP 실제 이력 구분"}],"workflowId":"WF10","originalStepId":"WF10_T01","actorDetail":"QS 담당자","sourceSteps":[],"level":"context","scope":null}</bpmn:documentation>
      <bpmn:outgoing>WF10_TF01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:startEvent id="WF10_T04" name="다음 발주 확인 요청을 등록한다">
      <bpmn:documentation>대상 자재·수량·요청 내용·받은 파일을 연결한다. 개정 작업과 발주 전 확인을 구분한다.
입력 자료: 구매·재고 요청 또는 업체 파일
전달 자료: 등록한 발주 대상 자재, 확인을 요청한 개정번호 또는 인쇄용 파일</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀","scope":null}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"구매·재고 요청 또는 업체 파일","outputs":"등록한 발주 대상 자재, 확인을 요청한 개정번호 또는 인쇄용 파일","businessRules":[],"approvedQuestionIds":[],"perspective":"tobe","phase":"Phase 1","functionIds":["C-17","T-15","T-07"],"sourceRefs":[{"path":"docs/20_회의록_2026-09-22.md","ref":"M-69·M-86 / 발주 전 버전 확인·위탁 문의"},{"path":"docs/22_URS원문.md","ref":"CF-01~03·CFE/CFN 발주 전 검수"},{"path":"docs/23_업무규칙장부.md","ref":"발주-06·발주-09·발주-11·발주-14·검건-03·차수-22·승인-07"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"T-07·T-15·C-14·C-17·B-18·B-19·B-45"},{"path":"CODEX.md","ref":"첫 발주와 반복 발주 / 외부 발주 정보·ERP 실제 이력 구분"}],"workflowId":"WF10","originalStepId":"WF10_T04","actorDetail":"QS 담당자","sourceSteps":[],"level":"context","scope":null}</bpmn:documentation>
      <bpmn:outgoing>WF10_TF03</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:startEvent id="WF10_T13" name="ERP 발주 데이터 파일을 받는다">
      <bpmn:documentation>확보한 실제 발주 데이터를 적재 대상으로 받는다. 실시간 ERP 연동으로 표현하지 않는다.
입력 자료: 받은 ERP 발주 자료
전달 자료: 적재할 ERP 발주 데이터 원본 파일</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"ERP 관련 담당 → 데이터 운영 담당","scope":null}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"받은 ERP 발주 자료","outputs":"적재할 ERP 발주 데이터 원본 파일","businessRules":[],"approvedQuestionIds":[],"perspective":"tobe","phase":"Phase 1","functionIds":["B-45"],"sourceRefs":[{"path":"docs/20_회의록_2026-09-22.md","ref":"M-69·M-86 / 발주 전 버전 확인·위탁 문의"},{"path":"docs/22_URS원문.md","ref":"CF-01~03·CFE/CFN 발주 전 검수"},{"path":"docs/23_업무규칙장부.md","ref":"발주-06·발주-09·발주-11·발주-14·검건-03·차수-22·승인-07"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"T-07·T-15·C-14·C-17·B-18·B-19·B-45"},{"path":"CODEX.md","ref":"첫 발주와 반복 발주 / 외부 발주 정보·ERP 실제 이력 구분"}],"workflowId":"WF10","originalStepId":"WF10_T13","actorDetail":"ERP 관련 담당 → 데이터 운영 담당","sourceSteps":[],"level":"context","scope":null}</bpmn:documentation>
      <bpmn:outgoing>WF10_TF13</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="WF10_T02" name="자재의 발주·입고 담당과 상태를 연결한다">
      <bpmn:documentation>동국 발주인지 외부 발주인지에 맞춰 확인 가능한 담당·상태·자료를 연결한다.
입력 자료: 대상 자재·승인본
전달 자료: 대상 자재에 연결한 발주·입고 담당자와 확인 가능한 진행 상태</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀","scope":null}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"대상 자재·승인본","outputs":"대상 자재에 연결한 발주·입고 담당자와 확인 가능한 진행 상태","businessRules":[],"approvedQuestionIds":[],"perspective":"tobe","phase":"Phase 1","functionIds":["B-11","C-17"],"sourceRefs":[{"path":"docs/20_회의록_2026-09-22.md","ref":"M-69·M-86 / 발주 전 버전 확인·위탁 문의"},{"path":"docs/22_URS원문.md","ref":"CF-01~03·CFE/CFN 발주 전 검수"},{"path":"docs/23_업무규칙장부.md","ref":"발주-06·발주-09·발주-11·발주-14·검건-03·차수-22·승인-07"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"T-07·T-15·C-14·C-17·B-18·B-19·B-45"},{"path":"CODEX.md","ref":"첫 발주와 반복 발주 / 외부 발주 정보·ERP 실제 이력 구분"}],"workflowId":"WF10","originalStepId":"WF10_T02","actorDetail":"QS 담당자·자재 담당","sourceSteps":[],"level":"context","scope":null}</bpmn:documentation>
      <bpmn:incoming>WF10_TF01</bpmn:incoming>
      <bpmn:outgoing>WF10_T02_SYS_RESPONSE_FLOW</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="WF10_T05" name="기록 조회인가, 파일 대조인가?" gatewayDirection="Diverging" default="WF10_TF05">
      <bpmn:documentation>숫자형 자재의 버전 요청과 업체 가공본 등 파일 비교 요청을 구분한다. 코드만으로 발주 주체를 단정하지 않는다.
입력 자료: 요청 종류와 파일
전달 자료: 확인할 경로</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀","scope":null}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"요청 종류와 파일","outputs":"확인할 경로","gatewayDirection":"Diverging","businessRules":[],"gatewayMeaning":"하나 선택","approvedQuestionIds":[],"perspective":"tobe","phase":"Phase 1","functionIds":["B-18","K-대조-19"],"sourceRefs":[{"path":"docs/20_회의록_2026-09-22.md","ref":"M-69·M-86 / 발주 전 버전 확인·위탁 문의"},{"path":"docs/22_URS원문.md","ref":"CF-01~03·CFE/CFN 발주 전 검수"},{"path":"docs/23_업무규칙장부.md","ref":"발주-06·발주-09·발주-11·발주-14·검건-03·차수-22·승인-07"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"T-07·T-15·C-14·C-17·B-18·B-19·B-45"},{"path":"CODEX.md","ref":"첫 발주와 반복 발주 / 외부 발주 정보·ERP 실제 이력 구분"}],"workflowId":"WF10","originalStepId":"WF10_T05","actorDetail":"QS 담당자","sourceSteps":[],"level":"context","scope":null}</bpmn:documentation>
      <bpmn:incoming>WF10_TF03</bpmn:incoming>
      <bpmn:outgoing>WF10_TF04</bpmn:outgoing>
      <bpmn:outgoing>WF10_TF05</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="WF10_T14" name="자재·개정·실제 발주 기록을 연결한다">
      <bpmn:documentation>중복·대상 연결을 확인해 실제 발주 이력을 적재한다. 같은 원천을 다시 넣어도 발주 횟수가 늘지 않게 한다.
입력 자료: ERP 발주 파일
전달 자료: 중복을 제외한 실제 발주 이력</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"시스템","scope":null}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"ERP 발주 파일","outputs":"중복을 제외한 실제 발주 이력","businessRules":[],"approvedQuestionIds":[],"perspective":"tobe","phase":"Phase 1","functionIds":["B-45","B-19"],"sourceRefs":[{"path":"docs/20_회의록_2026-09-22.md","ref":"M-69·M-86 / 발주 전 버전 확인·위탁 문의"},{"path":"docs/22_URS원문.md","ref":"CF-01~03·CFE/CFN 발주 전 검수"},{"path":"docs/23_업무규칙장부.md","ref":"발주-06·발주-09·발주-11·발주-14·검건-03·차수-22·승인-07"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"T-07·T-15·C-14·C-17·B-18·B-19·B-45"},{"path":"CODEX.md","ref":"첫 발주와 반복 발주 / 외부 발주 정보·ERP 실제 이력 구분"}],"workflowId":"WF10","originalStepId":"WF10_T14","actorDetail":"Artwork 시스템","sourceSteps":[],"level":"context","scope":null}</bpmn:documentation>
      <bpmn:incoming>WF10_TF13</bpmn:incoming>
      <bpmn:outgoing>WF10_TF14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="WF10_T02_SYS_RESPONSE" name="확인한 발주·입고 담당과 자료·상태를 보여준다">
      <bpmn:documentation>담당자가 연결한 자재의 발주·입고 정보와 확인 가능한 자료를 보존한다. 시스템이 실제 발주·입고를 수행하지 않는다.
입력 자료: 대상 자재에 연결한 발주·입고 담당자와 확인 가능한 진행 상태
전달 자료: 대상 자재에 연결한 발주·입고 담당자와 확인 가능한 진행 상태</bpmn:documentation>
