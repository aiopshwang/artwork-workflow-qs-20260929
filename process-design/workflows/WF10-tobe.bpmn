<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="WF10_T_Collaboration" name="발주 전 버전 확인과 첫 발주·입고 이력 · 도입 후 업무">
    <bpmn:documentation>발주 전 확인 이력과 ERP 실제 발주 이력을 분리하고 승인본을 기준으로 조회·대조한다.
입력 자료: 첫 발주 후속·반복 발주 확인·ERP 자료 수령
전달 자료: 첫 발주·입고 확인 상태, 발주 전 확인 회신·대조 기록, 필요한 개정의 연결 또는 자재·개정별 실제 발주 이력</bpmn:documentation>
    <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"첫 발주 후속·반복 발주 확인·ERP 자료 수령","outputs":"첫 발주·입고 확인 상태, 발주 전 확인 회신·대조 기록, 필요한 개정의 연결 또는 자재·개정별 실제 발주 이력","perspective":"tobe","sourceRefs":[{"path":"docs/20_회의록_2026-09-22.md","ref":"M-69·M-86 / 발주 전 버전 확인·위탁 문의"},{"path":"docs/22_URS원문.md","ref":"CF-01~03·CFE/CFN 발주 전 검수"},{"path":"docs/23_업무규칙장부.md","ref":"발주-06·발주-09·발주-11·발주-14·검건-03·차수-22·승인-07"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"T-07·T-15·C-14·C-17·B-18·B-19·B-45"},{"path":"CODEX.md","ref":"첫 발주와 반복 발주 / 외부 발주 정보·ERP 실제 이력 구분"}],"workflowId":"WF10","sourceSteps":[],"level":"context","scope":null}</bpmn:documentation>
    <bpmn:participant id="Participant_WF10_T_Process" name="발주 전 버전 확인과 첫 발주·입고 이력 · 도입 후 업무" processRef="WF10_T_Process" />
  </bpmn:collaboration>
  <bpmn:process id="WF10_T_Process" isExecutable="false">
    <bpmn:laneSet id="LaneSet_WF10_T_Process">
      <bpmn:lane id="Lane_WF10_T_Process_R2" name="ERP 관련 담당 → 데이터 운영 담당">
        <bpmn:flowNodeRef>WF10_T13</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_WF10_T_Process_R0" name="QS팀">
