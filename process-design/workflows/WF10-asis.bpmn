    <bpmn:exclusiveGateway id="WF10_A05" name="버전 조회인가, 받은 인쇄용 파일의 비교인가?" gatewayDirection="Diverging" default="WF10_AF05">
      <bpmn:documentation>코드 유형과 실제 요청에 맞게 기록 조회 또는 파일 비교를 진행한다.
입력 자료: 자재코드와 받은 요청·파일
전달 자료: 확인 방법</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀","scope":null}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"자재코드와 받은 요청·파일","outputs":"확인 방법","gatewayDirection":"Diverging","businessRules":[],"gatewayMeaning":"하나 선택","approvedQuestionIds":[],"perspective":"asis","phase":"현행","functionIds":[],"sourceRefs":[{"path":"docs/20_회의록_2026-09-22.md","ref":"M-69·M-86 / 발주 전 버전 확인·위탁 문의"},{"path":"docs/22_URS원문.md","ref":"CF-01~03·CFE/CFN 발주 전 검수"},{"path":"docs/23_업무규칙장부.md","ref":"발주-06·발주-09·발주-11·발주-14·검건-03·차수-22·승인-07"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"T-07·T-15·C-14·C-17·B-18·B-19·B-45"},{"path":"CODEX.md","ref":"첫 발주와 반복 발주 / 외부 발주 정보·ERP 실제 이력 구분"}],"workflowId":"WF10","originalStepId":"WF10_A05","actorDetail":"QS팀","sourceSteps":[],"level":"context","scope":null}</bpmn:documentation>
