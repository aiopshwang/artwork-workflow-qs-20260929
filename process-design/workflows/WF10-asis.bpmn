        <bpmn:flowNodeRef>WF10_A06</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J_WF10_A07</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF10_A03_RESULT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J_WF10_A08</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF10_A07</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF10_A08</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF10_A09</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF10_A10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF10_A11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF10_A10_RESULT</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_WF10_A_Process_R1" name="전략구매">
        <bpmn:flowNodeRef>WF10_A02</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_WF10_A_Process_R2" name="해당 발주 담당">
        <bpmn:flowNodeRef>WF10_A12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF10_A12_RESULT</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="WF10_A01" name="최종 파일·필요 표준서가 첫 발주 업무로 넘어온다">
      <bpmn:documentation>대상 자재의 후속 발주·입고 업무로 인계한다.
입력 자료: 최종 파일과 필요한 표준서
전달 자료: 첫 발주에 사용할 해당 자재의 최종 Artwork 파일과 필요한 자재표준서</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀","scope":null}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"최종 파일과 필요한 표준서","outputs":"첫 발주에 사용할 해당 자재의 최종 Artwork 파일과 필요한 자재표준서","businessRules":[],"approvedQuestionIds":[],"perspective":"asis","phase":"현행","functionIds":[],"sourceRefs":[{"path":"docs/20_회의록_2026-09-22.md","ref":"M-69·M-86 / 발주 전 버전 확인·위탁 문의"},{"path":"docs/22_URS원문.md","ref":"CF-01~03·CFE/CFN 발주 전 검수"},{"path":"docs/23_업무규칙장부.md","ref":"발주-06·발주-09·발주-11·발주-14·검건-03·차수-22·승인-07"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"T-07·T-15·C-14·C-17·B-18·B-19·B-45"},{"path":"CODEX.md","ref":"첫 발주와 반복 발주 / 외부 발주 정보·ERP 실제 이력 구분"}],"workflowId":"WF10","originalStepId":"WF10_A01","actorDetail":"QS팀 → 해당 자재 발주 담당","sourceSteps":[],"level":"context","scope":null}</bpmn:documentation>
      <bpmn:outgoing>WF10_AF01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:startEvent id="WF10_A04" name="같은 자재의 다음 발주 확인 요청을 받는다">
      <bpmn:documentation>이번 발주에서 사용할 버전이나 파일을 확인해 달라는 요청을 받는다.
입력 자료: 자재·수량·버전 요청 또는 인쇄용 파일
전달 자료: 발주 전 확인 요청</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀","scope":null}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"자재·수량·버전 요청 또는 인쇄용 파일","outputs":"발주 전 확인 요청","businessRules":[],"approvedQuestionIds":[],"perspective":"asis","phase":"현행","functionIds":[],"sourceRefs":[{"path":"docs/20_회의록_2026-09-22.md","ref":"M-69·M-86 / 발주 전 버전 확인·위탁 문의"},{"path":"docs/22_URS원문.md","ref":"CF-01~03·CFE/CFN 발주 전 검수"},{"path":"docs/23_업무규칙장부.md","ref":"발주-06·발주-09·발주-11·발주-14·검건-03·차수-22·승인-07"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"T-07·T-15·C-14·C-17·B-18·B-19·B-45"},{"path":"CODEX.md","ref":"첫 발주와 반복 발주 / 외부 발주 정보·ERP 실제 이력 구분"}],"workflowId":"WF10","originalStepId":"WF10_A04","actorDetail":"구매·재고 담당 또는 외부 제조사 → QS팀","sourceSteps":[],"level":"context","scope":null}</bpmn:documentation>
      <bpmn:outgoing>WF10_AF03</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="WF10_A02" name="해당 자재의 발주·입고를 진행한다">
      <bpmn:documentation>자재를 담당하는 쪽에서 발주·인쇄·입고 일정을 진행한다. 외부 회사의 내부 절차는 상세화하지 않는다.
입력 자료: 최종 파일과 발주 대상
전달 자료: 해당 자재의 실제 발주·입고 결과와 확인 가능한 관련 자료</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"전략구매","scope":null}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"최종 파일과 발주 대상","outputs":"해당 자재의 실제 발주·입고 결과와 확인 가능한 관련 자료","businessRules":[],"approvedQuestionIds":[],"perspective":"asis","phase":"현행","functionIds":[],"sourceRefs":[{"path":"docs/20_회의록_2026-09-22.md","ref":"M-69·M-86 / 발주 전 버전 확인·위탁 문의"},{"path":"docs/22_URS원문.md","ref":"CF-01~03·CFE/CFN 발주 전 검수"},{"path":"docs/23_업무규칙장부.md","ref":"발주-06·발주-09·발주-11·발주-14·검건-03·차수-22·승인-07"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"T-07·T-15·C-14·C-17·B-18·B-19·B-45"},{"path":"CODEX.md","ref":"첫 발주와 반복 발주 / 외부 발주 정보·ERP 실제 이력 구분"}],"workflowId":"WF10","originalStepId":"WF10_A02","actorDetail":"구매·재고 담당 또는 외부 발주 담당","sourceSteps":[],"level":"context","scope":null}</bpmn:documentation>
