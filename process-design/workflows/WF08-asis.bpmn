    <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"수정사항이 정리된 검토 도안","outputs":"QS가 최종 파일 확인과 전달을 마친 자재별 Artwork·Illustrator·PDF 파일","perspective":"asis","sourceRefs":[{"path":"docs/22_URS원문.md","ref":"ON 최종화·OO-13·GN 최종안·GO 최종안·AN-23~24·AO 최종화·CR-58"},{"path":"docs/23_업무규칙장부.md","ref":"차수-13·차수-14·차수-23·승인-01·승인-05·승인-06·승인-11·개정-01"},{"path":"CODEX.md","ref":"내용 확정·최종 전환·QS 완료의 구분"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"K-검토-12~15 / T-14"}],"workflowId":"WF08","sourceSteps":[],"level":"context","scope":null}</bpmn:documentation>
