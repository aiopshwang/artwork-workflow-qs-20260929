<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="NW_Q_MATERIAL_A_Collaboration" name="사용할 자재와 기존 승인 Artwork·규격을 확인한다 · 현재 업무">
    <bpmn:documentation>현재 해당 담당자가 수행하는 업무
입력 자료: 대상 자재, 기존 등록 정보와 승인 Artwork·규격
전달 자료: 사용할 자재와 승인본·규격, 신규 등록 또는 규격 변경 필요 여부</bpmn:documentation>
    <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"scope":{"parentNodeId":"Q_MATERIAL","start":"상위 흐름에서 아래 입력 자료를 받은 때","end":"아래 결과를 정리하여 상위 흐름의 다음 업무에 전달한 때","inputs":"대상 자재, 기존 등록 정보와 승인 Artwork·규격","outputs":"사용할 자재와 승인본·규격, 신규 등록 또는 규격 변경 필요 여부","includes":["대상 자재의 기존 규격·승인본 확인","같은 규격 또는 유사 규격 검색","사용할 기존 자재 선택과 등록 필요 구분"],"excludes":["ERP 등록 실행","디자인 전달 자료 취합","위탁 신규에 기존 자재 검색 강제"]}}</bpmn:documentation>
    <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"대상 자재, 기존 등록 정보와 승인 Artwork·규격","outputs":"사용할 자재와 승인본·규격, 신규 등록 또는 규격 변경 필요 여부","perspective":"asis","sourceRefs":[{"path":"docs/기능설계/조사_2026-09-25/08_기능지도_2판.md","ref":"K-접수-09·13·14·15 / B-34"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-31~40·M-78~80"},{"path":"docs/23_업무규칙장부.md","ref":"단계-36: 기존 자재 조회 1단계, 등록 절차 2단계"}],"workflowId":"NW_Q_MATERIAL","sourceSteps":["WF02_A01","WF02_A02","WF02_A03","WF02_T01","WF02_T02"],"level":"node-detail","scope":{"parentNodeId":"Q_MATERIAL","start":"상위 흐름에서 아래 입력 자료를 받은 때","end":"아래 결과를 정리하여 상위 흐름의 다음 업무에 전달한 때","inputs":"대상 자재, 기존 등록 정보와 승인 Artwork·규격","outputs":"사용할 자재와 승인본·규격, 신규 등록 또는 규격 변경 필요 여부","includes":["대상 자재의 기존 규격·승인본 확인","같은 규격 또는 유사 규격 검색","사용할 기존 자재 선택과 등록 필요 구분"],"excludes":["ERP 등록 실행","디자인 전달 자료 취합","위탁 신규에 기존 자재 검색 강제"]}}</bpmn:documentation>
    <bpmn:participant id="Participant_NW_Q_MATERIAL_A_Process" name="사용할 자재와 기존 승인 Artwork·규격을 확인한다 · 현재 업무" processRef="NW_Q_MATERIAL_A_Process" />
  </bpmn:collaboration>
  <bpmn:process id="NW_Q_MATERIAL_A_Process" isExecutable="false">
    <bpmn:laneSet id="LaneSet_NW_Q_MATERIAL_A_Process">
      <bpmn:lane id="Lane_NW_Q_MATERIAL_A_Process_R0" name="QS팀">
        <bpmn:flowNodeRef>NW_Q_MATERIAL_A00</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NW_Q_MATERIAL_A01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NW_Q_MATERIAL_A02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NW_Q_MATERIAL_A03</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NW_Q_MATERIAL_A04</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NW_Q_MATERIAL_A06</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NW_Q_MATERIAL_A05</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="NW_Q_MATERIAL_A00" name="대상 자재와 받은 자료를 확인한다">
      <bpmn:documentation>해당 자재의 이 업무를 시작할 자료를 받는다.
입력 자료: 대상 자재, 기존 등록 정보와 승인 Artwork·규격
전달 자료: 대상 자재, 기존 등록 정보와 승인 Artwork·규격</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀","scope":{"parentNodeId":"Q_MATERIAL","start":"상위 흐름에서 아래 입력 자료를 받은 때","end":"아래 결과를 정리하여 상위 흐름의 다음 업무에 전달한 때","inputs":"대상 자재, 기존 등록 정보와 승인 Artwork·규격","outputs":"사용할 자재와 승인본·규격, 신규 등록 또는 규격 변경 필요 여부","includes":["대상 자재의 기존 규격·승인본 확인","같은 규격 또는 유사 규격 검색","사용할 기존 자재 선택과 등록 필요 구분"],"excludes":["ERP 등록 실행","디자인 전달 자료 취합","위탁 신규에 기존 자재 검색 강제"]}}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"대상 자재, 기존 등록 정보와 승인 Artwork·규격","outputs":"대상 자재, 기존 등록 정보와 승인 Artwork·규격","businessRules":[],"approvedQuestionIds":[],"perspective":"asis","phase":"현행","functionIds":[],"sourceRefs":[{"path":"docs/기능설계/조사_2026-09-25/08_기능지도_2판.md","ref":"K-접수-09·13·14·15 / B-34"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-31~40·M-78~80"},{"path":"docs/23_업무규칙장부.md","ref":"단계-36: 기존 자재 조회 1단계, 등록 절차 2단계"}],"workflowId":"NW_Q_MATERIAL","originalStepId":"NW_Q_MATERIAL_A00","actorDetail":"QS팀","sourceSteps":[],"level":"node-detail","scope":{"parentNodeId":"Q_MATERIAL","start":"상위 흐름에서 아래 입력 자료를 받은 때","end":"아래 결과를 정리하여 상위 흐름의 다음 업무에 전달한 때","inputs":"대상 자재, 기존 등록 정보와 승인 Artwork·규격","outputs":"사용할 자재와 승인본·규격, 신규 등록 또는 규격 변경 필요 여부","includes":["대상 자재의 기존 규격·승인본 확인","같은 규격 또는 유사 규격 검색","사용할 기존 자재 선택과 등록 필요 구분"],"excludes":["ERP 등록 실행","디자인 전달 자료 취합","위탁 신규에 기존 자재 검색 강제"]}}</bpmn:documentation>
      <bpmn:outgoing>NW_Q_MATERIAL_AF01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="NW_Q_MATERIAL_A01" name="이번 자재에 필요한 규격을 확인한다">
      <bpmn:documentation>신규는 필요한 규격을, 개정은 변경 대상 자재와 바뀌는 규격을 확인한다.
입력 자료: 대상 자재와 제작·변경 요청
전달 자료: 확인할 자재와 규격</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀","scope":{"parentNodeId":"Q_MATERIAL","start":"상위 흐름에서 아래 입력 자료를 받은 때","end":"아래 결과를 정리하여 상위 흐름의 다음 업무에 전달한 때","inputs":"대상 자재, 기존 등록 정보와 승인 Artwork·규격","outputs":"사용할 자재와 승인본·규격, 신규 등록 또는 규격 변경 필요 여부","includes":["대상 자재의 기존 규격·승인본 확인","같은 규격 또는 유사 규격 검색","사용할 기존 자재 선택과 등록 필요 구분"],"excludes":["ERP 등록 실행","디자인 전달 자료 취합","위탁 신규에 기존 자재 검색 강제"]}}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"대상 자재와 제작·변경 요청","outputs":"확인할 자재와 규격","businessRules":[],"approvedQuestionIds":[],"perspective":"asis","phase":"현행","functionIds":[],"sourceRefs":[{"path":"docs/기능설계/조사_2026-09-25/08_기능지도_2판.md","ref":"K-접수-09·13·14·15 / B-34"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-31~40·M-78~80"},{"path":"docs/23_업무규칙장부.md","ref":"단계-36: 기존 자재 조회 1단계, 등록 절차 2단계"}],"workflowId":"NW_Q_MATERIAL","originalStepId":"NW_Q_MATERIAL_A01","actorDetail":"QS팀","sourceSteps":[],"level":"node-detail","scope":{"parentNodeId":"Q_MATERIAL","start":"상위 흐름에서 아래 입력 자료를 받은 때","end":"아래 결과를 정리하여 상위 흐름의 다음 업무에 전달한 때","inputs":"대상 자재, 기존 등록 정보와 승인 Artwork·규격","outputs":"사용할 자재와 승인본·규격, 신규 등록 또는 규격 변경 필요 여부","includes":["대상 자재의 기존 규격·승인본 확인","같은 규격 또는 유사 규격 검색","사용할 기존 자재 선택과 등록 필요 구분"],"excludes":["ERP 등록 실행","디자인 전달 자료 취합","위탁 신규에 기존 자재 검색 강제"]}}</bpmn:documentation>
      <bpmn:incoming>NW_Q_MATERIAL_AF01</bpmn:incoming>
      <bpmn:outgoing>NW_Q_MATERIAL_AF02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="NW_Q_MATERIAL_A02" name="기존 등록 자재의 규격과 승인 도안을 찾는다">
      <bpmn:documentation>기존 등록 정보와 승인 Artwork를 찾아 사용할 수 있는 자재인지 확인한다.
입력 자료: 대상 자재·규격
전달 자료: 기존 자재의 등록 정보·규격·승인 Artwork</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀","scope":{"parentNodeId":"Q_MATERIAL","start":"상위 흐름에서 아래 입력 자료를 받은 때","end":"아래 결과를 정리하여 상위 흐름의 다음 업무에 전달한 때","inputs":"대상 자재, 기존 등록 정보와 승인 Artwork·규격","outputs":"사용할 자재와 승인본·규격, 신규 등록 또는 규격 변경 필요 여부","includes":["대상 자재의 기존 규격·승인본 확인","같은 규격 또는 유사 규격 검색","사용할 기존 자재 선택과 등록 필요 구분"],"excludes":["ERP 등록 실행","디자인 전달 자료 취합","위탁 신규에 기존 자재 검색 강제"]}}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"대상 자재·규격","outputs":"기존 자재의 등록 정보·규격·승인 Artwork","businessRules":[],"approvedQuestionIds":[],"perspective":"asis","phase":"현행","functionIds":[],"sourceRefs":[{"path":"docs/기능설계/조사_2026-09-25/08_기능지도_2판.md","ref":"K-접수-09·13·14·15 / B-34"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-31~40·M-78~80"},{"path":"docs/23_업무규칙장부.md","ref":"단계-36: 기존 자재 조회 1단계, 등록 절차 2단계"}],"workflowId":"NW_Q_MATERIAL","originalStepId":"NW_Q_MATERIAL_A02","actorDetail":"QS팀","sourceSteps":[],"level":"node-detail","scope":{"parentNodeId":"Q_MATERIAL","start":"상위 흐름에서 아래 입력 자료를 받은 때","end":"아래 결과를 정리하여 상위 흐름의 다음 업무에 전달한 때","inputs":"대상 자재, 기존 등록 정보와 승인 Artwork·규격","outputs":"사용할 자재와 승인본·규격, 신규 등록 또는 규격 변경 필요 여부","includes":["대상 자재의 기존 규격·승인본 확인","같은 규격 또는 유사 규격 검색","사용할 기존 자재 선택과 등록 필요 구분"],"excludes":["ERP 등록 실행","디자인 전달 자료 취합","위탁 신규에 기존 자재 검색 강제"]}}</bpmn:documentation>
      <bpmn:incoming>NW_Q_MATERIAL_AF02</bpmn:incoming>
      <bpmn:outgoing>NW_Q_MATERIAL_AF03</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="NW_Q_MATERIAL_A03" name="기존 자재와 규격을 그대로 사용할 수 있는가?" gatewayDirection="Diverging" default="NW_Q_MATERIAL_AF05">
      <bpmn:documentation>기존 자재를 사용할지 신규 등록 또는 규격 변경이 필요한지 판단한다.
입력 자료: 기존 정보와 이번 요청
전달 자료: 기존 사용 또는 등록·변경 필요</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀","scope":{"parentNodeId":"Q_MATERIAL","start":"상위 흐름에서 아래 입력 자료를 받은 때","end":"아래 결과를 정리하여 상위 흐름의 다음 업무에 전달한 때","inputs":"대상 자재, 기존 등록 정보와 승인 Artwork·규격","outputs":"사용할 자재와 승인본·규격, 신규 등록 또는 규격 변경 필요 여부","includes":["대상 자재의 기존 규격·승인본 확인","같은 규격 또는 유사 규격 검색","사용할 기존 자재 선택과 등록 필요 구분"],"excludes":["ERP 등록 실행","디자인 전달 자료 취합","위탁 신규에 기존 자재 검색 강제"]}}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"기존 정보와 이번 요청","outputs":"기존 사용 또는 등록·변경 필요","gatewayDirection":"Diverging","businessRules":[],"gatewayMeaning":"하나 선택","approvedQuestionIds":[],"perspective":"asis","phase":"현행","functionIds":[],"sourceRefs":[{"path":"docs/기능설계/조사_2026-09-25/08_기능지도_2판.md","ref":"K-접수-09·13·14·15 / B-34"},{"path":"docs/20_회의록_2026-09-22.md","ref":"M-31~40·M-78~80"},{"path":"docs/23_업무규칙장부.md","ref":"단계-36: 기존 자재 조회 1단계, 등록 절차 2단계"}],"workflowId":"NW_Q_MATERIAL","originalStepId":"NW_Q_MATERIAL_A03","actorDetail":"QS팀","sourceSteps":[],"level":"node-detail","scope":{"parentNodeId":"Q_MATERIAL","start":"상위 흐름에서 아래 입력 자료를 받은 때","end":"아래 결과를 정리하여 상위 흐름의 다음 업무에 전달한 때","inputs":"대상 자재, 기존 등록 정보와 승인 Artwork·규격","outputs":"사용할 자재와 승인본·규격, 신규 등록 또는 규격 변경 필요 여부","includes":["대상 자재의 기존 규격·승인본 확인","같은 규격 또는 유사 규격 검색","사용할 기존 자재 선택과 등록 필요 구분"],"excludes":["ERP 등록 실행","디자인 전달 자료 취합","위탁 신규에 기존 자재 검색 강제"]}}</bpmn:documentation>
      <bpmn:incoming>NW_Q_MATERIAL_AF03</bpmn:incoming>
      <bpmn:outgoing>NW_Q_MATERIAL_AF04</bpmn:outgoing>
      <bpmn:outgoing>NW_Q_MATERIAL_AF05</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="NW_Q_MATERIAL_A04" name="사용할 기존 자재와 승인본을 정한다">
      <bpmn:documentation>이번 업무에 사용할 자재와 승인 Artwork·규격을 정리한다.
