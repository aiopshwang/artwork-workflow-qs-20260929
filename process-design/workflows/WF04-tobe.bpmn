<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="WF04_T_Collaboration" name="디자인팀 자료 전달·다운로드·반영 업로드 · 도입 후 업무">
    <bpmn:documentation>받은 일에서 자료를 내려받고 반영본을 같은 작업에 올린다. QS는 수령 후 검토를 시작한다.
입력 자료: QS가 확인한 전달자료
전달 자료: 원래 요청에 연결된 업로드 파일과 해당 경로의 검토용 자료, 또는 파일 재업로드 요청</bpmn:documentation>
    <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"QS가 확인한 전달자료","outputs":"원래 요청에 연결된 업로드 파일과 해당 경로의 검토용 자료, 또는 파일 재업로드 요청","perspective":"tobe","sourceRefs":[{"path":"docs/20_회의록_2026-09-22.md","ref":"디자인팀 자료 전달·반환 / 사용자 순간 22"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"5장 다 디자인팀 받은 일 / C-01~09"},{"path":"docs/23_업무규칙장부.md","ref":"전달-01~06·차수-11"},{"path":"CODEX.md","ref":"디자인팀 다운로드·업로드 중심 원칙"}],"workflowId":"WF04","sourceSteps":[],"level":"context","scope":null}</bpmn:documentation>
    <bpmn:participant id="Participant_WF04_T_Process" name="디자인팀 자료 전달·다운로드·반영 업로드 · 도입 후 업무" processRef="WF04_T_Process" />
  </bpmn:collaboration>
  <bpmn:process id="WF04_T_Process" isExecutable="false">
    <bpmn:laneSet id="LaneSet_WF04_T_Process">
      <bpmn:lane id="Lane_WF04_T_Process_R0" name="QS팀">
        <bpmn:flowNodeRef>WF04_T_START1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF04_T01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF04_T02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF04_T05</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF04_T08</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF04_T09</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF04_T10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF04_T10_RESULT</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_WF04_T_Process_R2" name="디자인팀">
        <bpmn:flowNodeRef>J_WF04_T03</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF04_T03</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF04_T04</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF04_T06</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J_WF04_T07</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF04_T07</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_WF04_T_Process_R1" name="시스템">
        <bpmn:flowNodeRef>WF04_T02_SYS_RESPONSE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF04_T03_SYS_RESPONSE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF04_T05_SYS_RESPONSE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF04_T07_SYS_RESPONSE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WF04_T09_SYS_RESPONSE</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="WF04_T_START1" name="시작">
      <bpmn:documentation>QS가 확인한 전달자료
입력 자료: QS가 확인한 전달자료
전달 자료: 기준자료·확정한 주석·작업 목적</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"QS가 확인한 전달자료","outputs":"기준자료·확정한 주석·작업 목적","perspective":"tobe","workflowId":"WF04"}</bpmn:documentation>
      <bpmn:outgoing>WF04_T_START_FLOW1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="WF04_T01" name="전달할 자료와 요청을 확인한다">
      <bpmn:documentation>전달할 파일과 버전을 선택한다. 최초 제작에는 아직 작성하지 않은 주석을 필수로 두지 않는다.
입력 자료: 기준자료·확정한 주석·작업 목적
전달 자료: 대상 자재의 제작·수정 요청, 사용할 파일과 QS 주석본을 모은 전달자료</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀","scope":null}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"기준자료·확정한 주석·작업 목적","outputs":"대상 자재의 제작·수정 요청, 사용할 파일과 QS 주석본을 모은 전달자료","businessRules":[],"approvedQuestionIds":[],"perspective":"tobe","phase":"Phase 1","functionIds":["C-03","C-05","C-07"],"sourceRefs":[{"path":"docs/20_회의록_2026-09-22.md","ref":"디자인팀 자료 전달·반환 / 사용자 순간 22"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"5장 다 디자인팀 받은 일 / C-01~09"},{"path":"docs/23_업무규칙장부.md","ref":"전달-01~06·차수-11"},{"path":"CODEX.md","ref":"디자인팀 다운로드·업로드 중심 원칙"}],"workflowId":"WF04","originalStepId":"WF04_T01","actorDetail":"QS 담당자","sourceSteps":[],"level":"context","scope":null}</bpmn:documentation>
      <bpmn:incoming>WF04_T_START_FLOW1</bpmn:incoming>
      <bpmn:outgoing>WF04_TF01</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="WF04_T02" name="디자인팀 받은 일로 전달한다">
      <bpmn:documentation>대상 자재·작업 내용·받을 자료를 전달한다. QS 내부 판정·점수·AI 의견은 보여 주지 않는다.
입력 자료: 자료 묶음과 담당 작업
전달 자료: 디자인팀이 받은 자재별 제작·수정 요청과 내려받을 전달자료</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀","scope":null}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"자료 묶음과 담당 작업","outputs":"디자인팀이 받은 자재별 제작·수정 요청과 내려받을 전달자료","businessRules":[],"approvedQuestionIds":[],"perspective":"tobe","phase":"Phase 1","functionIds":["C-01","C-02","C-08","C-09"],"sourceRefs":[{"path":"docs/20_회의록_2026-09-22.md","ref":"디자인팀 자료 전달·반환 / 사용자 순간 22"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"5장 다 디자인팀 받은 일 / C-01~09"},{"path":"docs/23_업무규칙장부.md","ref":"전달-01~06·차수-11"},{"path":"CODEX.md","ref":"디자인팀 다운로드·업로드 중심 원칙"}],"workflowId":"WF04","originalStepId":"WF04_T02","actorDetail":"QS 담당자 → 디자인팀","sourceSteps":[],"level":"context","scope":null}</bpmn:documentation>
      <bpmn:incoming>WF04_TF01</bpmn:incoming>
      <bpmn:outgoing>WF04_T02_SYS_RESPONSE_FLOW</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="WF04_T02_SYS_RESPONSE" name="디자인팀의 받은 일에 요청과 내려받을 파일을 보여준다">
      <bpmn:documentation>담당자가 전달한 요청의 자재·작업 내용·파일 판을 디자인팀에게 보여준다. QS 내부 판정·점수·AI 의견은 노출하지 않는다.
입력 자료: 디자인팀이 받은 자재별 제작·수정 요청과 내려받을 전달자료
전달 자료: 디자인팀이 받은 자재별 제작·수정 요청과 내려받을 전달자료</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"시스템","scope":null}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"디자인팀이 받은 자재별 제작·수정 요청과 내려받을 전달자료","outputs":"디자인팀이 받은 자재별 제작·수정 요청과 내려받을 전달자료","businessRules":[],"approvedQuestionIds":[],"perspective":"tobe","phase":"Phase 1","functionIds":["C-01","C-02","C-08","C-09"],"sourceRefs":[{"path":"docs/20_회의록_2026-09-22.md","ref":"디자인팀 자료 전달·반환 / 사용자 순간 22"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"5장 다 디자인팀 받은 일 / C-01~09"},{"path":"docs/23_업무규칙장부.md","ref":"전달-01~06·차수-11"},{"path":"CODEX.md","ref":"디자인팀 다운로드·업로드 중심 원칙"}],"workflowId":"WF04","originalStepId":"WF04_T02_SYS_RESPONSE","actorDetail":"Artwork 시스템","sourceSteps":["WF04_T02"],"level":"context","scope":null}</bpmn:documentation>
      <bpmn:incoming>WF04_T02_SYS_RESPONSE_FLOW</bpmn:incoming>
      <bpmn:outgoing>WF04_TF02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="J_WF04_T03" name="경로 합류" gatewayDirection="Converging">
      <bpmn:documentation>해당 경로의 업무 결과를 이어 받는다.
입력 자료: 자기에게 배정된 받은 일
전달 자료: 자기에게 배정된 받은 일</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"디자인팀"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"자기에게 배정된 받은 일","outputs":"자기에게 배정된 받은 일","gatewayDirection":"Converging","gatewayMeaning":"경로 합류","perspective":"tobe","workflowId":"WF04","originalStepId":"WF04_T03"}</bpmn:documentation>
      <bpmn:incoming>WF04_TF02</bpmn:incoming>
      <bpmn:incoming>WF04_TF05</bpmn:incoming>
      <bpmn:outgoing>WF04_T_JOIN_WF04_T03</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="WF04_T03" name="자료·주석을 내려받는다">
      <bpmn:documentation>필요한 원본·기준자료·주석본을 개별 또는 묶음으로 내려받는다.
입력 자료: 자기에게 배정된 받은 일
전달 자료: 디자인팀이 작업에 사용하도록 내려받은 제작자료와 QS 주석본</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"디자인팀","scope":null}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"자기에게 배정된 받은 일","outputs":"디자인팀이 작업에 사용하도록 내려받은 제작자료와 QS 주석본","businessRules":[],"approvedQuestionIds":[],"perspective":"tobe","phase":"Phase 1","functionIds":["C-03","C-05","C-07"],"sourceRefs":[{"path":"docs/20_회의록_2026-09-22.md","ref":"디자인팀 자료 전달·반환 / 사용자 순간 22"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"5장 다 디자인팀 받은 일 / C-01~09"},{"path":"docs/23_업무규칙장부.md","ref":"전달-01~06·차수-11"},{"path":"CODEX.md","ref":"디자인팀 다운로드·업로드 중심 원칙"}],"workflowId":"WF04","originalStepId":"WF04_T03","actorDetail":"디자인팀","sourceSteps":[],"level":"context","scope":null}</bpmn:documentation>
      <bpmn:incoming>WF04_T_JOIN_WF04_T03</bpmn:incoming>
      <bpmn:outgoing>WF04_T03_SYS_RESPONSE_FLOW</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="WF04_T03_SYS_RESPONSE" name="요청에 연결된 원본·자료·주석본을 내려준다">
      <bpmn:documentation>디자인팀이 고른 전달자료의 정확한 판을 개별 또는 묶음 파일로 제공한다.
입력 자료: 디자인팀이 작업에 사용하도록 내려받은 제작자료와 QS 주석본
전달 자료: 디자인팀이 작업에 사용하도록 내려받은 제작자료와 QS 주석본</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"시스템","scope":null}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"디자인팀이 작업에 사용하도록 내려받은 제작자료와 QS 주석본","outputs":"디자인팀이 작업에 사용하도록 내려받은 제작자료와 QS 주석본","businessRules":[],"approvedQuestionIds":[],"perspective":"tobe","phase":"Phase 1","functionIds":["C-03","C-05","C-07"],"sourceRefs":[{"path":"docs/20_회의록_2026-09-22.md","ref":"디자인팀 자료 전달·반환 / 사용자 순간 22"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"5장 다 디자인팀 받은 일 / C-01~09"},{"path":"docs/23_업무규칙장부.md","ref":"전달-01~06·차수-11"},{"path":"CODEX.md","ref":"디자인팀 다운로드·업로드 중심 원칙"}],"workflowId":"WF04","originalStepId":"WF04_T03_SYS_RESPONSE","actorDetail":"Artwork 시스템","sourceSteps":["WF04_T03"],"level":"context","scope":null}</bpmn:documentation>
      <bpmn:incoming>WF04_T03_SYS_RESPONSE_FLOW</bpmn:incoming>
      <bpmn:outgoing>WF04_TF03</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="WF04_T04" name="자료 보완이나 새 전달본 확인이 필요한가?" gatewayDirection="Diverging" default="WF04_TF06">
      <bpmn:documentation>자료가 부족하거나 QS가 새 묶음을 보내면 현재 요청을 확인한다.
입력 자료: 내려받은 자료와 새 판 알림
전달 자료: 자료 확인 또는 작업 진행</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"디자인팀","scope":null}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"내려받은 자료와 새 판 알림","outputs":"자료 확인 또는 작업 진행","gatewayDirection":"Diverging","businessRules":[],"gatewayMeaning":"하나 선택","approvedQuestionIds":[],"perspective":"tobe","phase":"Phase 1","functionIds":["C-04","C-08"],"sourceRefs":[{"path":"docs/20_회의록_2026-09-22.md","ref":"디자인팀 자료 전달·반환 / 사용자 순간 22"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"5장 다 디자인팀 받은 일 / C-01~09"},{"path":"docs/23_업무규칙장부.md","ref":"전달-01~06·차수-11"},{"path":"CODEX.md","ref":"디자인팀 다운로드·업로드 중심 원칙"}],"workflowId":"WF04","originalStepId":"WF04_T04","actorDetail":"디자인팀","sourceSteps":[],"level":"context","scope":null}</bpmn:documentation>
      <bpmn:incoming>WF04_TF03</bpmn:incoming>
      <bpmn:outgoing>WF04_TF04</bpmn:outgoing>
      <bpmn:outgoing>WF04_TF06</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="WF04_T05" name="QS가 자료를 보완해 새 묶음을 전달한다">
      <bpmn:documentation>전달 버전을 새로 만들고 이전 묶음은 보존한다. 자료 등록만으로 디자인팀에 미확정 자료를 배포하지 않는다.
입력 자료: 디자인팀 문의 또는 변경된 기준자료
전달 자료: 부족한 자료를 보완한 새 전달자료와 그 자료가 도착했다는 알림</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀","scope":null}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"디자인팀 문의 또는 변경된 기준자료","outputs":"부족한 자료를 보완한 새 전달자료와 그 자료가 도착했다는 알림","businessRules":[],"approvedQuestionIds":[],"perspective":"tobe","phase":"Phase 1","functionIds":["C-04","C-09"],"sourceRefs":[{"path":"docs/20_회의록_2026-09-22.md","ref":"디자인팀 자료 전달·반환 / 사용자 순간 22"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"5장 다 디자인팀 받은 일 / C-01~09"},{"path":"docs/23_업무규칙장부.md","ref":"전달-01~06·차수-11"},{"path":"CODEX.md","ref":"디자인팀 다운로드·업로드 중심 원칙"}],"workflowId":"WF04","originalStepId":"WF04_T05","actorDetail":"QS 담당자","sourceSteps":[],"level":"context","scope":null}</bpmn:documentation>
      <bpmn:incoming>WF04_TF04</bpmn:incoming>
      <bpmn:outgoing>WF04_T05_SYS_RESPONSE_FLOW</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="WF04_T06" name="외부 디자인 도구에서 요청사항을 반영한다">
      <bpmn:documentation>기존 디자인 도구에서 제작·수정한다. 시스템은 도안을 자동 편집하지 않는다.
입력 자료: 받은 파일·주석
전달 자료: 외부 디자인 도구에서 제작하거나 QS 수정 요청을 반영한 Artwork 파일</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"디자인팀","scope":null}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"받은 파일·주석","outputs":"외부 디자인 도구에서 제작하거나 QS 수정 요청을 반영한 Artwork 파일","businessRules":[],"approvedQuestionIds":[],"perspective":"tobe","phase":"Phase 1","functionIds":["C-02"],"sourceRefs":[{"path":"docs/20_회의록_2026-09-22.md","ref":"디자인팀 자료 전달·반환 / 사용자 순간 22"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"5장 다 디자인팀 받은 일 / C-01~09"},{"path":"docs/23_업무규칙장부.md","ref":"전달-01~06·차수-11"},{"path":"CODEX.md","ref":"디자인팀 다운로드·업로드 중심 원칙"}],"workflowId":"WF04","originalStepId":"WF04_T06","actorDetail":"디자인팀","sourceSteps":[],"level":"context","scope":null}</bpmn:documentation>
      <bpmn:incoming>WF04_TF06</bpmn:incoming>
      <bpmn:outgoing>WF04_TF07</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="WF04_T05_SYS_RESPONSE" name="새 전달자료를 저장하고 이전 전달본과 구분해 알린다">
      <bpmn:documentation>담당자가 전달을 결정한 새 묶음을 저장하고 이전 묶음은 보존한다. 자료 등록만으로 미확정 자료를 배포하지 않는다.
입력 자료: 부족한 자료를 보완한 새 전달자료와 그 자료가 도착했다는 알림
전달 자료: 부족한 자료를 보완한 새 전달자료와 그 자료가 도착했다는 알림</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"시스템","scope":null}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"부족한 자료를 보완한 새 전달자료와 그 자료가 도착했다는 알림","outputs":"부족한 자료를 보완한 새 전달자료와 그 자료가 도착했다는 알림","businessRules":[],"approvedQuestionIds":[],"perspective":"tobe","phase":"Phase 1","functionIds":["C-04","C-09"],"sourceRefs":[{"path":"docs/20_회의록_2026-09-22.md","ref":"디자인팀 자료 전달·반환 / 사용자 순간 22"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"5장 다 디자인팀 받은 일 / C-01~09"},{"path":"docs/23_업무규칙장부.md","ref":"전달-01~06·차수-11"},{"path":"CODEX.md","ref":"디자인팀 다운로드·업로드 중심 원칙"}],"workflowId":"WF04","originalStepId":"WF04_T05_SYS_RESPONSE","actorDetail":"Artwork 시스템","sourceSteps":["WF04_T05"],"level":"context","scope":null}</bpmn:documentation>
      <bpmn:incoming>WF04_T05_SYS_RESPONSE_FLOW</bpmn:incoming>
      <bpmn:outgoing>WF04_TF05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="J_WF04_T07" name="경로 합류" gatewayDirection="Converging">
      <bpmn:documentation>해당 경로의 업무 결과를 이어 받는다.
입력 자료: 초안·반영본·전환본과 필요한 설명
전달 자료: 초안·반영본·전환본과 필요한 설명</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"디자인팀"}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"초안·반영본·전환본과 필요한 설명","outputs":"초안·반영본·전환본과 필요한 설명","gatewayDirection":"Converging","gatewayMeaning":"경로 합류","perspective":"tobe","workflowId":"WF04","originalStepId":"WF04_T07"}</bpmn:documentation>
      <bpmn:incoming>WF04_TF07</bpmn:incoming>
      <bpmn:incoming>WF04_TF10</bpmn:incoming>
      <bpmn:outgoing>WF04_T_JOIN_WF04_T07</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="WF04_T07" name="동일한 받은 일에 작업 파일을 올린다">
      <bpmn:documentation>해당 작업에 반환 파일을 업로드한다. 시스템은 수령 사실을 QS에 알린다.
입력 자료: 초안·반영본·전환본과 필요한 설명
전달 자료: 디자인팀이 받은 원래 요청에 연결해 올린 신규 Artwork 또는 주석 반영본</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"디자인팀","scope":null}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"초안·반영본·전환본과 필요한 설명","outputs":"디자인팀이 받은 원래 요청에 연결해 올린 신규 Artwork 또는 주석 반영본","businessRules":[],"approvedQuestionIds":[],"perspective":"tobe","phase":"Phase 1","functionIds":["C-06","C-08"],"sourceRefs":[{"path":"docs/20_회의록_2026-09-22.md","ref":"디자인팀 자료 전달·반환 / 사용자 순간 22"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"5장 다 디자인팀 받은 일 / C-01~09"},{"path":"docs/23_업무규칙장부.md","ref":"전달-01~06·차수-11"},{"path":"CODEX.md","ref":"디자인팀 다운로드·업로드 중심 원칙"}],"workflowId":"WF04","originalStepId":"WF04_T07","actorDetail":"디자인팀","sourceSteps":[],"level":"context","scope":null}</bpmn:documentation>
      <bpmn:incoming>WF04_T_JOIN_WF04_T07</bpmn:incoming>
      <bpmn:outgoing>WF04_T07_SYS_RESPONSE_FLOW</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="WF04_T07_SYS_RESPONSE" name="업로드 파일을 원래 요청에 연결하고 수령 사실을 알린다">
      <bpmn:documentation>업로드한 제작·수정 또는 최종 전환 파일을 동일한 받은 일에 저장한다. 시스템 안 담당자에게 수령을 알리며 파일 업로드만으로 QS의 검토 차수를 열지 않는다. 개발부·외부 회사에 자동 발송하지 않는다.
입력 자료: 디자인팀이 받은 원래 요청에 연결해 올린 신규 Artwork 또는 주석 반영본
전달 자료: 디자인팀이 받은 원래 요청에 연결해 올린 신규 Artwork 또는 주석 반영본</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"시스템","scope":null}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"디자인팀이 받은 원래 요청에 연결해 올린 신규 Artwork 또는 주석 반영본","outputs":"디자인팀이 받은 원래 요청에 연결해 올린 신규 Artwork 또는 주석 반영본","businessRules":[],"approvedQuestionIds":[],"perspective":"tobe","phase":"Phase 1","functionIds":["C-06","C-08"],"sourceRefs":[{"path":"docs/20_회의록_2026-09-22.md","ref":"디자인팀 자료 전달·반환 / 사용자 순간 22"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"5장 다 디자인팀 받은 일 / C-01~09"},{"path":"docs/23_업무규칙장부.md","ref":"전달-01~06·차수-11"},{"path":"CODEX.md","ref":"디자인팀 다운로드·업로드 중심 원칙"}],"workflowId":"WF04","originalStepId":"WF04_T07_SYS_RESPONSE","actorDetail":"Artwork 시스템","sourceSteps":["WF04_T07"],"level":"context","scope":null}</bpmn:documentation>
      <bpmn:incoming>WF04_T07_SYS_RESPONSE_FLOW</bpmn:incoming>
      <bpmn:outgoing>WF04_TF08</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="WF04_T08" name="검토할 대상·판·파일이 맞는가?" gatewayDirection="Diverging" default="WF04_TF11">
      <bpmn:documentation>대상 자재와 요청 목적에 맞는 파일인지 확인한다. 업로드만으로 차수를 열거나 완료하지 않는다.
입력 자료: 업로드 알림과 반환 파일
전달 자료: 검토 시작 또는 반환</bpmn:documentation>
