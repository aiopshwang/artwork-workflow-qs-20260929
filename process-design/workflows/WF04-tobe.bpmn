      <bpmn:outgoing>WF04_T10_END_FLOW</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="WF04_T09_SYS_RESPONSE" name="재업로드 사유와 요청을 디자인팀에 보여준다">
      <bpmn:documentation>담당자가 남긴 반환 사유와 대상 파일을 같은 작업에 연결하고 디자인팀이 다시 올릴 자료를 알 수 있게 한다.
입력 자료: 파일 재업로드 요청
전달 자료: 파일 재업로드 요청</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"시스템","scope":null}</bpmn:documentation>
      <bpmn:documentation textFormat="application/vnd.artwork.review-context+json">{"inputs":"파일 재업로드 요청","outputs":"파일 재업로드 요청","businessRules":[],"approvedQuestionIds":[],"perspective":"tobe","phase":"Phase 1","functionIds":["C-06","C-08","C-09"],"sourceRefs":[{"path":"docs/20_회의록_2026-09-22.md","ref":"디자인팀 자료 전달·반환 / 사용자 순간 22"},{"path":"docs/superpowers/specs/2026-09-25-artwork-phase1-functional-design.md","ref":"5장 다 디자인팀 받은 일 / C-01~09"},{"path":"docs/23_업무규칙장부.md","ref":"전달-01~06·차수-11"},{"path":"CODEX.md","ref":"디자인팀 다운로드·업로드 중심 원칙"}],"workflowId":"WF04","originalStepId":"WF04_T09_SYS_RESPONSE","actorDetail":"Artwork 시스템","sourceSteps":["WF04_T09"],"level":"context","scope":null}</bpmn:documentation>
