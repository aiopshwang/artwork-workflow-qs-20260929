          <bpmn:flowNodeRef>GN_review</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>GN_correction</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>GN_fix</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>GN_production_record</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>GN_production_fix</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>GN_final</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>GN_final_out</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>GN_end</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="Lane_Artwork_GN_3" name="제조 수탁사">
