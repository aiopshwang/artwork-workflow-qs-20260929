          <bpmn:incoming>OOR_f8</bpmn:incoming>
          <bpmn:outgoing>OOR_f9</bpmn:outgoing>
          <bpmn:laneSet id="LaneSet_OOR_basis">
            <bpmn:lane id="Lane_OOR_basis_1" name="QS팀">
              <bpmn:flowNodeRef>OORB_start</bpmn:flowNodeRef>
              <bpmn:flowNodeRef>OORB_permit</bpmn:flowNodeRef>
