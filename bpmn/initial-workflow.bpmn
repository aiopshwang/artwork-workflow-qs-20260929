            <bpmn:flowNodeRef>ANR_start</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>ANR_both_formats</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>ANR_round</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>ANR_equivalence</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>ANR_basis</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>ANR_same_design</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>ANR_choose_input</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>ANR_verdict</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>ANR_fix</bpmn:flowNodeRef>
