            <bpmn:incoming>ANVB_f6</bpmn:incoming>
            <bpmn:outgoing>ANVB_f7</bpmn:outgoing>
          </bpmn:userTask>
          <bpmn:endEvent id="ANVB_end" name="대조 조건 준비">
            <bpmn:documentation>담당: QS팀
상태: 장부 기재 · 초안 검토 중
지원 범위: 1단계</bpmn:documentation>
            <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀","status":"장부 기재 · 초안 검토 중","scope":"1단계"}</bpmn:documentation>
            <bpmn:incoming>ANVB_f7</bpmn:incoming>
          </bpmn:endEvent>
