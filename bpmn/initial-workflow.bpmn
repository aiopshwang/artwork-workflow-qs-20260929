            <bpmn:outgoing>GOPChange_f8</bpmn:outgoing>
          </bpmn:userTask>
          <bpmn:endEvent id="GOPChange_end" name="확정된 변경 범위로 작업">
            <bpmn:documentation>담당: QS팀
상태: 장부 기재 · 초안 검토 중
지원 범위: 1단계</bpmn:documentation>
            <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀","status":"장부 기재 · 초안 검토 중","scope":"1단계"}</bpmn:documentation>
