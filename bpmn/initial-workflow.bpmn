          <bpmn:sequenceFlow id="ANVB_f2" name="있음" sourceRef="ANVB_permit" targetRef="ANVB_permit_yes" />
          <bpmn:sequenceFlow id="ANVB_f3" name="없음" sourceRef="ANVB_permit" targetRef="ANVB_permit_no" />
