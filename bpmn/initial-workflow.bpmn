            <bpmn:incoming>OOPChange_f6</bpmn:incoming>
            <bpmn:incoming>OOPChange_f7</bpmn:incoming>
            <bpmn:outgoing>OOPChange_f8</bpmn:outgoing>
          </bpmn:userTask>
          <bpmn:endEvent id="OOPChange_end" name="확정된 변경 범위로 작업">
            <bpmn:documentation>담당: QS팀
상태: 장부 기재 · 초안 검토 중
지원 범위: 1단계</bpmn:documentation>
            <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀","status":"장부 기재 · 초안 검토 중","scope":"1단계"}</bpmn:documentation>
            <bpmn:incoming>OOPChange_f8</bpmn:incoming>
          </bpmn:endEvent>
          <bpmn:sequenceFlow id="OOPChange_f1" sourceRef="OOPChange_start" targetRef="OOPChange_reason" />
          <bpmn:sequenceFlow id="OOPChange_f2" name="허가 / 규제" sourceRef="OOPChange_reason" targetRef="OOPChange_permit" />
