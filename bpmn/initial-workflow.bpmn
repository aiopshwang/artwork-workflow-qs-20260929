          <bpmn:sequenceFlow id="OOPC_f3" sourceRef="OOPC_material" targetRef="OOPC_existing" />
          <bpmn:sequenceFlow id="OOPC_f4" name="없음" sourceRef="OOPC_existing" targetRef="OOPC_open" />
          <bpmn:sequenceFlow id="OOPC_f5" name="있음" sourceRef="OOPC_existing" targetRef="OOPC_choice" />
          <bpmn:sequenceFlow id="OOPC_f6" name="편입" sourceRef="OOPC_choice" targetRef="OOPC_merge" />
          <bpmn:sequenceFlow id="OOPC_f7" name="대기" sourceRef="OOPC_choice" targetRef="OOPC_queue" />
          <bpmn:sequenceFlow id="OOPC_f8" sourceRef="OOPC_merge" targetRef="OOPC_merged" />
          <bpmn:sequenceFlow id="OOPC_f9" sourceRef="OOPC_queue" targetRef="OOPC_open" />
          <bpmn:sequenceFlow id="OOPC_f10" sourceRef="OOPC_open" targetRef="OOPC_end" />
        </bpmn:subProcess>
        <bpmn:exclusiveGateway id="OOP_case_result" name="접수 처리 결과" gatewayDirection="Diverging">
          <bpmn:documentation>

검건-08 — 한 자재에 열린 개정 작업은 하나 · 새 요청은 따로 받아 둔다
결정 상태: 원문 ＋ 수석 결정(09-30) ＋ 우리가 정함(잠정)
담당: QS팀
상태: 잠정 포함 · 수석 확인 전
지원 범위: 1단계</bpmn:documentation>
          <bpmn:documentation textFormat="application/vnd.artwork.rule-ids">["검건-08"]</bpmn:documentation>
          <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀","status":"잠정 포함 · 수석 확인 전","scope":"1단계"}</bpmn:documentation>
          <bpmn:incoming>OOP_f2</bpmn:incoming>
          <bpmn:outgoing>OOP_f3</bpmn:outgoing>
          <bpmn:outgoing>OOP_f4</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:endEvent id="OOP_existing" name="기존 열린 작업에서 이어감">
          <bpmn:documentation>담당: QS팀
상태: 장부 기재 · 초안 검토 중
지원 범위: 1단계</bpmn:documentation>
          <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀","status":"장부 기재 · 초안 검토 중","scope":"1단계"}</bpmn:documentation>
          <bpmn:incoming>OOP_f3</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:userTask id="OOP_new_case" name="새 자재별 작업 준비">
          <bpmn:documentation>

검건-05 — 검토 건은 자재마다 하나, 사건은 묶음이다
결정 상태: 원문 ＋ 우리가 정함(잠정) ＋ 우리가 정함(잠정 — 수석 09-30 물음)
담당: QS팀
상태: 잠정 포함 · 수석 확인 전
지원 범위: 1단계</bpmn:documentation>
          <bpmn:documentation textFormat="application/vnd.artwork.rule-ids">["검건-05"]</bpmn:documentation>
          <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀","status":"잠정 포함 · 수석 확인 전","scope":"1단계"}</bpmn:documentation>
          <bpmn:incoming>OOP_f4</bpmn:incoming>
          <bpmn:outgoing>OOP_f5</bpmn:outgoing>
        </bpmn:userTask>
        <bpmn:subProcess id="OOP_change" name="개정 사유 · 변경 범위 풀기">
          <bpmn:documentation>

개정-10 — 표시자재의 제정 · 개정은 신제품 도입 · 허가사항 변경 · 수탁사 / 설비 변경 · 통일조정 · 변경 명령 등으로 생긴다 —
결정 상태: 원문

개정-19 — 개정 사유 · 개정일
결정 상태: 원문 ＋ 수석 결정(09-30) ＋ 우리가 정함(잠정)

단계-17 — 기존제품 변경은 동국 QS팀이 변경 사유 · 근거자료 · 적용 시점을 확인하고 영향범위를 판단한다(수탁 기존은 업체의 변경 사
결정 상태: 원문

단계-20 — 외부 조건(변경 명령 등)으로 시작하는 건 — 우리 시스템이 검토 목록에 알림 → 동국 QS 담당자가 고르면 우리 시스템이 변
결정 상태: 원문
담당: QS팀
상태: 잠정 포함 · 수석 확인 전
지원 범위: 1단계</bpmn:documentation>
          <bpmn:documentation textFormat="application/vnd.artwork.rule-ids">["개정-10","개정-19","단계-17","단계-20"]</bpmn:documentation>
          <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀","status":"잠정 포함 · 수석 확인 전","scope":"1단계"}</bpmn:documentation>
          <bpmn:incoming>OOP_f5</bpmn:incoming>
          <bpmn:outgoing>OOP_f6</bpmn:outgoing>
          <bpmn:laneSet id="LaneSet_OOP_change">
            <bpmn:lane id="Lane_OOP_change_1" name="QS팀">
              <bpmn:flowNodeRef>OOPChange_start</bpmn:flowNodeRef>
              <bpmn:flowNodeRef>OOPChange_reason</bpmn:flowNodeRef>
              <bpmn:flowNodeRef>OOPChange_permit</bpmn:flowNodeRef>
              <bpmn:flowNodeRef>OOPChange_spec</bpmn:flowNodeRef>
              <bpmn:flowNodeRef>OOPChange_wording</bpmn:flowNodeRef>
              <bpmn:flowNodeRef>OOPChange_confirm</bpmn:flowNodeRef>
              <bpmn:flowNodeRef>OOPChange_end</bpmn:flowNodeRef>
            </bpmn:lane>
          </bpmn:laneSet>
          <bpmn:startEvent id="OOPChange_start" name="기존 승인본에 변경 발생">
            <bpmn:documentation>담당: QS팀
상태: 장부 기재 · 초안 검토 중
지원 범위: 1단계</bpmn:documentation>
            <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀","status":"장부 기재 · 초안 검토 중","scope":"1단계"}</bpmn:documentation>
            <bpmn:outgoing>OOPChange_f1</bpmn:outgoing>
          </bpmn:startEvent>
          <bpmn:exclusiveGateway id="OOPChange_reason" name="변경이 생긴 배경" gatewayDirection="Diverging">
            <bpmn:documentation>

개정-10 — 표시자재의 제정 · 개정은 신제품 도입 · 허가사항 변경 · 수탁사 / 설비 변경 · 통일조정 · 변경 명령 등으로 생긴다 —
결정 상태: 원문

개정-19 — 개정 사유 · 개정일
결정 상태: 원문 ＋ 수석 결정(09-30) ＋ 우리가 정함(잠정)
담당: QS팀
상태: 잠정 포함 · 수석 확인 전
지원 범위: 1단계</bpmn:documentation>
