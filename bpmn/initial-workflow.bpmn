            <bpmn:incoming>ANRB_f6</bpmn:incoming>
            <bpmn:outgoing>ANRB_f7</bpmn:outgoing>
          </bpmn:userTask>
          <bpmn:endEvent id="ANRB_end" name="대조 조건 준비">
            <bpmn:documentation>담당: QS팀
상태: 장부 기재 · 초안 검토 중
지원 범위: 1단계</bpmn:documentation>
            <bpmn:documentation textFormat="application/vnd.artwork.metadata+json">{"actor":"QS팀","status":"장부 기재 · 초안 검토 중","scope":"1단계"}</bpmn:documentation>
            <bpmn:incoming>ANRB_f7</bpmn:incoming>
          </bpmn:endEvent>
          <bpmn:sequenceFlow id="ANRB_f1" sourceRef="ANRB_start" targetRef="ANRB_permit" />
          <bpmn:sequenceFlow id="ANRB_f2" name="있음" sourceRef="ANRB_permit" targetRef="ANRB_permit_yes" />
          <bpmn:sequenceFlow id="ANRB_f3" name="없음" sourceRef="ANRB_permit" targetRef="ANRB_permit_no" />
          <bpmn:sequenceFlow id="ANRB_f4" sourceRef="ANRB_permit_yes" targetRef="ANRB_classification" />
          <bpmn:sequenceFlow id="ANRB_f5" sourceRef="ANRB_classification" targetRef="ANRB_barcode" />
          <bpmn:sequenceFlow id="ANRB_f6" sourceRef="ANRB_barcode" targetRef="ANRB_freeze" />
